# The demo as a sequence of analyses. Run them in order in Dyad Builder;
# every one has a SimulationSolutionPlot artifact. Training takes longer than
# a free-running evaluation; its budget must close the shooting constraints.
#
#   A1_UntrainedTNN             the model before training
#   A2_TrainTNNQuick            a continuity-feasible training run
#   A3_RetrainedTNN             the fit A2 just wrote
#   A4_CalibratedTNN            the shipped fit, with the PyTorch reference overlaid
#   A5_CalibratedTNNProfile60   the shipped fit on held-out profiles
#   A6_CalibratedTNNProfile62
#   A7_CalibratedTNNProfile74
#
# The full-budget calibration behind the README results lives in
# scripts/train_stochastic_ms.jl. Current timings and unvalidated presets are
# documented in docs/followup-validation.md.

"""
**1 · Before training.** The Thermal Neural Network with its initial weights,
free-running over the training profile. The conductance network starts near
mid-range and the loss network near zero, so every node relaxes towards the
coolant and ambient temperatures and misses the measured heating.
"""
analysis A1_UntrainedTNN
  extends MotorTemperatureSciML.TNNFreeRunAnalysis(calibration = "", reference = "")
  model = MotorTemperatureSciML.Models.Tests.TestTNNProfile()
end

"""
**2 · Training, short budget.** Up to 30 augmented-Lagrangian iterations
of 12 Adam epochs (1080 updates maximum). Shooting states start from the
measured training data in the ODE state order. Stops only when the largest
junction gap is below 0.2 °C, and exports only a successful fit for A3.
Continuity success does not guarantee a fully trained model: inspect FitPlot
and ErrorTable as well. This replaces the old six-update pipeline check.
"""
analysis A2_TrainTNNQuick
  extends MotorTemperatureSciML.TNNTrainingAnalysis(inner_epochs = 12, outer_maxiters = 30,
    results_path = "dyad://MotorTemperatureSciML/story/calibrated_params.csv")
  model = MotorTemperatureSciML.Models.Tests.TestTNNProfile()
end

"""
**3 · After training, your own run.** Same as `A4_CalibratedTNN` but with the
parameters `A2_TrainTNNQuick` just wrote. Compare this short fit with the
shipped full calibration in the next plot.
"""
analysis A3_RetrainedTNN
  extends MotorTemperatureSciML.TNNFreeRunAnalysis(
    calibration = "dyad://MotorTemperatureSciML/story/calibrated_params.csv",
    reference = "dyad://MotorTemperatureSciML/data/pytorch_profile_17.parquet")
  model = MotorTemperatureSciML.Models.Tests.TestTNNProfile()
end

"""
**3 · After training.** The shipped calibration, free-running over the full
training profile including the held-out tail after 7200 s, with the PyTorch
reference TNN trained on the same profile overlaid.
"""
analysis A4_CalibratedTNN
  extends MotorTemperatureSciML.TNNFreeRunAnalysis(
    calibration = "dyad://MotorTemperatureSciML/data/calibrated_params.csv",
    reference = "dyad://MotorTemperatureSciML/data/pytorch_profile_17.parquet")
  model = MotorTemperatureSciML.Models.Tests.TestTNNProfile()
end

# ── Held-out profiles ────────────────────────────────────────────────────────
# The same harness driven by a different profile; `data_file` is structural, so
# each profile is its own component.

"`TestTNNProfile` driven by held-out profile 60."
test component TestTNNProfile60
  extends MotorTemperatureSciML.Models.Tests.TestTNNProfile(data_file = "dyad://MotorTemperatureSciML/data/profile_60.parquet")
end

"`TestTNNProfile` driven by held-out profile 62."
test component TestTNNProfile62
  extends MotorTemperatureSciML.Models.Tests.TestTNNProfile(data_file = "dyad://MotorTemperatureSciML/data/profile_62.parquet")
end

"`TestTNNProfile` driven by held-out profile 74."
test component TestTNNProfile74
  extends MotorTemperatureSciML.Models.Tests.TestTNNProfile(data_file = "dyad://MotorTemperatureSciML/data/profile_74.parquet")
end

"""
**3 · Held out.** The shipped calibration on profile 60, which the model never
saw. Both the Dyad and the PyTorch model trained on a single profile, so this
is a stress test: the published TNN trains on 66 profiles.
"""
analysis A5_CalibratedTNNProfile60
  extends MotorTemperatureSciML.TNNFreeRunAnalysis(
    calibration = "dyad://MotorTemperatureSciML/data/calibrated_params.csv",
    reference = "dyad://MotorTemperatureSciML/data/pytorch_profile_60.parquet",
    train_horizon = 0)
  model = TestTNNProfile60()
end

"**3 · Held out.** The shipped calibration on profile 62."
analysis A6_CalibratedTNNProfile62
  extends MotorTemperatureSciML.TNNFreeRunAnalysis(
    calibration = "dyad://MotorTemperatureSciML/data/calibrated_params.csv",
    reference = "dyad://MotorTemperatureSciML/data/pytorch_profile_62.parquet",
    train_horizon = 0)
  model = TestTNNProfile62()
end

"**3 · Held out.** The shipped calibration on profile 74."
analysis A7_CalibratedTNNProfile74
  extends MotorTemperatureSciML.TNNFreeRunAnalysis(
    calibration = "dyad://MotorTemperatureSciML/data/calibrated_params.csv",
    reference = "dyad://MotorTemperatureSciML/data/pytorch_profile_74.parquet",
    train_horizon = 0)
  model = TestTNNProfile74()
end
