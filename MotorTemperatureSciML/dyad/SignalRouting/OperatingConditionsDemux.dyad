"Split the dataset vector into named scalar channels; order matches TestTNNProfile dependent_vars."
component OperatingConditionsDemux
  u = [RealInput() for i in 1:10] {^u}
  u_q = RealOutput() {^u_q}
  coolant = RealOutput() {^coolant}
  u_d = RealOutput() {^u_d}
  motor_speed = RealOutput() {^motor_speed}
  i_d = RealOutput() {^i_d}
  i_q = RealOutput() {^i_q}
  ambient = RealOutput() {^ambient}
  torque = RealOutput() {^torque}
  i_s = RealOutput() {^i_s}
  u_s = RealOutput() {^u_s}
relations
  u_q = u[1]
  coolant = u[2]
  u_d = u[3]
  motor_speed = u[4]
  i_d = u[5]
  i_q = u[6]
  ambient = u[7]
  torque = u[8]
  i_s = u[9]
  u_s = u[10]
metadata {
  "Dyad": {
    "labels": [
      {"label": "$(instance)", "x": 500, "y": -100, "layer": "icon"}
    ],
    "icons": {"default": "dyad://MotorTemperatureSciML/OperatingConditionsDemux.svg"}
  },
  "_links": {
    "u": {"Dyad": {"placement": {"icon": {"iconName": "default", "x1": -30.0, "y1": 480.0, "x2": 30.0, "y2": 520.0, "show": 1}}}},
    "u_q": {"Dyad": {"placement": {"icon": {"iconName": "default", "x1": 970.0, "y1": 35.0, "x2": 1030.0, "y2": 65.0}}}},
    "coolant": {"Dyad": {"placement": {"icon": {"iconName": "default", "x1": 970.0, "y1": 135.0, "x2": 1030.0, "y2": 165.0}}}},
    "u_d": {"Dyad": {"placement": {"icon": {"iconName": "default", "x1": 970.0, "y1": 235.0, "x2": 1030.0, "y2": 265.0}}}},
    "motor_speed": {"Dyad": {"placement": {"icon": {"iconName": "default", "x1": 970.0, "y1": 335.0, "x2": 1030.0, "y2": 365.0}}}},
    "i_d": {"Dyad": {"placement": {"icon": {"iconName": "default", "x1": 970.0, "y1": 435.0, "x2": 1030.0, "y2": 465.0}}}},
    "i_q": {"Dyad": {"placement": {"icon": {"iconName": "default", "x1": 970.0, "y1": 535.0, "x2": 1030.0, "y2": 565.0}}}},
    "ambient": {"Dyad": {"placement": {"icon": {"iconName": "default", "x1": 970.0, "y1": 635.0, "x2": 1030.0, "y2": 665.0}}}},
    "torque": {"Dyad": {"placement": {"icon": {"iconName": "default", "x1": 970.0, "y1": 735.0, "x2": 1030.0, "y2": 765.0}}}},
    "i_s": {"Dyad": {"placement": {"icon": {"iconName": "default", "x1": 970.0, "y1": 835.0, "x2": 1030.0, "y2": 865.0}}}},
    "u_s": {"Dyad": {"placement": {"icon": {"iconName": "default", "x1": 970.0, "y1": 935.0, "x2": 1030.0, "y2": 965.0}}}}
  }
}
