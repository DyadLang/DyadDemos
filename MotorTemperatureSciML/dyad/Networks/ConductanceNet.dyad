"""
Conductance sub-network for the Thermal Neural Network (TNN).

Maps a 14-element input vector — 10 normalised operating conditions (`x`, in
`Normalizer.out` order) followed by the 4 estimated normalised temperatures
(`T`, in `ThermalDynamics.T` order) — to 15 thermal conductance values via
`Dense(14 → 15, sigmoid)`. The 15 outputs correspond to all unique edges in a
fully connected graph of 6 temperature nodes. Outputs lie in `(0, 1)` courtesy
of the sigmoid.

The network is wrapped in `DyadModelDiscovery.NeuralNetworkBlock` so the
forward pass is registered symbolically as a single opaque callable
(`stateless_apply`) over one vector parameter `p` — MTK sees one parameter,
not 225 scalar weights.
"""
component ConductanceNet
  "Number of operating-condition inputs (first block of the NN input vector)"
  structural parameter n_x::Integer = 10
  "Number of temperature feedback inputs (second block of the NN input vector)"
  structural parameter n_T::Integer = 4
  "NN input width, must equal n_x + n_T"
  structural parameter n_in::Integer = 14
  structural parameter n_out::Integer = 15

  "Normalised operating conditions (Normalizer.out ordering)"
  x = [RealInput() for i in 1:n_x] {^x}
  "Estimated normalised temperatures fed back from ThermalDynamics.T"
  T = [RealInput() for i in 1:n_T] {^T}
  "Output conductance values in (0, 1) after sigmoid activation"
  out = [RealOutput() for j in 1:n_out] {^out}

  nn = DyadModelDiscovery.NeuralNetworkBlock(
    n_input = n_in,
    n_output = n_out,
    chain = MotorTemperatureSciML.conductance_chain()) {^nn}
  mux = MotorTemperatureSciML.SignalRouting.FeatureMux(n_x = n_x, n_T = n_T) {^mux}
relations
  connect(x, mux.x) {^features}
  connect(T, mux.T) {^feedback}
  connect(mux.y, nn.inputs) {^nn_input}
  connect(nn.outputs, out)
metadata {
  "Dyad": {
    "labels": [
      {"label": "$(instance)", "x": 500, "y": -130, "layer": "icon", "attrs": {}},
      {"label": "Operating conditions · x[10]", "x": 150, "y": 230, "layer": "diagram", "attrs": {"font-size": "20", "width": "max-content", "white-space": "nowrap"}},
      {"label": "Estimated temperatures · T[4]", "x": 180, "y": 680, "layer": "diagram", "attrs": {"font-size": "20", "width": "max-content", "white-space": "nowrap"}},
      {"label": "[x; T] · 14", "x": 435, "y": 410, "layer": "diagram", "attrs": {"font-size": "20", "width": "max-content", "white-space": "nowrap"}}
    ],
    "icons": {"default": "dyad://MotorTemperatureSciML/ConductanceNet.svg"}
  },
  "_links": {
    "x": {"Dyad": {"placement": {"icon": {"iconName": "default", "x1": -27.5, "y1": 372.5, "x2": 27.5, "y2": 427.5, "show": 1}, "diagram": {"iconName": "default", "x1": 88.0, "y1": 338.0, "x2": 112.0, "y2": 362.0, "show": 1}}}},
    "T": {"Dyad": {"placement": {"icon": {"iconName": "default", "x1": 472.5, "y1": 972.5, "x2": 527.5, "y2": 1027.5, "show": 1, "rot": 270}, "diagram": {"iconName": "default", "x1": 88.0, "y1": 538.0, "x2": 112.0, "y2": 562.0, "show": 1}}}},
    "out": {"Dyad": {"placement": {"icon": {"iconName": "default", "x1": 972.5, "y1": 372.5, "x2": 1027.5, "y2": 427.5, "show": 1}, "diagram": {"iconName": "default", "x1": 918.0, "y1": 438.0, "x2": 942.0, "y2": 462.0, "show": 1}}}},
    "nn": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 500.0, "y1": 300.0, "x2": 800.0, "y2": 600.0}}}},
    "mux": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 220.0, "y1": 250.0, "x2": 380.0, "y2": 650.0}}}},
    "features": {"Dyad": {"edges": [{"S": 1, "E": 2, "M": []}]}},
    "feedback": {"Dyad": {"edges": [{"S": 1, "E": 2, "M": []}]}},
    "nn_input": {"Dyad": {"edges": [{"S": 1, "E": 2, "M": []}]}}
  }
}
end
