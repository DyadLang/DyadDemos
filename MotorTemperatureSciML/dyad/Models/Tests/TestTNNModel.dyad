"""
Test harness for the full `TNNModel` driven with constant inputs.

With small random weights (the default `scaled_kaiming(1e-8)` init in the Lux
chains), `ConductanceNet.out ≈ sigmoid(0) = 0.5` and `PowerLossNet.out ≈ 0`,
so the temperature states drift toward the mean of the coolant and ambient
inputs.
"""
test component TestTNNModel
  model = MotorTemperatureSciML.Models.TNNModel() {^model}

  "Typical operating point inputs"
  src_u_q = BlockComponents.Sources.Constant(k = 50.0) {^src_u_q}
  src_coolant = BlockComponents.Sources.Constant(k = 60.0) {^src_coolant}
  src_u_d = BlockComponents.Sources.Constant(k = -30.0) {^src_u_d}
  src_motor_speed = BlockComponents.Sources.Constant(k = 500.0) {^src_motor_speed}
  src_i_d = BlockComponents.Sources.Constant(k = -100.0) {^src_i_d}
  src_i_q = BlockComponents.Sources.Constant(k = 150.0) {^src_i_q}
  src_ambient = BlockComponents.Sources.Constant(k = 25.0) {^src_ambient}
  src_torque = BlockComponents.Sources.Constant(k = 100.0) {^src_torque}
  "Precomputed |i| ≈ sqrt((-100/399.72)² + (150/369.96)²) ≈ 0.4764"
  src_i_s = BlockComponents.Sources.Constant(k = 0.4764) {^src_i_s}
  "Precomputed |u| ≈ sqrt((-30/164.79)² + (50/162.27)²)  ≈ 0.3580"
  src_u_s = BlockComponents.Sources.Constant(k = 0.3580) {^src_u_s}
relations
  connect(src_u_q.y, model.u_q_raw) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 400, "y": 100}, {"x": 400, "y": 550}], "E": 2}]}}
  connect(src_coolant.y, model.coolant_raw) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 350, "y": 250}, {"x": 350, "y": 600}], "E": 2}]}}
  connect(src_u_d.y, model.u_d_raw) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 300, "y": 400}, {"x": 300, "y": 650}], "E": 2}]}}
  connect(src_motor_speed.y, model.motor_speed_raw) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 250, "y": 550}, {"x": 250, "y": 700}], "E": 2}]}}
  connect(src_i_d.y, model.i_d_raw) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 200, "y": 700}, {"x": 200, "y": 750}], "E": 2}]}}
  connect(src_i_q.y, model.i_q_raw) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 200, "y": 850}, {"x": 200, "y": 800}], "E": 2}]}}
  connect(src_ambient.y, model.ambient_raw) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 250, "y": 1000}, {"x": 250, "y": 850}], "E": 2}]}}
  connect(src_torque.y, model.torque_raw) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 300, "y": 1150}, {"x": 300, "y": 900}], "E": 2}]}}
  connect(src_i_s.y, model.i_s_raw) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 350, "y": 1300}, {"x": 350, "y": 950}], "E": 2}]}}
  connect(src_u_s.y, model.u_s_raw) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 400, "y": 1450}, {"x": 400, "y": 1000}], "E": 2}]}}
metadata {
  "_links": {
    "src_u_q": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 50, "y1": 50, "x2": 150, "y2": 150, "rot": 0}}}},
    "src_coolant": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 50, "y1": 200, "x2": 150, "y2": 300, "rot": 0}}}},
    "src_u_d": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 50, "y1": 350, "x2": 150, "y2": 450, "rot": 0}}}},
    "src_motor_speed": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 50, "y1": 500, "x2": 150, "y2": 600, "rot": 0}}}},
    "src_i_d": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 50, "y1": 650, "x2": 150, "y2": 750, "rot": 0}}}},
    "src_i_q": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 50, "y1": 800, "x2": 150, "y2": 900, "rot": 0}}}},
    "src_ambient": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 50, "y1": 950, "x2": 150, "y2": 1050, "rot": 0}}}},
    "src_torque": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 50, "y1": 1100, "x2": 150, "y2": 1200, "rot": 0}}}},
    "src_i_s": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 50, "y1": 1250, "x2": 150, "y2": 1350, "rot": 0}}}},
    "src_u_s": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 50, "y1": 1400, "x2": 150, "y2": 1500, "rot": 0}}}},
    "model": {"Dyad": {"placement": {"diagram": {"iconName": "default", "x1": 500, "y1": 525, "x2": 1000, "y2": 1025, "rot": 0}}}}
  }
}
end

analysis TestTNNModelAnalysis
  extends TransientAnalysis(stop = 500.0)
  model = TestTNNModel()
end
