      {"label": "Inverse capacitances", "x": 1110, "y": 860, "layer": "diagram", "attrs": {"font-size": "20", "width": "max-content", "white-space": "nowrap"}},
      {"label": "Temperatures [°C]", "x": 1480, "y": 180, "layer": "diagram", "attrs": {"font-size": "23", "width": "max-content", "white-space": "nowrap"}}
