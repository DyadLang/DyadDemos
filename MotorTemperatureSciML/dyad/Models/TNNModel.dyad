    "cap_to_thermal":   {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1100, "y": 800}, {"x": 1100, "y": 640}, {"x": 800, "y": 640}, {"x": 800, "y": 498}], "E": 2}]}},
    "coolant":          {"Dyad": {"edges": [{"S": 1, "M": [{"x": 380, "y": 442}, {"x": 380, "y": 362}], "E": 2}]}},
    "ambient":          {"Dyad": {"edges": [{"S": 1, "M": [{"x": 400, "y": 525}, {"x": 400, "y": 384}], "E": 2}]}}
  }
}
end
