"Tire spring-damper that pushes only while squashed. Stretched past `s_rel0` the wheel has left the road, so the total force drops to zero — the same lift-off behaviour as `ConfigurableTireSpringDamper`. While in contact the force is the linear spring-damper plus whatever the neural network feeds into `f_residual`."
component TireWithExternalResidual
  flange_a = Flange() {^flange_a}
  flange_b = Flange() {^flange_b}
  f_residual = RealInput() {^f_residual}
  s_rel_out = Dyad.RealOutput() {^s_rel_out}
  parameter k1::TranslationalSpringConstant = 200e3
  parameter d::TranslationalDampingConstant = 50.0
  parameter s_rel0::Distance = 0.2
  variable s_rel::Distance
  variable v_rel::Velocity
  variable f::Force
relations
  s_rel = flange_b.s - flange_a.s
  v_rel = der(s_rel)
  f = ifelse(s_rel < s_rel0, k1 * (s_rel - s_rel0) + d * v_rel + f_residual, 0.0)
  flange_b.f = f
  flange_a.f = -f
  s_rel_out = s_rel
metadata {
  "Dyad": {"icons": {"default": "dyad://TranslationalComponents/SpringDamper.svg"}},
  "_links": {
