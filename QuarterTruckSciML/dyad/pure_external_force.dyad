"Force element that transmits an externally supplied force (via `f_external` RealInput) between its flanges, with no internal dynamics. Used to inject the NN-learned friction force between tire and body masses."
component PureExternalForce
  flange_a = Flange() {^flange_a}
  flange_b = Flange() {^flange_b}
  f_external = RealInput() {^f_external}
  v_rel_out = Dyad.RealOutput() {^v_rel_out}
  variable s_rel::Distance
  variable v_rel::Velocity
relations
  s_rel = flange_b.s - flange_a.s
  v_rel = der(s_rel)
  flange_b.f = f_external
  flange_a.f = -f_external
  v_rel_out = v_rel
metadata {
