"The trained gray-box truck used throughout the suspension-learning story."
component StoryQuarterTruck
  extends QuarterTruckSciML.QuarterTruckFullNN
relations
metadata {
  "Dyad": {"icons": {"default": "dyad://QuarterTruckSciML/icon.svg"}}
}
end

"A1 · Pose the ride-prediction problem on a rough-road experiment."
analysis A1Problem
  extends QuarterTruckSciML.Story.Partials.A1ProblemAnalysis
  model = StoryQuarterTruck()
end

"A2 · Measure the linear suspension model's acceleration gap."
analysis A2Gap
  extends QuarterTruckSciML.Story.Partials.A2GapAnalysis
  model = StoryQuarterTruck()
end

"A3 · Run a short optimizer-limited training demonstration on controlled sine data."
analysis A3Training
  extends QuarterTruckSciML.Story.Partials.A3TrainingAnalysis
  model = StoryQuarterTruck()
end

"A4 · Evaluate the separately pretrained model on a held-out road input."
analysis A4Performance
  extends QuarterTruckSciML.Story.Partials.A4PerformanceAnalysis
  model = StoryQuarterTruck()
end

"A5 · Compare the pretrained model at the sine condition used for training."
analysis A5SineValidation
  extends QuarterTruckSciML.Story.Partials.A5SineValidationAnalysis
  model = StoryQuarterTruck()
end

"A6 · Compare the pretrained model at a configurable sine condition outside training."
analysis A6OutOfDomain
  extends QuarterTruckSciML.Story.Partials.A6OutOfDomainAnalysis
  model = StoryQuarterTruck()
end
