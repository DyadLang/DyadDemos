# NN training analyses for the full 3-nonlinearity gray-box truck.
#
# The two-stage training is:
#   1. Adam (TruckFullNNTrainingAnalysis) for fast global descent
#   2. LBFGS (TruckFullNNTrainingAnalysisLBFGS) starting from Adam's weights
#      for high-precision refinement
#
# Both consume the same sin-excited training set; the LBFGS analysis reads the
# Adam-trained weights via `initial_values_path`.

"Sanity: sin-driven gray-box truck with random NN init (should integrate cleanly but NOT match the GT)."
analysis AnalysisFullNNSin
  extends TransientAnalysis(stop=5.0, saveat=0.01)
  model = TestQuarterTruckFullNNSin()
end

"Sanity: sin-driven nonlinear GT with all 3 nonlinearities active."
analysis AnalysisNonlinearFullSin
  extends TransientAnalysis(stop=5.0, saveat=0.01)
  model = TestQuarterTruckConfigurableFullSin()
end

using DyadData: DyadDataset

"Train the full 3-nonlinearity NN on sin-excited ground truth. Stage 1: Adam."
analysis TruckFullNNTrainingAnalysis
  extends DyadModelDiscovery.NNTrainingAnalysis(
    data = DyadData.DyadTimeseries("file://data/truck_sin_full_train.csv",
      independent_var = "timestamp",
      dependent_vars = ["model.tire.s(t)", "model.driver.s(t)", "model.driver.a(t)"]),
    depvars_names = ["model.tire.s", "model.driver.s", "model.driver.a"],
    stop = 5.0,
    alg = ODEAlg.Tsit5(),
    calibration_alg = "SingleShooting",
    optimizer = "Adam",
    optimizer_maxiters = 5000,
    learning_rate = 1e-3,
    network_component = "model.nn",
    results_path = "data/nn_weights_full_sin.csv")
  model = TestQuarterTruckFullNNSin()
end

"Refine the full-NN weights with LBFGS after Adam pre-training."
analysis TruckFullNNTrainingAnalysisLBFGS
  extends DyadModelDiscovery.NNTrainingAnalysis(
    data = DyadData.DyadTimeseries("file://data/truck_sin_full_train.csv",
      independent_var = "timestamp",
      dependent_vars = ["model.tire.s(t)", "model.driver.s(t)", "model.driver.a(t)"]),
    depvars_names = ["model.tire.s", "model.driver.s", "model.driver.a"],
    stop = 5.0,
    alg = ODEAlg.Tsit5(),
    calibration_alg = "SingleShooting",
    optimizer = "LBFGS",
    optimizer_maxiters = 200,
    network_component = "model.nn",
    initial_values_path = "data/nn_weights_full_sin.csv",
    results_path = "data/nn_weights_full_sin_lbfgs.csv")
  model = TestQuarterTruckFullNNSin()
end
