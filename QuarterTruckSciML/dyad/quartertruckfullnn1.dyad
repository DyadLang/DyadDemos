# Full 3-nonlinearity gray-box quarter truck.
#
# A single neural network recovers three distinct suspension nonlinearities
# simultaneously from sin-input training data:
#   1. Tire cubic stiffness with compression-only lift-off
#   2. Tire-body Coulomb friction
#   3. Seat-driver viscoelastic damping (power-law)
#
# Validation: held-out ISO 8608 Class A road, compared against linear baseline
# and nonlinear ground truth.
"Quarter truck with a single NeuralNetworkBlock (3 inputs → 3 outputs) learning THREE suspension nonlinearities: tire cubic residual (compression-only gated), tire-body Coulomb friction, and seat-driver viscoelastic damping residual. Physics inputs: normalized tire deflection, normalized tire-body relative velocity, normalized seat-driver relative velocity. Outputs (each × its own f_scale): tire residual force [N], friction force [N], seat damping residual force [N]."
component QuarterTruckFullNN1
  sin_signal = BlockComponents.Sources.Sine(amplitude = amplitude, frequency = frequency, start_time = 0.1) {^sin_signal}
  # Masses (identical to QuarterTruckConfigurable)
  tire = TranslationalComponents.Components.Mass(m = 40.0, L = 0.0, g = 9.81, theta = 1.5708) {^tire}
  body = TranslationalComponents.Components.Mass(m = 300.0, L = 0.0, g = 9.81, theta = 1.5708) {^body}
  seat = TranslationalComponents.Components.Mass(m = 15.0, L = 0.0, g = 9.81, theta = 1.5708) {^seat}
  driver = TranslationalComponents.Components.Mass(m = 75.0, L = 0.0, g = 9.81, theta = 1.5708) {^driver}
  # Gray-box spring-damper elements (each carries the known linear physics;
  # the NN-learned nonlinear residual is injected via the RealInput port).
  tire_to_road = QuarterTruckSciML.TireWithExternalResidual(k1 = 200e3, d = 50.0, final s_rel0 = s_rel0_tire) {^tire_to_road}
  tire_to_body = TranslationalComponents.Components.SpringDamper(c = 20e3, d = 1500.0, s_rel0 = 1.0) {^tire_to_body}
  friction_tb = QuarterTruckSciML.PureExternalForce() {^friction_tb}
  body_to_seat = TranslationalComponents.Components.SpringDamper(c = 15e3, d = 800.0, s_rel0 = 0.2) {^body_to_seat}
  seat_to_driver = QuarterTruckSciML.SpringDamperWithExternalResidual(k = 10e3, d = 500.0, final s_rel0 = s_rel0_seat) {^seat_to_driver}
  road = TranslationalComponents.Sources.Position(ref_type=TranslationalComponents.Sources.ReferenceType.Filtered(f_crit = 100.0))
  nn = DyadModelDiscovery.NeuralNetworkBlock(n_input = n_input, n_output = n_output, chain = chain) {^nn}
  demux = QuarterTruckSciML.Demux3() {^demux}
  mux = QuarterTruckSciML.Mux3() {^mux}
  parameter amplitude::Distance = 0.03
  parameter frequency::Frequency = 2.0
  structural parameter n_input::Integer = 3
  structural parameter n_output::Integer = 3
  structural parameter nn_depth::Integer = 1
  structural parameter nn_width::Integer = 5
  structural parameter chain::Native = DyadModelDiscovery.multi_layer_feed_forward(n_input, n_output, depth = nn_depth, width = nn_width, activation = Lux.tanh)
  "Tire unstretched length [m]"
  parameter s_rel0_tire::Dyad.Distance = 0.2
  "Seat-driver unstretched length [m]"
  parameter s_rel0_seat::Dyad.Distance = 0.1
  "Tire deflection normalization [m]"
  parameter s_scale_tire::Dyad.Distance = 0.05
  "Friction velocity normalization [m/s]"
  parameter v_friction_scale::Dyad.Velocity = 0.1
  "Seat-driver velocity normalization [m/s]"
  parameter v_seat_scale::Dyad.Velocity = 0.2
  "Force scale for tire NN output [N]"
  parameter f_scale_tire::Dyad.Force = 1000.0
  "Force scale for friction NN output [N] (matches true F_c magnitude)"
  parameter f_scale_friction::Dyad.Force = 500.0
relations
  connect(road.flange, tire_to_road.flange_a) {^id15}
  connect(tire_to_road.flange_b, tire.flange_a) {^id16}
  connect(tire.flange_b, tire_to_body.flange_a) {^id17}
  connect(tire.flange_b, friction_tb.flange_a) {^id18}
  connect(friction_tb.flange_b, body.flange_a) {^id19}
  connect(body.flange_b, body_to_seat.flange_a) {^id20}
  connect(body_to_seat.flange_b, seat.flange_a) {^id21}
  connect(seat.flange_b, seat_to_driver.flange_a) {^id22}
  connect(seat_to_driver.flange_b, driver.flange_a) {^id23}
  # NN outputs wired to gray-box force-injection ports.
  # Tire:     direct NN residual scaled to Newtons (compression-only gate is
  #           applied INSIDE TireWithExternalResidual).
  # Friction: direct NN output scaled to the expected F_c magnitude.
  # Seat:     physics-informed factorization. The viscoelastic damping residual
  #           is d·v·[(v²+v_reg²)^((n−1)/2) − 1] — a function with a cusp-like
  #           infinite slope at v=0 which a smooth tanh NN cannot resolve.
  #           Factoring out `d·v` transforms the NN's learning target into the
  #           smooth, bounded bracket modifier, and the `v` prefactor enforces
  #           the kinematic constraint that damping force vanishes at v=0.
  initial tire.s = 0.178908
  initial tire.v = 0.0
  initial body.s = 0.987613
  initial body.v = 0.0
  initial seat.s = 1.128754
  initial seat.v = 0.0
  initial driver.s = 1.128754 + 0.1 - 75.0 * 9.81 / 10e3
  initial driver.v = 0.0
  connect(tire_to_body.flange_b, body.flange_a) {^id24}
  connect(mux.y, nn.inputs) {^id25}
  connect(nn.outputs, demux.u) {^id26}
  connect(tire_to_road.s_rel_out, mux.u1) {^id27}
  connect(friction_tb.v_rel_out, mux.u2) {^id28}
  connect(seat_to_driver.v_rel_out, mux.u3) {^id29}
  connect(demux.y1, tire_to_road.f_residual) {^id30}
  connect(demux.y2, friction_tb.f_external) {^id31}
  connect(demux.y3, seat_to_driver.f_residual) {^id32}
