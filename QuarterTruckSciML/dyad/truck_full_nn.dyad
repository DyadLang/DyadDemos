    },
    "id3": {"Dyad": {"renderStyle": "standard", "edges": [{"S": 1, "E": 2, "M": []}]}}
  }
}
end

# Validation harnesses: linear vs. NN vs. truth on an ISO 8608 Class A road.
"Linear-baseline quarter truck (all three nonlinearities disabled — tire_k3=0, friction_Fc=0, seat_driver_n=1.0) driven by ISO 8608 Class A road excitation. This is the 'before' model in the demo."
test component TestQuarterTruckLinearISOA
  model = QuarterTruckConfigurable()
  iso_road = DenseISO8608Road(roughness = 1e-6, speed = speed, start_time = 0.0)
  parameter speed::Velocity = 13.89
relations
  connect(iso_road.y, model.road.s_ref)
end

"Nonlinear ground-truth quarter truck (tire cubic + compression-only + friction + viscoelastic seat) driven by ISO 8608 Class A. This is the 'truth' against which linear and NN models are compared."
test component TestQuarterTruckNonlinearISOA
  model = QuarterTruckConfigurable(tire_k3 = 1e7, tire_compression_only = 1.0, friction_Fc = 500.0, seat_driver_n = 0.5)
  iso_road = DenseISO8608Road(roughness = 1e-6, speed = speed, start_time = 0.0)
  parameter speed::Velocity = 13.89
relations
  connect(iso_road.y, model.road.s_ref)
end

"Full-NN gray-box quarter truck driven by ISO 8608 Class A — trained weights are loaded in the Julia validation script."
test component TestQuarterTruckFullNNISOA
  model = QuarterTruckFullNN()
  iso_road = DenseISO8608Road(roughness = 1e-6, speed = speed, start_time = 0.0)
  parameter speed::Velocity = 13.89
relations
  connect(iso_road.y, model.s_rel)
end