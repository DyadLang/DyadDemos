# Training harnesses, driven by a sine road input.
"Nonlinear ground-truth quarter truck with tire cubic (compression-only), tire-body Coulomb friction, AND seat-driver viscoelastic damping all active. Sin road excitation — used to generate training data."
test component TestQuarterTruckConfigurableFullSin
  model = QuarterTruckConfigurable(tire_k3 = tire_k3, tire_compression_only = tire_compression_only, friction_Fc = friction_Fc, friction_v0 = friction_v0, seat_driver_n = seat_driver_n)
  sin_signal = BlockComponents.Sources.Sine(amplitude = amplitude, frequency = frequency, start_time = 0.1)
  parameter amplitude::Distance = 0.03
  parameter frequency::Frequency = 2.0
  parameter tire_k3::Real = 1e7
  parameter tire_compression_only::Real = 1.0
  parameter friction_Fc::Force = 500.0
  parameter friction_v0::Velocity = 0.1
  parameter seat_driver_n::Real = 0.5
relations
  connect(sin_signal.y, model.road.s_ref)
end

analysis QuarterTruckReferenceTransient
  extends TransientAnalysis(stop = 5.0, saveat = 0.01)
  model = TestQuarterTruckConfigurableFullSin(amplitude = amplitude, frequency = frequency, tire_k3 = tire_k3, tire_compression_only = tire_compression_only, friction_Fc = friction_Fc, friction_v0 = friction_v0, seat_driver_n = seat_driver_n)
  parameter amplitude::Distance = 0.03
  parameter frequency::Frequency = 2.0
  parameter tire_k3::Real = 1e7
  parameter tire_compression_only::Real = 1.0
  parameter friction_Fc::Force = 500.0
  parameter friction_v0::Velocity = 0.1
  parameter seat_driver_n::Real = 0.5
relations
end

"Training harness: full 3-nonlinearity gray-box truck driven by the same sin as the ground-truth. The NN learns all three nonlinear residual forces jointly."
test component TestQuarterTruckFullNNSin
  model = QuarterTruckFullNN() {^model}
  sin_signal = BlockComponents.Sources.Sine(amplitude = amplitude, frequency = frequency, start_time = 0.1) {^sin_signal}
  parameter amplitude::Distance = 0.03
  parameter frequency::Frequency = 2.0
relations
  connect(sin_signal.y, model.s_rel) {^id3}
metadata {
  "_links": {
    "model": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 500, "y1": 450, "x2": 600, "y2": 550, "rot": 0}
