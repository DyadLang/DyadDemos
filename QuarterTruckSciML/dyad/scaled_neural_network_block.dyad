# Scaled neural-network block for the gray-box quarter truck.
#
# Wraps a single DyadModelDiscovery.NeuralNetworkBlock (3 in -> 3 out) together
# with all of the input normalization and output force-scaling, expressed with
# visible BlockComponents math blocks (Gain / Add / Product / Constant) so the
# scaling is part of the component diagram rather than hidden inside equations.
#
#   Inputs  (raw physics):
#     in_tire     - tire deflection s_rel [m]
#     in_friction - tire-body relative velocity [m/s]
#     in_seat     - seat-driver relative velocity [m/s]
#
#   NN input normalization:
#     u1 = (in_tire - s_rel0_tire) / s_scale_tire
#     u2 = in_friction / v_friction_scale
#     u3 = in_seat / v_seat_scale
#
#   Outputs (forces, from NN outputs):
#     out_tire     = f_scale_tire     * nn_out1
#     out_friction = f_scale_friction * nn_out2
#     out_seat     = d_seat * in_seat * nn_out3   (physics-informed d*v factorization)
#
#   The seat output reuses the normalized seat signal: d_seat*v_seat_scale*(v/v_seat_scale)*nn3
#   = d_seat*v*nn3, so the d*v prefactor that forces the damping residual to vanish at v=0 is
#   reconstructed without an extra port.
"Neural network that supplies the truck's missing forces: three raw physics signals in, three forces in Newtons out. The surrounding Gain and Product blocks do the scaling that keeps the network working on numbers near 1."
component ScaledNeuralNetworkBlock
  "Raw tire deflection s_rel [m]"
  in_tire = Dyad.RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"iconName": "input", "x1": -80, "y1": 210, "x2": 0, "y2": 290},
        "diagram": {"iconName": "input", "x1": -70, "y1": 350, "x2": -30, "y2": 390}
      }
    }
  }
  "Raw tire-body relative velocity [m/s]"
  in_friction = Dyad.RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"iconName": "input", "x1": -80, "y1": 460, "x2": 0, "y2": 540},
        "diagram": {"iconName": "input", "x1": -70, "y1": 630, "x2": -30, "y2": 670}
      }
    }
  }
  "Raw seat-driver relative velocity [m/s]"
  in_seat = Dyad.RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"iconName": "input", "x1": -80, "y1": 710, "x2": 0, "y2": 790},
        "diagram": {"iconName": "input", "x1": -70, "y1": 880, "x2": -30, "y2": 920}
      }
    }
  }
  "Tire residual force [N]"
  out_tire = Dyad.RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"iconName": "output", "x1": 1000, "y1": 210, "x2": 1080, "y2": 290},
        "diagram": {"iconName": "output", "x1": 2430, "y1": 330, "x2": 2470, "y2": 370}
      }
    }
  }
  "Friction force [N]"
  out_friction = Dyad.RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"iconName": "output", "x1": 1000, "y1": 460, "x2": 1080, "y2": 540},
        "diagram": {"iconName": "output", "x1": 2430, "y1": 580, "x2": 2470, "y2": 620}
      }
    }
  }
  "Seat damping residual force [N]"
  out_seat = Dyad.RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"iconName": "output", "x1": 1000, "y1": 710, "x2": 1080, "y2": 790},
        "diagram": {"iconName": "output", "x1": 2430, "y1": 830, "x2": 2470, "y2": 870}
      }
    }
  }
  # --- Neural network and signal (de)multiplexing ---
  nn = DyadModelDiscovery.NeuralNetworkBlock(n_input = n_input, n_output = n_output, chain = chain) {
    "Dyad": {"placement": {"diagram": {"x1": 1300, "y1": 450, "x2": 1500, "y2": 650}}}
  }
  mux = QuarterTruckSciML.Mux3() {
    "Dyad": {"placement": {"diagram": {"x1": 950, "y1": 450, "x2": 1150, "y2": 650}}}
  }
  demux = QuarterTruckSciML.Demux3() {
    "Dyad": {"placement": {"diagram": {"x1": 1650, "y1": 450, "x2": 1850, "y2": 650}}}
  }
  # --- Input normalization blocks ---
  s_rel0_src = BlockComponents.Sources.Constant(k = s_rel0_tire) {
    "Dyad": {"placement": {"diagram": {"x1": 250, "y1": 450, "x2": 350, "y2": 550}}}
  }
  norm_tire = BlockComponents.Math.Add(k1 = 1.0 / s_scale_tire, k2 = -1.0 / s_scale_tire) {
    "Dyad": {"placement": {"diagram": {"x1": 500, "y1": 350, "x2": 600, "y2": 450}}}
  }
  norm_friction = BlockComponents.Math.Gain(k = 1.0 / v_friction_scale) {
    "Dyad": {"placement": {"diagram": {"x1": 500, "y1": 600, "x2": 600, "y2": 700}}}
  }
  norm_seat = BlockComponents.Math.Gain(k = 1.0 / v_seat_scale) {
    "Dyad": {"placement": {"diagram": {"x1": 500, "y1": 850, "x2": 600, "y2": 950}}}
  }
  # --- Output scaling blocks ---
  scale_tire = BlockComponents.Math.Gain(k = f_scale_tire) {
    "Dyad": {"placement": {"diagram": {"x1": 2000, "y1": 300, "x2": 2100, "y2": 400}}}
  }
  scale_friction = BlockComponents.Math.Gain(k = f_scale_friction) {
    "Dyad": {"placement": {"diagram": {"x1": 2000, "y1": 550, "x2": 2100, "y2": 650}}}
  }
  seat_prod = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 2000, "y1": 800, "x2": 2100, "y2": 900}}}
  }
  scale_seat = BlockComponents.Math.Gain(k = d_seat * v_seat_scale) {
    "Dyad": {"placement": {"diagram": {"x1": 2250, "y1": 800, "x2": 2350, "y2": 900}}}
  }
  # --- Scaling parameters (dimensionless: signals are plain Real) ---
  "Tire unstretched length [m]"
  parameter s_rel0_tire::Real = 0.2
  "Tire deflection normalization [m]"
  parameter s_scale_tire::Real = 0.05
  "Friction velocity normalization [m/s]"
  parameter v_friction_scale::Real = 0.1
  "Seat-driver velocity normalization [m/s]"
  parameter v_seat_scale::Real = 0.2
  "Force scale for tire NN output [N]"
  parameter f_scale_tire::Real = 1000.0
  "Force scale for friction NN output [N]"
  parameter f_scale_friction::Real = 500.0
  "Seat-driver damping coefficient [N*s/m] (d*v prefactor)"
  parameter d_seat::Real = 500.0
  # --- NN structural parameters ---
  structural parameter n_input::Integer = 3
  structural parameter n_output::Integer = 3
  structural parameter nn_depth::Integer = 1
  structural parameter nn_width::Integer = 5
  structural parameter chain::Native = DyadModelDiscovery.multi_layer_feed_forward(n_input, n_output, depth = nn_depth, width = nn_width, activation = Lux.tanh)
relations
  # Input normalization -> mux -> NN
  connect(in_tire, norm_tire.u1) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": -50, "y": 400}, {"x": 450, "y": 400}, {"x": 450, "y": 370}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(s_rel0_src.y, norm_tire.u2) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 450, "y": 500}, {"x": 450, "y": 430}], "E": 2}],
      "path": {}
    }
  }
  connect(norm_tire.y, mux.u1) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 900, "y": 400}, {"x": 900, "y": 500}], "E": 2}],
      "path": {}
    }
  }
  connect(in_friction, norm_friction.u) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(norm_friction.y, mux.u2) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 850, "y": 650}, {"x": 850, "y": 550}], "E": 2}],
      "path": {}
    }
  }
  connect(in_seat, norm_seat.u) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(mux.y, nn.inputs) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(nn.outputs, demux.u) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  # Output scaling
  connect(demux.y1, scale_tire.u) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 1900, "y": 500}, {"x": 1900, "y": 350}], "E": 2}],
      "path": {}
    }
  }
  connect(scale_tire.y, out_tire) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(demux.y2, scale_friction.u) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 1950, "y": 550}, {"x": 1950, "y": 600}], "E": 2}],
      "path": {}
    }
  }
  connect(scale_friction.y, out_friction) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(norm_seat.y, seat_prod.u1, mux.u3) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [{"x": 900, "y": 900}], "E": -1},
        {
          "S": 2,
          "M": [{"x": 1950, "y": 819.9999999999999}, {"x": 1950, "y": 800}],
          "E": -1
        },
        {"S": 3, "M": [{"x": 900, "y": 600}], "E": -1}
      ],
      "junctions": [{"x": 900, "y": 800}],
      "path": {}
    }
  }
  connect(demux.y3, seat_prod.u2) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 1900, "y": 600},
            {"x": 1900, "y": 850},
            {"x": 1950, "y": 850},
            {"x": 1950, "y": 880.0000000000001}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(seat_prod.y, scale_seat.u) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(scale_seat.y, out_seat) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
metadata {"Dyad": {"icons": {"default": "dyad://DyadModelDiscovery/nn_icon.svg"}}}
end
