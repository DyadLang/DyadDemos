"short Demux3 component description"
component Demux3
  u = [Dyad.RealInput() for i in 1:3] {^u}
  y1 = Dyad.RealOutput() {^y1}
  y2 = Dyad.RealOutput() {^y2}
  y3 = Dyad.RealOutput() {^y3}
relations

  u[1] = y1
  u[2] = y2
  u[3] = y3

