# Parameter calibration demo.
#
# Recover four representative physical parameters (one each: mass, stiffness,
# damping, friction) from time-series measurements of tire force, suspension
# travel and seat acceleration. Perturbation bounds follow Michael Hoffmann's
# spec: mass ±5%, stiffness ±10%, damping ±20%, friction ±50% (the search
# bounds below are intentionally wider than the truth offset, so the optimizer
# has room to manoeuvre).
#
# The measurements CSV is generated by `scripts/generate_calibration_data.jl`
# from the *perturbed* nonlinear model on the same ISO 8608 Class A road that
# the NN-discovery demo uses for validation. The search space targets the
# top-level pass-through parameters (model.body_m, model.tire_to_body_c, …)
# which propagate to the sub-component parameters via `final` bindings in
# QuarterTruckConfigurable.

"Recover four physical parameters from ISO 8608 ride measurements (tire contact force, suspension travel, seat acceleration). Truth values are 5%/10%/20%/50% perturbations from the nominal (body_m=300, tire_to_body_c=20e3, tire_to_body_d=1500, friction_Fc=500); search bounds are ~2× the perturbation. Synthetic measurements live in `data/calibration_measurements.csv`."
analysis QuarterTruckCalibrationAnalysis
  extends DyadModelOptimizer.CalibrationAnalysis(
    stop = 10.0, saveat = 0.01,
    data = DyadData.DyadTimeseries("dyad://QuarterTruckSciML/data/calibration_measurements.csv",
      independent_var = "timestamp",
      dependent_vars = ["tire_F(t)", "suspension_travel(t)", "seat_a(t)"]),
    depvars_names = ["model.tire_to_road.f", "model.tire_to_body.s_rel", "model.seat.a"],
    search_space_names = ["model.body_m",
                          "model.tire_to_body_c",
                          "model.tire_to_body_d",
                          "model.friction_Fc"],
    search_space_lb    = [270.0,  16e3,  900.0,    0.0],
    search_space_ub    = [330.0,  24e3, 2100.0, 1000.0],
    calibration_alg = "SingleShooting",
    optimizer = "auto",
    optimizer_maxiters = 100)
  model = TestQuarterTruckNonlinearISOA()
end
