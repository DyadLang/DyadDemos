external component NeuralNetworkBlock
  inputs = [Dyad.RealInput() for i in 1:n_input] {^inputs}
  outputs = [Dyad.RealOutput() for i in 1:n_output] {^outputs}
  structural parameter chain::Native = ModelingToolkitNeuralNets.multi_layer_feed_forward(n_input, n_output)
  structural parameter n_input::Integer = 1
  structural parameter n_output::Integer = 1
  structural parameter rng::Native = Xoshiro(0)
  structural parameter init_params::Real[:] = Lux.initialparameters(rng, chain)
  parameter p::Real[:]
