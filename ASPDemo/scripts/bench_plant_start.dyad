component BenchPlant
  source = FlowSourceFile(input_file = input_file) {^source}
  mixer = Mixer3() {^mixer}
  tank1 = Denitrification() {^tank1}
  tank2 = Denitrification(states_start = [3.000000000000e+01, 2.963119860782e+00, 1.115525591261e+03, 1.047623215724e+02, 2.560547745833e+03, 1.031268208361e+02, 4.344353591719e+02, 3.460669280848e-05, 2.374326657217e-01, 1.943283861745e+01, 3.395010672094e-01, 6.666141082522e+00, 6.077331022060e+00]) {^tank2}
  tank3 = Nitrification(V = 1333, states_start = [3.000000000000e+01, 3.303021229952e+00, 1.115644789581e+03, 4.595646450845e+01, 2.587816054472e+03, 1.042607977985e+02, 4.368395184843e+02, 2.258220736507e+00, 6.086417053368e+00, 1.320662231965e+01, 8.483247444772e-01, 3.147367816870e+00, 5.185981698738e+00]) {^tank3}
  tank4 = Nitrification(V = 1333, states_start = [3.000000000000e+01, 1.965671861503e+00, 1.119243168969e+03, 1.995691428575e+01, 2.602154360121e+03, 1.057038911944e+02, 4.404846296373e+02, 3.505091698746e+00, 1.223560863789e+01, 7.372095764081e+00, 6.723187178583e-01, 1.509911199178e+00, 4.336906375072e+00]) {^tank4}
  tank5 = Nitrification(V = 1333, states_start = [3.000000000000e+01, 1.263795984345e+00, 1.123348086405e+03, 1.185225923915e+01, 2.606406877777e+03, 1.068019744323e+02, 4.439932752854e+02, 1.999997685099e+00, 1.674245866877e+01, 3.117292580061e+00, 4.979610348992e-01, 9.817952441673e-01, 3.735179685088e+00]) {^tank5}
  divider = Divider2() {^divider}
  settler = SecondaryClarifierTakacs() {^settler}
  recyclePump = Pump(Q_max = 92230) {^recyclePump}
  returnPump = Pump(Q_max = 18446) {^returnPump}
  wastePump = Pump(Q_max = 385) {^wastePump}
  sinkWaste = SludgeSink() {^sinkWaste}
  sinkEffluent = EffluentSink() {^sinkEffluent}
  blower1 = Blower(Q_max = 34574.2654508612) {^blower1}
  blower2 = Blower(Q_max = 34574.2654508612) {^blower2}
  blower3 = Blower(Q_max = 34574.2654508612) {^blower3}
  sensor_NO = CombinedSensor() {^sensor_NO}
  sensor_O2 = CombinedSensor() {^sensor_O2}
  sensor_TSS1 = CombinedSensor() {^sensor_TSS1}
  sensor_effluent = CombinedSensor() {^sensor_effluent}
  constant1 = BlockComponents.Constant(k = 1) {^constant1}
  constant2 = BlockComponents.Constant(k = 1) {^constant2}
  temperature = BlockComponents.Constant(k = 15) {^temperature}
  oxygenSetpoint = BlockComponents.Step(height = 2) {^oxygenSetpoint}
  PI1 = PI(Ti = 0.001, k = 500) {^PI1}
  nitrogenSetpoint = BlockComponents.Constant(k = 1) {^nitrogenSetpoint}
  limiter1 = Limiter(y_max = 10, y_min = 0.1) {^limiter1}
  PI2 = PI(Ti = 0.05, k = 15000) {^PI2}
  structural parameter input_file::String = "dyad://ASPDemo/../test/data/Inf_dry.csv"
relations
  connect(temperature.y, tank1.T) {^id30}
  connect(temperature.y, tank2.T) {^id31}
  connect(temperature.y, tank3.T) {^id32}
  connect(temperature.y, tank4.T) {^id33}
  connect(temperature.y, tank5.T) {^id34}
  connect(source.port, mixer.portIn1) {^id35}
  connect(mixer.portOut, tank1.portIn) {^id36}
  connect(tank1.portOut, tank2.portIn) {^id37}
  connect(tank2.portOut, sensor_NO.portIn) {^id38}
  connect(sensor_NO.portOut, tank3.portIn) {^id39}
  connect(tank3.portOut, tank4.portIn) {^id40}
  connect(tank4.portOut, tank5.portIn) {^id41}
  connect(tank5.portOut, sensor_O2.portIn) {^id42}
  connect(sensor_O2.portOut, divider.portIn) {^id43}
  connect(divider.portOut1, sensor_TSS1.portIn) {^id44}
  connect(sensor_TSS1.portOut, settler.feed) {^id45}
  connect(divider.portOut2, recyclePump.portIn) {^id46}
  connect(recyclePump.portOut, mixer.portIn3) {^id47}
  connect(settler.return1, returnPump.portIn) {^id48}
  connect(returnPump.portOut, mixer.portIn2) {^id49}
  connect(settler.waste, wastePump.portIn) {^id50}
  connect(wastePump.portOut, sinkWaste.port) {^id51}
  connect(settler.effluent, sensor_effluent.portIn) {^id52}
  connect(sensor_effluent.portOut, sinkEffluent.port) {^id53}
  connect(blower1.Q_air, tank3.Q_air) {^id54}
  connect(blower2.Q_air, tank4.Q_air) {^id55}
  connect(blower3.Q_air, tank5.Q_air) {^id56}
  connect(constant1.y, blower1.u) {^id57}
  connect(constant1.y, blower2.u) {^id58}
  connect(constant2.y, returnPump.u) {^id59}
  connect(constant2.y, wastePump.u) {^id60}
  connect(oxygenSetpoint.y, PI1.u_s) {^id61}
  connect(sensor_O2.So, PI1.u_m) {^id62}
  connect(PI1.y, blower3.u) {^id63}
  connect(nitrogenSetpoint.y, PI2.u_s) {^id64}
  connect(sensor_NO.Sno, limiter1.u) {^id65}
  connect(limiter1.y, PI2.u_m) {^id66}
  connect(PI2.y, recyclePump.u) {^id67}
