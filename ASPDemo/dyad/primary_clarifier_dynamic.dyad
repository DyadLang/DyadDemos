# dynamic primary clarifier tank, based on Otterpohl and Freund to be used for feed forward calculation, e.g. influent data needed
component PrimaryClarifierDynamic
  portIn = FluidPortIn() [{"Dyad": {"placement": {"icon": {"x1": -50, "y1": 450, "x2": 50, "y2": 550}}}}]
  portOut = FluidPortOut() [{"Dyad": {"placement": {"icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550}}}}]
  parameter V::Volume = 500

  # FIXME
  structural parameter nS::Integer = 13
  variable states::Real[nS]
  parameter states_start::MassFraction[nS] = [3.000000000000e+01, 
                                              5.744300865020e+00,
                                              1.114625044801e+03,
                                              1.056484783737e+02,
                                              2.563306641801e+03,
                                              1.032778829295e+02,
                                              4.321781192137e+02,
                                              4.776381995772e-03,
                                              1.736044358829e+00,
                                              1.841130239895e+01,
                                              1.046350972054e+00,
                                              6.244453916847e+00,
                                              5.956124593796e+00]

  # hydraulic residence time in primary sedimentation tank [h]
  variable hrt_h::Real
  # efficiency of COD removal [%]
  variable n_COD::Real 
  # efficiency transformed to particulate fractions [%]
  variable n_X::Real
  variable CODin::Real
  variable CODout::Real
  variable XCODin::Real
  variable H::Real
  variable Q::Real
relations
  for i in 1:nS
    initial states[i] = states_start[i]
  end

  # calculation of hydraical residence time
  hrt_h = V/portIn.Q*24

  # n_COD according Otterpohl and Freund 1992 "Dynamic Models for Clarifiers"
  n_COD = 2.7*(log(hrt_h*hrt_h) + 9)/100
  # n_COD according Otterpohl 1995, Dissertation
  # n_COD = (1.45 + 6.15 * log(hrt_min))/100;

  XCODin = portIn.Xi + portIn.Xs + portIn.Xbh + portIn.Xba + portIn.Xp
  # particulate COD in the influent
  CODin = portIn.Si + portIn.Ss + XCODin
  # total COD in the influent

  CODout = portOut.Si + portOut.Ss + portOut.Xi + portOut.Xs + portOut.Xbh + portOut.Xba + portOut.Xp

  H = n_COD*CODin/XCODin

  # n_X can not be greater than 1
  # therefore is this check
  # n_X = if H > 0.95 then 0.95 else if H < 0.05 then 0.05 else H;
  n_X = max(0.05, min(H, 0.95))


  # in this case the model needs to be modified by a new n_COD
  # n_COD_? = (2.88*XCODin/CODin - 0.118) * n_COD;

  Q = portIn.Q
  der(states[1]) = (portIn.Si - states[1])*Q/V 
  der(states[2]) = (portIn.Ss - states[2])*Q/V 
  der(states[3]) = (portIn.Xi - states[3])*Q/V 
  der(states[4]) = (portIn.Xs - states[4])*Q/V 
  der(states[5]) = (portIn.Xbh - states[5])*Q/V 
  der(states[6]) = (portIn.Xba - states[6])*Q/V 
  der(states[7]) = (portIn.Xp - states[7])*Q/V 
  der(states[8]) = (portIn.So - states[8])*Q/V 
  der(states[9]) = (portIn.Sno - states[9])*Q/V 
  der(states[10]) = (portIn.Snh - states[10])*Q/V 
  der(states[11]) = (portIn.Snd - states[11])*Q/V 
  der(states[12]) = (portIn.Xnd - states[12])*Q/V 
  der(states[13]) = (portIn.Salk - states[13])*Q/V
 
  portOut.Si = states[1]
  portOut.Ss = states[2]
  portOut.Xi = (1 - n_X) * states[3]
  portOut.Xs = (1 - n_X) * states[4]
  portOut.Xbh = (1 - n_X) * states[5]
  portOut.Xba = (1 - n_X) * states[6]
  portOut.Xp = (1 - n_X) * states[7]
  portOut.So = states[8]
  portOut.Sno = states[9]
  portOut.Snh = states[10]
  portOut.Snd = states[11]
  portOut.Xnd = (1 - n_X) * states[12]
  portOut.Salk = states[13]

  portOut.Q = Q
metadata {"Dyad": {"icons": {"default": "dyad://ASPDemo/PreClar1.svg"}}}
end

# A test model for a fixed volume
test component TestPrimaryClarifierDynamic
  source = FlowSource()
  preclar = PrimaryClarifierDynamic()
  sink = EffluentSink()
relations
  source.Q_in = 2.1477000000000000e+04  

  source.Si = 3.0000000000000000e+01
  source.Ss = 6.3634549999999997e+01 
  source.Xi = 5.8475999999999999e+01
  source.Xs = 2.2435200000000000e+02
  source.Xbh = 3.1425000000000001e+01
  source.Xba = 0.0000000000000000e+00
  source.Xp = 0.0000000000000000e+00
  source.So = 0.0000000000000000e+00
  source.Sno = 0.0000000000000000e+00 
  source.Snh = 3.0247620000000001e+01 
  source.Snd = 6.3634599999999999e+00 
  source.Xnd = 1.1814000000000000e+01 
  source.Salk = 7.0000000000000000e+00
                                   
  connect(source.port, preclar.portIn)
  connect(preclar.portOut, sink.port)
metadata {
  "Dyad": {
    "tests": {
      "case1": {"stop": 100, "expect": {"signals": ["volume.T", "resistance.port_a.m_flow"]}}
    }
  }
}
end

analysis simprimaryclarifierdynamic
  extends TransientAnalysis(stop=0.1)
  model = TestPrimaryClarifierDynamic()
end
