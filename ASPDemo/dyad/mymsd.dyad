"short MyMSD component description"
component MyMSD
  flange = Dyad.Flange() {^flange}
  flange1 = Dyad.Flange() {^flange1}
  mass = TranslationalComponents.Components.Mass() {^mass}
  springdamper = TranslationalComponents.Components.SpringDamper() {^springdamper}
relations
  connect(flange, mass.flange_a) {^id5}
  connect(springdamper.flange_b, flange1) {^id6}
  connect(mass.flange_b, springdamper.flange_a) {^id7}
