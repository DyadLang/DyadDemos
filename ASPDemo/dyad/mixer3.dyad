component Mixer3
  portIn1 = FluidPortIn() [{"Dyad": {"placement": {"icon": {"x1": -50, "y1": 275, "x2": 50, "y2": 375}}}}]
  portIn2 = FluidPortIn() [{"Dyad": {"placement": {"icon": {"x1": -50, "y1": 475, "x2": 50, "y2": 575}}}}]
  portIn3 = FluidPortIn() [{"Dyad": {"placement": {"icon": {"x1": -50, "y1": 675, "x2": 50, "y2": 775}}}}]
  portOut = FluidPortOut() [{"Dyad": {"placement": {"icon": {"x1": 950, "y1": 475, "x2": 1050, "y2": 575}}}}]
  variable Q1::Real 
  variable Q2::Real 
  variable Q3::Real 
  variable Q_tot::Real
relations
  Q1 = portIn1.Q
  Q2 = portIn2.Q
  Q3 = portIn3.Q
  Q_tot = Q1 + Q2 + Q3
  portOut.Q = Q_tot
  portOut.Si = (portIn1.Si*Q1 + portIn2.Si*Q2 + portIn3.Si*Q3)/Q_tot
  portOut.Ss = (portIn1.Ss*Q1 + portIn2.Ss*Q2 + portIn3.Ss*Q3)/Q_tot
  portOut.Xi = (portIn1.Xi*Q1 + portIn2.Xi*Q2 + portIn3.Xi*Q3)/Q_tot
  portOut.Xs = (portIn1.Xs*Q1 + portIn2.Xs*Q2 + portIn3.Xs*Q3)/Q_tot
  portOut.Xbh = (portIn1.Xbh*Q1 + portIn2.Xbh*Q2 + portIn3.Xbh*Q3)/Q_tot
  portOut.Xba = (portIn1.Xba*Q1 + portIn2.Xba*Q2 + portIn3.Xba*Q3)/Q_tot
  portOut.Xp = (portIn1.Xp*Q1 + portIn2.Xp*Q2 + portIn3.Xp*Q3)/Q_tot
  portOut.So = (portIn1.So*Q1 + portIn2.So*Q2 + portIn3.So*Q3)/Q_tot
  portOut.Sno = (portIn1.Sno*Q1 + portIn2.Sno*Q2 + portIn3.Sno*Q3)/Q_tot
  portOut.Snh = (portIn1.Snh*Q1 + portIn2.Snh*Q2 + portIn3.Snh*Q3)/Q_tot
  portOut.Snd = (portIn1.Snd*Q1 + portIn2.Snd*Q2 + portIn3.Snd*Q3)/Q_tot
  portOut.Xnd = (portIn1.Xnd*Q1 + portIn2.Xnd*Q2 + portIn3.Xnd*Q3)/Q_tot
  portOut.Salk = (portIn1.Salk*Q1 + portIn2.Salk*Q2 + portIn3.Salk*Q3)/Q_tot

metadata {
  "Dyad": {
    "labels": [{"label": "$(instance)", "x": 500, "y": 100, "rot": 0, "layer":"icon"}],
    "icons": {"default": "dyad://ASPDemo/Mixer3.svg"}
  }
}
end

# A test model for a fixed volume
test component TestMixer3
  source = FlowSource()
  source2 = FlowSource()
  source3 = FlowSource()
  mixer = Mixer3()
  sink = EffluentSink()
relations
  source.Q_in = 2.1477000000000000e+04  
  source2.Q_in = 2*source.Q_in
  source3.Q_in = 4*source.Q_in

  source.Si = 3.0000000000000000e+01
  source.Ss = 6.3634549999999997e+01 
  source.Xi = 5.8475999999999999e+01
  source.Xs = 2.2435200000000000e+02
  source.Xbh = 3.1425000000000001e+01
  source.Xba = 0.0000000000000000e+00
  source.Xp = 0.0000000000000000e+00
  source.So = 0.0000000000000000e+00
  source.Sno = 0.0000000000000000e+00 
  source.Snh = 3.0247620000000001e+01 
  source.Snd = 6.3634599999999999e+00 
  source.Xnd = 1.1814000000000000e+01 
  source.Salk = 7.0000000000000000e+00

  source2.Si = source.Si
  source2.Ss = source.Ss 
  source2.Xi = source.Xi
  source2.Xs = source.Xs
  source2.Xbh = source.Xbh
  source2.Xba = source.Xba
  source2.Xp = source.Xp
  source2.So = source.So
  source2.Sno = source.Sno
  source2.Snh = source.Snh
  source2.Snd = source.Snd
  source2.Xnd = source.Xnd
  source2.Salk = source.Salk

  source3.Si = source.Si
  source3.Ss = source.Ss 
  source3.Xi = source.Xi
  source3.Xs = source.Xs
  source3.Xbh = source.Xbh
  source3.Xba = source.Xba
  source3.Xp = source.Xp
  source3.So = source.So
  source3.Sno = source.Sno
  source3.Snh = source.Snh
  source3.Snd = source.Snd
  source3.Xnd = source.Xnd
  source3.Salk = source.Salk
                                   
  connect(source.port, mixer.portIn1)
  connect(source2.port, mixer.portIn2)
  connect(source3.port, mixer.portIn3)
  connect(mixer.portOut, sink.port)
metadata {
  "Dyad": {
    "tests": {
      "case1": {"stop": 100, "expect": {"signals": ["volume.T", "resistance.port_a.m_flow"]}}
    }
  }
}
end

analysis simmixer3
  extends TransientAnalysis(stop=0.1)
  model = TestMixer3()
end
