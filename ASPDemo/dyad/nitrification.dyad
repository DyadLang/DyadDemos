component Nitrification
  extends PartialTank_2Port
  Q_air = RealInput() [{"Dyad": {"placement": {"icon": {"x1": 450, "y1": 950, "x2": 550, "y2": 1050, "rot": 270}}}}]

  # Oxygen transfer factor
  parameter alpha::Real = 0.7
  # Depth of aeration
  parameter de::Length = 4.5
  # Specific oxygen feed factor [gO2/(m^3*m)]
  parameter R_air::Real = 23.5
  # Dissolved oxygen saturation
  variable So_sat::MassConcentration
relations
  # Temperature dependent oxygen saturation by Simba
  So_sat = 13.89 + (-0.3825 + (0.007311 - 0.00006588*T)*T)*T
  # For COST benchmark, set So_sat = 8
  # So_sat = 8

  # extends the Oxygen differential equation by an aeration term
  # aeration [mgO2/l]; AirIn.Q_air needs to be in
  # Simulationtimeunit [m3*day^-1]
  aeration = (alpha*(So_sat - states[8])/So_sat*Q_air*R_air*de)/V
metadata {
  "Dyad": {
    "labels": [{"label": "$(instance)", "x": 500, "y": 150, "rot": 0, "layer":"icon"}],
    "icons": {"default": "dyad://ASPDemo/Nitri.svg"}
  }
}
end

# A test model for a fixed volume
test component TestNitrification
  source = FlowSource()
  tank = Nitrification(V=1333)
  sink = EffluentSink()
relations
  source.Q_in = 2.1477000000000000e+04  

  source.Si = 3.0000000000000000e+01
  source.Ss = 6.3634549999999997e+01 
  source.Xi = 5.8475999999999999e+01
  source.Xs = 2.2435200000000000e+02
  source.Xbh = 3.1425000000000001e+01
  source.Xba = 0.0000000000000000e+00
  source.Xp = 0.0000000000000000e+00
  source.So = 0.0000000000000000e+00
  source.Sno = 0.0000000000000000e+00 
  source.Snh = 3.0247620000000001e+01 
  source.Snd = 6.3634599999999999e+00 
  source.Xnd = 1.1814000000000000e+01 
  source.Salk = 7.0000000000000000e+00
                                 
  tank.T = 15
  tank.Q_air = 34574.2654508612
  
  connect(source.port, tank.portIn)
  connect(tank.portOut, sink.port)
metadata {
  "Dyad": {
    "tests": {
      "case1": {"stop": 100, "expect": {"signals": ["volume.T", "resistance.port_a.m_flow"]}}
    }
  }
}
end

analysis simnitrification
  extends TransientAnalysis(stop=0.1)
  model = TestNitrification()
end
