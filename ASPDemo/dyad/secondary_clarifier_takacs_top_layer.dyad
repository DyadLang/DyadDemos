component SecondaryClarifierTakacs_TopLayer
  sDn = SolubleIn() [{"Dyad": {"placement": {"icon": {"x1": 950, "y1": 700, "x2": 1050, "y2": 800}}}}]
  Dn = SedimentationVelocitySludgeIn() [{"Dyad": {"placement": {"icon": {"x1": 450, "y1": 950, "x2": 550, "y2": 1050}}}}]
  fDn = FlowEffluentIn() [{"Dyad": {"placement": {"icon": {"x1": 200, "y1": -50, "x2": 300, "y2": 50}}}}]

  effluent = FluidPortOut() [{"Dyad": {"placement": {"icon": {"x1": 700, "y1": -50, "x2": 800, "y2": 50}}}}]
  outDn = SedimentationFluxSludgeOut() [{"Dyad": {"placement": {"icon": {"x1": 700, "y1": 950, "x2": 800, "y2": 1050}}}}]
  soluble = SolubleOut() [{"Dyad": {"placement": {"icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550}}}}]

  # Total sludge concentration in clarifier feed
  Xf = RealInput()
  rXi = RealInput()
  rXs = RealInput()
  rXbh = RealInput()
  rXba = RealInput()
  rXp = RealInput()
  rXnd = RealInput()

  # Total sludge concentration in m-th layer
  variable X::MassConcentration
  # Sink velocity in m-th layer
  variable vS::Real
  # Sedimentation flux in m-th layer
  variable Jsm::Real
  # Soluble inert organic matter
  variable Si::MassConcentration
  # Readily biodegradable substrate
  variable Ss::MassConcentration
  # Dissolved oxygen
  variable So::MassConcentration
  # Nitrate and nitrite nitrogen
  variable Sno::MassConcentration
  # Ammonium nitrogen
  variable Snh::MassConcentration
  # Soluble biodegradable organic nitrogen
  variable Snd::MassConcentration
  # Alkalinity
  variable Salk::MassConcentration
  # Surface area of sec clarifier [m2]
  parameter Asc::Area
  # Height of m-th secondary clarifier layer [m]
  parameter zm::Length
  # threshold for X
  parameter Xt::MassConcentration
  parameter X_start::MassConcentration
  parameter soluble_start::MassConcentration[7]
relations
  initial X = X_start
  initial Si = soluble_start[1]
  initial Ss = soluble_start[2]
  initial So = soluble_start[3]
  initial Sno = soluble_start[4]
  initial Snh = soluble_start[5]
  initial Snd = soluble_start[6]
  initial Salk = soluble_start[7]

  # Sink velocity
  vS = vS_TakacsDoubleExponential(X, Xf)

  # Sedimentation flux in m-th layer sinking to lower layer
  Jsm = ifelse(Dn.X_dn <= Xt, vS*X, min(vS*X, Dn.vS_dn*Dn.X_dn))

  # ODE of solid component
  der(X) = (fDn.Qe/Asc*(Dn.X_dn - X) - Jsm)/zm
  
  # ODE of soluble components
  der(Si) = fDn.Qe*(sDn.Si - Si)/(Asc*zm)
  der(Ss) = fDn.Qe*(sDn.Ss - Ss)/(Asc*zm)
  der(So) = fDn.Qe*(sDn.So - So)/(Asc*zm)
  der(Sno) = fDn.Qe*(sDn.Sno - Sno)/(Asc*zm)
  der(Snh) = fDn.Qe*(sDn.Snh - Snh)/(Asc*zm)
  der(Snd) = fDn.Qe*(sDn.Snd - Snd)/(Asc*zm)
  der(Salk) = fDn.Qe*(sDn.Salk - Salk)/(Asc*zm)
  
  # Set outputs
  effluent.Q = fDn.Qe 

  outDn.SedFlux = Jsm
  outDn.X = X

  soluble.Si = Si
  soluble.Ss = Ss
  soluble.So = So
  soluble.Sno = Sno
  soluble.Snh = Snh
  soluble.Snd = Snd
  soluble.Salk = Salk

    # return sludge flow, solid and soluble components (ASM1)
  effluent.Si = Si
  effluent.Ss = Ss
  effluent.Xi = rXi*X
  effluent.Xs = rXs*X
  effluent.Xbh = rXbh*X
  effluent.Xba = rXba*X
  effluent.Xp = rXp*X
  effluent.So = So
  effluent.Sno = Sno
  effluent.Snh = Snh
  effluent.Snd = Snd
  effluent.Xnd = rXnd*X
  effluent.Salk = Salk

metadata {"Dyad": {"icons": {"default": "dyad://ASPDemo/TakacsTopLayer.svg"}}}
end

test component TestClarifierTop
  source = FlowSource()

  top_layer = SecondaryClarifierTakacs_TopLayer(zm=0.4, Asc=1500, Xt=3000, X_start = 3.707094910985e+02, soluble_start=[3.000000000000e+01, 1.241568688152e+00, 
  1.999999828995e+00, 1.656542580977e+01, 3.157645899664e+00, 4.924690064049e-01, 3.763667982244e+00])
  # Total sludge concentration in clarifier feed
  variable Xf::MassConcentration
relations
  Xf = 0.75*(source.Xs + source.Xbh + source.Xba + source.Xp + source.Xi)

  top_layer.Xf = Xf
  top_layer.rXi = source.Xi/Xf
  top_layer.rXs = source.Xs/Xf
  top_layer.rXbh = source.Xbh/Xf
  top_layer.rXba = source.Xba/Xf
  top_layer.rXp = source.Xp/Xf
  top_layer.rXnd = source.Xnd/Xf

  source.Q_in = 2.1477000000000000e+04  
  source.Si = 3.0000000000000000e+01
  source.Ss = 6.3634549999999997e+01 
  source.Xi = 5.8475999999999999e+01
  source.Xs = 2.2435200000000000e+02
  source.Xbh = 3.1425000000000001e+01
  source.Xba = 0.0000000000000000e+00
  source.Xp = 0.0000000000000000e+00
  source.So = 0.0000000000000000e+00
  source.Sno = 0.0000000000000000e+00 
  source.Snh = 3.0247620000000001e+01 
  source.Snd = 6.3634599999999999e+00 
  source.Xnd = 1.1814000000000000e+01 
  source.Salk = 7.0000000000000000e+00

  # FIXME: get values for SedFlux and vS_dn
  top_layer.Dn.vS_dn = 5
  top_layer.Dn.X_dn = 3.707094910985e+02
  top_layer.fDn.Qe = 0.1*2.1477000000000000e+04 

  top_layer.sDn.Si = 3.0000000000000000e+01
  top_layer.sDn.Ss = 6.3634549999999997e+01 
  top_layer.sDn.So = 0.0000000000000000e+00
  top_layer.sDn.Sno = 0.0000000000000000e+00 
  top_layer.sDn.Snh = 3.0247620000000001e+01 
  top_layer.sDn.Snd = 6.3634599999999999e+00 
  top_layer.sDn.Salk = 7.0000000000000000e+00
  
metadata {
  "Dyad": {
    "tests": {
      "case1": {"stop": 100, "expect": {"signals": ["volume.T", "resistance.port_a.m_flow"]}}
    }
  }
}
end

analysis simclarifiertop
  extends TransientAnalysis(stop=1)
  model = TestClarifierTop()
end
