connector FluidPortIn
  input Q::VolumeFlowRate
  # Mass Concentrations in [g COD/m3]
  # Soluble inert organic matter
  input Si::MassConcentration
  # Readily bidegradable substrate
  input Ss::MassConcentration
  # Particulate inert organic matter
  input Xi::MassConcentration
  # Slowly biodegradable substrate
  input Xs::MassConcentration
  # Active heterotrophic biomass
  input Xbh::MassConcentration
  # Active autotrophic biomass
  input Xba::MassConcentration
  # Particulate products from biomass decay
  input Xp::MassConcentration
  # Dissolved oxygen
  input So::MassConcentration
  # Nitrate and nitrite oxygen
  input Sno::MassConcentration
  # Ammonium nitrogen
  input Snh::MassConcentration
  # Solube biodegradable organic nitrogen 
  input Snd::MassConcentration
  # Parciculate biodegradable organic nitrogen
  input Xnd::MassConcentration
  # Alkanility in [mmol/L]
  input Salk::Real
metadata {"Dyad": {"icons": {"default": "dyad://ASPDemo/FluidInPort.svg"}}}
end