connector FluidPortOut
  output Q::VolumeFlowRate
  # Mass Concentrations in [g COD/m3]
  # Soluble inert organic matter
  output Si::MassConcentration
  # Readily bidegradable substrate
  output Ss::MassConcentration
  # Particulate inert organic matter
  output Xi::MassConcentration
  # Slowly biodegradable substrate
  output Xs::MassConcentration
  # Active heterotrophic biomass
  output Xbh::MassConcentration
  # Active autotrophic biomass
  output Xba::MassConcentration
  # Particulate products from biomass decay
  output Xp::MassConcentration
  # Dissolved oxygen
  output So::MassConcentration
  # Nitrate and nitrite oxygen
  output Sno::MassConcentration
  # Ammonium nitrogen
  output Snh::MassConcentration
  # Solube biodegradable organic nitrogen 
  output Snd::MassConcentration
  # Parciculate biodegradable organic nitrogen
  output Xnd::MassConcentration
  # Alkanility in [mmol/L]
  output Salk::Real
metadata {"Dyad": {"icons": {"default": "dyad://ASPDemo/FluidOutPort.svg"}}}
end