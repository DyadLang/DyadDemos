component SecondaryClarifierTakacs
  feed = FluidPortIn() [{"Dyad": {"placement": {"icon": {"x1": -50, "y1": 380, "x2": 50, "y2": 480}}}}]
  return1 = FluidPortOut() [{"Dyad": {"placement": {"icon": {"x1": 300, "y1": 950, "x2": 400, "y2": 1050}}}}]
  waste = FluidPortOut() [{"Dyad": {"placement": {"icon": {"x1": 600, "y1": 950, "x2": 700, "y2": 1050}}}}]
  effluent = FluidPortOut() [{"Dyad": {"placement": {"icon": {"x1": 950, "y1": 175, "x2": 1050, "y2": 275}}}}]


  # height of secondary clarifier
  parameter hsc::Length=4.0 
  # number of layers of SC model
  structural parameter n::Integer=10
  # height of m-th secondary clarifier layer
  parameter zm::Length=hsc/(1.0*n)
  # area of secondary clarifier
  parameter Asc::Area=1500.0 
  # threshold for X
  parameter Xt::MassConcentration=3000.0

  # Total sludge concentration in clarifier feed
  variable Xf::MassConcentration
  variable rXi::Real
  variable rXs::Real
  variable rXbh::Real
  variable rXba::Real
  variable rXp::Real
  variable rXnd::Real


  S10 = SecondaryClarifierTakacs_TopLayer(zm=zm, Asc=Asc, Xt=Xt, X_start = 1.275536445419e+01, 
        soluble_start=[3.000000000000e+01, 1.315923153747e+00, 1.999997854492e+00, 1.597856572461e+01, 2.659914027399e+00, 5.157153781401e-01, 3.865860459171e+00])

  S9 = SecondaryClarifierTakacs_UpperLayer(zm=zm, Asc=Asc, Xt=Xt, X_start = 1.863693081583e+01, 
        soluble_start=[3.000000000000e+01, 1.326501630233e+00, 1.999998510920e+00, 1.575300220995e+01, 3.014297581126e+00, 5.192990500291e-01, 3.893271573616e+00])
  S8 = SecondaryClarifierTakacs_UpperLayer(zm=zm, Asc=Asc, Xt=Xt, X_start = 3.082070988771e+01, 
        soluble_start=[3.000000000000e+01, 1.311404689710e+00, 2.000000119719e+00, 1.573179778908e+01, 3.309840625819e+00, 5.156280775302e-01, 3.892000582300e+00])
  S7 = SecondaryClarifierTakacs_UpperLayer(zm=zm, Asc=Asc, Xt=Xt, X_start = 7.377320137134e+01, 
        soluble_start=[3.000000000000e+01, 1.269543710665e+00, 2.000001062187e+00, 1.603779083408e+01, 3.350596024011e+00, 5.029453608766e-01, 3.844215940355e+00])
  
  S6 = SecondaryClarifierTakacs_FeedLayer(zm=zm, Asc=Asc, X_start = 3.707094910985e+02, 
        soluble_start=[3.000000000000e+01, 1.241568688152e+00, 1.999999828995e+00, 1.656542580977e+01, 3.157645899664e+00, 4.924690064049e-0, 3.763667982244e+00])
  
  S5 = SecondaryClarifierTakacs_LowerLayer(zm=zm, Asc=Asc, X_start = 3.927733554733e+02, 
        soluble_start=[3.000000000000e+01, 1.269942550715e+00, 2.000001082463e+00, 1.603225585080e+01, 3.353479657344e+00, 5.030845728215e-01, 3.845018683832e+00])
  S4 = SecondaryClarifierTakacs_LowerLayer(zm=zm, Asc=Asc, X_start = 3.658163924836e+02, 
        soluble_start=[3.000000000000e+01, 1.312069378217e+00, 2.000000137779e+00, 1.572405217982e+01, 3.311901710677e+00, 5.158389625268e-01, 3.893033083113e+00])
  S3 = SecondaryClarifierTakacs_LowerLayer(zm=zm, Asc=Asc, X_start = 3.535368422348e+02, 
        soluble_start=[3.000000000000e+01, 1.326304062865e+00, 1.999998505695e+00, 1.574321763600e+01, 3.005628887378e+00, 5.192334322417e-01, 3.894456624540e+00])
  S2 = SecondaryClarifierTakacs_LowerLayer(zm=zm, Asc=Asc, X_start = 3.858534185097e+02, 
        soluble_start=[3.000000000000e+01, 1.313469109476e+00, 1.999997808673e+00, 1.596796727152e+01, 2.620688498604e+00, 5.149498956479e-01, 3.866969541077e+00])
  
  S1 = SecondaryClarifierTakacs_BottomLayer(zm=zm, Asc=Asc, X_start = 6.424263681363e+03, 
        soluble_start=[3.000000000000e+01, 1.295030132149e+00, 1.999998370446e+00, 1.623473547370e+01, 2.356727799827e+00, 5.097661184448e-01, 3.833472190060e+00])

relations

  connect(feed, S6.In)
  connect(return1, S1.PQr)
  connect(waste, S1.PQw)
  connect(effluent, S10.effluent)

  connect(S10.Dn, S9.outUp)
  connect(S10.fDn, S9.fUp)
  connect(S10.outDn, S9.Up)
  connect(S10.sDn, S9.soluble)

  connect(S9.Dn, S8.outUp)
  connect(S9.fDn, S8.fUp)
  connect(S9.outDn, S8.Up)
  connect(S9.sDn, S8.soluble)

  connect(S8.Dn, S7.outUp)
  connect(S8.fDn, S7.fUp)
  connect(S8.outDn, S7.Up)
  connect(S8.sDn, S7.soluble)

  connect(S7.Dn, S6.outUp)
  connect(S7.fDn, S6.fUp)
  connect(S7.outDn, S6.Up)
  connect(S7.sDn, S6.soluble)

  connect(S6.Dn, S5.outUp)
  connect(S6.fDn, S5.fUp)
  connect(S6.soluble, S5.sUp)
  connect(S6.outDn, S5.Up)

  connect(S5.Dn, S4.outUp)
  connect(S5.fDn, S4.fUp)
  connect(S5.soluble, S4.sUp)
  connect(S5.outDn, S4.Up)

  connect(S4.Dn, S3.outUp)
  connect(S4.fDn, S3.fUp)
  connect(S4.soluble, S3.sUp)
  connect(S4.outDn, S3.Up)

  connect(S3.Dn, S2.outUp)
  connect(S3.fDn, S2.fUp)
  connect(S3.soluble, S2.sUp)
  connect(S3.outDn, S2.Up)

  connect(S2.Dn, S1.outUp)
  connect(S2.fDn, S1.fUp)
  connect(S2.soluble, S1.sUp)
  connect(S2.outDn, S1.Up)

  S10.Xf = Xf
  S10.rXi = rXi
  S10.rXs = rXs
  S10.rXbh = rXbh
  S10.rXba = rXba
  S10.rXp = rXp
  S10.rXnd = rXnd
  S9.Xf = Xf
  S8.Xf = Xf
  S7.Xf = Xf
  S6.Xf = Xf
  S5.Xf = Xf
  S4.Xf = Xf
  S3.Xf = Xf
  S2.Xf = Xf
  S1.Xf = Xf
  S1.rXi = rXi
  S1.rXs = rXs
  S1.rXbh = rXbh
  S1.rXba = rXba
  S1.rXp = rXp
  S1.rXnd = rXnd

  Xf = 0.75*(feed.Xs + feed.Xbh + feed.Xba + feed.Xp + feed.Xi)
  rXi = feed.Xi/Xf
  rXs = feed.Xs/Xf
  rXbh = feed.Xbh/Xf
  rXba = feed.Xba/Xf
  rXp = feed.Xp/Xf
  rXnd = feed.Xnd/Xf
metadata {
  "Dyad": {
    "labels": [{"label": "$(instance)", "x": 500, "y": 100, "rot": 0, "layer":"icon"}],
    "icons": {"default": "dyad://ASPDemo/SecClar.svg"}
  }
}
end

test component TestClarifier
  source = FlowSource()
  settler = SecondaryClarifierTakacs()
relations
  source.Q_in = 2.1477000000000000e+04  

  source.Si = 3.0000000000000000e+01
  source.Ss = 6.3634549999999997e+01 
  source.Xi = 5.8475999999999999e+01
  source.Xs = 2.2435200000000000e+02
  source.Xbh = 3.1425000000000001e+01
  source.Xba = 0.0000000000000000e+00
  source.Xp = 0.0000000000000000e+00
  source.So = 0.0000000000000000e+00
  source.Sno = 0.0000000000000000e+00 
  source.Snh = 3.0247620000000001e+01 
  source.Snd = 6.3634599999999999e+00 
  source.Xnd = 1.1814000000000000e+01 
  source.Salk = 7.0000000000000000e+00

  settler.return1.Q = 0.1*source.Q_in
  settler.waste.Q = 0.2*source.Q_in

  connect(source.port, settler.feed)
  
metadata {
  "Dyad": {
    "tests": {
      "case1": {"stop": 100, "expect": {"signals": ["volume.T", "resistance.port_a.m_flow"]}}
    }
  }
}
end

analysis simclarifier
  extends TransientAnalysis(stop=1)
  model = TestClarifier()
end
