analysis simsourcesink
  extends TransientAnalysis(stop=1)
  model = TestSourceSink()
end

component WWSource
  port = FluidPortOut() [{"Dyad": {"placement": {"icon": {"x1": 950, "y1": 800, "x2": 1050, "y2": 900}}}}]
  Si = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": -50, "y1": 550, "x2": 50, "y2": 650}}}}]
  Ss = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": -50, "y1": 750, "x2": 50, "y2": 850}}}}]
  Xi = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": -50, "y1": 750, "x2": 50, "y2": 850}}}}]
  Xs = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": -50, "y1": 750, "x2": 50, "y2": 850}}}}]
  Xbh = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": -50, "y1": 750, "x2": 50, "y2": 850}}}}]
  Xba = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": -50, "y1": 750, "x2": 50, "y2": 850}}}}]
  Xp = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": -50, "y1": 750, "x2": 50, "y2": 850}}}}]
  So = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": -50, "y1": 750, "x2": 50, "y2": 850}}}}]
  Sno = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": -50, "y1": 750, "x2": 50, "y2": 850}}}}]
  Snh = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": -50, "y1": 750, "x2": 50, "y2": 850}}}}]
  Snd = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": -50, "y1": 750, "x2": 50, "y2": 850}}}}]
  Xnd = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": -50, "y1": 750, "x2": 50, "y2": 850}}}}]
  Salk = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": -50, "y1": 750, "x2": 50, "y2": 850}}}}]
relations
  port.Si = Si
  port.Ss = Ss
  port.Xi = Xi
  port.Xs = Xs
  port.Xbh = Xbh
  port.Xba = Xba
  port.Xp = Xp
  port.So = So
  port.Sno = Sno
  port.Snh = Snh
  port.Snd = Snd
  port.Xnd = Xnd
  port.Salk = Salk
  metadata {"Dyad": {"icons": {"default": "dyad://ASPDemo/FlowSource.svg"}}}
end

# A test model for a source and sink
test component TestSourceSink
  source = WWSource()
  sink = EffluentSink()
relations
  source.Si = 1
  source.Ss = 2
  source.Xi = 3
  source.Xs = 4
  source.Xbh = 5
  source.Xba = 6
  source.Xp = 7
  source.So = 8
  source.Sno = 9
  source.Snh = 10
  source.Snd = 11
  source.Xnd = 12
  source.Salk = 13
  connect(source.port, sink.port)
metadata {
  "Dyad": {
    "tests": {
      "case1": {
        "stop": 1,
        "expect": {"signals": ["source.port.m_flow", "source.port.h_outflow"]}
      }
    }
  }
}
end