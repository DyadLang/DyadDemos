partial component PartialTank_2Port
  portIn = FluidPortIn() [{"Dyad": {"placement": {"icon": {"x1": -50, "y1": 450, "x2": 50, "y2": 550}}}}]
  portOut = FluidPortOut() [{"Dyad": {"placement": {"icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550}}}}]
  T = RealInput() [{"Dyad": {"placement": {"icon": {"x1": -50, "y1": 250, "x2": 50, "y2":350}}}}]
  parameter V::Volume = 1000

  # FIXME
  structural parameter nS::Integer = 13
  variable states::Real[nS]
  parameter states_start::MassFraction[nS] = [3.000000000000e+01, 
                                              5.744300865020e+00,
                                              1.114625044801e+03,
                                              1.056484783737e+02,
                                              2.563306641801e+03,
                                              1.032778829295e+02,
                                              4.321781192137e+02,
                                              4.776381995772e-03,
                                              1.736044358829e+00,
                                              1.841130239895e+01,
                                              1.046350972054e+00,
                                              6.244453916847e+00,
                                              5.956124593796e+00]

  # Reaction rate terms r1-r13
  variable r::Real[nS]
  variable aeration::Real
  variable Q::Real
  parameter medium::AbstractMedium = ASM1()
relations
  initial states = states_start

  r = reactions(medium, T, states)

  Q = portIn.Q
  der(states[1]) = (portIn.Si - states[1])*Q/V + r[1]
  der(states[2]) = (portIn.Ss - states[2])*Q/V + r[2]
  der(states[3]) = (portIn.Xi - states[3])*Q/V + r[3]
  der(states[4]) = (portIn.Xs - states[4])*Q/V + r[4]
  der(states[5]) = (portIn.Xbh - states[5])*Q/V + r[5]
  der(states[6]) = (portIn.Xba - states[6])*Q/V + r[6]
  der(states[7]) = (portIn.Xp - states[7])*Q/V + r[7]
  der(states[8]) = (portIn.So - states[8])*Q/V + r[8] + aeration
  der(states[9]) = (portIn.Sno - states[9])*Q/V + r[9]
  der(states[10]) = (portIn.Snh - states[10])*Q/V + r[10]
  der(states[11]) = (portIn.Snd - states[11])*Q/V + r[11]
  der(states[12]) = (portIn.Xnd - states[12])*Q/V + r[12]
  der(states[13]) = (portIn.Salk - states[13])*Q/V + r[13]
 
  portOut.Si = states[1]
  portOut.Ss = states[2]
  portOut.Xi = states[3]
  portOut.Xs = states[4]
  portOut.Xbh = states[5]
  portOut.Xba = states[6]
  portOut.Xp = states[7]
  portOut.So = states[8]
  portOut.Sno = states[9]
  portOut.Snh = states[10]
  portOut.Snd = states[11]
  portOut.Xnd = states[12]
  portOut.Salk = states[13]

  portOut.Q = Q
metadata {"Dyad": {"icons": {"default": "dyad://ASPDemo/FluidVolume.svg"}}}
end

# A test model for a fixed volume
test component TestTank
  source = FlowSource()
  tank = PartialTank_2Port()
  sink = EffluentSink()
relations
  source.Q_in = 2.1477000000000000e+04  

  source.Si = 3.0000000000000000e+01
  source.Ss = 6.3634549999999997e+01 
  source.Xi = 5.8475999999999999e+01
  source.Xs = 2.2435200000000000e+02
  source.Xbh = 3.1425000000000001e+01
  source.Xba = 0.0000000000000000e+00
  source.Xp = 0.0000000000000000e+00
  source.So = 0.0000000000000000e+00
  source.Sno = 0.0000000000000000e+00 
  source.Snh = 3.0247620000000001e+01 
  source.Snd = 6.3634599999999999e+00 
  source.Xnd = 1.1814000000000000e+01 
  source.Salk = 7.0000000000000000e+00
                                 
  tank.T = 15
  tank.aeration = 0
  
  connect(source.port, tank.portIn)
  connect(tank.portOut, sink.port)
metadata {
  "Dyad": {
    "tests": {
      "case1": {"stop": 100, "expect": {"signals": ["volume.T", "resistance.port_a.m_flow"]}}
    }
  }
}
end

analysis simtank
  extends TransientAnalysis(stop=0.1)
  model = TestTank()
end
