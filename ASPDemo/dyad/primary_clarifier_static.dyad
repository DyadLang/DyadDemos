# static primary clarifier tank, based on Otterpohl and Freund to be used for feed forward calculation, e.g. influent data needed
component PrimaryClarifierStatic
  portIn = FluidPortIn() [{"Dyad": {"placement": {"icon": {"x1": -50, "y1": 450, "x2": 50, "y2": 550}}}}]
  portOut = FluidPortOut() [{"Dyad": {"placement": {"icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550}}}}]
  parameter V::Volume = 500

  # hydraulic residence time in primary sedimentation tank [h]
  variable hrt_h::Real
  # efficiency of COD removal [%]
  variable n_COD::Real 
  # efficiency transformed to particulate fractions [%]
  variable n_X::Real
  variable CODin::Real
  variable CODout::Real
  variable XCODin::Real
  variable H::Real
  variable Q::Real
relations
  # calculation of hydraical residence time
  hrt_h = V/portIn.Q*24

  # n_COD according Otterpohl and Freund 1992 "Dynamic Models for Clarifiers"
  n_COD = 2.7*(log(hrt_h*hrt_h) + 9)/100
  # n_COD according Otterpohl 1995, Dissertation
  # n_COD = (1.45 + 6.15 * log(hrt_min))/100;

  XCODin = portIn.Xi + portIn.Xs + portIn.Xbh + portIn.Xba + portIn.Xp
  # particulate COD in the influent
  CODin = portIn.Si + portIn.Ss + XCODin
  # total COD in the influent

  CODout = portOut.Si + portOut.Ss + portOut.Xi + portOut.Xs + portOut.Xbh + portOut.Xba + portOut.Xp

  H = n_COD*CODin/XCODin

  # n_X can not be greater than 1
  # therefore is this check
  # n_X = if H > 0.95 then 0.95 else if H < 0.05 then 0.05 else H;
  n_X = max(0.05, min(H, 0.95))


  # in this case the model needs to be modified by a new n_COD
  # n_COD_? = (2.88*XCODin/CODin - 0.118) * n_COD;

  Q = portIn.Q

  portOut.Si = portIn.Si
  portOut.Ss = portIn.Ss
  portOut.Xi = (1 - n_X) * portIn.Xi
  portOut.Xs = (1 - n_X) * portIn.Xs
  portOut.Xbh = (1 - n_X) * portIn.Xbh
  portOut.Xba = (1 - n_X) * portIn.Xba
  portOut.Xp = (1 - n_X) * portIn.Xp
  portOut.So = portIn.So
  portOut.Sno = portIn.Sno
  portOut.Snh = portIn.Snh
  portOut.Snd = portIn.Snd
  portOut.Xnd = (1 - n_X) * portIn.Xnd
  portOut.Salk = portIn.Salk

  portOut.Q = Q
metadata {"Dyad": {"icons": {"default": "dyad://ASPDemo/PreClar2.svg"}}}
end

# A test model for a fixed volume
test component TestPrimaryClarifierStatic
  source = FlowSource()
  preclar = PrimaryClarifierStatic()
  sink = EffluentSink()
relations
  source.Q_in = 2.1477000000000000e+04  

  source.Si = 3.0000000000000000e+01
  source.Ss = 6.3634549999999997e+01 
  source.Xi = 5.8475999999999999e+01
  source.Xs = 2.2435200000000000e+02
  source.Xbh = 3.1425000000000001e+01
  source.Xba = 0.0000000000000000e+00
  source.Xp = 0.0000000000000000e+00
  source.So = 0.0000000000000000e+00
  source.Sno = 0.0000000000000000e+00 
  source.Snh = 3.0247620000000001e+01 
  source.Snd = 6.3634599999999999e+00 
  source.Xnd = 1.1814000000000000e+01 
  source.Salk = 7.0000000000000000e+00
                                   
  connect(source.port, preclar.portIn)
  connect(preclar.portOut, sink.port)
metadata {
  "Dyad": {
    "tests": {
      "case1": {"stop": 100, "expect": {"signals": ["volume.T", "resistance.port_a.m_flow"]}}
    }
  }
}
end

analysis simprimaryclarifierstatic
  extends TransientAnalysis(stop=0.1)
  model = TestPrimaryClarifierStatic()
end
