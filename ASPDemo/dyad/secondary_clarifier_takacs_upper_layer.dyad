component SecondaryClarifierTakacs_UpperLayer
  sDn = SolubleIn() [{"Dyad": {"placement": {"icon": {"x1": 950, "y1": 700, "x2": 1050, "y2": 800}}}}]
  Dn = SedimentationVelocitySludgeIn() [{"Dyad": {"placement": {"icon": {"x1": 450, "y1": 950, "x2": 550, "y2": 1050}}}}]
  fDn = FlowEffluentIn() [{"Dyad": {"placement": {"icon": {"x1": 200, "y1": -50, "x2": 300, "y2": 50}}}}]
  Up = SedimentationFluxSludgeIn() [{"Dyad": {"placement": {"icon": {"x1": 450, "y1": -50, "x2": 550, "y2": 50}}}}]

  fUp = FlowEffluentOut() [{"Dyad": {"placement": {"icon": {"x1": 200, "y1": -50, "x2": 300, "y2": 50}}}}]
  outUp = SedimentationVelocitySludgeOut() [{"Dyad": {"placement": {"icon": {"x1": 700, "y1": -50, "x2": 800, "y2": 50}}}}]
  outDn = SedimentationFluxSludgeOut() [{"Dyad": {"placement": {"icon": {"x1": 700, "y1": 950, "x2": 800, "y2": 1050}}}}]
  soluble = SolubleOut() [{"Dyad": {"placement": {"icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550}}}}]

  # Total sludge concentration in clarifier feed
  Xf = RealInput()
  # Total sludge concentration in m-th layer
  variable X::MassConcentration
  # Sink velocity in m-th layer
  variable vS::Real
  # Sedimentation flux in m-th layer
  variable Jsm::Real
  # Soluble inert organic matter
  variable Si::MassConcentration
  # Readily biodegradable substrate
  variable Ss::MassConcentration
  # Dissolved oxygen
  variable So::MassConcentration
  # Nitrate and nitrite nitrogen
  variable Sno::MassConcentration
  # Ammonium nitrogen
  variable Snh::MassConcentration
  # Soluble biodegradable organic nitrogen
  variable Snd::MassConcentration
  # Alkalinity
  variable Salk::MassConcentration
  # Surface area of sec clarifier [m2]
  parameter Asc::Area
  # Height of m-th secondary clarifier layer [m]
  parameter zm::Length
  # threshold for X
  parameter Xt::MassConcentration
  parameter X_start::MassConcentration
  parameter soluble_start::MassConcentration[7]
relations
  initial X = X_start
  initial Si = soluble_start[1]
  initial Ss = soluble_start[2]
  initial So = soluble_start[3]
  initial Sno = soluble_start[4]
  initial Snh = soluble_start[5]
  initial Snd = soluble_start[6]
  initial Salk = soluble_start[7]

  # Sink velocity
  vS = vS_TakacsDoubleExponential(X, Xf)

  # Sedimentation flux in m-th layer sinking to lower layer
  Jsm = ifelse(Dn.X_dn <= Xt, vS*X, min(vS*X, Dn.vS_dn*Dn.X_dn))

  # ODE of solid component
  der(X) = (fDn.Qe/Asc*(Dn.X_dn - X) + Up.SedFlux - Jsm)/zm
  
  # ODE of soluble components
  der(Si) = fDn.Qe*(sDn.Si - Si)/(Asc*zm)
  der(Ss) = fDn.Qe*(sDn.Ss - Ss)/(Asc*zm)
  der(So) = fDn.Qe*(sDn.So - So)/(Asc*zm)
  der(Sno) = fDn.Qe*(sDn.Sno - Sno)/(Asc*zm)
  der(Snh) = fDn.Qe*(sDn.Snh - Snh)/(Asc*zm)
  der(Snd) = fDn.Qe*(sDn.Snd - Snd)/(Asc*zm)
  der(Salk) = fDn.Qe*(sDn.Salk - Salk)/(Asc*zm)
  
  # Set outputs
  fUp.Qe = fDn.Qe 

  outDn.SedFlux = Jsm
  outDn.X = X

  outUp.vS_dn = vS
  outUp.X_dn = X

  soluble.Si = Si
  soluble.Ss = Ss
  soluble.So = So
  soluble.Sno = Sno
  soluble.Snh = Snh
  soluble.Snd = Snd
  soluble.Salk = Salk

metadata {"Dyad": {"icons": {"default": "dyad://ASPDemo/TakacsUpperLayer.svg"}}}
end

test component TestClarifierUpper
  upper_layer = SecondaryClarifierTakacs_UpperLayer(zm = 0.4, Asc=1500, Xt=3000.0, X_start = 3.707094910985e+02, soluble_start=[3.000000000000e+01, 1.241568688152e+00, 
  1.999999828995e+00, 1.656542580977e+01, 3.157645899664e+00, 4.924690064049e-01, 3.763667982244e+00])
  # Total sludge concentration in clarifier feed
  variable Xf::MassConcentration
relations
  Xf = 235.68975000000003
  upper_layer.Xf = Xf

  # FIXME: get values for SedFlux and vS_dn
  upper_layer.Up.SedFlux = 50
  upper_layer.Up.X = 3.707094910985e+02
  upper_layer.Dn.vS_dn = 5
  upper_layer.Dn.X_dn = 3.707094910985e+02
  upper_layer.fDn.Qe = 0.1*2.1477000000000000e+04 

  upper_layer.sDn.Si = 3.0000000000000000e+01
  upper_layer.sDn.Ss = 6.3634549999999997e+01 
  upper_layer.sDn.So = 0.0000000000000000e+00
  upper_layer.sDn.Sno = 0.0000000000000000e+00 
  upper_layer.sDn.Snh = 3.0247620000000001e+01 
  upper_layer.sDn.Snd = 6.3634599999999999e+00 
  upper_layer.sDn.Salk = 7.0000000000000000e+00
  
metadata {
  "Dyad": {
    "tests": {
      "case1": {"stop": 100, "expect": {"signals": ["volume.T", "resistance.port_a.m_flow"]}}
    }
  }
}
end

analysis simclarifierupper
  extends TransientAnalysis(stop=1)
  model = TestClarifierUpper()
end
