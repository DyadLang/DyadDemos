component SecondaryClarifierTakacs_BottomLayer
  sUp = SolubleIn() [{"Dyad": {"placement": {"icon": {"x1": 950, "y1": 200, "x2": 1050, "y2": 300}}}}]
  Up = SedimentationFluxSludgeIn() [{"Dyad": {"placement": {"icon": {"x1": 450, "y1": -50, "x2": 550, "y2": 50}}}}]

  fUp = FlowReturnWasteSludgeOut() [{"Dyad": {"placement": {"icon": {"x1": 200, "y1": -50, "x2": 300, "y2": 50}}}}]
  outUp = SedimentationVelocitySludgeOut() [{"Dyad": {"placement": {"icon": {"x1": 700, "y1": -50, "x2": 800, "y2": 50}}}}]
  PQw = FluidPortOut() [{"Dyad": {"placement": {"icon": {"x1": 700, "y1": 950, "x2": 800, "y2": 1050}}}}]
  PQr = FluidPortOut() [{"Dyad": {"placement": {"icon": {"x1": 200, "y1": 950, "x2": 300, "y2": 1050}}}}]
  soluble = SolubleOut() [{"Dyad": {"placement": {"icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550}}}}]

  # Total sludge concentration in clarifier feed
  Xf = RealInput()
  rXi = RealInput()
  rXs = RealInput()
  rXbh = RealInput()
  rXba = RealInput()
  rXp = RealInput()
  rXnd = RealInput()

  # Total sludge concentration in m-th layer
  variable X::MassConcentration
  # Sink velocity in m-th layer
  variable vS::Real
  # Sedimentation flux in m-th layer
  variable Jsm::Real
  # Soluble inert organic matter
  variable Si::MassConcentration
  # Readily biodegradable substrate
  variable Ss::MassConcentration
  # Dissolved oxygen
  variable So::MassConcentration
  # Nitrate and nitrite nitrogen
  variable Sno::MassConcentration
  # Ammonium nitrogen
  variable Snh::MassConcentration
  # Soluble biodegradable organic nitrogen
  variable Snd::MassConcentration
  # Alkalinity
  variable Salk::MassConcentration
  # Surface area of sec clarifier [m2]
  parameter Asc::Area
  # Height of m-th secondary clarifier layer [m]
  parameter zm::Length
  parameter X_start::MassConcentration
  parameter soluble_start::MassConcentration[7]
relations
  initial X = X_start
  initial Si = soluble_start[1]
  initial Ss = soluble_start[2]
  initial So = soluble_start[3]
  initial Sno = soluble_start[4]
  initial Snh = soluble_start[5]
  initial Snd = soluble_start[6]
  initial Salk = soluble_start[7]

  # Sink velocity
  vS = vS_TakacsDoubleExponential(X, Xf)

  # Sedimentation flux in m-th layer sinking to lower layer
  Jsm = 0

  # ODE of solid component
  der(X) = ((fUp.Qr + fUp.Qw)/Asc*(Up.X - X) + Up.SedFlux)/zm
  
  # ODE of soluble components
  der(Si) = (fUp.Qr + fUp.Qw)*(sUp.Si - Si)/(Asc*zm)
  der(Ss) = (fUp.Qr + fUp.Qw)*(sUp.Ss - Ss)/(Asc*zm)
  der(So) = (fUp.Qr + fUp.Qw)*(sUp.So - So)/(Asc*zm)
  der(Sno) = (fUp.Qr + fUp.Qw)*(sUp.Sno - Sno)/(Asc*zm)
  der(Snh) = (fUp.Qr + fUp.Qw)*(sUp.Snh - Snh)/(Asc*zm)
  der(Snd) = (fUp.Qr + fUp.Qw)*(sUp.Snd - Snd)/(Asc*zm)
  der(Salk) = (fUp.Qr + fUp.Qw)*(sUp.Salk - Salk)/(Asc*zm)
  
  # Set outputs
  fUp.Qr = PQr.Q 
  fUp.Qw = PQw.Q 

  outUp.vS_dn = vS
  outUp.X_dn = X

  soluble.Si = Si
  soluble.Ss = Ss
  soluble.So = So
  soluble.Sno = Sno
  soluble.Snh = Snh
  soluble.Snd = Snd
  soluble.Salk = Salk

  # return sludge flow, solid and soluble components (ASM1)
  PQr.Si = Si
  PQr.Ss = Ss
  PQr.Xi = rXi*X
  PQr.Xs = rXs*X
  PQr.Xbh = rXbh*X
  PQr.Xba = rXba*X
  PQr.Xp = rXp*X
  PQr.So = So
  PQr.Sno = Sno
  PQr.Snh = Snh
  PQr.Snd = Snd
  PQr.Xnd = rXnd*X
  PQr.Salk = Salk

  # waste sludge flow, solid and soluble components (ASM1)
  PQw.Si = Si
  PQw.Ss = Ss
  PQw.Xi = rXi*X
  PQw.Xs = rXs*X
  PQw.Xbh = rXbh*X
  PQw.Xba = rXba*X
  PQw.Xp = rXp*X
  PQw.So = So
  PQw.Sno = Sno
  PQw.Snh = Snh
  PQw.Snd = Snd
  PQw.Xnd = rXnd*X
  PQw.Salk = Salk

metadata {"Dyad": {"icons": {"default": "dyad://ASPDemo/TakacsBottomLayer.svg"}}}
end

test component TestClarifierBottom
  source = FlowSource()

  bottom_layer = SecondaryClarifierTakacs_BottomLayer(zm = 0.4, Asc=1500, X_start = 3.707094910985e+02, soluble_start=[3.000000000000e+01, 1.241568688152e+00, 
  1.999999828995e+00, 1.656542580977e+01, 3.157645899664e+00, 4.924690064049e-01, 3.763667982244e+00])
  # Total sludge concentration in clarifier feed
  variable Xf::MassConcentration
relations
  Xf = 0.75*(source.Xs + source.Xbh + source.Xba + source.Xp + source.Xi)

  bottom_layer.Xf = Xf
  bottom_layer.rXi = source.Xi/Xf
  bottom_layer.rXs = source.Xs/Xf
  bottom_layer.rXbh = source.Xbh/Xf
  bottom_layer.rXba = source.Xba/Xf
  bottom_layer.rXp = source.Xp/Xf
  bottom_layer.rXnd = source.Xnd/Xf

  source.Q_in = 2.1477000000000000e+04  
  source.Si = 3.0000000000000000e+01
  source.Ss = 6.3634549999999997e+01 
  source.Xi = 5.8475999999999999e+01
  source.Xs = 2.2435200000000000e+02
  source.Xbh = 3.1425000000000001e+01
  source.Xba = 0.0000000000000000e+00
  source.Xp = 0.0000000000000000e+00
  source.So = 0.0000000000000000e+00
  source.Sno = 0.0000000000000000e+00 
  source.Snh = 3.0247620000000001e+01 
  source.Snd = 6.3634599999999999e+00 
  source.Xnd = 1.1814000000000000e+01 
  source.Salk = 7.0000000000000000e+00

  # FIXME: get values for SedFlux and vS_dn
  bottom_layer.Up.SedFlux = 50
  bottom_layer.Up.X = 3.707094910985e+02
  bottom_layer.PQr.Q = 0.1*2.1477000000000000e+04 
  bottom_layer.PQw.Q = 0.2*2.1477000000000000e+04 

  bottom_layer.sUp.Si = 3.0000000000000000e+01
  bottom_layer.sUp.Ss = 6.3634549999999997e+01 
  bottom_layer.sUp.So = 0.0000000000000000e+00
  bottom_layer.sUp.Sno = 0.0000000000000000e+00 
  bottom_layer.sUp.Snh = 3.0247620000000001e+01 
  bottom_layer.sUp.Snd = 6.3634599999999999e+00 
  bottom_layer.sUp.Salk = 7.0000000000000000e+00

  
metadata {
  "Dyad": {
    "tests": {
      "case1": {"stop": 100, "expect": {"signals": ["volume.T", "resistance.port_a.m_flow"]}}
    }
  }
}
end

analysis simclarifierbottom
  extends TransientAnalysis(stop=1)
  model = TestClarifierBottom()
end
