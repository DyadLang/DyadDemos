component Blower
  u = RealInput() {^u}
  Q_air = RealOutput() {^Q_air}
  # Flowrate units are m3/day
  parameter Q_max::Real = 20000
  parameter Q_min::Real = 0
relations
  Q_air = min(Q_max, max(0.5 * (-Q_min + Q_max) + u * 0.5 * (-Q_min + Q_max) + Q_min, Q_min))
metadata {
  "Dyad": {
    "labels": [{"label": "$(instance)", "x": 500, "y": 950, "rot": 0, "layer": "icon"}],
    "icons": {"default": "dyad://ASPDemo/Blower.svg"}
  },
  "_links": {
    "u": {
      "Dyad": {
        "placement": {"icon": {"x1": 950, "y1": 600, "x2": 1050, "y2": 700, "rot": 180}}
      }
    },
    "Q_air": {
      "Dyad": {"placement": {"icon": {"x1": 400, "y1": -50, "x2": 500, "y2": 50, "rot": 270}}}
    }
  }
}
end

# A test model for a blower
test component TestBlower
  blower = Blower()
  variable Q_air::Real
relations
  initial Q_air = 0
  blower.u = -1 + 0.25 * floor(time / 0.5)
  der(Q_air) = (blower.Q_air - Q_air) / 0.05
metadata {
  "Dyad": {"tests": {"case1": {"stop": 4, "expect": {"signals": ["blower.Q_air"]}}}}
}
end

analysis simblower
  extends TransientAnalysis(stop = 4)
  model = TestBlower()
relations
end