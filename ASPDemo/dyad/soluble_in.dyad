connector SolubleIn
  # Mass Concentrations in [g COD/m3]
  # Solube inert organic matter
  input Si::MassConcentration
  # Readily bidegradable substrate
  input Ss::MassConcentration
  # Dissolved oxygen
  input So::MassConcentration
  # Nitrate and nitrite oxygen
  input Sno::MassConcentration
  # Ammonium nitrogen
  input Snh::MassConcentration
  # Solube biodegradable organic nitrogen 
  input Snd::MassConcentration
  # Alkanility in [mmol/L]
  input Salk::Real
metadata {"Dyad": {"icons": {"default": "dyad://ASPDemo/SolubleInPort.svg"}}}
end