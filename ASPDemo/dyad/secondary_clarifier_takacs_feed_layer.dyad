component SecondaryClarifierTakacs_FeedLayer
  In = FluidPortIn() [{"Dyad": {"placement": {"icon": {"x1": -50, "y1": 450, "x2": 50, "y2": 550}}}}]
  Dn = SedimentationVelocitySludgeIn() [{"Dyad": {"placement": {"icon": {"x1": 450, "y1": 950, "x2": 550, "y2": 1050}}}}]
  fDn = FlowReturnWasteSludgeIn() [{"Dyad": {"placement": {"icon": {"x1": 200, "y1": -50, "x2": 300, "y2": 50}}}}]
  Up = SedimentationFluxSludgeIn() [{"Dyad": {"placement": {"icon": {"x1": 450, "y1": -50, "x2": 550, "y2": 50}}}}]
  
  fUp = FlowEffluentOut() [{"Dyad": {"placement": {"icon": {"x1": 200, "y1": -50, "x2": 300, "y2": 50}}}}]
  outUp = SedimentationVelocitySludgeOut() [{"Dyad": {"placement": {"icon": {"x1": 700, "y1": -50, "x2": 800, "y2": 50}}}}]
  outDn = SedimentationFluxSludgeOut() [{"Dyad": {"placement": {"icon": {"x1": 700, "y1": 950, "x2": 800, "y2": 1050}}}}]
  soluble = SolubleOut() [{"Dyad": {"placement": {"icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550}}}}]

  # Total sludge concentration in clarifier feed
  Xf = RealInput()
  # Total sludge concentration in m-th layer
  variable X::MassConcentration
  # Sink velocity in m-th layer
  variable vS::Real
  # Sedimentation flux in m-th layer
  variable Jsm::Real
  # Soluble inert organic matter
  variable Si::MassConcentration
  # Readily biodegradable substrate
  variable Ss::MassConcentration
  # Dissolved oxygen
  variable So::MassConcentration
  # Nitrate and nitrite nitrogen
  variable Sno::MassConcentration
  # Ammonium nitrogen
  variable Snh::MassConcentration
  # Soluble biodegradable organic nitrogen
  variable Snd::MassConcentration
  # Alkalinity
  variable Salk::MassConcentration
  # Surface area of sec clarifier [m2]
  parameter Asc::Area
  # Height of m-th secondary clarifier layer [m]
  parameter zm::Length
  parameter X_start::MassConcentration
  parameter soluble_start::MassConcentration[7]
relations
  initial X = X_start
  initial Si = soluble_start[1]
  initial Ss = soluble_start[2]
  initial So = soluble_start[3]
  initial Sno = soluble_start[4]
  initial Snh = soluble_start[5]
  initial Snd = soluble_start[6]
  initial Salk = soluble_start[7]

  # Sink velocity
  vS = vS_TakacsDoubleExponential(X, Xf)

  # Sedimentation flux in m-th layer sinking to lower layer
  Jsm = min(vS*X, Dn.vS_dn*Dn.X_dn)

  # ODE of solid component
  der(X) = (In.Q/Asc*Xf - (fUp.Qe)/Asc*X - ((fDn.Qr + fDn.Qw))/Asc*X + Up.
    SedFlux - Jsm)/zm
  
  # ODE of soluble components
  der(Si) = (In.Q*In.Si - (fUp.Qe)*Si - ((fDn.Qr + fDn.Qw))*Si)/(Asc*zm)
  der(Ss) = (In.Q*In.Ss - (fUp.Qe)*Ss - ((fDn.Qr + fDn.Qw))*Ss)/(Asc*zm)
  der(So) = (In.Q*In.So - (fUp.Qe)*So - ((fDn.Qr + fDn.Qw))*So)/(Asc*zm)
  der(Sno) = (In.Q*In.Sno - (fUp.Qe)*Sno - ((fDn.Qr + fDn.Qw))*Sno)/(Asc*zm)
  der(Snh) = (In.Q*In.Snh - (fUp.Qe)*Snh - ((fDn.Qr + fDn.Qw))*Snh)/(Asc*zm)
  der(Snd) = (In.Q*In.Snd - (fUp.Qe)*Snd - ((fDn.Qr + fDn.Qw))*Snd)/(Asc*zm)
  der(Salk) = (In.Q*In.Salk - (fUp.Qe)*Salk - ((fDn.Qr + fDn.Qw))*Salk)/(Asc*zm)
  
  # Set outputs
  fUp.Qe = In.Q - fDn.Qr - fDn.Qw 
  outDn.SedFlux = Jsm
  outDn.X = X

  outUp.vS_dn = vS
  outUp.X_dn = X

  soluble.Si = Si
  soluble.Ss = Ss
  soluble.So = So
  soluble.Sno = Sno
  soluble.Snh = Snh
  soluble.Snd = Snd
  soluble.Salk = Salk

metadata {"Dyad": {"icons": {"default": "dyad://ASPDemo/TakacsFeedLayer.svg"}}}
end

test component TestClarifierFeed
  source = FlowSource()
  feed_layer = SecondaryClarifierTakacs_FeedLayer(zm = 0.4, Asc=1500, X_start = 3.707094910985e+02, soluble_start=[3.000000000000e+01, 1.241568688152e+00, 
  1.999999828995e+00, 1.656542580977e+01, 3.157645899664e+00, 4.924690064049e-01, 3.763667982244e+00])
  # Total sludge concentration in clarifier feed
  variable Xf::MassConcentration
relations
  source.Q_in = 2.1477000000000000e+04  

  source.Si = 3.0000000000000000e+01
  source.Ss = 6.3634549999999997e+01 
  source.Xi = 5.8475999999999999e+01
  source.Xs = 2.2435200000000000e+02
  source.Xbh = 3.1425000000000001e+01
  source.Xba = 0.0000000000000000e+00
  source.Xp = 0.0000000000000000e+00
  source.So = 0.0000000000000000e+00
  source.Sno = 0.0000000000000000e+00 
  source.Snh = 3.0247620000000001e+01 
  source.Snd = 6.3634599999999999e+00 
  source.Xnd = 1.1814000000000000e+01 
  source.Salk = 7.0000000000000000e+00

  connect(source.port, feed_layer.In)

  Xf = 0.75*(feed_layer.In.Xs + feed_layer.In.Xbh + feed_layer.In.Xba + feed_layer.In.Xp + feed_layer.In.Xi)
  feed_layer.Xf = Xf

  # FIXME: get values for SedFlux and vS_dn
  feed_layer.Up.SedFlux = 50
  feed_layer.Dn.vS_dn = 5
  feed_layer.Dn.X_dn = 3.707094910985e+02
  feed_layer.fDn.Qr = 0.1*source.Q_in
  feed_layer.fDn.Qw = 0.2*source.Q_in

  feed_layer.Up.X = 0
  
metadata {
  "Dyad": {
    "tests": {
      "case1": {"stop": 100, "expect": {"signals": ["volume.T", "resistance.port_a.m_flow"]}}
    }
  }
}
end

analysis simclarifierfeed
  extends TransientAnalysis(stop=1)
  model = TestClarifierFeed()
end
