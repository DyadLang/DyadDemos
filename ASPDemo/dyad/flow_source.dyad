analysis simflowsourcesink
  extends TransientAnalysis(stop=1)
  model = TestFlowSourceSink()
end

component FlowSource
  port = FluidPortOut() [{"Dyad": {"placement": {"icon": {"x1": 950, "y1": 800, "x2": 1050, "y2": 900}}}}]
  Q_in = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": 400, "y1": -100, "x2": 500, "y2": 0, "rot": 90}}}}]
  Si = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": -50, "y1": -50, "x2": 50, "y2": 50}}}}]
  Ss = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": -50, "y1": 100, "x2": 50, "y2": 200}}}}]
  Xi = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": -50, "y1": 250, "x2": 50, "y2": 350}}}}]
  Xs = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": -50, "y1": 400, "x2": 50, "y2": 500}}}}]
  Xbh = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": -50, "y1": 550, "x2": 50, "y2": 650}}}}]
  Xba = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": -50, "y1": 700, "x2": 50, "y2": 800}}}}]
  Xp = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": -50, "y1": 850, "x2": 50, "y2": 950}}}}]
  So = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": -50, "y1": 1000, "x2": 50, "y2": 1100}}}}]
  Sno = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": 150, "y1": 1000, "x2": 250, "y2": 1100, "rot": 270}}}}]
  Snh = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": 300, "y1": 1000, "x2": 400, "y2": 1100, "rot": 270}}}}]
  Snd = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": 450, "y1": 1000, "x2": 550, "y2": 1100, "rot": 270}}}}]
  Xnd = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": 600, "y1": 1000, "x2": 700, "y2": 1100, "rot": 270}}}}]
  Salk = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input1", "x1": 750, "y1": 1000, "x2": 850, "y2": 1100, "rot": 270}}}}]
relations
  port.Si = Si
  port.Ss = Ss
  port.Xi = Xi
  port.Xs = Xs
  port.Xbh = Xbh
  port.Xba = Xba
  port.Xp = Xp
  port.So = So
  port.Sno = Sno
  port.Snh = Snh
  port.Snd = Snd
  port.Xnd = Xnd
  port.Salk = Salk
  port.Q = Q_in
  metadata {
  "Dyad": {
    "labels": [{"label": "$(instance)", "x": 500, "y": 150, "rot": 0, "layer":"icon"}],
    "icons": {"default": "dyad://ASPDemo/WWSource.svg"}
  }
}
end

# A test model for a source and sink
test component TestFlowSourceSink
  source = FlowSource()
  sink = EffluentSink()
relations
  source.Q_in = 0.5
  source.Si = 1
  source.Ss = 2
  source.Xi = 3
  source.Xs = 4
  source.Xbh = 5
  source.Xba = 6
  source.Xp = 7
  source.So = 8
  source.Sno = 9
  source.Snh = 10
  source.Snd = 11
  source.Xnd = 12
  source.Salk = 13
  connect(source.port, sink.port)
metadata {
  "Dyad": {
    "tests": {
      "case1": {
        "stop": 1,
        "expect": {"signals": ["source.port.m_flow", "source.port.h_outflow"]}
      }
    }
  }
}
end