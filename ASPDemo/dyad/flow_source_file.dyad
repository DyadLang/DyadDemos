analysis simflowsourcefileesink
  extends TransientAnalysis(stop = 1)
  model = TestFlowSourceFileSink()
relations
end

component FlowSourceFile
  port = FluidPortOut() {^port}
  Q_interp = BlockComponents.Interpolation(interpolation_type = BlockComponents.InterpolationType.LinearInterpolation(), dataset = dataset_Q)
  Si_interp = BlockComponents.Interpolation(interpolation_type = BlockComponents.InterpolationType.LinearInterpolation(), dataset = dataset_Si)
  Ss_interp = BlockComponents.Interpolation(interpolation_type = BlockComponents.InterpolationType.LinearInterpolation(), dataset = dataset_Ss)
  Xi_interp = BlockComponents.Interpolation(interpolation_type = BlockComponents.InterpolationType.LinearInterpolation(), dataset = dataset_Xi)
  Xs_interp = BlockComponents.Interpolation(interpolation_type = BlockComponents.InterpolationType.LinearInterpolation(), dataset = dataset_Xs)
  Xbh_interp = BlockComponents.Interpolation(interpolation_type = BlockComponents.InterpolationType.LinearInterpolation(), dataset = dataset_Xbh)
  Xba_interp = BlockComponents.Interpolation(interpolation_type = BlockComponents.InterpolationType.LinearInterpolation(), dataset = dataset_Xba)
  Xp_interp = BlockComponents.Interpolation(interpolation_type = BlockComponents.InterpolationType.LinearInterpolation(), dataset = dataset_Xp)
  So_interp = BlockComponents.Interpolation(interpolation_type = BlockComponents.InterpolationType.LinearInterpolation(), dataset = dataset_So)
  Sno_interp = BlockComponents.Interpolation(interpolation_type = BlockComponents.InterpolationType.LinearInterpolation(), dataset = dataset_Sno)
  Snh_interp = BlockComponents.Interpolation(interpolation_type = BlockComponents.InterpolationType.LinearInterpolation(), dataset = dataset_Snh)
  Snd_interp = BlockComponents.Interpolation(interpolation_type = BlockComponents.InterpolationType.LinearInterpolation(), dataset = dataset_Snd)
  Xnd_interp = BlockComponents.Interpolation(interpolation_type = BlockComponents.InterpolationType.LinearInterpolation(), dataset = dataset_Xnd)
  Salk_interp = BlockComponents.Interpolation(interpolation_type = BlockComponents.InterpolationType.LinearInterpolation(), dataset = dataset_Salk)
  structural parameter input_file::String = "dyad://ASPDemo/../test/data/Inf_dry_const_benchmark.csv"
  structural parameter dataset_Q::DyadData.DyadTimeseries = DyadData.DyadTimeseries(input_file, dependent_vars = ["Q"], independent_var = "t")
  structural parameter dataset_Si::DyadData.DyadTimeseries = DyadData.DyadTimeseries(input_file, dependent_vars = ["Si"], independent_var = "t")
  structural parameter dataset_Ss::DyadData.DyadTimeseries = DyadData.DyadTimeseries(input_file, dependent_vars = ["Ss"], independent_var = "t")
  structural parameter dataset_Xi::DyadData.DyadTimeseries = DyadData.DyadTimeseries(input_file, dependent_vars = ["Xi"], independent_var = "t")
  structural parameter dataset_Xs::DyadData.DyadTimeseries = DyadData.DyadTimeseries(input_file, dependent_vars = ["Xs"], independent_var = "t")
  structural parameter dataset_Xbh::DyadData.DyadTimeseries = DyadData.DyadTimeseries(input_file, dependent_vars = ["Xbh"], independent_var = "t")
  structural parameter dataset_Xba::DyadData.DyadTimeseries = DyadData.DyadTimeseries(input_file, dependent_vars = ["Xba"], independent_var = "t")
  structural parameter dataset_Xp::DyadData.DyadTimeseries = DyadData.DyadTimeseries(input_file, dependent_vars = ["Xp"], independent_var = "t")
  structural parameter dataset_So::DyadData.DyadTimeseries = DyadData.DyadTimeseries(input_file, dependent_vars = ["So"], independent_var = "t")
  structural parameter dataset_Sno::DyadData.DyadTimeseries = DyadData.DyadTimeseries(input_file, dependent_vars = ["Sno"], independent_var = "t")
  structural parameter dataset_Snh::DyadData.DyadTimeseries = DyadData.DyadTimeseries(input_file, dependent_vars = ["Snh"], independent_var = "t")
  structural parameter dataset_Snd::DyadData.DyadTimeseries = DyadData.DyadTimeseries(input_file, dependent_vars = ["Snd"], independent_var = "t")
  structural parameter dataset_Xnd::DyadData.DyadTimeseries = DyadData.DyadTimeseries(input_file, dependent_vars = ["Xnd"], independent_var = "t")
  structural parameter dataset_Salk::DyadData.DyadTimeseries = DyadData.DyadTimeseries(input_file, dependent_vars = ["Salk"], independent_var = "t")
relations
  Q_interp.u = time
  port.Q = Q_interp.y
  Si_interp.u = time
  port.Si = Si_interp.y
  Ss_interp.u = time
  port.Ss = Ss_interp.y
  Xi_interp.u = time
  port.Xi = Xi_interp.y
  Xs_interp.u = time
  port.Xs = Xs_interp.y
  Xbh_interp.u = time
  port.Xbh = Xbh_interp.y
  Xba_interp.u = time
  port.Xba = Xba_interp.y
  Xp_interp.u = time
  port.Xp = Xp_interp.y
  So_interp.u = time
  port.So = So_interp.y
  Sno_interp.u = time
  port.Sno = Sno_interp.y
  Snh_interp.u = time
  port.Snh = Snh_interp.y
  Snd_interp.u = time
  port.Snd = Snd_interp.y
  Xnd_interp.u = time
  port.Xnd = Xnd_interp.y
  Salk_interp.u = time
  port.Salk = Salk_interp.y
metadata {
  "Dyad": {
    "labels": [{"label": "$(instance)", "x": 500, "y": 150, "rot": 0, "layer": "icon"}],
    "icons": {"default": "dyad://ASPDemo/WWSource.svg"}
  },
  "_links": {
    "port": {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 800, "x2": 1050, "y2": 900}}}}
  }
}
end

# A test model for a file based source and sink
test component TestFlowSourceFileSink
  source = FlowSourceFile()
  sink = EffluentSink()
relations
  connect(source.port, sink.port)
metadata {
  "Dyad": {
    "tests": {
      "case1": {
        "stop": 1,
        "expect": {"signals": ["source.port.m_flow", "source.port.h_outflow"]}
      }
    }
  }
}
end