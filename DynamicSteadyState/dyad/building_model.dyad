"""
Three-Zone Commercial Office Building — Single Source of Truth

This file defines ONE building model (ThreeZoneBuilding) and applies
TWO different analyses to it:

  1. SteadyStateAnalysis  →  HVAC equipment sizing at design-day conditions
  2. TransientAnalysis    →  24-hour diurnal operation with thermostat control

Both analyses share the exact same thermal network, zone capacitances,
envelope resistances, and HVAC controller logic. Only the boundary
conditions differ (fixed vs. time-varying), demonstrating that Dyad
supports dynamic and steady-state workflows on a single source of truth.

The occupancy schedule is a representative weekday office profile with
  piecewise-linear interpolation between hourly breakpoints (fractions 0–1).
"""
component HeatCapacitorNoInit
  # ================================================================
  # HeatCapacitorNoInit — HeatCapacitor without built-in initial condition
  #
  # Identical to ThermalComponents.HeatCapacitor but omits
  # "initial T = T0", allowing the test harness to supply initial
  # conditions for transient analysis while leaving the steady-state
  # analysis free of over-determined initialization constraints.
  # ================================================================
  "Thermal port for heat exchange"
  port = HeatPort() {^port}
  "Heat capacity of the element (J/K)"
  parameter C::HeatCapacity
  "Temperature of the element"
  variable T::Temperature
  "Time derivative of temperature"
  variable dT::TemperatureSlope
relations
  T = port.T
  der(T) = dT
  dT = port.Q_flow / C
metadata {
  "Dyad": {
    "labels": [{"label": "$(instance)", "x": 500, "y": 1100, "rot": 0}],
    "icons": {"default": "dyad://ThermalComponents/HeatCapacitor.svg"}
  },
  "_links": {
    "port": {"Dyad": {"placement": {"icon": {"x1": 450, "y1": 950, "x2": 550, "y2": 1050}}}}
  }
}
end

component ThermostatHeater
  # ================================================================
  # Proportional thermostat heater (reusable subcomponent)
  # ================================================================
  "Thermal port — connects to the zone port"
  port = HeatPort() {^port}
  "Proportional gain (W/K)"
  parameter K::Real = 500.0
  "Heating setpoint temperature"
  parameter T_set::Temperature = 294.15
  "Maximum heating capacity (W)"
  parameter Q_max::HeatFlowRate = 5000.0
  "Raw proportional demand (W)"
  variable Q_raw::HeatFlowRate
  "Delivered heating power (W, 0 ≤ Q ≤ Q_max)"
  variable Q_delivered::HeatFlowRate
relations
  Q_raw = K * (T_set - port.T)
  Q_delivered = ifelse(Q_raw > Q_max, Q_max, ifelse(Q_raw < 0.0, 0.0, Q_raw))
  port.Q_flow = -Q_delivered
metadata {
  "Dyad": {"icons": {"default": "dyad://DynamicSteadyState/icon_thermostat_heater.svg"}},
  "_links": {
    "port": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 450, "y1": 950, "x2": 550, "y2": 1050, "rot": 0}
        },
        "tags": []
      }
    }
  }
}
end

# ================================================================
# ZoneRoom — Lumped single-zone thermal model
#
# Encapsulates per-zone envelope (wall, window, roof, slab,
# infiltration) and thermal mass into one reusable passive block.
# Set R_wall or R_win to a large value (e.g. 1e6) for interior
# zones with no exterior wall/window.
#
# Outdoor and ground temperatures enter as causal signal inputs
# (RealInput), converted internally via PrescribedTemperature.
# The zone_port is the single acausal Node port for HVAC,
# gains, and inter-zone connections.
# ================================================================
component ZoneRoom
  "Outdoor temperature signal (K)"
  T_outdoor = RealInput() {^T_outdoor}
  "Ground temperature signal (K)"
  T_ground = RealInput() {^T_ground}
  "Zone port — connect HVAC, gains, and inter-zone partitions here"
  zone_port = HeatPort() {^zone_port}
  # ---- Internal boundary condition sources ----
  outdoor_src = ThermalComponents.Sources.PrescribedTemperature() {^outdoor_src}
  ground_src = ThermalComponents.Sources.PrescribedTemperature() {^ground_src}
  # ---- Envelope resistors ----
  wall = ThermalComponents.Components.ThermalResistor(R = R_wall) {^wall}
  win = ThermalComponents.Components.ThermalResistor(R = R_win) {^win}
  roof = ThermalComponents.Components.ThermalResistor(R = R_roof) {^roof}
  slab = ThermalComponents.Components.ThermalResistor(R = R_slab) {^slab}
  infil = ThermalComponents.Components.ThermalResistor(R = R_infil) {^infil}
  cap = HeatCapacitorNoInit(C = C) {^cap}
  # ---- Envelope thermal resistances ----
  parameter R_wall::ThermalResistance = 0.01
  parameter R_win::ThermalResistance = 0.015
  parameter R_roof::ThermalResistance = 0.025
  parameter R_slab::ThermalResistance = 0.05
  parameter R_infil::ThermalResistance = 0.0333
  # ---- Zone thermal mass ----
  parameter C::HeatCapacity = 400000.0
relations
  # Signal inputs drive internal prescribed temperature sources
  connect(T_outdoor, outdoor_src.T) {^id12}
  connect(T_ground, ground_src.T) {^id13}
  # Outdoor source → envelope resistors
  connect(outdoor_src.port, wall.port_a, win.port_a, roof.port_a, infil.port_a) {^id14}
  # Ground source → slab
  connect(ground_src.port, slab.port_a) {^id15}
  # Zone port: all resistor b-sides, capacitor, zone port
  connect(wall.port_b, win.port_b, roof.port_b, slab.port_b, infil.port_b, cap.port, zone_port) {^id16}
metadata {
