# ================================================================
# ANALYSIS 1b: Cold-Night HVAC Sizing
#
# Unoccupied cold-night conditions (worst-case heating demand):
#   Outdoor = −10°C, Ground = 10°C
#   No internal gains, no solar gains (nighttime)
#
# Same building, same setpoint — only boundary conditions differ.
# Equipment must be sized to the maximum of design-day and cold-night
# demand per zone: Q_max = max(design-day, cold-night) × safety factor.
# ================================================================
test component TestColdNightSizing
  building = ThreeZoneBuilding() {^building}
  # ---- Boundary condition signals ----
  outdoor_signal = BlockComponents.Sources.Constant(k = 263.15) {^outdoor_signal}
  ground_signal = BlockComponents.Sources.Constant(k = 283.15) {^ground_signal}
  # ---- Zone temperature setpoints (FixedTemperature at 21°C) ----
  zone1_setpoint = ThermalComponents.Sources.FixedTemperature(T = 294.15) {^zone1_setpoint}
  zone2_setpoint = ThermalComponents.Sources.FixedTemperature(T = 294.15) {^zone2_setpoint}
  zone3_setpoint = ThermalComponents.Sources.FixedTemperature(T = 294.15) {^zone3_setpoint}
relations
  connect(outdoor_signal.y, building.T_outdoor) {^id7}
  connect(ground_signal.y, building.T_ground) {^id8}
  connect(zone1_setpoint.port, building.zone1_port) {^id9}
  connect(zone2_setpoint.port, building.zone2_port) {^id10}
  connect(zone3_setpoint.port, building.zone3_port) {^id11}
metadata {
  "Dyad": {
    "experiments": {},
    "tests": {},
    "labels": [
      {
        "label": "Cold Night Sizing Analysis",
        "x": 630,
        "y": 80,
        "rot": 0,
