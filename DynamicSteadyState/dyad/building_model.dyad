# ================================================================
# THE SOURCE OF TRUTH: Three-Zone Building Envelope
#
# Three ZoneRoom blocks connected by partition resistors.
# Outdoor and ground temperatures enter as causal RealInput
# signals, eliminating two acausal Node ports and reducing
# diagram wiring. HVAC strategy is external to this model.
# ================================================================
component ThreeZoneBuilding
  "Outdoor temperature signal (K)"
  T_outdoor = RealInput() {^T_outdoor}
  "Ground temperature signal (K)"
  T_ground = RealInput() {^T_ground}
  "Zone 1 (South) port — connect HVAC, gains, and external loads here"
  zone1_port = HeatPort() {^zone1_port}
  "Zone 2 (Core) port"
  zone2_port = HeatPort() {^zone2_port}
  "Zone 3 (North) port"
  zone3_port = HeatPort() {^zone3_port}
  # ==== Three rooms ====
  z1 = ZoneRoom(R_wall = 0.01, R_win = 0.015, R_roof = 0.025, R_slab = 0.05, R_infil = 0.0333, C = 400000.0) {^z1}
  z2 = ZoneRoom(R_wall = 1e6, R_win = 1e6, R_roof = 0.025, R_slab = 0.05, R_infil = 0.0667, C = 300000.0) {^z2}
  z3 = ZoneRoom(R_wall = 0.01, R_win = 0.02, R_roof = 0.025, R_slab = 0.05, R_infil = 0.0333, C = 400000.0) {^z3}
  # ==== Inter-zone partitions ====
  partition12 = ThermalComponents.Components.ThermalResistor(R = 0.01) {^partition12}
  partition23 = ThermalComponents.Components.ThermalResistor(R = 0.01) {^partition23}
relations
  # Outdoor and ground signals fan out to each zone
  connect(T_ground, z1.T_ground, z2.T_ground, z3.T_ground) {^id11}
  connect(z2.zone_port, zone2_port, partition23.port_a, partition12.port_b) {^id12}
  connect(T_outdoor, z1.T_outdoor, z2.T_outdoor, z3.T_outdoor) {^id13}
  connect(z1.zone_port, zone1_port, partition12.port_a) {^id14}
  connect(z3.zone_port, zone3_port, partition23.port_b) {^id15}
metadata {
  "Dyad": {"icons": {"default": "dyad://DynamicSteadyState/icon_three_zone_building.svg"}},
  "_links": {
    "T_outdoor": {
