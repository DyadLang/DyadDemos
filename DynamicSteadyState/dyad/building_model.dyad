# ================================================================
# ANALYSIS 1a: Design-Day HVAC Sizing
#
# Occupied design-day winter conditions:
#   Outdoor = −5°C, Ground = 10°C
#   Internal gains = peak occupancy values (600, 500, 400 W)
#   Solar gains = design average (1500 W south, 375 W north)
#
# FixedTemperature boundary conditions at 21°C (294.15 K) on each
# HVAC port impose the desired zone temperature directly. The solver
# determines the heat flow Q through each port — this IS the
# required HVAC capacity. No controller or equipment model is needed.
# ================================================================
test component TestSteadySizing
  building = ThreeZoneBuilding() {^building}
  # ---- Boundary condition signals ----
  outdoor_signal = BlockComponents.Sources.Constant(k = 268.15) {^outdoor_signal}
  ground_signal = BlockComponents.Sources.Constant(k = 283.15) {^ground_signal}
  # ---- Internal and solar gains ----
  int1 = ThermalComponents.Sources.FixedHeatFlow(Q_flow = 600.0) {^int1}
  int2 = ThermalComponents.Sources.FixedHeatFlow(Q_flow = 500.0) {^int2}
  int3 = ThermalComponents.Sources.FixedHeatFlow(Q_flow = 400.0) {^int3}
  solar1 = ThermalComponents.Sources.FixedHeatFlow(Q_flow = 1500.0) {^solar1}
  solar3 = ThermalComponents.Sources.FixedHeatFlow(Q_flow = 375.0) {^solar3}
  # ---- Zone temperature setpoints (FixedTemperature at 21°C) ----
  zone1_setpoint = ThermalComponents.Sources.FixedTemperature(T = 294.15) {^zone1_setpoint}
  zone2_setpoint = ThermalComponents.Sources.FixedTemperature(T = 294.15) {^zone2_setpoint}
  zone3_setpoint = ThermalComponents.Sources.FixedTemperature(T = 294.15) {^zone3_setpoint}
relations
  connect(outdoor_signal.y, building.T_outdoor) {^id12}
  connect(ground_signal.y, building.T_ground) {^id13}
  connect(int1.port, solar1.port, zone1_setpoint.port, building.zone1_port) {^id14}
  connect(int2.port, zone2_setpoint.port, building.zone2_port) {^id15}
  connect(int3.port, solar3.port, zone3_setpoint.port, building.zone3_port) {^id16}
metadata {
