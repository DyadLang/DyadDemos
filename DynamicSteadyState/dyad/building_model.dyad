# ================================================================
# Representative Weekday Office Occupancy Schedule
# Piecewise linear interpolation of hourly fractions (0–1)
# ================================================================
component OfficeOccupancy
  "Occupancy fraction output (0–1)"
  y = RealOutput() {^y}
  variable occ::Real
relations
  occ = ifelse(time < 18000.0, 0.0, ifelse(time < 21600.0, (time - 18000.0) * 2.7778e-5, ifelse(time < 25200.0, 0.10 + (time - 21600.0) * 2.7778e-5, ifelse(time < 28800.0, 0.20 + (time - 25200.0) * 2.0833e-4, ifelse(time < 39600.0, 0.95, ifelse(time < 43200.0, 0.95 - (time - 39600.0) * 1.25e-4, ifelse(time < 46800.0, 0.50 + (time - 43200.0) * 1.25e-4, ifelse(time < 57600.0, 0.95, ifelse(time < 61200.0, 0.95 - (time - 57600.0) * 1.8056e-4, ifelse(time < 64800.0, 0.30 - (time - 61200.0) * 5.5556e-5, ifelse(time < 75600.0, 0.10, ifelse(time < 79200.0, 0.10 - (time - 75600.0) * 1.3889e-5, ifelse(time < 82800.0, 0.05, ifelse(time < 86400.0, 0.05 - (time - 82800.0) * 1.3889e-5, 0.0))))))))))))))
  y = occ
metadata {
  "Dyad": {"icons": {"default": "dyad://DynamicSteadyState/icon_office_occupancy.svg"}},
  "_links": {
    "y": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 950, "y1": 460, "x2": 1050, "y2": 560, "rot": 0}
        },
        "tags": []
      }
    }
  }
}
end

# ================================================================
# ANALYSIS 2: 24-Hour Diurnal Operation
#
# Same ThreeZoneBuilding, now with time-varying boundary conditions:
#   Outdoor = sinusoidal diurnal cycle (−10°C to 0°C)
#   Solar = sinusoidal, peaks at noon (south 0–3000 W, north 0–750 W)
#   Internal gains = occupancy fraction × peak watts
#
# ThermostatHeater controllers are attached at the test harness
# level. Q_max = max(design-day, cold-night) × 1.2 safety factor:
#   Z1 = max(4274, 7558) × 1.2 = 7558 × 1.2 ≈ 9070 W  (cold night governs)
#   Z2 = max(1150, 1925) × 1.2 = 1925 × 1.2 ≈ 2310 W  (cold night governs)
#   Z3 = max(5166, 7041) × 1.2 = 7041 × 1.2 ≈ 8450 W  (cold night governs)
# ================================================================
test component TestDiurnalOperation
  building = ThreeZoneBuilding() {^building}
  # ---- Outdoor temperature (diurnal sine) — connects directly as signal ----
  outdoor_signal = BlockComponents.Sources.Sine(amplitude = 5.0, frequency = 1.1574e-5, phase = -1.5708, offset = 268.15) {^outdoor_signal}
  # ---- Ground (stable year-round) ----
  ground_signal = BlockComponents.Sources.Constant(k = 283.15) {^ground_signal}
  # ---- Representative office occupancy schedule ----
  occ_schedule = OfficeOccupancy() {^occ_schedule}
  # ---- Solar gains (sine, peaks at noon) ----
  solar_south = BlockComponents.Sources.Sine(amplitude = 1500.0, frequency = 1.1574e-5, phase = -1.5708, offset = 1500.0) {^solar_south}
  solar_north = BlockComponents.Sources.Sine(amplitude = 375.0, frequency = 1.1574e-5, phase = -1.5708, offset = 375.0) {^solar_north}
  # ---- Internal gains = occupancy × peak watts ----
  int1_scale = BlockComponents.Math.Gain(k = 600.0) {^int1_scale}
  int1_source = ThermalComponents.Sources.PrescribedHeatFlow() {^int1_source}
  int2_scale = BlockComponents.Math.Gain(k = 500.0) {^int2_scale}
  int2_source = ThermalComponents.Sources.PrescribedHeatFlow() {^int2_source}
  int3_scale = BlockComponents.Math.Gain(k = 400.0) {^int3_scale}
  int3_source = ThermalComponents.Sources.PrescribedHeatFlow() {^int3_source}
  # ---- Solar thermal sources ----
  solar1_source = ThermalComponents.Sources.PrescribedHeatFlow() {^solar1_source}
  solar3_source = ThermalComponents.Sources.PrescribedHeatFlow() {^solar3_source}
  # ---- HVAC thermostat controllers (capacity = max(design-day, cold-night) × 1.2) ----
  hvac1 = ThermostatHeater(K = 5000.0, T_set = 294.15, Q_max = 9070.0) {^hvac1}
  hvac2 = ThermostatHeater(K = 5000.0, T_set = 294.15, Q_max = 2310.0) {^hvac2}
  hvac3 = ThermostatHeater(K = 5000.0, T_set = 294.15, Q_max = 8450.0) {^hvac3}
relations
  # Boundary condition signals → building
  connect(outdoor_signal.y, building.T_outdoor) {^id18}
  connect(ground_signal.y, building.T_ground) {^id19}
  # Occupancy → gain scaling → heat sources
  connect(occ_schedule.y, int1_scale.u) {^id20}
  connect(occ_schedule.y, int2_scale.u) {^id21}
  connect(occ_schedule.y, int3_scale.u) {^id22}
  connect(int1_scale.y, int1_source.Q_flow) {^id23}
  connect(int2_scale.y, int2_source.Q_flow) {^id24}
  connect(int3_scale.y, int3_source.Q_flow) {^id25}
  # Solar → heat sources
  connect(solar_south.y, solar1_source.Q_flow) {^id26}
  connect(solar_north.y, solar3_source.Q_flow) {^id27}
  # Heat sources + HVAC controllers → building zone ports
  connect(int1_source.port, solar1_source.port, hvac1.port, building.zone1_port) {^id28}
  connect(int2_source.port, hvac2.port, building.zone2_port) {^id29}
  connect(int3_source.port, solar3_source.port, hvac3.port, building.zone3_port) {^id30}
  # Initial zone temperatures (cold-start at 12°C)
  initial building.z1.cap.T = 285.15
  initial building.z2.cap.T = 285.15
  initial building.z3.cap.T = 285.15
metadata {
