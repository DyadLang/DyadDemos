"""
Three-Zone Commercial Office Building — Single Source of Truth

This file defines ONE building model (ThreeZoneBuilding) and applies
TWO different analyses to it:

  1. SteadyStateAnalysis  →  HVAC equipment sizing at design-day conditions
  2. TransientAnalysis    →  24-hour diurnal operation with thermostat control

Both analyses share the exact same thermal network, zone capacitances,
envelope resistances, and HVAC controller logic. Only the boundary
conditions differ (fixed vs. time-varying), demonstrating that Dyad
supports dynamic and steady-state workflows on a single source of truth.

The occupancy schedule is a representative weekday office profile with
  piecewise-linear interpolation between hourly breakpoints (fractions 0–1).
"""
component HeatCapacitorNoInit
  # Omits HeatCapacitor's `initial T = T0`, which would over-determine the steady-state solve.
  # The transient harness supplies its own starting temperature.
  "Thermal port for heat exchange"
  node = HeatPort() {"Dyad": {"placement": {"icon": {"x1": 450, "y1": 950, "x2": 550, "y2": 1050}}}}
  "Heat capacity of the element (J/K)"
  parameter C::HeatCapacity
  "Temperature of the element"
  variable T::Temperature
  "Time derivative of temperature"
  variable dT::TemperatureSlope
relations
  T = node.T
  der(T) = dT
  dT = node.Q_flow / C
metadata {
  "Dyad": {
    "labels": [{"label": "$(instance)", "x": 500, "y": 1100, "rot": 0}],
    "icons": {"default": "dyad://ThermalComponents/HeatCapacitor.svg"}
  }
}
end

component ThermostatHeater
  "Thermal port — connects to the zone node"
  node = HeatPort() {
    "Dyad": {
      "placement": {
        "diagram": {"iconName": "default", "x1": 450, "y1": 950, "x2": 550, "y2": 1050, "rot": 0}
      },
      "tags": []
    }
  }
  "Proportional gain (W/K)"
  parameter K::Real = 500.0
  "Heating setpoint temperature"
  parameter T_set::Temperature = 294.15
  "Maximum heating capacity (W)"
  parameter Q_max::HeatFlowRate = 5000.0
  "Raw proportional demand (W)"
  variable Q_raw::HeatFlowRate
  "Delivered heating power (W, 0 ≤ Q ≤ Q_max)"
  variable Q_delivered::HeatFlowRate
relations
  Q_raw = K * (T_set - node.T)
  Q_delivered = ifelse(Q_raw > Q_max, Q_max, ifelse(Q_raw < 0.0, 0.0, Q_raw))
  node.Q_flow = -Q_delivered
metadata {
  "Dyad": {"icons": {"default": "dyad://DynamicSteadyState/icon_thermostat_heater.svg"}}
}
end

# Set R_wall or R_win to 1e6 for an interior zone; that removes the exterior path.
component ZoneRoom
  "Outdoor temperature signal (K)"
  T_outdoor = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 200, "x2": 50, "y2": 300},
        "diagram": {"x1": -50, "y1": 450, "x2": 50, "y2": 550}
      }
    }
  }
  "Ground temperature signal (K)"
  T_ground = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 700, "x2": 50, "y2": 800},
        "diagram": {"x1": -50, "y1": 1050, "x2": 50, "y2": 1150}
      }
    }
  }
  "Zone port — connect HVAC, gains, and inter-zone partitions here"
  zone_port = HeatPort() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550},
        "diagram": {"x1": 1250, "y1": 600, "x2": 1350, "y2": 700}
      }
    }
  }
  # ---- Internal boundary condition sources ----
  outdoor_src = ThermalComponents.Sources.PrescribedTemperature() {
    "Dyad": {"placement": {"diagram": {"x1": 200, "y1": 450, "x2": 300, "y2": 550}}}
  }
  ground_src = ThermalComponents.Sources.PrescribedTemperature() {
    "Dyad": {"placement": {"diagram": {"x1": 200, "y1": 1050, "x2": 300, "y2": 1150}}}
  }
  # ---- Envelope resistors ----
  wall = ThermalComponents.Components.ThermalResistor(R = R_wall) {
    "Dyad": {"placement": {"diagram": {"x1": 650, "y1": 150, "x2": 750, "y2": 250}}}
  }
  win = ThermalComponents.Components.ThermalResistor(R = R_win) {
    "Dyad": {"placement": {"diagram": {"x1": 650, "y1": 350, "x2": 750, "y2": 450}}}
  }
  roof = ThermalComponents.Components.ThermalResistor(R = R_roof) {
    "Dyad": {"placement": {"diagram": {"x1": 650, "y1": 550, "x2": 750, "y2": 650}}}
  }
  slab = ThermalComponents.Components.ThermalResistor(R = R_slab) {
    "Dyad": {"placement": {"diagram": {"x1": 650, "y1": 1050, "x2": 750, "y2": 1150}}}
  }
  infil = ThermalComponents.Components.ThermalResistor(R = R_infil) {
    "Dyad": {"placement": {"diagram": {"x1": 650, "y1": 750, "x2": 750, "y2": 850}}}
  }
  cap = HeatCapacitorNoInit(C = C) {
    "Dyad": {"placement": {"diagram": {"x1": 1000, "y1": 250, "x2": 1100, "y2": 350}}}
  }
  # ---- Envelope thermal resistances ----
  parameter R_wall::ThermalResistance = 0.01
  parameter R_win::ThermalResistance = 0.015
  parameter R_roof::ThermalResistance = 0.025
  parameter R_slab::ThermalResistance = 0.05
  parameter R_infil::ThermalResistance = 0.0333
  # ---- Zone thermal mass ----
  parameter C::HeatCapacity = 400000.0
relations
  # Signal inputs drive internal prescribed temperature sources
  connect(T_outdoor, outdoor_src.T) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(T_ground, ground_src.T) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  # Outdoor source → envelope resistors
  connect(outdoor_src.port, wall.port_a, win.port_a, roof.port_a, infil.port_a) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [], "E": -1},
        {"S": 2, "M": [{"x": 500, "y": 200}], "E": -1},
        {"S": 3, "M": [{"x": 500, "y": 400}], "E": -1},
        {"S": 4, "M": [{"x": 500, "y": 600}], "E": -1},
        {"S": 5, "M": [{"x": 500, "y": 800}], "E": -1}
      ],
      "junctions": [{"x": 500, "y": 500}],
      "path": {}
    }
  }
  # Ground source → slab
  connect(ground_src.port, slab.port_a) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  # Zone node: all resistor b-sides, capacitor, zone port
  connect(wall.port_b, win.port_b, roof.port_b, slab.port_b, infil.port_b, cap.node, zone_port) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [{"x": 900, "y": 200}], "E": -1},
        {"S": 2, "M": [{"x": 900, "y": 400}], "E": -1},
        {"S": 3, "M": [{"x": 900, "y": 600}], "E": -1},
        {"S": 4, "M": [{"x": 900, "y": 1100}], "E": -1},
        {"S": 5, "M": [{"x": 900, "y": 800}], "E": -1},
        {"S": 6, "M": [{"x": 1050, "y": 650}], "E": -1},
        {"S": 7, "M": [], "E": -1}
      ],
      "junctions": [{"x": 900, "y": 650}],
      "path": {}
    }
  }
metadata {"Dyad": {"icons": {"default": "dyad://DynamicSteadyState/icon_zone_room.svg"}}}
end

"""
The building: three zones joined by partition resistors, and the single source of truth every
analysis reuses. HVAC strategy lives outside this model, which is what makes that reuse possible.
"""
component ThreeZoneBuilding
  "Outdoor temperature signal (K)"
  T_outdoor = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 700, "x2": 50, "y2": 800},
        "diagram": {"x1": -50, "y1": 100, "x2": 50, "y2": 200}
      }
    }
  }
  "Ground temperature signal (K)"
  T_ground = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 200, "x2": 50, "y2": 300},
        "diagram": {"x1": -50, "y1": 1000, "x2": 50, "y2": 1100}
      }
    }
  }
  "Zone 1 (South) port — connect HVAC, gains, and external loads here"
  zone1_port = HeatPort() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 200, "x2": 1050, "y2": 300},
        "diagram": {"x1": 1050, "y1": 150, "x2": 1150, "y2": 250}
      }
    }
  }
  "Zone 2 (Core) port"
  zone2_port = HeatPort() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550},
        "diagram": {"x1": 1050, "y1": 550, "x2": 1150, "y2": 650}
      }
    }
  }
  "Zone 3 (North) port"
  zone3_port = HeatPort() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 700, "x2": 1050, "y2": 800},
        "diagram": {"x1": 1050, "y1": 950, "x2": 1150, "y2": 1050}
      }
    }
  }
  # ==== Three rooms ====
  z1 = ZoneRoom(R_wall = 0.01, R_win = 0.015, R_roof = 0.025, R_slab = 0.05, R_infil = 0.0333, C = 400000.0) {
    "Dyad": {
      "placement": {
        "diagram": {"iconName": "default", "x1": 400, "y1": 100, "x2": 600, "y2": 300, "rot": 0}
      },
      "tags": []
    }
  }
  z2 = ZoneRoom(R_wall = 1e6, R_win = 1e6, R_roof = 0.025, R_slab = 0.05, R_infil = 0.0667, C = 300000.0) {
    "Dyad": {"placement": {"diagram": {"x1": 400, "y1": 500, "x2": 600, "y2": 700}}}
  }
  z3 = ZoneRoom(R_wall = 0.01, R_win = 0.02, R_roof = 0.025, R_slab = 0.05, R_infil = 0.0333, C = 400000.0) {
    "Dyad": {"placement": {"diagram": {"x1": 400, "y1": 900, "x2": 600, "y2": 1100}}}
  }
  # ==== Inter-zone partitions ====
  partition12 = ThermalComponents.Components.ThermalResistor(R = 0.01) {
    "Dyad": {"placement": {"diagram": {"x1": 750, "y1": 350, "x2": 850, "y2": 450}}}
  }
  partition23 = ThermalComponents.Components.ThermalResistor(R = 0.01) {
    "Dyad": {"placement": {"diagram": {"x1": 750, "y1": 750, "x2": 850, "y2": 850}}}
  }
relations
  # Outdoor and ground signals fan out to each zone
  connect(T_ground, z1.T_ground, z2.T_ground, z3.T_ground) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [], "E": -1},
        {"S": 2, "M": [{"x": 300, "y": 250}], "E": -1},
        {"S": 3, "M": [{"x": 300, "y": 650}], "E": -1},
        {"S": 4, "M": [], "E": -1}
      ],
      "junctions": [{"x": 300, "y": 1050}],
      "path": {}
    }
  }
  connect(z2.zone_port, zone2_port, partition23.port_a, partition12.port_b) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [], "E": -1},
        {"S": 2, "M": [], "E": -1},
        {"S": 3, "M": [{"x": 700, "y": 800}], "E": -1},
        {"S": 4, "M": [{"x": 900, "y": 400}, {"x": 900, "y": 600}], "E": -1}
      ],
      "junctions": [{"x": 700, "y": 600}],
      "path": {}
    }
  }
  connect(T_outdoor, z1.T_outdoor, z2.T_outdoor, z3.T_outdoor) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [], "E": -1},
        {"S": 2, "M": [], "E": -1},
        {"S": 3, "M": [{"x": 350, "y": 550}], "E": -1},
        {"S": 4, "M": [{"x": 350, "y": 950}], "E": -1}
      ],
      "junctions": [{"x": 350, "y": 150}],
      "path": {}
    }
  }
  connect(z1.zone_port, zone1_port, partition12.port_a) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [], "E": -1},
        {"S": 2, "M": [], "E": -1},
        {"S": 3, "M": [{"x": 700, "y": 400}], "E": -1}
      ],
      "junctions": [{"x": 700, "y": 200}],
      "path": {}
    }
  }
  connect(z3.zone_port, zone3_port, partition23.port_b) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [], "E": -1},
        {"S": 2, "M": [], "E": -1},
        {"S": 3, "M": [{"x": 900, "y": 800}], "E": -1}
      ],
      "junctions": [{"x": 900, "y": 1000}],
      "path": {}
    }
  }
metadata {
  "Dyad": {"icons": {"default": "dyad://DynamicSteadyState/icon_three_zone_building.svg"}}
}
end

# Pinning every zone port at the 21 °C setpoint and reading back the port heat flow gives the
# required HVAC capacity directly, with no controller or equipment model in the loop.
test component TestSteadySizing
  building = ThreeZoneBuilding() {
    "Dyad": {"placement": {"diagram": {"x1": 800, "y1": 600, "x2": 1200, "y2": 1000}}}
  }
  # ---- Boundary condition signals ----
  outdoor_signal = BlockComponents.Sources.Constant(k = 268.15) {
    "Dyad": {"placement": {"diagram": {"x1": 450, "y1": 850, "x2": 550, "y2": 950}}}
  }
  ground_signal = BlockComponents.Sources.Constant(k = 283.15) {
    "Dyad": {"placement": {"diagram": {"x1": 450, "y1": 650, "x2": 550, "y2": 750}}}
  }
  # ---- Internal and solar gains ----
  int1 = ThermalComponents.Sources.FixedHeatFlow(Q_flow = 600.0) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "y1": 200, "x2": 650, "y2": 300}}}
  }
  int2 = ThermalComponents.Sources.FixedHeatFlow(Q_flow = 500.0) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "y1": 1550, "x2": 650, "y2": 1650}}}
  }
  int3 = ThermalComponents.Sources.FixedHeatFlow(Q_flow = 400.0) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "y1": 1250, "x2": 650, "y2": 1350}}}
  }
  solar1 = ThermalComponents.Sources.FixedHeatFlow(Q_flow = 1500.0) {
    "Dyad": {"placement": {"diagram": {"x1": 750, "y1": 200, "x2": 850, "y2": 300}}}
  }
  solar3 = ThermalComponents.Sources.FixedHeatFlow(Q_flow = 375.0) {
    "Dyad": {"placement": {"diagram": {"x1": 750, "y1": 1250, "x2": 850, "y2": 1350}}}
  }
  # ---- Zone temperature setpoints (FixedTemperature at 21°C) ----
  zone1_setpoint = ThermalComponents.Sources.FixedTemperature(T = 294.15) {
    "Dyad": {"placement": {"diagram": {"x1": 950, "y1": 200, "x2": 1050, "y2": 300}}}
  }
  zone2_setpoint = ThermalComponents.Sources.FixedTemperature(T = 294.15) {
    "Dyad": {"placement": {"diagram": {"x1": 750, "y1": 1550, "x2": 850, "y2": 1650}}}
  }
  zone3_setpoint = ThermalComponents.Sources.FixedTemperature(T = 294.15) {
    "Dyad": {"placement": {"diagram": {"x1": 950, "y1": 1250, "x2": 1050, "y2": 1350}}}
  }
relations
  connect(outdoor_signal.y, building.T_outdoor) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(ground_signal.y, building.T_ground) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(int1.port, solar1.port, zone1_setpoint.port, building.zone1_port) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [{"x": 700, "y": 250}, {"x": 700, "y": 400}], "E": -1},
        {"S": 2, "M": [{"x": 900, "y": 250}, {"x": 900, "y": 400}], "E": -1},
        {"S": 3, "M": [{"x": 1300, "y": 250}], "E": -1},
        {"S": 4, "M": [{"x": 1300, "y": 700}], "E": -1}
      ],
      "junctions": [{"x": 1300, "y": 400}],
      "path": {}
    }
  }
  connect(int2.port, zone2_setpoint.port, building.zone2_port) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [{"x": 700, "y": 1600}, {"x": 700, "y": 1450}], "E": -1},
        {"S": 2, "M": [{"x": 1400, "y": 1600}], "E": -1},
        {"S": 3, "M": [{"x": 1400, "y": 800}], "E": -1}
      ],
      "junctions": [{"x": 1400, "y": 1450}],
      "path": {}
    }
  }
  connect(int3.port, solar3.port, zone3_setpoint.port, building.zone3_port) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [{"x": 700, "y": 1300}, {"x": 700, "y": 1150}], "E": -1},
        {"S": 2, "M": [{"x": 900, "y": 1300}, {"x": 900, "y": 1150}], "E": -1},
        {"S": 3, "M": [{"x": 1300, "y": 1300}], "E": -1},
        {"S": 4, "M": [{"x": 1300, "y": 900}], "E": -1}
      ],
      "junctions": [{"x": 1300, "y": 1150}],
      "path": {}
    }
  }
metadata {
  "Dyad": {
    "experiments": {},
    "tests": {},
    "labels": [
      {
        "label": "Design Day Sizing Analysis",
        "x": 925,
        "y": 100,
        "rot": 0,
        "layer": "diagram",
        "attrs": {
          "fill": "black",
          "font-size": "20",
          "dominant-baseline": "central",
          "text-anchor": "middle"
        }
      }
    ],
    "icons": {"default": "dyad://Dyad/Default.svg"},
    "path": {},
    "doc": {"behavior": true}
  }
}
end

analysis HVACSizing
  extends SteadyStateAnalysis()
  model = TestSteadySizing()
relations
end

# Worst case for heating: an unoccupied cold night, with no internal or solar gains to help.
# Each zone's equipment is sized to whichever of the two sizing solves demands more.
test component TestColdNightSizing
  building = ThreeZoneBuilding() {
    "Dyad": {"placement": {"diagram": {"x1": 800, "y1": 600, "x2": 1200, "y2": 1000}}}
  }
  # ---- Boundary condition signals ----
  outdoor_signal = BlockComponents.Sources.Constant(k = 263.15) {
    "Dyad": {"placement": {"diagram": {"x1": 450, "y1": 850, "x2": 550, "y2": 950}}}
  }
  ground_signal = BlockComponents.Sources.Constant(k = 283.15) {
    "Dyad": {"placement": {"diagram": {"x1": 450, "y1": 650, "x2": 550, "y2": 750}}}
  }
  # ---- Zone temperature setpoints (FixedTemperature at 21°C) ----
  zone1_setpoint = ThermalComponents.Sources.FixedTemperature(T = 294.15) {
    "Dyad": {"placement": {"diagram": {"x1": 950, "y1": 350, "x2": 1050, "y2": 450}}}
  }
  zone2_setpoint = ThermalComponents.Sources.FixedTemperature(T = 294.15) {
    "Dyad": {"placement": {"diagram": {"x1": 750, "y1": 1450, "x2": 850, "y2": 1550}}}
  }
  zone3_setpoint = ThermalComponents.Sources.FixedTemperature(T = 294.15) {
    "Dyad": {"placement": {"diagram": {"x1": 950, "y1": 1200, "x2": 1050, "y2": 1300}}}
  }
relations
  connect(outdoor_signal.y, building.T_outdoor) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(ground_signal.y, building.T_ground) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(zone1_setpoint.port, building.zone1_port) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 1250, "y": 400}, {"x": 1250, "y": 700}], "E": 2}],
      "path": {}
    }
  }
  connect(zone2_setpoint.port, building.zone2_port) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 1300, "y": 1500}, {"x": 1300, "y": 800}], "E": 2}],
      "path": {}
    }
  }
  connect(zone3_setpoint.port, building.zone3_port) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 1250, "y": 1250}, {"x": 1250, "y": 900}], "E": 2}],
      "path": {}
    }
  }
metadata {
  "Dyad": {
    "experiments": {},
    "tests": {},
    "labels": [
      {
        "label": "Cold Night Sizing Analysis",
        "x": 875,
        "y": 270,
        "rot": 0,
        "layer": "diagram",
        "attrs": {
          "fill": "black",
          "font-size": "20",
          "dominant-baseline": "central",
          "text-anchor": "middle"
        }
      }
    ],
    "icons": {"default": "dyad://Dyad/Default.svg"},
    "path": {},
    "doc": {"behavior": true}
  }
}
end

analysis ColdNightSizing
  extends SteadyStateAnalysis()
  model = TestColdNightSizing()
relations
end

"""
Occupancy fraction for a representative weekday office, 0 (empty) to 1 (full).
"""
component OfficeOccupancy
  "Occupancy fraction output (0–1)"
  y = RealOutput() {
    "Dyad": {
      "placement": {
        "diagram": {"iconName": "default", "x1": 950, "y1": 460, "x2": 1050, "y2": 560, "rot": 0}
      },
      "tags": []
    }
  }
  variable occ::Real
relations
  # Weekday office profile, `time` in seconds from midnight. One segment per line; each ramps
  # linearly from the previous segment's end value to the fraction named beside it.
  occ =
    ifelse(time < 18000.0, 0.0,                                            # to 05:00, empty
    ifelse(time < 21600.0, (time - 18000.0) * 2.7778e-5,                   # to 06:00, ramp to 0.10
    ifelse(time < 25200.0, 0.10 + (time - 21600.0) * 2.7778e-5,            # to 07:00, ramp to 0.20
    ifelse(time < 28800.0, 0.20 + (time - 25200.0) * 2.0833e-4,            # to 08:00, ramp to 0.95
    ifelse(time < 39600.0, 0.95,                                           # to 11:00, full
    ifelse(time < 43200.0, 0.95 - (time - 39600.0) * 1.25e-4,              # to 12:00, ramp to 0.50
    ifelse(time < 46800.0, 0.50 + (time - 43200.0) * 1.25e-4,              # to 13:00, back to 0.95
    ifelse(time < 57600.0, 0.95,                                           # to 16:00, full
    ifelse(time < 61200.0, 0.95 - (time - 57600.0) * 1.8056e-4,            # to 17:00, ramp to 0.30
    ifelse(time < 64800.0, 0.30 - (time - 61200.0) * 5.5556e-5,            # to 18:00, ramp to 0.10
    ifelse(time < 75600.0, 0.10,                                           # to 21:00, evening shift
    ifelse(time < 79200.0, 0.10 - (time - 75600.0) * 1.3889e-5,            # to 22:00, ramp to 0.05
    ifelse(time < 82800.0, 0.05,                                           # to 23:00, skeleton crew
    ifelse(time < 86400.0, 0.05 - (time - 82800.0) * 1.3889e-5,            # to 24:00, ramp to 0.00
    0.0))))))))))))))
  y = occ
metadata {
  "Dyad": {"icons": {"default": "dyad://DynamicSteadyState/icon_office_occupancy.svg"}}
}
end

# Heater capacity carries a 1.2 safety factor over the larger of the two sizing solves. The cold
# night governs every zone:
#   Z1 = 7558 × 1.2 ≈ 9070 W   (design day asked 4274 W)
#   Z2 = 1925 × 1.2 ≈ 2310 W   (design day asked 1150 W)
#   Z3 = 7041 × 1.2 ≈ 8450 W   (design day asked 5166 W)
test component TestDiurnalOperation
  building = ThreeZoneBuilding() {
    "Dyad": {
      "placement": {
        "diagram": {"iconName": "default", "x1": 678, "y1": 579, "x2": 778, "y2": 679, "rot": 0}
      },
      "tags": []
    }
  }
  # ---- Outdoor temperature (diurnal sine) — connects directly as signal ----
  outdoor_signal = BlockComponents.Sources.Sine(amplitude = 5.0, frequency = 1.1574e-5, phase = -1.5708, offset = 268.15) {
    "Dyad": {
      "placement": {
        "diagram": {"iconName": "default", "x1": 545, "y1": 691, "x2": 645, "y2": 791, "rot": 0}
      },
      "tags": []
    }
  }
  # ---- Ground (stable year-round) ----
  ground_signal = BlockComponents.Sources.Constant(k = 283.15) {
    "Dyad": {
      "placement": {
        "diagram": {"iconName": "default", "x1": 545, "y1": 554, "x2": 645, "y2": 654, "rot": 0}
      },
      "tags": []
    }
  }
  # ---- Representative office occupancy schedule ----
  occ_schedule = OfficeOccupancy() {
    "Dyad": {
      "placement": {
        "diagram": {"iconName": "default", "x1": 20, "y1": 244, "x2": 120, "y2": 344, "rot": 0}
      },
      "tags": []
    }
  }
  # ---- Solar gains (sine, peaks at noon) ----
  solar_south = BlockComponents.Sources.Sine(amplitude = 1500.0, frequency = 1.1574e-5, phase = -1.5708, offset = 1500.0) {
    "Dyad": {
      "placement": {
        "diagram": {"iconName": "default", "x1": 285, "y1": 125, "x2": 385, "y2": 225, "rot": 0}
      },
      "tags": []
    }
  }
  solar_north = BlockComponents.Sources.Sine(amplitude = 375.0, frequency = 1.1574e-5, phase = -1.5708, offset = 375.0) {
    "Dyad": {
      "placement": {
        "diagram": {"iconName": "default", "x1": 285, "y1": 896, "x2": 385, "y2": 996, "rot": 0}
      },
      "tags": []
    }
  }
  # ---- Internal gains = occupancy × peak watts ----
  int1_scale = BlockComponents.Math.Gain(k = 600.0) {
    "Dyad": {
      "placement": {
        "diagram": {"iconName": "default", "x1": 155, "y1": 245, "x2": 255, "y2": 345, "rot": 0}
      },
      "tags": []
    }
  }
  int1_source = ThermalComponents.Sources.PrescribedHeatFlow() {
    "Dyad": {
      "placement": {
        "diagram": {"iconName": "default", "x1": 290, "y1": 245, "x2": 390, "y2": 345, "rot": 0}
      },
      "tags": []
    }
  }
  int2_scale = BlockComponents.Math.Gain(k = 500.0) {
    "Dyad": {
      "placement": {
        "diagram": {"iconName": "default", "x1": 155, "y1": 450, "x2": 255, "y2": 550, "rot": 0}
      },
      "tags": []
    }
  }
  int2_source = ThermalComponents.Sources.PrescribedHeatFlow() {
    "Dyad": {
      "placement": {
        "diagram": {"iconName": "default", "x1": 290, "y1": 450, "x2": 390, "y2": 550, "rot": 0}
      },
      "tags": []
    }
  }
  int3_scale = BlockComponents.Math.Gain(k = 400.0) {
    "Dyad": {
      "placement": {
        "diagram": {"iconName": "default", "x1": 155, "y1": 630, "x2": 255, "y2": 730, "rot": 0}
      },
      "tags": []
    }
  }
  int3_source = ThermalComponents.Sources.PrescribedHeatFlow() {
    "Dyad": {
      "placement": {
        "diagram": {"iconName": "default", "x1": 290, "y1": 630, "x2": 390, "y2": 730, "rot": 0}
      },
      "tags": []
    }
  }
  # ---- Solar thermal sources ----
  solar1_source = ThermalComponents.Sources.PrescribedHeatFlow() {
    "Dyad": {
      "placement": {
        "diagram": {"iconName": "default", "x1": 420, "y1": 125, "x2": 520, "y2": 225, "rot": 0}
      },
      "tags": []
    }
  }
  solar3_source = ThermalComponents.Sources.PrescribedHeatFlow() {
    "Dyad": {
      "placement": {
        "diagram": {"iconName": "default", "x1": 420, "y1": 896, "x2": 520, "y2": 996, "rot": 0}
      },
      "tags": []
    }
  }
  # ---- HVAC thermostat controllers (capacity = max(design-day, cold-night) × 1.2) ----
  hvac1 = ThermostatHeater(K = 5000.0, T_set = 294.15, Q_max = 9070.0) {
    "Dyad": {
      "placement": {
        "diagram": {"iconName": "default", "x1": 550, "y1": 20, "x2": 650, "y2": 120, "rot": 0}
      },
      "tags": []
    }
  }
  hvac2 = ThermostatHeater(K = 5000.0, T_set = 294.15, Q_max = 2310.0) {
    "Dyad": {
      "placement": {
        "diagram": {"iconName": "default", "x1": 420, "y1": 345, "x2": 520, "y2": 445, "rot": 0}
      },
      "tags": []
    }
  }
  hvac3 = ThermostatHeater(K = 5000.0, T_set = 294.15, Q_max = 8450.0) {
    "Dyad": {
      "placement": {
        "diagram": {"iconName": "default", "x1": 550, "y1": 811, "x2": 650, "y2": 911, "rot": 0}
      },
      "tags": []
    }
  }
relations
  # Boundary condition signals → building
  connect(outdoor_signal.y, building.T_outdoor) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 665, "y": 741}, {"x": 665, "y": 654}], "E": 2}],
      "renderStyle": "standard"
    }
  }
  connect(ground_signal.y, building.T_ground) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}}
  # Occupancy → gain scaling → heat sources
  connect(occ_schedule.y, int1_scale.u) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}}
  connect(occ_schedule.y, int2_scale.u) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [], "E": -1},
        {"S": -1, "M": [], "E": -2},
        {"S": -2, "M": [], "E": 2}
      ],
      "junctions": [{"x": 135, "y": 295}, {"x": 135, "y": 500}],
      "renderStyle": "standard"
    }
  }
  connect(occ_schedule.y, int3_scale.u) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 135, "y": 295}, {"x": 135, "y": 680}], "E": 2}],
      "renderStyle": "standard"
    }
  }
  connect(int1_scale.y, int1_source.Q_flow) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}}
  connect(int2_scale.y, int2_source.Q_flow) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}}
  connect(int3_scale.y, int3_source.Q_flow) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}}
  # Solar → heat sources
  connect(solar_south.y, solar1_source.Q_flow) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}}
  connect(solar_north.y, solar3_source.Q_flow) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}}
  # Heat sources + HVAC controllers → building zone ports
  connect(int1_source.port, solar1_source.port, hvac1.node, building.zone1_port) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [{"x": 535, "y": 295}], "E": -1},
        {"S": -1, "M": [], "E": 2},
        {"S": -1, "M": [], "E": -2},
        {"S": -2, "M": [], "E": 3},
        {"S": -2, "M": [{"x": 804, "y": 175}, {"x": 804, "y": 604}], "E": 4}
      ],
      "junctions": [{"x": 535, "y": 175}, {"x": 600, "y": 175}],
      "renderStyle": "standard"
    }
  }
  connect(int2_source.port, hvac2.node, building.zone2_port) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [], "E": -1},
        {"S": -1, "M": [], "E": 2},
        {"S": -1, "M": [{"x": 794, "y": 500}, {"x": 794, "y": 629}], "E": 3}
      ],
      "junctions": [{"x": 470, "y": 500}],
      "renderStyle": "standard"
    }
  }
  connect(int3_source.port, solar3_source.port, hvac3.node, building.zone3_port) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [{"x": 535, "y": 680}], "E": -1},
        {"S": -1, "M": [], "E": 2},
        {"S": -1, "M": [], "E": -2},
        {"S": -2, "M": [], "E": 3},
        {"S": -2, "M": [{"x": 794, "y": 946}, {"x": 794, "y": 654}], "E": 4}
      ],
      "junctions": [{"x": 535, "y": 946}, {"x": 600, "y": 946}],
      "renderStyle": "standard"
    }
  }
  # Initial zone temperatures (cold-start at 12°C)
  initial building.z1.cap.T = 285.15
  initial building.z2.cap.T = 285.15
  initial building.z3.cap.T = 285.15
end

analysis DiurnalOperation
  extends TransientAnalysis(stop = 86400.0)
  model = TestDiurnalOperation()
relations
end