"""
Undamped spring-mass oscillator with PID damping control.
The system oscillates without natural damping, and the PID controller
can apply damping force to suppress oscillations.
"""
component ControlledOscillator
  "Mass component"
  mass = TranslationalComponents.Components.Mass(m = 1.0) {
    "Dyad": {"placement": {"diagram": {"x1": 600, "y1": 600, "x2": 700, "y2": 700}}}
  }
  "Spring component - provides restoring force"
  spring = TranslationalComponents.Components.Spring(c = 100.0, s_rel0 = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 400, "y1": 600, "x2": 500, "y2": 700}}}
  }
  "Fixed reference point"
  fixed = TranslationalComponents.Components.Fixed(s0 = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 300, "y1": 700, "x2": 400, "y2": 800}}}
  }
  "PID controller - generates damping force based on velocity"
  pid = BlockComponents.Continuous.LimPID(with_I = pid_with_I, with_D = pid_with_D, k = pid_k, Ti = pid_Ti, Td = pid_Td, y_max = pid_y_max, y_min = pid_y_min) {
    "Dyad": {"placement": {"diagram": {"x1": 300, "y1": 300, "x2": 400, "y2": 400}}}
  }
  "Setpoint for PID (zero velocity = rest)"
  setpoint = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 100, "y1": 277, "x2": 200, "y2": 377}}}
  }
  "Velocity sensor for feedback"
  velocity_sensor = TranslationalComponents.Sensors.VelocitySensor() {
    "Dyad": {"placement": {"diagram": {"x1": 600, "y1": 750, "x2": 700, "y2": 850}}}
  }
  "Control force actuator"
  control_force = TranslationalComponents.Sources.Force() {
    "Dyad": {"placement": {"diagram": {"x1": 600, "y1": 400, "x2": 700, "y2": 500}}}
  }
  "Ground for force actuator"
  ground = TranslationalComponents.Components.Fixed(s0 = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 500, "y1": 500, "x2": 600, "y2": 600}}}
  }
  "Feed-forward input (zero by default)"
  ff_input = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 100, "y1": 100, "x2": 200, "y2": 200}}}
  }
  "Include the integral branch of the controller"
  structural parameter pid_with_I::Boolean = true
  "Include the derivative branch of the controller"
  structural parameter pid_with_D::Boolean = true
  "PID proportional gain"
  parameter pid_k::Real = 10.0
  "PID integral time"
  parameter pid_Ti::Real = 10.0
  "PID derivative time"
  parameter pid_Td::Real = 0.5
  "Maximum control force"
  parameter pid_y_max::Real = 50.0
  "Minimum control force"
  parameter pid_y_min::Real = -50.0
relations
  connect(fixed.flange, spring.flange_a) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 350, "y": 650}], "E": 2}], "path": {}}}
  connect(spring.flange_b, mass.flange_a) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(velocity_sensor.flange, mass.flange_a) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 550, "y": 800}, {"x": 550, "y": 650}], "E": 2}],
      "path": {}
    }
  }
  connect(ground.flange, control_force.flange_a) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 550, "y": 450}], "E": 2}], "path": {}}}
  connect(control_force.flange_b, mass.flange_b) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 750, "y": 450}, {"x": 750, "y": 650}], "E": 2}],
      "path": {}
    }
  }
  connect(setpoint.y, pid.u_s) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(velocity_sensor.v, pid.u_m) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 750, "y": 800},
            {"x": 750, "y": 900},
            {"x": 250, "y": 900},
            {"x": 250, "y": 373}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(pid.y, control_force.f) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 650, "y": 350}], "E": 2}], "path": {}}}
  connect(ff_input.y, pid.u_ff) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 350, "y": 150}], "E": 2}], "path": {}}}
  initial mass.s = 0.5
  initial mass.v = 0.0
end

test component TestStrongDamping
  "Initial displacement to trigger oscillation"
  system = ControlledOscillator()
relations
end

test component TestWeakDamping
  "Reduced PID gain allows oscillation"
  system = ControlledOscillator(pid_k = 1.0, pid_Td = 0.1, pid_y_max = 10.0, pid_y_min = -10.0)
relations
end

test component TestNoDamping
  "Pure oscillation with integral and derivative branches removed"
  system = ControlledOscillator(pid_k = 0.0, pid_with_I = false, pid_with_D = false)
relations
end

analysis StrongDampingAnalysis
  extends TransientAnalysis(stop = 10.0)
  model = TestStrongDamping()
relations
end

analysis WeakDampingAnalysis
  extends TransientAnalysis(stop = 10.0)
  model = TestWeakDamping()
relations
end

analysis NoDampingAnalysis
  extends TransientAnalysis(stop = 10.0)
  model = TestNoDamping()
relations
end