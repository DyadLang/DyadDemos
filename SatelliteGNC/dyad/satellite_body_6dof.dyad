# =====================================================
# TEST: Circular orbit propagation (one full period)
#
# Initial conditions: 400 km LEO circular orbit
#   r = [R_earth + 400km, 0, 0] m
#   v = [0, v_circ, 0] m/s
#   Zero attitude, zero angular velocity, no forces/torques
#
# Expected:
#   - Keplerian orbit, period ≈ 5545 s
#   - Position returns near initial after one period
#   - Orbital energy E = 0.5*v² - μ/r is conserved
#   - No attitude change (gravity gradient zero when aligned)
# =====================================================
test component TestOrbitPropagation
  sat = SatelliteBody6DOF(Ixx = 10.0, Iyy = 8.0, Izz = 6.0, m = 4.0)
relations
  # Initial conditions: circular orbit at 400 km
  initial sat.pos_x = 6771000.0
  initial sat.pos_y = 0.0
  initial sat.pos_z = 0.0
  initial sat.vel_x = 0.0
  initial sat.vel_y = 7672.6
  initial sat.vel_z = 0.0
  # Zero attitude and rates
  initial sat.wx = 0.0
  initial sat.wy = 0.0
  initial sat.wz = 0.0
  initial sat.phi = 0.0
  initial sat.theta = 0.0
  initial sat.psi = 0.0
  # No external forces or torques
  sat.tau_x = 0.0
  sat.tau_y = 0.0
  sat.tau_z = 0.0
  sat.fx = 0.0
  sat.fy = 0.0
  sat.fz = 0.0
end

analysis TestOrbitPropagationSim
  extends TransientAnalysis(stop = 5545.0, abstol = 1e-10, reltol = 1e-10)
  model = TestOrbitPropagation()
end