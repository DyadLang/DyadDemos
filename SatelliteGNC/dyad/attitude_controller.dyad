"""
3-axis PD attitude controller with feedforward.

Computes torque commands from attitude error, rate error, and feedforward:
  τ_i = -Kp_i * (angle_i - ref_i) - Kd_i * (ω_i - ω_ref_i) + I_i * α_ref_i

The feedforward term (I * α_ref) eliminates steady-state tracking lag during
ramp/coast trajectory phases.

Inputs: reference angles, reference rates, feedforward accelerations,
        measured angles, measured angular velocities.
Outputs: commanded torques in the body frame.
"""
component AttitudeController
  "Reference angle inputs"
  phi_ref = RealInput() {^phi_ref}
  theta_ref = RealInput() {^theta_ref}
  psi_ref = RealInput() {^psi_ref}
  "Reference rate inputs (for rate error damping)"
  wx_ref = RealInput() {^wx_ref}
  wy_ref = RealInput() {^wy_ref}
  wz_ref = RealInput() {^wz_ref}
  "Feedforward acceleration inputs (α_ref = dω_ref/dt)"
  ax_ff = RealInput() {^ax_ff}
  ay_ff = RealInput() {^ay_ff}
  az_ff = RealInput() {^az_ff}
  "Measured angle inputs"
  phi_meas = RealInput() {^phi_meas}
  theta_meas = RealInput() {^theta_meas}
  psi_meas = RealInput() {^psi_meas}
  "Measured angular velocity inputs"
  wx_meas = RealInput() {^wx_meas}
  wy_meas = RealInput() {^wy_meas}
  wz_meas = RealInput() {^wz_meas}
  "Torque command outputs"
  tau_x = RealOutput() {^tau_x}
  tau_y = RealOutput() {^tau_y}
  tau_z = RealOutput() {^tau_z}
  "Proportional gains"
  parameter Kp_x::Real = 5.0
  parameter Kp_y::Real = 4.0
  parameter Kp_z::Real = 3.0
  "Derivative gains"
  parameter Kd_x::Real = 20.0
  parameter Kd_y::Real = 16.0
  parameter Kd_z::Real = 12.0
  "Feedforward inertias (must match plant)"
  parameter Ixx_ff::Real = 10.0
  parameter Iyy_ff::Real = 8.0
  parameter Izz_ff::Real = 6.0
relations
  tau_x = -Kp_x * (phi_meas - phi_ref) - Kd_x * (wx_meas - wx_ref) + Ixx_ff * ax_ff
  tau_y = -Kp_y * (theta_meas - theta_ref) - Kd_y * (wy_meas - wy_ref) + Iyy_ff * ay_ff
  tau_z = -Kp_z * (psi_meas - psi_ref) - Kd_z * (wz_meas - wz_ref) + Izz_ff * az_ff
metadata {
  "Dyad": {"icons": {"default": "dyad://SatelliteGNC/AttitudeController.svg"}},
  "_links": {
    "phi_ref": {
      "Dyad": {
        "placement": {
