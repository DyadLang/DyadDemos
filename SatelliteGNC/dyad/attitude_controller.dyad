          "x1": -18.75,
          "y1": 918.75,
          "x2": 18.75,
          "y2": 956.25,
          "rot": 0
        },
        "diagram": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 918.75,
          "x2": 18.75,
          "y2": 956.25,
          "rot": 0
