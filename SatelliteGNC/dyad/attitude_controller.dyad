"""
3-axis PD attitude controller with feedforward.

Computes torque commands from attitude error, rate error, and feedforward:
  τ_i = -Kp_i * (angle_i - ref_i) - Kd_i * (ω_i - ω_ref_i) + I_i * α_ref_i

The feedforward term (I * α_ref) eliminates steady-state tracking lag during
ramp/coast trajectory phases.

Inputs: reference angles, reference rates, feedforward accelerations,
        measured angles, measured angular velocities.
Outputs: commanded torques in the body frame.
"""
component AttitudeController
  "Reference angle inputs"
  phi_ref = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 418.75,
          "x2": 18.75,
          "y2": 456.25,
          "rot": 0
        },
        "diagram": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 418.75,
          "x2": 18.75,
          "y2": 456.25,
          "rot": 0
        }
      },
      "tags": []
    }
  }
  theta_ref = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 606.25,
          "x2": 18.75,
          "y2": 643.75,
          "rot": 0
        },
        "diagram": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 606.25,
          "x2": 18.75,
          "y2": 643.75,
          "rot": 0
        }
      },
      "tags": []
    }
  }
  psi_ref = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 793.75,
          "x2": 18.75,
          "y2": 831.25,
          "rot": 0
        },
        "diagram": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 793.75,
          "x2": 18.75,
          "y2": 831.25,
          "rot": 0
        }
      },
      "tags": []
    }
  }
  "Reference rate inputs (for rate error damping)"
  wx_ref = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 481.25,
          "x2": 18.75,
          "y2": 518.75,
          "rot": 0
        },
        "diagram": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 481.25,
          "x2": 18.75,
          "y2": 518.75,
          "rot": 0
        }
      },
      "tags": []
    }
  }
  wy_ref = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 668.75,
          "x2": 18.75,
          "y2": 706.25,
          "rot": 0
        },
        "diagram": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 668.75,
          "x2": 18.75,
          "y2": 706.25,
          "rot": 0
        }
      },
      "tags": []
    }
  }
  wz_ref = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 856.25,
          "x2": 18.75,
          "y2": 893.75,
          "rot": 0
        },
        "diagram": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 856.25,
          "x2": 18.75,
          "y2": 893.75,
          "rot": 0
        }
      },
      "tags": []
    }
  }
  "Feedforward acceleration inputs (α_ref = dω_ref/dt)"
  ax_ff = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 543.75,
          "x2": 18.75,
          "y2": 581.25,
          "rot": 0
        },
        "diagram": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 543.75,
          "x2": 18.75,
          "y2": 581.25,
          "rot": 0
        }
      },
      "tags": []
    }
  }
  ay_ff = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {
