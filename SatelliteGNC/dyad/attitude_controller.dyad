  }
  "Measured angle inputs"
  phi_meas = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 43.75,
          "x2": 18.75,
          "y2": 81.25,
          "rot": 0
        },
        "diagram": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 43.75,
          "x2": 18.75,
          "y2": 81.25,
          "rot": 0
        }
      },
      "tags": []
    }
  }
  theta_meas = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 106.25,
          "x2": 18.75,
          "y2": 143.75,
          "rot": 0
        },
        "diagram": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 106.25,
          "x2": 18.75,
          "y2": 143.75,
          "rot": 0
        }
      },
      "tags": []
    }
  }
  psi_meas = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 168.75,
          "x2": 18.75,
          "y2": 206.25,
          "rot": 0
        },
        "diagram": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 168.75,
          "x2": 18.75,
          "y2": 206.25,
          "rot": 0
        }
      },
      "tags": []
    }
  }
  "Measured angular velocity inputs"
  wx_meas = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 231.25,
          "x2": 18.75,
          "y2": 268.75,
          "rot": 0
        },
        "diagram": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 231.25,
          "x2": 18.75,
          "y2": 268.75,
          "rot": 0
        }
      },
      "tags": []
    }
  }
  wy_meas = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 293.75,
          "x2": 18.75,
          "y2": 331.25,
          "rot": 0
        },
        "diagram": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 293.75,
          "x2": 18.75,
          "y2": 331.25,
          "rot": 0
        }
      },
      "tags": []
    }
  }
  wz_meas = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 356.25,
          "x2": 18.75,
          "y2": 393.75,
          "rot": 0
        },
        "diagram": {
          "iconName": "default",
          "x1": -18.75,
          "y1": 356.25,
          "x2": 18.75,
          "y2": 393.75,
          "rot": 0
        }
      },
      "tags": []
    }
  }
  "Torque command outputs"
  tau_x = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {
          "iconName": "default",
          "x1": 981.25,
          "y1": 418.75,
          "x2": 1018.75,
          "y2": 456.25,
          "rot": 0
        },
        "diagram": {
          "iconName": "default",
          "x1": 981.25,
          "y1": 418.75,
          "x2": 1018.75,
          "y2": 456.25,
          "rot": 0
        }
      },
      "tags": []
    }
  }
  tau_y = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {
          "iconName": "default",
          "x1": 981.25,
          "y1": 481.25,
          "x2": 1018.75,
          "y2": 518.75,
          "rot": 0
        },
        "diagram": {
          "iconName": "default",
          "x1": 981.25,
          "y1": 481.25,
          "x2": 1018.75,
          "y2": 518.75,
          "rot": 0
        }
      },
      "tags": []
    }
  }
  tau_z = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {
          "iconName": "default",
          "x1": 981.25,
          "y1": 543.75,
          "x2": 1018.75,
          "y2": 581.25,
          "rot": 0
        },
        "diagram": {
          "iconName": "default",
          "x1": 981.25,
          "y1": 543.75,
          "x2": 1018.75,
          "y2": 581.25,
          "rot": 0
        }
      },
      "tags": []
    }
  }
  "Proportional gains"
  parameter Kp_x::Real = 5.0
  parameter Kp_y::Real = 4.0
  parameter Kp_z::Real = 3.0
  "Derivative gains"
  parameter Kd_x::Real = 20.0
  parameter Kd_y::Real = 16.0
  parameter Kd_z::Real = 12.0
  "Feedforward inertias (must match plant)"
  parameter Ixx_ff::Real = 10.0
  parameter Iyy_ff::Real = 8.0
  parameter Izz_ff::Real = 6.0
relations
  tau_x = -Kp_x * (phi_meas - phi_ref) - Kd_x * (wx_meas - wx_ref) + Ixx_ff * ax_ff
  tau_y = -Kp_y * (theta_meas - theta_ref) - Kd_y * (wy_meas - wy_ref) + Iyy_ff * ay_ff
  tau_z = -Kp_z * (psi_meas - psi_ref) - Kd_z * (wz_meas - wz_ref) + Izz_ff * az_ff
metadata {
  "Dyad": {
    "icons": {"default": "dyad://SatelliteGNC/AttitudeController.svg"},
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 1031.5,
        "layer": "icon",
        "attrs": {"font-size": "45"}
      }
    ]
  }
}
end

# =====================================================
# TEST: Closed-loop 3-axis slew maneuver
#
# Command a simultaneous repointing:
#   φ_ref = 0.1745 rad (10°)
#   θ_ref = 0.0873 rad (5°)
#   ψ_ref = 0.2618 rad (15°)
#
# PD gains chosen for each axis:
#   ωn = sqrt(Kp/I),  ζ = Kd/(2*sqrt(Kp*I))
#
#   X-axis: Kp=5, Kd=20, I=10 → ωn=0.707, ζ=1.41 (overdamped)
#   Y-axis: Kp=4, Kd=16, I=8  → ωn=0.707, ζ=1.41 (overdamped)
#   Z-axis: Kp=3, Kd=12, I=6  → ωn=0.707, ζ=1.41 (overdamped)
#
# Expected: All angles settle to their references with
# no overshoot (overdamped). Settling time ≈ 8-12 s.
# At t=30 s all angles should be within 1% of reference.
# =====================================================
test component TestSatelliteClosedLoop
  sat = SatelliteBody(Ixx = 10.0, Iyy = 8.0, Izz = 6.0) {
    "Dyad": {"placement": {"diagram": {"x1": 1500, "y1": 700, "x2": 1900, "y2": 1100}}}
  }
  ctrl = AttitudeController(Kp_x = 5.0, Kd_x = 20.0, Kp_y = 4.0, Kd_y = 16.0, Kp_z = 3.0, Kd_z = 12.0) {
    "Dyad": {"placement": {"diagram": {"x1": 400, "y1": 500, "x2": 1200, "y2": 1300}}}
  }
  "Reference angles (rad)"
  parameter phi_cmd::Real = 0.1745
  parameter theta_cmd::Real = 0.0873
  parameter psi_cmd::Real = 0.2618
relations
  # Initial conditions — satellite at rest, zero attitude
  initial sat.wx = 0.0
  initial sat.wy = 0.0
  initial sat.wz = 0.0
  initial sat.phi = 0.0
  initial sat.theta = 0.0
  initial sat.psi = 0.0
  # Reference commands (constant setpoints)
  ctrl.phi_ref = phi_cmd
  ctrl.theta_ref = theta_cmd
  ctrl.psi_ref = psi_cmd
  # No feedforward for step commands
  ctrl.wx_ref = 0.0
  ctrl.wy_ref = 0.0
  ctrl.wz_ref = 0.0
  ctrl.ax_ff = 0.0
  ctrl.ay_ff = 0.0
  ctrl.az_ff = 0.0
  # Feedback: satellite measurements → controller
  connect(sat.phi_out, ctrl.phi_meas) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 1950, "y": 750},
            {"x": 1950, "y": 450},
            {"x": 350, "y": 450},
            {"x": 350, "y": 550}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(sat.theta_out, ctrl.theta_meas) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 2000, "y": 800},
            {"x": 2000, "y": 400},
            {"x": 300, "y": 400},
            {"x": 300, "y": 600}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(sat.psi_out, ctrl.psi_meas) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 2050, "y": 850},
            {"x": 2050, "y": 350},
            {"x": 250, "y": 350},
            {"x": 250, "y": 650}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(sat.wx_out, ctrl.wx_meas) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 2100, "y": 950},
            {"x": 2100, "y": 300},
            {"x": 200, "y": 300},
            {"x": 200, "y": 700}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(sat.wy_out, ctrl.wy_meas) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 2150, "y": 1000},
            {"x": 2150, "y": 250},
            {"x": 150, "y": 250},
            {"x": 150, "y": 750}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(sat.wz_out, ctrl.wz_meas) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 2200, "y": 1050},
            {"x": 2200, "y": 200},
            {"x": 100, "y": 200},
            {"x": 100, "y": 800}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  # Controller outputs → satellite torque inputs
  connect(ctrl.tau_x, sat.tau_x) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(ctrl.tau_y, sat.tau_y) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(ctrl.tau_z, sat.tau_z) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
end

analysis TestSatelliteClosedLoopSim
  extends TransientAnalysis(stop = 30.0)
  model = TestSatelliteClosedLoop()
relations
end