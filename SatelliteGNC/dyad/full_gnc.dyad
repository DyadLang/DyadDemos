# =====================================================
# Full GNC closed-loop: Trajectory + Observer + Controller + Plant
#
# Architecture:
#   [TrapezoidalProfile x3] → ref angles/rates
#                                    ↓
#   [AttitudeController] ← estimated rates from [LuenbergerObserver]
#         ↓ torques                                    ↑
#   [SatelliteBody] → measured angles ─────────────────┘
#
# Scenario: CubeSat-class 3-axis repointing maneuver
#   φ → 20° (0.349 rad)
#   θ → 10° (0.175 rad)
#   ψ → 30° (0.524 rad)
#
# Rate/accel limits: ω_max=2°/s, α_max=0.5°/s²
#
# Expected behavior:
#   - Smooth trapezoidal profiles (longest axis ψ finishes ~19s)
#   - Observer estimates converge within ~3s (poles at -2)
#   - Tracking error remains small throughout maneuver
#   - All axes settle to target by t=30s
# =====================================================
test component TestFullGNC
  "Plant"
  sat = SatelliteBody(Ixx = 10.0, Iyy = 8.0, Izz = 6.0) {^sat}
  "Trajectory generators (one per axis)"
  traj_phi = TrapezoidalProfile(target_angle = 0.3491, w_max = 0.0349, a_max = 0.00873) {^traj_phi}
  traj_theta = TrapezoidalProfile(target_angle = 0.1745, w_max = 0.0349, a_max = 0.00873) {^traj_theta}
  traj_psi = TrapezoidalProfile(target_angle = 0.5236, w_max = 0.0349, a_max = 0.00873) {^traj_psi}
  "Observer (estimates angular rates from angle measurements)"
  obs = LuenbergerObserver(Ixx = 10.0, Iyy = 8.0, Izz = 6.0, p = 2.0, La_x = 4.0, La_y = 4.0, La_z = 4.0, Lw_x = 40.0, Lw_y = 32.0, Lw_z = 24.0) {^obs}
  "Controller (uses measured angles + estimated rates + feedforward)"
  ctrl = AttitudeController(Kp_x = 5.0, Kd_x = 20.0, Kp_y = 4.0, Kd_y = 16.0, Kp_z = 3.0, Kd_z = 12.0, Ixx_ff = 10.0, Iyy_ff = 8.0, Izz_ff = 6.0) {^ctrl}
relations
  # --- Initial conditions ---
  # Plant starts at rest, zero attitude
  initial sat.wx = 0.0
  initial sat.wy = 0.0
  initial sat.wz = 0.0
  initial sat.phi = 0.0
  initial sat.theta = 0.0
  initial sat.psi = 0.0
  # Observer starts with zero estimates (matches plant IC)
  initial obs.phi_est = 0.0
  initial obs.theta_est = 0.0
  initial obs.psi_est = 0.0
  initial obs.wx_est = 0.0
  initial obs.wy_est = 0.0
  initial obs.wz_est = 0.0
  # --- Trajectory angle references → Controller ---
  connect(traj_phi.angle_ref, ctrl.phi_ref) {^id7}
  connect(traj_theta.angle_ref, ctrl.theta_ref) {^id8}
  connect(traj_psi.angle_ref, ctrl.psi_ref) {^id9}
  # --- Trajectory rate references → Controller ---
  connect(traj_phi.rate_ref, ctrl.wx_ref) {^id10}
  connect(traj_theta.rate_ref, ctrl.wy_ref) {^id11}
  connect(traj_psi.rate_ref, ctrl.wz_ref) {^id12}
  # --- Trajectory accel feedforward → Controller ---
  connect(traj_phi.accel_ref, ctrl.ax_ff) {^id13}
  connect(traj_theta.accel_ref, ctrl.ay_ff) {^id14}
  connect(traj_psi.accel_ref, ctrl.az_ff) {^id15}
  # --- Measured angles → Controller (direct measurement) ---
  connect(sat.phi_out, ctrl.phi_meas) {^id16}
  connect(sat.theta_out, ctrl.theta_meas) {^id17}
  connect(sat.psi_out, ctrl.psi_meas) {^id18}
  # --- Estimated rates → Controller (from observer) ---
  connect(obs.wx_hat, ctrl.wx_meas) {^id19}
  connect(obs.wy_hat, ctrl.wy_meas) {^id20}
  connect(obs.wz_hat, ctrl.wz_meas) {^id21}
  # --- Measured angles → Observer ---
  connect(sat.phi_out, obs.phi_meas) {^id22}
  connect(sat.theta_out, obs.theta_meas) {^id23}
  connect(sat.psi_out, obs.psi_meas) {^id24}
  # --- Controller torques → Plant ---
  connect(ctrl.tau_x, sat.tau_x) {^id25}
  connect(ctrl.tau_y, sat.tau_y) {^id26}
  connect(ctrl.tau_z, sat.tau_z) {^id27}
  # --- Controller torques → Observer (known inputs) ---
  connect(ctrl.tau_x, obs.tau_x) {^id28}
  connect(ctrl.tau_y, obs.tau_y) {^id29}
  connect(ctrl.tau_z, obs.tau_z) {^id30}
