# =====================================================
# Full GNC closed-loop: Trajectory + Observer + Controller + Plant
#
# Architecture:
#   [TrapezoidalProfile x3] → ref angles/rates
#                                    ↓
#   [AttitudeController] ← estimated rates from [LuenbergerObserver]
#         ↓ torques                                    ↑
#   [SatelliteBody] → measured angles ─────────────────┘
#
# Scenario: CubeSat-class 3-axis repointing maneuver
#   φ → 20° (0.349 rad)
#   θ → 10° (0.175 rad)
#   ψ → 30° (0.524 rad)
#
# Rate/accel limits: ω_max=2°/s, α_max=0.5°/s²
#
# Expected behavior:
#   - Smooth trapezoidal profiles (longest axis ψ finishes ~19s)
#   - Observer estimates converge within ~3s (poles at -2)
#   - Tracking error remains small throughout maneuver
#   - All axes settle to target by t=30s
# =====================================================
test component TestFullGNC
  "Plant"
  sat = SatelliteBody(Ixx = 10.0, Iyy = 8.0, Izz = 6.0) {
    "Dyad": {"placement": {"diagram": {"x1": 1800, "y1": 700, "x2": 2200, "y2": 1100}}}
  }
  "Trajectory generators (one per axis)"
  traj_phi = TrapezoidalProfile(target_angle = 0.3491, w_max = 0.0349, a_max = 0.00873) {
    "Dyad": {"placement": {"diagram": {"x1": 100, "y1": 800, "x2": 300, "y2": 1000}}}
  }
  traj_theta = TrapezoidalProfile(target_angle = 0.1745, w_max = 0.0349, a_max = 0.00873) {
    "Dyad": {"placement": {"diagram": {"x1": 100, "y1": 1050, "x2": 300, "y2": 1250}}}
  }
  traj_psi = TrapezoidalProfile(target_angle = 0.5236, w_max = 0.0349, a_max = 0.00873) {
    "Dyad": {"placement": {"diagram": {"x1": 100, "y1": 1300, "x2": 300, "y2": 1500}}}
  }
  "Observer (estimates angular rates from angle measurements)"
  obs = LuenbergerObserver(Ixx = 10.0, Iyy = 8.0, Izz = 6.0, p = 2.0, La_x = 4.0, La_y = 4.0, La_z = 4.0, Lw_x = 40.0, Lw_y = 32.0, Lw_z = 24.0) {
    "Dyad": {"placement": {"diagram": {"x1": 2500, "y1": 700, "x2": 2900, "y2": 1100}}}
  }
  "Controller (uses measured angles + estimated rates + feedforward)"
  ctrl = AttitudeController(Kp_x = 5.0, Kd_x = 20.0, Kp_y = 4.0, Kd_y = 16.0, Kp_z = 3.0, Kd_z = 12.0, Ixx_ff = 10.0, Iyy_ff = 8.0, Izz_ff = 6.0) {
    "Dyad": {"placement": {"diagram": {"x1": 700, "y1": 500, "x2": 1500, "y2": 1300}}}
  }
relations
  # --- Initial conditions ---
  # Plant starts at rest, zero attitude
  initial sat.wx = 0.0
  initial sat.wy = 0.0
  initial sat.wz = 0.0
  initial sat.phi = 0.0
  initial sat.theta = 0.0
  initial sat.psi = 0.0
  # Observer starts with zero estimates (matches plant IC)
  initial obs.phi_est = 0.0
  initial obs.theta_est = 0.0
  initial obs.psi_est = 0.0
  initial obs.wx_est = 0.0
  initial obs.wy_est = 0.0
  initial obs.wz_est = 0.0
  # --- Trajectory angle references → Controller ---
  connect(traj_phi.angle_ref, ctrl.phi_ref) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(traj_theta.angle_ref, ctrl.theta_ref) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 350, "y": 1100}, {"x": 350, "y": 1000}], "E": 2}],
      "path": {}
    }
  }
  connect(traj_psi.angle_ref, ctrl.psi_ref) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 500, "y": 1350}, {"x": 500, "y": 1150}], "E": 2}],
      "path": {}
    }
  }
  # --- Trajectory rate references → Controller ---
  connect(traj_phi.rate_ref, ctrl.wx_ref) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(traj_theta.rate_ref, ctrl.wy_ref) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 400, "y": 1150}, {"x": 400, "y": 1050}], "E": 2}],
      "path": {}
    }
  }
  connect(traj_psi.rate_ref, ctrl.wz_ref) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 550, "y": 1400}, {"x": 550, "y": 1200}], "E": 2}],
      "path": {}
    }
  }
  # --- Trajectory accel feedforward → Controller ---
  connect(traj_phi.accel_ref, ctrl.ax_ff) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(traj_theta.accel_ref, ctrl.ay_ff) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 450, "y": 1200}, {"x": 450, "y": 1100}], "E": 2}],
      "path": {}
    }
  }
  connect(traj_psi.accel_ref, ctrl.az_ff) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 600, "y": 1450}, {"x": 600, "y": 1250}], "E": 2}],
      "path": {}
    }
  }
  # --- Measured angles → Controller (direct measurement) ---
  connect(sat.phi_out, ctrl.phi_meas) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [], "E": -1},
        {
          "S": -1,
          "M": [{"x": 2250, "y": 450}, {"x": 650, "y": 450}, {"x": 650, "y": 550}],
          "E": 2
        }
      ],
      "path": {},
      "junctions": [{"x": 2250, "y": 750}]
    }
  }
  connect(sat.theta_out, ctrl.theta_meas) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [], "E": -1},
        {
          "S": -1,
          "M": [{"x": 2300, "y": 400}, {"x": 600, "y": 400}, {"x": 600, "y": 600}],
          "E": 2
        }
      ],
      "path": {},
      "junctions": [{"x": 2300, "y": 800}]
    }
  }
  connect(sat.psi_out, ctrl.psi_meas) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [], "E": -1},
        {
          "S": -1,
          "M": [{"x": 2350, "y": 350}, {"x": 550, "y": 350}, {"x": 550, "y": 650}],
          "E": 2
        }
      ],
      "path": {},
      "junctions": [{"x": 2350, "y": 850}]
    }
  }
  # --- Estimated rates → Controller (from observer) ---
  connect(obs.wx_hat, ctrl.wx_meas) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 2950, "y": 950},
            {"x": 2950, "y": 300},
            {"x": 500, "y": 300},
            {"x": 500, "y": 700}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(obs.wy_hat, ctrl.wy_meas) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 3000, "y": 1000},
            {"x": 3000, "y": 250},
            {"x": 450, "y": 250},
            {"x": 450, "y": 750}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(obs.wz_hat, ctrl.wz_meas) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 3050, "y": 1050},
            {"x": 3050, "y": 200},
            {"x": 400, "y": 200},
            {"x": 400, "y": 800}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  # --- Measured angles → Observer ---
  connect(sat.phi_out, obs.phi_meas) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(sat.theta_out, obs.theta_meas) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(sat.psi_out, obs.psi_meas) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  # --- Controller torques → Plant ---
  connect(ctrl.tau_x, sat.tau_x) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(ctrl.tau_y, sat.tau_y) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(ctrl.tau_z, sat.tau_z) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  # --- Controller torques → Observer (known inputs) ---
  connect(ctrl.tau_x, obs.tau_x) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [], "E": -1},
        {
          "S": -1,
          "M": [{"x": 1750, "y": 1200}, {"x": 2250, "y": 1200}, {"x": 2250, "y": 950}],
          "E": 2
        }
      ],
      "path": {},
      "junctions": [{"x": 1750, "y": 850}]
    }
  }
  connect(ctrl.tau_y, obs.tau_y) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [], "E": -1},
        {
          "S": -1,
          "M": [{"x": 1700, "y": 1250}, {"x": 2300, "y": 1250}, {"x": 2300, "y": 1000}],
          "E": 2
        }
      ],
      "path": {},
      "junctions": [{"x": 1700, "y": 900}]
    }
  }
  connect(ctrl.tau_z, obs.tau_z) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [], "E": -1},
        {
          "S": -1,
          "M": [{"x": 1650, "y": 1300}, {"x": 2350, "y": 1300}, {"x": 2350, "y": 1050}],
          "E": 2
        }
      ],
      "path": {},
      "junctions": [{"x": 1650, "y": 950}]
    }
  }
end

analysis TestFullGNCSim
  extends TransientAnalysis(stop = 40.0)
  model = TestFullGNC()
relations
end