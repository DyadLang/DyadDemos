# =====================================================
# TEST: Open-loop single-axis torque
# Apply constant torque about X only. With ωy=ωz=0
# the cross-coupling vanishes and we get pure rotation
# about X.
#
# Expected at t=10 s (Ixx=10, τx=0.1):
#   αx  = 0.01 rad/s²
#   ωx  = 0.1 rad/s
#   φ   = 0.5 rad  (≈ 28.6°)
#   θ,ψ = 0
#   ωy,ωz = 0
# =====================================================
test component TestSatelliteOpenLoop
  sat = SatelliteBody(Ixx = 10.0, Iyy = 8.0, Izz = 6.0) {^sat}
  "Constant torque about X axis"
  parameter tau_x_val::Real = 0.1
relations
  # Initial conditions — satellite at rest, zero attitude
  initial sat.wx = 0.0
  initial sat.wy = 0.0
  initial sat.wz = 0.0
  initial sat.phi = 0.0
  initial sat.theta = 0.0
  initial sat.psi = 0.0
  # Apply constant torque on X, zero on Y and Z
  sat.tau_x = tau_x_val
  sat.tau_y = 0.0
  sat.tau_z = 0.0
metadata {
  "_links": {
    "sat": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 20, "y1": 20, "x2": 120, "y2": 120, "rot": 0}
        },
        "tags": []
      }
    }
  }
}
end

analysis TestSatelliteOpenLoopSim
  extends TransientAnalysis(stop = 10.0)
  model = TestSatelliteOpenLoop()
relations
end