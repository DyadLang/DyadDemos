"""
3-axis rigid body satellite dynamics.

Euler's rotational equations of motion for a rigid body with principal-axis
inertia (Ixx, Iyy, Izz), coupled with 3-2-1 Euler angle kinematics
(yaw-pitch-roll).

Inputs: 3 torque components in the body frame.
Outputs: 3 Euler angles (roll φ, pitch θ, yaw ψ) and 3 angular velocities.
"""
component SatelliteBody
  "Torque inputs (body frame)"
  tau_x = RealInput() {^tau_x}
  tau_y = RealInput() {^tau_y}
  tau_z = RealInput() {^tau_z}
  "Euler angle outputs"
  phi_out = RealOutput() {^phi_out}
  theta_out = RealOutput() {^theta_out}
  psi_out = RealOutput() {^psi_out}
  "Angular velocity outputs (body frame)"
  wx_out = RealOutput() {^wx_out}
  wy_out = RealOutput() {^wy_out}
  wz_out = RealOutput() {^wz_out}
  "Principal moments of inertia"
  parameter Ixx::Real = 10.0
  parameter Iyy::Real = 8.0
  parameter Izz::Real = 6.0
  "Angular velocities in body frame (rad/s)"
  variable wx::Real
  variable wy::Real
  variable wz::Real
  "Euler angles: roll, pitch, yaw (rad)"
  variable phi::Real
  variable theta::Real
  variable psi::Real
relations
  # --- Euler's equations of motion (principal axes) ---
  Ixx * der(wx) = tau_x + (Iyy - Izz) * wy * wz
  Iyy * der(wy) = tau_y + (Izz - Ixx) * wz * wx
  Izz * der(wz) = tau_z + (Ixx - Iyy) * wx * wy
  # --- 3-2-1 Euler angle kinematics ---
  der(phi) = wx + (wy * sin(phi) + wz * cos(phi)) * tan(theta)
  der(theta) = wy * cos(phi) - wz * sin(phi)
  der(psi) = (wy * sin(phi) + wz * cos(phi)) / cos(theta)
  # --- Wire outputs ---
  phi_out = phi
  theta_out = theta
  psi_out = psi
  wx_out = wx
  wy_out = wy
  wz_out = wz
metadata {
  "Dyad": {
    "icons": {"default": "dyad://SatelliteGNC/SatelliteBody.svg"}
  },
  "_links": {
