"""
Upper body-flap elevator assist (spec 10.5): DUFDE = DLEC + 15 only when
DLEC < -15, else 0. Four mixers share DACMD = 0, DRCMD = 0, DSBCMD = 16.42
(so DBFSBUC = 10 - 16.42 = -6.42 and DBFSBLC = 16.42, all aileron flap
commands zero) and differ only in DECMD:

  mix_t: DECMD = 5.5  (trim)       -> DUFDE = 0,  DUL = DUR = -6.42
  mix_b: DECMD = -20 (below -15)   -> DUFDE = -5, DUL = DUR = -11.42
  mix_e: DECMD = -15 (at -15)      -> DUFDE = 0,  DUL = DUR = -6.42
  mix_a: DECMD = -10 (above -15)   -> DUFDE = 0,  DUL = DUR = -6.42

Expected values come from the spec arithmetic, not from the model. The old
(buggy) wiring gave DUFDE = DLEC + 15 above -15, i.e. +14.08 at trim.
"""
test component TestMixerAssist
  mix_t = HL20Mixer() {
    "Dyad": {"placement": {"diagram": {"x1": 475, "x2": 575, "y1": 600, "y2": 700}}}
  }
  mix_b = HL20Mixer() {
    "Dyad": {"placement": {"diagram": {"x1": 475, "x2": 575, "y1": 1600, "y2": 1700}}}
  }
  mix_e = HL20Mixer() {
    "Dyad": {"placement": {"diagram": {"x1": 475, "x2": 575, "y1": 2600, "y2": 2700}}}
  }
  mix_a = HL20Mixer() {
    "Dyad": {"placement": {"diagram": {"x1": 475, "x2": 575, "y1": 3600, "y2": 3700}}}
  }
  t_dec = BlockComponents.Sources.Constant(k = 5.5) {
    "Dyad": {"placement": {"diagram": {"x1": 225, "x2": 325, "y1": 200, "y2": 300}}}
  }
  t_dac = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 225, "x2": 325, "y1": 450, "y2": 550}}}
  }
  t_drc = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 225, "x2": 325, "y1": 700, "y2": 800}}}
  }
  t_dsb = BlockComponents.Sources.Constant(k = 16.42) {
    "Dyad": {"placement": {"diagram": {"x1": 225, "x2": 325, "y1": 950, "y2": 1050}}}
  }
  b_dec = BlockComponents.Sources.Constant(k = -20.0) {
    "Dyad": {"placement": {"diagram": {"x1": 225, "x2": 325, "y1": 1200, "y2": 1300}}}
  }
  b_dac = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 225, "x2": 325, "y1": 1450, "y2": 1550}}}
  }
  b_drc = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 225, "x2": 325, "y1": 1700, "y2": 1800}}}
  }
  b_dsb = BlockComponents.Sources.Constant(k = 16.42) {
    "Dyad": {"placement": {"diagram": {"x1": 225, "x2": 325, "y1": 1950, "y2": 2050}}}
  }
  e_dec = BlockComponents.Sources.Constant(k = -15.0) {
    "Dyad": {"placement": {"diagram": {"x1": 225, "x2": 325, "y1": 2200, "y2": 2300}}}
  }
  e_dac = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 225, "x2": 325, "y1": 2450, "y2": 2550}}}
  }
  e_drc = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 225, "x2": 325, "y1": 2700, "y2": 2800}}}
  }
  e_dsb = BlockComponents.Sources.Constant(k = 16.42) {
    "Dyad": {"placement": {"diagram": {"x1": 225, "x2": 325, "y1": 2950, "y2": 3050}}}
  }
  a_dec = BlockComponents.Sources.Constant(k = -10.0) {
    "Dyad": {"placement": {"diagram": {"x1": 225, "x2": 325, "y1": 3200, "y2": 3300}}}
  }
  a_dac = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 225, "x2": 325, "y1": 3450, "y2": 3550}}}
  }
  a_drc = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 225, "x2": 325, "y1": 3700, "y2": 3800}}}
  }
  a_dsb = BlockComponents.Sources.Constant(k = 16.42) {
    "Dyad": {"placement": {"diagram": {"x1": 225, "x2": 325, "y1": 3950, "y2": 4050}}}
  }
relations
