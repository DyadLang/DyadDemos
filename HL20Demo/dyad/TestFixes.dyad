  }
  c_qx = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 212.5, "x2": 312.5, "y1": 700, "y2": 800}}}
  }
  c_qy = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 212.5, "x2": 312.5, "y1": 950, "y2": 1050}}}
