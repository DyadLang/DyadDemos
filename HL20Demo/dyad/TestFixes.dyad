            "rot_b.v2": 0.0,
            "rot_b.v3": 0.0
          }
        }
      }
    }
  }
}
end

"""
Body -> inertial -> body round trip: feeding QuatToInertial's output back
through QuatToBody with the same quaternion must return the original body
vector. With q = (sqrt(1/2), 0, 0, sqrt(1/2)) the intermediate inertial
vector for b = (3, -2, 5) is R*b = (2, 3, 5); applying the transpose twice
(both rotations buggy the same way) would return (-3, 2, 5) instead.
"""
test component TestQuatRoundTrip
  rot_f = QuatToInertial() {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 800, "y1": 250, "y2": 1250}}}
  }
  rot_b = QuatToBody() {
    "Dyad": {"placement": {"diagram": {"x1": 1250, "x2": 1500, "y1": 900, "y2": 1900}}}
  }
  c_qw = BlockComponents.Sources.Constant(k = 0.7071067811865476) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 250, "y2": 350}}}
  }
  c_qx = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 400, "y2": 500}}}
  }
  c_qy = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 550, "y2": 650}}}
  }
  c_qz = BlockComponents.Sources.Constant(k = 0.7071067811865476) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 700, "y2": 800}}}
  }
  f_qw = BlockComponents.Sources.Constant(k = 0.7071067811865476) {
    "Dyad": {"placement": {"diagram": {"x1": 1060, "x2": 1160, "y1": 900, "y2": 1000}}}
  }
  f_qx = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 1060, "x2": 1160, "y1": 1050, "y2": 1150}}}
  }
  f_qy = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 1060, "x2": 1160, "y1": 1200, "y2": 1300}}}
  }
  f_qz = BlockComponents.Sources.Constant(k = 0.7071067811865476) {
    "Dyad": {"placement": {"diagram": {"x1": 1060, "x2": 1160, "y1": 1350, "y2": 1450}}}
  }
  c_b1 = BlockComponents.Sources.Constant(k = 3.0) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 850, "y2": 950}}}
  }
  c_b2 = BlockComponents.Sources.Constant(k = -2.0) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 1000, "y2": 1100}}}
  }
  c_b3 = BlockComponents.Sources.Constant(k = 5.0) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 1150, "y2": 1250}}}
  }
relations
  connect(c_qw.y, rot_f.qw) {
    "Dyad": {
      "edges": [{"S": 1, "M": [], "E": 2}],
      "path": {}
    }
  }
  connect(c_qx.y, rot_f.qx) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 410, "y": 450}, {"x": 410, "y": 400}], "E": 2}],
