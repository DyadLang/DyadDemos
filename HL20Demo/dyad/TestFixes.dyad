"""
Review-fix regression tests (independent of the model equations).

TestQuatDirection checks that QuatToInertial applies the body-to-inertial
rotation matrix R(q) itself, not its transpose. The quaternion
q = (sqrt(1/2), 0, 0, sqrt(1/2)) gives, by hand,

    R = [ 0 -1  0
          1  0  0
          0  0  1 ]

so a forward body vector (1,0,0) must map to (0,+1,0) in NED and a right
body vector (0,1,0) must map to (-1,0,0). The old (buggy) wiring applied
R^T and would have produced (0,-1,0) and (+1,0,0).
"""
test component TestQuatDirection
  rot_a = QuatToInertial() {
    "Dyad": {"placement": {"diagram": {"x1": 462.5, "x2": 562.5, "y1": 950, "y2": 1050}}}
  }
  rot_b = QuatToInertial() {
    "Dyad": {"placement": {"diagram": {"x1": 462.5, "x2": 562.5, "y1": 2700, "y2": 2800}}}
  }
  a_qw = BlockComponents.Sources.Constant(k = 0.7071067811865476) {
    "Dyad": {"placement": {"diagram": {"x1": 212.5, "x2": 312.5, "y1": 200, "y2": 300}}}
  }
  a_qx = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 212.5, "x2": 312.5, "y1": 450, "y2": 550}}}
  }
  a_qy = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 212.5, "x2": 312.5, "y1": 700, "y2": 800}}}
  }
  a_qz = BlockComponents.Sources.Constant(k = 0.7071067811865476) {
    "Dyad": {"placement": {"diagram": {"x1": 212.5, "x2": 312.5, "y1": 950, "y2": 1050}}}
  }
  a_b1 = BlockComponents.Sources.Constant(k = 1.0) {
    "Dyad": {"placement": {"diagram": {"x1": 212.5, "x2": 312.5, "y1": 1200, "y2": 1300}}}
  }
  a_b2 = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 212.5, "x2": 312.5, "y1": 1450, "y2": 1550}}}
  }
  a_b3 = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 212.5, "x2": 312.5, "y1": 1700, "y2": 1800}}}
  }
  b_qw = BlockComponents.Sources.Constant(k = 0.7071067811865476) {
    "Dyad": {"placement": {"diagram": {"x1": 212.5, "x2": 312.5, "y1": 1950, "y2": 2050}}}
  }
  b_qx = BlockComponents.Sources.Constant(k = 0.0) {
