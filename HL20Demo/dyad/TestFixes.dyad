      "path": {}
    }
  }
  connect(rot_f.v3, rot_b.v3) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 890, "y": 900}, {"x": 890, "y": 1650}], "E": 2}],
      "path": {}
    }
  }
metadata {
  "Dyad": {
    "tests": {
      "roundtrip": {
        "stop": 1,
        "atol": {
          "rot_f.v1": 1e-9,
          "rot_f.v2": 1e-9,
          "rot_f.v3": 1e-9,
