      "path": {}
    }
  }
  connect(b_b1.y, rot_b.b1) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 470, "y": 2550}, {"x": 470, "y": 2450}], "E": 2}],
      "path": {}
