"""
Flat-earth 6-DOF rigid-body dynamics with scalar-first quaternion
orientation (body-to-inertial NED). Translational dynamics are integrated in
the inertial NED frame with gravity added internally on the down axis; Euler's
equations are integrated in the body frame with diagonal inertia. Every
operation is a wired BlockComponents block.
"""
component RigidBody6DOF
  "External force, inertial NED axis 1 (N)"
  F1 = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 0, "x2": 50, "y2": 100},
        "diagram": {"x1": -50, "x2": 50, "y1": 350, "y2": 450}
      }
    }
  }
  "External force, inertial NED axis 2 (N)"
  F2 = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "x2": 50, "y1": 180, "y2": 280}, "diagram": {"x1": -50, "x2": 50, "y1": 550, "y2": 650}}}}
  "External force, inertial NED axis 3 (N)"
  F3 = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "x2": 50, "y1": 360, "y2": 460}, "diagram": {"x1": -50, "x2": 50, "y1": 700, "y2": 800}}}}
  "External torque, body axis 1 (N.m)"
  T1 = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "x2": 50, "y1": 540, "y2": 640}, "diagram": {"x1": -50, "x2": 50, "y1": 1600, "y2": 1700}}}}
  "External torque, body axis 2 (N.m)"
  T2 = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "x2": 50, "y1": 720, "y2": 820}, "diagram": {"x1": -50, "x2": 50, "y1": 1800, "y2": 1900}}}}
  "External torque, body axis 3 (N.m)"
  T3 = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "x2": 50, "y1": 900, "y2": 1000}, "diagram": {"x1": -50, "x2": 50, "y1": 1950, "y2": 2050}}}}
  "Position, inertial NED axis 1 (m)"
  pos_1 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 975, "x2": 1025, "y1": 25, "y2": 75}, "diagram": {"x1": 3300, "x2": 3400, "y1": 700, "y2": 800}}}}
  "Position, inertial NED axis 2 (m)"
  pos_2 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 975, "x2": 1025, "y1": 100, "y2": 150}, "diagram": {"x1": 3300, "x2": 3400, "y1": 850, "y2": 950}}}}
  "Position, inertial NED axis 3 (m)"
  pos_3 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 975, "x2": 1025, "y1": 175, "y2": 225}, "diagram": {"x1": 3300, "x2": 3400, "y1": 1000, "y2": 1100}}}}
  "Velocity, inertial NED axis 1 (m/s)"
  vel_1 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 975, "x2": 1025, "y1": 250, "y2": 300}, "diagram": {"x1": 3300, "x2": 3400, "y1": 250, "y2": 350}}}}
  "Velocity, inertial NED axis 2 (m/s)"
  vel_2 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 975, "x2": 1025, "y1": 325, "y2": 375}, "diagram": {"x1": 3300, "x2": 3400, "y1": 400, "y2": 500}}}}
  "Velocity, inertial NED axis 3 (m/s)"
  vel_3 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 975, "x2": 1025, "y1": 400, "y2": 450}, "diagram": {"x1": 3300, "x2": 3400, "y1": 550, "y2": 650}}}}
  "Quaternion scalar part"
  qw = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 975, "x2": 1025, "y1": 475, "y2": 525}, "diagram": {"x1": 3300, "x2": 3400, "y1": 1150, "y2": 1250}}}}
  "Quaternion x part"
  qx = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 975, "x2": 1025, "y1": 550, "y2": 600}, "diagram": {"x1": 3300, "x2": 3400, "y1": 1300, "y2": 1400}}}}
  "Quaternion y part"
  qy = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 975, "x2": 1025, "y1": 625, "y2": 675}, "diagram": {"x1": 3300, "x2": 3400, "y1": 1450, "y2": 1550}}}}
  "Quaternion z part"
  qz = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 975, "x2": 1025, "y1": 700, "y2": 750}, "diagram": {"x1": 3300, "x2": 3400, "y1": 1600, "y2": 1700}}}}
  "Body angular rate, roll (rad/s)"
  omega_1 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 975, "x2": 1025, "y1": 775, "y2": 825}, "diagram": {"x1": 3300, "x2": 3400, "y1": 2000, "y2": 2100}}}}
  "Body angular rate, pitch (rad/s)"
  omega_2 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 975, "x2": 1025, "y1": 850, "y2": 900}, "diagram": {"x1": 3300, "x2": 3400, "y1": 2150, "y2": 2250}}}}
  "Body angular rate, yaw (rad/s)"
  omega_3 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 975, "x2": 1025, "y1": 925, "y2": 975}, "diagram": {"x1": 3300, "x2": 3400, "y1": 2300, "y2": 2400}}}}
  "Vehicle mass (kg)"
  parameter mass::Real = 8664.1
  "Roll moment of inertia (kg.m^2)"
  parameter Jxx::Real = 10186.272
  "Pitch moment of inertia (kg.m^2)"
  parameter Jyy::Real = 45557.464
  "Yaw moment of inertia (kg.m^2)"
  parameter Jzz::Real = 48333.264
  "Gravitational acceleration (m/s^2)"
  parameter g::Real = 9.81
  "Initial position, axis 1 (m)"
  parameter p1_0::Real = 0.0
  "Initial position, axis 2 (m)"
  parameter p2_0::Real = 0.0
  "Initial position, axis 3 (m)"
  parameter p3_0::Real = 0.0
  "Initial velocity, axis 1 (m/s)"
  parameter v1_0::Real = 0.0
  "Initial velocity, axis 2 (m/s)"
  parameter v2_0::Real = 0.0
  "Initial velocity, axis 3 (m/s)"
  parameter v3_0::Real = 0.0
  "Initial quaternion scalar part"
  parameter q0_0::Real = 1.0
  "Initial quaternion x part"
  parameter q1_0::Real = 0.0
  "Initial quaternion y part"
  parameter q2_0::Real = 0.0
  "Initial quaternion z part"
  parameter q3_0::Real = 0.0
  "Initial body roll rate (rad/s)"
  parameter w1_0::Real = 0.0
  "Initial body pitch rate (rad/s)"
  parameter w2_0::Real = 0.0
  "Initial body yaw rate (rad/s)"
  parameter w3_0::Real = 0.0
  trans = TransDynamics(mass = mass, g = g, v1_0 = v1_0, v2_0 = v2_0, v3_0 = v3_0, p1_0 = p1_0, p2_0 = p2_0, p3_0 = p3_0) {
    "Dyad": {"placement": {"diagram": {"x1": 650, "x2": 1650, "y1": 200, "y2": 1000}}}
  }
  rot = RotDynamics(Jxx = Jxx, Jyy = Jyy, Jzz = Jzz, w1_0 = w1_0, w2_0 = w2_0, w3_0 = w3_0) {
    "Dyad": {"placement": {"diagram": {"x1": 650, "x2": 1650, "y1": 1450, "y2": 2250}}}
  }
  qkin = QuatKinematics(q0_0 = q0_0, q1_0 = q1_0, q2_0 = q2_0, q3_0 = q3_0) {
    "Dyad": {"placement": {"diagram": {"x1": 1800, "x2": 2800, "y1": 1000, "y2": 1800}}}
  }
relations
  connect(F1, trans.F1) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 643.75, "y": 400}, {"x": 643.75, "y": 360}], "E": 2}],
      "path": {}
    }
  }
  connect(T1, rot.T1) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 643.75, "y": 1650}, {"x": 643.75, "y": 1610}], "E": 2}], "path": {}}}
      connect(trans.v1, vel_1) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1720, "y": 240}, {"x": 1720, "y": 300}], "E": 2}], "path": {}}}
  connect(trans.p1, pos_1) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1730, "y": 672}, {"x": 1730, "y": 750}], "E": 2}], "path": {}}}
    connect(rot.w1, qkin.w1, omega_1) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 1660, "y": 1610}, {"x": 1660, "y": 1160}], "E": 2}, {"S": -1, "M": [{"x": 1680, "y": 2050}], "E": 3}], "path": {}, "junctions": [{"x": 1680, "y": 1610}]}}
  connect(F2, trans.F2) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 643.75, "y": 600}, {"x": 643.75, "y": 560}], "E": 2}],
      "path": {}
    }
  }
  connect(T2, rot.T2) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 643.75, "y": 1850}, {"x": 643.75, "y": 1810}], "E": 2}], "path": {}}}
      connect(trans.v2, vel_2) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1710, "y": 384}, {"x": 1710, "y": 450}], "E": 2}], "path": {}}}
  connect(trans.p2, pos_2) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1740, "y": 816}, {"x": 1740, "y": 900}], "E": 2}], "path": {}}}
    connect(rot.w2, qkin.w2, omega_2) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 1690, "y": 1810}, {"x": 1690, "y": 1360}], "E": 2}, {"S": -1, "M": [{"x": 1675, "y": 2200}], "E": 3}], "path": {}, "junctions": [{"x": 1675, "y": 1810}]}}
  connect(F3, trans.F3) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 643.75, "y": 750}, {"x": 643.75, "y": 760}], "E": 2}],
      "path": {}
    }
  }
  connect(T3, rot.T3) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 643.75, "y": 2000}, {"x": 643.75, "y": 2010}], "E": 2}], "path": {}}}
      connect(trans.v3, vel_3) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1700, "y": 528}, {"x": 1700, "y": 600}], "E": 2}], "path": {}}}
  connect(trans.p3, pos_3) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1750, "y": 960}, {"x": 1750, "y": 985}, {"x": 3290, "y": 985}, {"x": 3290, "y": 1050}], "E": 2}], "path": {}}}
    connect(rot.w3, qkin.w3, omega_3) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 1695, "y": 2010}, {"x": 1695, "y": 1560}], "E": 2}, {"S": -1, "M": [{"x": 1670, "y": 2350}], "E": 3}], "path": {}, "junctions": [{"x": 1670, "y": 2010}]}}
  connect(qkin.q0, qw) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 2840, "y": 1120}, {"x": 2840, "y": 1200}], "E": 2}], "path": {}}}
  connect(qkin.q1, qx) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 2830, "y": 1280}, {"x": 2830, "y": 1350}], "E": 2}], "path": {}}}
  connect(qkin.q2, qy) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 2820, "y": 1440}, {"x": 2820, "y": 1500}], "E": 2}], "path": {}}}
  connect(qkin.q3, qz) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 2810, "y": 1600}, {"x": 2810, "y": 1650}], "E": 2}], "path": {}}}
metadata {"Dyad": {"icons": {"default": "dyad://HL20Demo/dynamics6.svg"}}}
end