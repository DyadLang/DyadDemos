    connect(rot.w1, qkin.w1, omega_1) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 1690, "y": 1160}], "E": 2}, {"S": -1, "M": [{"x": 1760, "y": 1610}, {"x": 1760, "y": 2050}], "E": 3}], "path": {}, "junctions": [{"x": 1690, "y": 1610}]}}
