"""
Airspeed and aero angles from body-axis velocity [u,v,w]: total airspeed,
angle of attack alpha and sideslip beta in degrees plus the sine/cosine
signals the control laws consume.
"""
component AeroAngles
  "Body velocity, forward (m/s)"
  u = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 20, "x2": 30, "y2": 80},
        "diagram": {"x1": -30, "x2": 30, "y1": 420, "y2": 480}
      }
    }
  }
  "Body velocity, right (m/s)"
  v = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 220, "x2": 30, "y2": 280},
        "diagram": {"x1": -30, "x2": 30, "y1": 720, "y2": 780}
      }
    }
  }
  "Body velocity, down (m/s)"
  w = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 420, "x2": 30, "y2": 480},
        "diagram": {"x1": -30, "x2": 30, "y1": 1020, "y2": 1080}
      }
    }
  }
  "Total airspeed (m/s)"
  v_scalar = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 970, "y1": 20, "x2": 1030, "y2": 80},
        "diagram": {"x1": 2570, "x2": 2630, "y1": 370, "y2": 430}
      }
    }
  }
  "Angle of attack (deg)"
  alpha_deg = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 970, "y1": 220, "x2": 1030, "y2": 280},
        "diagram": {"x1": 2570, "x2": 2630, "y1": 670, "y2": 730}
      }
    }
  }
  "Sideslip angle (deg)"
  beta_deg = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 970, "y1": 420, "x2": 1030, "y2": 480},
        "diagram": {"x1": 2570, "x2": 2630, "y1": 970, "y2": 1030}
      }
    }
  }
  "sin of angle of attack"
  sin_alpha = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 970, "y1": 620, "x2": 1030, "y2": 680},
        "diagram": {"x1": 2570, "x2": 2630, "y1": 1270, "y2": 1330}
      }
    }
  }
  "cos of angle of attack"
  cos_alpha = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 970, "y1": 820, "x2": 1030, "y2": 880},
        "diagram": {"x1": 2570, "x2": 2630, "y1": 1570, "y2": 1630}
      }
    }
  }
  uu = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 650, "x2": 750, "y1": 800, "y2": 900}}}
  }
  vv = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 650, "x2": 750, "y1": 350, "y2": 450}}}
  }
  ww = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 650, "x2": 750, "y1": 1050, "y2": 1150}}}
  }
  sum_uvw = BlockComponents.Math.Add3() {
    "Dyad": {"placement": {"diagram": {"x1": 900, "x2": 1000, "y1": 450, "y2": 550}}}
  }
  v_eps = BlockComponents.Sources.Constant(k = 1e-6) {
    "Dyad": {"placement": {"diagram": {"x1": 900, "x2": 1000, "y1": 200, "y2": 300}}}
  }
  sum_v = BlockComponents.Math.Add() {
    "Dyad": {"placement": {"diagram": {"x1": 1150, "x2": 1250, "y1": 350, "y2": 450}}}
