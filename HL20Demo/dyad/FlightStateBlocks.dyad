"""
Airspeed and aero angles from body-axis velocity [u,v,w]: total airspeed,
angle of attack alpha and sideslip beta in degrees plus the sine/cosine
signals the control laws consume.
"""
component AeroAngles
  "Body velocity, forward (m/s)"
  u = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 0, "x2": 50, "y2": 100},
        "diagram": {"x1": -50, "x2": 50, "y1": 400, "y2": 500}
      }
    }
  }
  "Body velocity, right (m/s)"
  v = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 200, "x2": 50, "y2": 300},
        "diagram": {"x1": -50, "x2": 50, "y1": 700, "y2": 800}
      }
    }
  }
  "Body velocity, down (m/s)"
  w = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 400, "x2": 50, "y2": 500},
        "diagram": {"x1": -50, "x2": 50, "y1": 1000, "y2": 1100}
      }
    }
  }
  "Total airspeed (m/s)"
  v_scalar = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 0, "x2": 1050, "y2": 100},
        "diagram": {"x1": 2550, "x2": 2650, "y1": 350, "y2": 450}
      }
    }
  }
  "Angle of attack (deg)"
  alpha_deg = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 200, "x2": 1050, "y2": 300},
        "diagram": {"x1": 2550, "x2": 2650, "y1": 650, "y2": 750}
      }
    }
  }
  "Sideslip angle (deg)"
  beta_deg = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 400, "x2": 1050, "y2": 500},
        "diagram": {"x1": 2550, "x2": 2650, "y1": 950, "y2": 1050}
      }
    }
  }
  "sin of angle of attack"
  sin_alpha = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 600, "x2": 1050, "y2": 700},
        "diagram": {"x1": 2550, "x2": 2650, "y1": 1250, "y2": 1350}
      }
    }
  }
  "cos of angle of attack"
  cos_alpha = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 800, "x2": 1050, "y2": 900},
        "diagram": {"x1": 2550, "x2": 2650, "y1": 1550, "y2": 1650}
      }
    }
  }
  uu = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 650, "x2": 750, "y1": 800, "y2": 900}}}
  }
  vv = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 650, "x2": 750, "y1": 350, "y2": 450}}}
  }
  ww = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 650, "x2": 750, "y1": 1050, "y2": 1150}}}
  }
  sum_uvw = BlockComponents.Math.Add3() {
