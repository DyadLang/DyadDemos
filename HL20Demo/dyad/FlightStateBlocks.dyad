"""
Euler angles of the scalar-first quaternion q = [qw, qx, qy, qz]: roll phi,
pitch theta and yaw psi in degrees plus the sine/cosine signals the
control laws consume.
"""
component EulerAngles
  "Quaternion scalar part"
  qw = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 20, "x2": 30, "y2": 80}, "diagram": {"x1": -30, "x2": 30, "y1": 720, "y2": 780}}}}
  "Quaternion x part"
  qx = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 220, "x2": 30, "y2": 280}, "diagram": {"x1": -30, "x2": 30, "y1": 520, "y2": 580}}}}
  "Quaternion y part"
  qy = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 420, "x2": 30, "y2": 480}, "diagram": {"x1": -30, "x2": 30, "y1": 2420, "y2": 2480}}}}
  "Quaternion z part"
  qz = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 620, "x2": 30, "y2": 680}, "diagram": {"x1": -30, "x2": 30, "y1": 2570, "y2": 2630}}}}
  "Euler roll angle (deg)"
  phi_deg = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 20, "x2": 1030, "y2": 80}, "diagram": {"x1": 2370, "x2": 2430, "y1": 720, "y2": 780}}}}
  "Euler pitch angle (deg)"
  theta_deg = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 170, "x2": 1030, "y2": 230}, "diagram": {"x1": 2370, "x2": 2430, "y1": 1370, "y2": 1430}}}}
  "Euler yaw angle (deg)"
  psi_deg = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 320, "x2": 1030, "y2": 380}, "diagram": {"x1": 2370, "x2": 2430, "y1": 1970, "y2": 2030}}}}
  "sin of Euler roll angle"
  sin_phi = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 470, "x2": 1030, "y2": 530}, "diagram": {"x1": 2370, "x2": 2430, "y1": 970, "y2": 1030}}}}
  "cos of Euler roll angle"
  cos_phi = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 620, "x2": 1030, "y2": 680}, "diagram": {"x1": 2370, "x2": 2430, "y1": 1170, "y2": 1230}}}}
  "cos of Euler pitch angle"
  cos_theta = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 770, "x2": 1030, "y2": 830}, "diagram": {"x1": 2370, "x2": 2430, "y1": 1570, "y2": 1630}}}}
