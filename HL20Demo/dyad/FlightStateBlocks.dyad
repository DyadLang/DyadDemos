"""
Euler angles of the scalar-first quaternion q = [qw, qx, qy, qz]: roll phi,
pitch theta and yaw psi in degrees plus the sine/cosine signals the
control laws consume.
"""
component EulerAngles
  "Quaternion scalar part"
  qw = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 0, "x2": 50, "y2": 100},
        "diagram": {"x1": -50, "x2": 50, "y1": 850, "y2": 950}
      }
    }
  }
  "Quaternion x part"
  qx = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 200, "x2": 50, "y2": 300},
        "diagram": {"x1": -50, "x2": 50, "y1": 650, "y2": 750}
      }
    }
  }
  "Quaternion y part"
  qy = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 400, "x2": 50, "y2": 500},
        "diagram": {"x1": -50, "x2": 50, "y1": 2350, "y2": 2450}
      }
    }
  }
  "Quaternion z part"
  qz = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 600, "x2": 50, "y2": 700},
        "diagram": {"x1": -50, "x2": 50, "y1": 2150, "y2": 2250}
      }
    }
  }
  "Euler roll angle (deg)"
  phi_deg = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 0, "x2": 1050, "y2": 100},
        "diagram": {"x1": 1500, "x2": 1600, "y1": -50, "y2": 50}
      }
    }
  }
  "Euler pitch angle (deg)"
  theta_deg = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 150, "x2": 1050, "y2": 250},
        "diagram": {"x1": 2350, "x2": 2450, "y1": 1250, "y2": 1350}
      }
    }
  }
  "Euler yaw angle (deg)"
  psi_deg = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 300, "x2": 1050, "y2": 400},
        "diagram": {"x1": 2350, "x2": 2450, "y1": 1950, "y2": 2050}
      }
    }
  }
  "sin of Euler roll angle"
  sin_phi = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550},
        "diagram": {"x1": 2350, "x2": 2450, "y1": 850, "y2": 950}
      }
    }
  }
  "cos of Euler roll angle"
  cos_phi = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 600, "x2": 1050, "y2": 700},
        "diagram": {"x1": 2350, "x2": 2450, "y1": 1050, "y2": 1150}
      }
    }
  }
  "cos of Euler pitch angle"
  cos_theta = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 750, "x2": 1050, "y2": 850},
        "diagram": {"x1": 2350, "x2": 2450, "y1": 1500, "y2": 1600}
      }
    }
  }
