"HL-20 roll-rate damper with asymmetric stick gain (TM-107580 section 4.1)."
component RollControl
  DWPILOT = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 150, "x2": 50, "y2": 250},
        "diagram": {"x1": -50, "x2": 50, "y1": 200, "y2": 300}
      }
    }
  }
  PDEG = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 283, "y1": 950, "x2": 383, "y2": 1050},
        "diagram": {"x1": -50, "x2": 50, "y1": 900, "y2": 1000}
      }
    }
  }
  DACMD = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550},
        "diagram": {"x1": 1450, "x2": 1550, "y1": 750, "y2": 850}
      }
    }
  }
  parameter GDADWL::Real = 0.67
  parameter GDADWR::Real = 0.67
  parameter GDAP::Real = -1.4
  gl = BlockComponents.Math.Gain(k = GDADWL) {
    "Dyad": {"placement": {"diagram": {"x1": 300, "x2": 400, "y1": 200, "y2": 300}}}
  }
  gr = BlockComponents.Math.Gain(k = GDADWR) {
    "Dyad": {"placement": {"diagram": {"x1": 300, "x2": 400, "y1": 450, "y2": 550}}}
  }
  sel = Switch(threshold = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 500, "y2": 600}}}
  }
  dap = BlockComponents.Math.Gain(k = GDAP) {
    "Dyad": {"placement": {"diagram": {"x1": 300, "x2": 400, "y1": 900, "y2": 1000}}}
  }
  sum = BlockComponents.Math.Add() {
    "Dyad": {"placement": {"diagram": {"x1": 800, "x2": 900, "y1": 750, "y2": 850}}}
  }
  lim = BlockComponents.Nonlinear.Limiter(y_min = -30.0, y_max = 30.0) {
    "Dyad": {"placement": {"diagram": {"x1": 1050, "x2": 1150, "y1": 750, "y2": 850}}}
  }
relations
  connect(DWPILOT, gl.u) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(DWPILOT, gr.u) {
    "Dyad": {
