"""
HL-20 yaw damper with rudder washout and Mach-scheduled aileron-rudder
interconnect (TM-107580 section 4.1).
"""
component YawControl
  DPPILOT = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 100, "x2": 50, "y2": 200},
        "diagram": {"x1": -50, "x2": 50, "y1": 200, "y2": 300}
      }
    }
  }
  RDEG = RealInput() {
    "Dyad": {
      "placement": {"icon": {"iconName": "default", "x1": -50, "y1": 300, "x2": 50, "y2": 400}}
    }
  }
  DACMD = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 500, "x2": 50, "y2": 600},
        "diagram": {"x1": -50, "x2": 50, "y1": 750, "y2": 850}
      }
    }
  }
  MACH = RealInput() {
    "Dyad": {
      "placement": {"icon": {"iconName": "default", "x1": -50, "y1": 700, "x2": 50, "y2": 800}}
    }
  }
  DRCMD = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550},
        "diagram": {"x1": 1950, "x2": 2050, "y1": 300, "y2": 400}
      }
    }
  }
  parameter GDRDP::Real = -11.1
  parameter GDRDA::Real = -0.01
  parameter GRSAS::Real = 40.0
  parameter TAU_WASH::Real = 2.0
  parameter RBWASH0::Real = 0.0
  drdir = BlockComponents.Math.Gain(k = GDRDP) {
    "Dyad": {"placement": {"diagram": {"x1": 1300, "x2": 1400, "y1": 200, "y2": 300}}}
  }
  wash = BlockComponents.Continuous.FirstOrder(T = TAU_WASH, k = 1.0) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 300, "y2": 400}}}
  }
  g_const = BlockComponents.Sources.Constant(k = GDRDA) {
    "Dyad": {"placement": {"diagram": {"x1": 300, "x2": 400, "y1": 450, "y2": 550}}}
  }
  z_const = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 300, "x2": 400, "y1": 700, "y2": 800}}}
  }
  gsel = Switch(threshold = 0.9) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 750, "y2": 850}}}
  }
  wash_err = BlockComponents.Math.Add(k2 = -1.0) {
    "Dyad": {"placement": {"diagram": {"x1": 800, "x2": 900, "y1": 350, "y2": 450}}}
  }
  g_wash = BlockComponents.Math.Gain(k = GRSAS * 0.01745) {
    "Dyad": {"placement": {"diagram": {"x1": 1050, "x2": 1150, "y1": 450, "y2": 550}}}
  }
  ari = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 800, "x2": 900, "y1": 750, "y2": 850}}}
  }
  drsas = BlockComponents.Math.Add() {
    "Dyad": {"placement": {"diagram": {"x1": 1300, "x2": 1400, "y1": 450, "y2": 550}}}
  }
  drcmd = BlockComponents.Math.Add() {
    "Dyad": {"placement": {"diagram": {"x1": 1550, "x2": 1650, "y1": 300, "y2": 400}}}
  }
relations
  connect(DPPILOT, drdir.u) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(RDEG, wash.u) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(MACH, gsel.u_sel) {
