"""
HL-20 yaw damper with rudder washout and Mach-scheduled aileron-rudder
interconnect (TM-107580 section 4.1).
"""
component YawControl
  DPPILOT = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 100, "x2": 50, "y2": 200},
        "diagram": {"x1": -50, "x2": 50, "y1": 1050, "y2": 1150}
      }
    }
  }
  RDEG = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 550, "y1": 950, "x2": 650, "y2": 1050},
        "diagram": {"x1": -50, "x2": 50, "y1": 625, "y2": 675}
      }
    }
  }
  DACMD = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 500, "x2": 50, "y2": 600},
        "diagram": {"x1": -50, "x2": 50, "y1": 525, "y2": 575}
      }
    }
  }
  MACH = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 150, "y1": 950, "x2": 250, "y2": 1050},
        "diagram": {"x1": -50, "x2": 50, "y1": 350, "y2": 450}
      }
    }
  }
  DRCMD = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550},
        "diagram": {"x1": 2350, "x2": 2450, "y1": 900, "y2": 1000}
      }
    }
  }
  parameter GDRDP::Real = -11.1
  parameter GDRDA::Real = -0.01
  parameter GRSAS::Real = 40.0
  parameter TAU_WASH::Real = 2.0
  parameter RBWASH0::Real = 0.0
  drdir = BlockComponents.Math.Gain(k = GDRDP) {
    "Dyad": {"placement": {"diagram": {"x1": 700, "x2": 800, "y1": 1050, "y2": 1150}}}
  }
  wash = BlockComponents.Continuous.FirstOrder(T = TAU_WASH, k = 1.0) {
    "Dyad": {"placement": {"diagram": {"x1": 700, "x2": 800, "y1": 600, "y2": 700}}}
  }
  g_const = BlockComponents.Sources.Constant(k = GDRDA) {
    "Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 200, "y2": 300}}}
  }
  z_const = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 450, "y2": 550}}}
  }
  gsel = Switch(threshold = 0.9) {
    "Dyad": {"placement": {"diagram": {"x1": 700, "x2": 800, "y1": 350, "y2": 450}}}
  }
  wash_err = BlockComponents.Math.Add(k2 = -1.0) {
    "Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 700, "y2": 800}}}
  }
  g_wash = BlockComponents.Math.Gain(k = GRSAS * 0.01745) {
    "Dyad": {"placement": {"diagram": {"x1": 1200, "x2": 1300, "y1": 700, "y2": 800}}}
  }
  ari = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 350, "y2": 450}}}
  }
  drsas = BlockComponents.Math.Add() {
    "Dyad": {"placement": {"diagram": {"x1": 1450, "x2": 1550, "y1": 700, "y2": 800}}}
  }
  drcmd = BlockComponents.Math.Add() {
    "Dyad": {"placement": {"diagram": {"x1": 1700, "x2": 1800, "y1": 900, "y2": 1000}}}
  }
relations
  connect(DPPILOT, drdir.u) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(RDEG, wash.u) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(MACH, gsel.u_sel) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
