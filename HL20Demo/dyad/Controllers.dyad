"""
HL-20 manual-mode speedbrake law: DSBDIR = DSBSF1*u + DSBSF2*u^2 (TM-107580
section 4.1).
"""
component SpeedControl
  DLSBCOM = RealInput() {
    "Dyad": {
      "placement": {"icon": {"iconName": "default", "x1": -50, "y1": 450, "x2": 50, "y2": 550}}
    }
  }
  DSBCMD = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550},
        "diagram": {"x1": 1150, "x2": 1250, "y1": 250, "y2": 350}
      }
    }
  }
  parameter DSBSF1::Real = 0.0
  parameter DSBSF2::Real = 0.0375
  u2 = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 300, "x2": 400, "y1": 450, "y2": 550}}}
  }
  g1 = BlockComponents.Math.Gain(k = DSBSF1) {
    "Dyad": {"placement": {"diagram": {"x1": 300, "x2": 400, "y1": 200, "y2": 300}}}
  }
  g2 = BlockComponents.Math.Gain(k = DSBSF2) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 400, "y2": 500}}}
  }
  sum = BlockComponents.Math.Add() {
    "Dyad": {"placement": {"diagram": {"x1": 800, "x2": 900, "y1": 250, "y2": 350}}}
  }
relations
  connect(DLSBCOM, u2.u1) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 250, "y": 500}, {"x": 250, "y": 470}], "E": 2}],
      "path": {}
    }
  }
  connect(DLSBCOM, u2.u2) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 250, "y": 500}, {"x": 250, "y": 530}], "E": 2}],
      "path": {}
    }
  }
  connect(DLSBCOM, g1.u) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 200, "y": 500}, {"x": 200, "y": 250}], "E": 2}],
      "path": {}
