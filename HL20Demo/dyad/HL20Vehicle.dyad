"""
HL-20 vehicle plant: wires RigidBody6DOF, AirData, FlightState,
HL20Aero and AeroForceBuilder into the closed airframe model and exposes the
feedback signals the control laws consume. Unit conversions live in
AirData and VehicleOutputs.
"""
component HL20Vehicle
  # Control-surface deflection commands (deg)
  DBFUL = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 120, "x2": 30, "y2": 180}, "diagram": {"x1": 2266, "x2": 2314, "y1": 3420, "y2": 3480}}}}
  DBFUR = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 220, "x2": 30, "y2": 280}, "diagram": {"x1": 2326, "x2": 2374, "y1": 3420, "y2": 3480}}}}
  DBFLL = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 320, "x2": 30, "y2": 380}, "diagram": {"x1": 2386, "x2": 2434, "y1": 3420, "y2": 3480}}}}
  DBFLR = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 420, "x2": 30, "y2": 480}, "diagram": {"x1": 2446, "x2": 2494, "y1": 3420, "y2": 3480}}}}
  DWFL = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 520, "x2": 30, "y2": 580}, "diagram": {"x1": 2506, "x2": 2554, "y1": 3420, "y2": 3480}}}}
  DWFR = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 620, "x2": 30, "y2": 680}, "diagram": {"x1": 2566, "x2": 2614, "y1": 3420, "y2": 3480}}}}
  DRUD = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 720, "x2": 30, "y2": 780}, "diagram": {"x1": 2626, "x2": 2674, "y1": 3420, "y2": 3480}}}}
  parameter ft_per_m::Real = 3.28084
  parameter BSPAN::Real = 13.89
  parameter mass::Real = 8664.1
  parameter g::Real = 9.81
  parameter rho_sl::Real = 0.002378
  parameter knots_per_fps::Real = 0.592484
  parameter p1_0::Real = 0.0
  parameter p2_0::Real = 0.0
  parameter p3_0::Real = -3048.0
  parameter v1_0::Real = 170.678
  parameter v2_0::Real = 0.0
  parameter v3_0::Real = 52.18176
  parameter q0_0::Real = 0.9950556
  parameter q1_0::Real = 0.0
  parameter q2_0::Real = -0.09932
  parameter q3_0::Real = 0.0
  parameter w1_0::Real = 0.0
  parameter w2_0::Real = 0.0
  parameter w3_0::Real = 0.0
  # Feedback outputs (spec section 8)
  POS_3 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 755, "x2": 1030, "y2": 795}, "diagram": {"x1": 4720, "x2": 4780, "y1": 850, "y2": 910}}}}
  ALPHA_DEG = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 970, "y1": 0, "x2": 1030, "y2": 50},
        "diagram": {"x1": 4720, "y1": 1070, "x2": 4780, "y2": 1130}
      }
    }
  }
  BETADEG = RealOutput() {
