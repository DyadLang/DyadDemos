"""
HL-20 vehicle dynamics: 6-DOF rigid body, flight-state resolver, air-data
computer and aerodynamic force builder wired as one package.
"""
component VehicleDynamics
  alpha_deg = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "x2": 1030, "y1": 88.33333333333334, "y2": 128.33333333333334}, "diagram": {"x1": 1580, "x2": 1640, "y1": 1595, "y2": 1655}}}}
  beta_deg = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "x2": 1030, "y1": 138.33333333333331, "y2": 178.33333333333331}, "diagram": {"x1": 1580, "x2": 1640, "y1": 1715, "y2": 1775}}}}
  mach = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "x2": 1030, "y1": 188.33333333333334, "y2": 228.33333333333334}, "diagram": {"x1": 2150, "x2": 2210, "y1": 1040, "y2": 1100}}}}
  v_fps = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "x2": 1030, "y1": 238.33333333333337, "y2": 278.33333333333337}, "diagram": {"x1": 2220, "x2": 2280, "y1": 1165.875, "y2": 1225.875}}}}
  hob = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "x2": 1030, "y1": 288.33333333333337, "y2": 328.33333333333337}, "diagram": {"x1": 2150, "x2": 2210, "y1": 1224.875, "y2": 1284.875}}}}
  pb = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "x2": 1030, "y1": 338.3333333333333, "y2": 378.3333333333333}, "diagram": {"x1": 1780, "x2": 1840, "y1": 2080, "y2": 2140}}}}
  p_rad = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 70, "x2": 130, "y1": 970, "y2": 1030}, "diagram": {"x1": 1850, "x2": 1910, "y1": 2060, "y2": 2120}}}}
  qb = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "x2": 1030, "y1": 388.3333333333333, "y2": 428.3333333333333}, "diagram": {"x1": 835, "x2": 895, "y1": 2300, "y2": 2360}}}}
  q_rad = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 270, "x2": 330, "y1": 970, "y2": 1030}, "diagram": {"x1": 1000, "x2": 1060, "y1": 2300, "y2": 2360}}}}
  rb = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "x2": 1030, "y1": 438.3333333333333, "y2": 478.3333333333333}, "diagram": {"x1": 2190, "x2": 2250, "y1": 2210, "y2": 2270}}}}
  r_rad = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 470, "x2": 530, "y1": 970, "y2": 1030}, "diagram": {"x1": 2190, "x2": 2250, "y1": 2330, "y2": 2390}}}}
  Fz_body = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 670, "x2": 730, "y1": 970, "y2": 1030}, "diagram": {"x1": 920, "x2": 980, "y1": 3380, "y2": 3440}}}}
  pos_3 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "x2": 1030, "y1": 938.3333333333334, "y2": 978.3333333333334}, "diagram": {"x1": 1070, "x2": 1130, "y1": 850, "y2": 910}}}}
  sin_phi = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "x2": 1030, "y1": 588.3333333333333, "y2": 628.3333333333333}, "diagram": {"x1": 1515, "x2": 1575, "y1": 1788, "y2": 1848}}}}
  cos_phi = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "x2": 1030, "y1": 638.3333333333334, "y2": 678.3333333333334}, "diagram": {"x1": 1610, "x2": 1670, "y1": 1970, "y2": 2030}}}}
  cos_theta = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "x2": 1030, "y1": 688.3333333333334, "y2": 728.3333333333334}, "diagram": {"x1": 1530, "x2": 1590, "y1": 1920, "y2": 1980}}}}
  bdot = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "x2": 1030, "y1": 738.3333333333333, "y2": 778.3333333333333}, "diagram": {"x1": 1800, "x2": 1860, "y1": 940, "y2": 1000}}}}
  eas_kts = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "x2": 1030, "y1": 788.3333333333334, "y2": 828.3333333333334}, "diagram": {"x1": 1890, "x2": 1950, "y1": 790, "y2": 850}}}}
  alt_ft = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "x2": 1030, "y1": 838.3333333333333, "y2": 878.3333333333333}, "diagram": {"x1": 2040, "x2": 2100, "y1": 990, "y2": 1050}}}}
  qbar_psf = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "x2": 1030, "y1": 888.3333333333334, "y2": 928.3333333333334}, "diagram": {"x1": 2000, "x2": 2060, "y1": 830, "y2": 890}}}}
  CX = RealInput() {"Dyad": {"placement": {"icon": {"x1": 720, "x2": 780, "y1": -30, "y2": 30}, "diagram": {"x1": 470, "x2": 530, "y1": 2510, "y2": 2570}}}}
  CY = RealInput() {"Dyad": {"placement": {"icon": {"x1": 586.6666666666667, "x2": 646.6666666666667, "y1": -30, "y2": 30}, "diagram": {"x1": 385, "x2": 445, "y1": 2590, "y2": 2650}}}}
  CZ = RealInput() {"Dyad": {"placement": {"icon": {"x1": 453.3333333333333, "x2": 513.3333333333333, "y1": -30, "y2": 30}, "diagram": {"x1": 470, "x2": 530, "y1": 2670, "y2": 2730}}}}
  Cl = RealInput() {"Dyad": {"placement": {"icon": {"x1": 320, "x2": 380, "y1": -30, "y2": 30}, "diagram": {"x1": 385, "x2": 445, "y1": 2750, "y2": 2810}}}}
  Cm = RealInput() {"Dyad": {"placement": {"icon": {"x1": 186.66666666666669, "x2": 246.66666666666669, "y1": -30, "y2": 30}, "diagram": {"x1": 470, "x2": 530, "y1": 2830, "y2": 2890}}}}
  Cn = RealInput() {"Dyad": {"placement": {"icon": {"x1": 53.33333333333333, "x2": 113.33333333333333, "y1": -30, "y2": 30}, "diagram": {"x1": 385, "x2": 445, "y1": 2910, "y2": 2970}}}}
  body = RigidBody6DOF(mass=mass, g=g, p1_0=p1_0, p2_0=p2_0, p3_0=p3_0, v1_0=v1_0, v2_0=v2_0, v3_0=v3_0, q0_0=q0_0, q1_0=q1_0, q2_0=q2_0, q3_0=q3_0, w1_0=w1_0, w2_0=w2_0, w3_0=w3_0) {"Dyad": {"placement": {"diagram": {"x1": 600, "x2": 800, "y1": 1500, "y2": 2300, "rot": 0}}}}
  flight = FlightState() {"Dyad": {"placement": {"diagram": {"x1": 1300, "x2": 1500, "y1": 1400, "y2": 2130, "rot": 0}}}}
  airdata = AirData(ft_per_m=ft_per_m, BSPAN=BSPAN, rho_sl=rho_sl, knots_per_fps=knots_per_fps) {"Dyad": {"placement": {"diagram": {"x1": 1700, "x2": 2100, "y1": 1100, "y2": 1690, "rot": 0}}}}
  forces = AeroForceBuilder() {"Dyad": {"placement": {"diagram": {"x1": 550, "x2": 850, "y1": 2500, "y2": 3300, "rot": 0}}}}
  parameter ft_per_m::Real = 3.28084
  parameter BSPAN::Real = 13.89
  parameter mass::Real = 8664.1
  parameter g::Real = 9.81
  parameter rho_sl::Real = 0.002378
  parameter knots_per_fps::Real = 0.592484
  parameter p1_0::Real = 0.0
  parameter p2_0::Real = 0.0
  parameter p3_0::Real = -3048.0
  parameter v1_0::Real = 170.678
  parameter v2_0::Real = 0.0
  parameter v3_0::Real = 52.18176
  parameter q0_0::Real = 0.9950556
  parameter q1_0::Real = 0.0
  parameter q2_0::Real = -0.09932
  parameter q3_0::Real = 0.0
  parameter w1_0::Real = 0.0
  parameter w2_0::Real = 0.0
  parameter w3_0::Real = 0.0
relations
  connect(body.vel_1, flight.vel_1) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 820, "y": 1640}, {"x": 820, "y": 1605}, {"x": 1210, "y": 1605}, {"x": 1210, "y": 1436.5}], "E": 2}], "path": {}} }
