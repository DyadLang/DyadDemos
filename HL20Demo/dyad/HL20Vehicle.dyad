  # Airframe dynamics
  body = RigidBody6DOF(mass=mass, g=g, p1_0=p1_0, p2_0=p2_0, p3_0=p3_0, v1_0=v1_0, v2_0=v2_0, v3_0=v3_0, q0_0=q0_0, q1_0=q1_0, q2_0=q2_0, q3_0=q3_0, w1_0=w1_0, w2_0=w2_0, w3_0=w3_0) {
    "Dyad": {"placement": {"diagram": {"x1": 600, "y1": 1500, "x2": 800, "y2": 2300}}}
  }
  airdata = AirData(ft_per_m=ft_per_m, BSPAN=BSPAN, rho_sl=rho_sl, knots_per_fps=knots_per_fps) {
    "Dyad": {"placement": {"diagram": {"x1": 1700, "y1": 1540, "x2": 2100, "y2": 2130}}}
  }
  flight = FlightState() {
    "Dyad": {"placement": {"diagram": {"x1": 1300, "y1": 1400, "x2": 1500, "y2": 2130}}}
  }
  aero = HL20Demo.shared.HL20Aero() {
    "Dyad": {"placement": {"diagram": {"x1": 2300, "y1": 1400, "x2": 2700, "y2": 2200}}}
  }
  forces = AeroForceBuilder() {
    "Dyad": {"placement": {"diagram": {"x1": 3100, "y1": 1400, "x2": 3300, "y2": 2130}}}
  }
  vout = VehicleOutputs(mass=mass, g=g) {
    "Dyad": {"placement": {"diagram": {"x1": 4050, "y1": 2500, "x2": 4350, "y2": 2900}}}
  }
