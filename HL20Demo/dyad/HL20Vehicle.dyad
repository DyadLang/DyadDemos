"""
HL-20 vehicle plant: wires RigidBody6DOF, AirData, FlightState,
HL20Aero and AeroForceBuilder into the closed airframe model and exposes the
feedback signals the control laws consume. Unit conversions live in
AirData and VehicleOutputs.
"""
component HL20Vehicle
  # Control-surface deflection commands (deg)
  DBFUL = RealInput() {"Dyad": {"placement": {"icon": {"x1": -45, "x2": 45, "y1": 5, "y2": 95}, "diagram": {"x1": 2070.0, "x2": 2170.0, "y1": 2210.0, "y2": 2310.0}}}}
  DBFUR = RealInput() {"Dyad": {"placement": {"icon": {"x1": -45, "x2": 45, "y1": 155, "y2": 245}, "diagram": {"x1": 2130.0, "x2": 2230.0, "y1": 2330.0, "y2": 2430.0}}}}
  DBFLL = RealInput() {"Dyad": {"placement": {"icon": {"x1": -45, "x2": 45, "y1": 305, "y2": 395}, "diagram": {"x1": 2190.0, "x2": 2290.0, "y1": 2210.0, "y2": 2310.0}}}}
  DBFLR = RealInput() {"Dyad": {"placement": {"icon": {"x1": -45, "x2": 45, "y1": 455, "y2": 545}, "diagram": {"x1": 2250.0, "x2": 2350.0, "y1": 2330.0, "y2": 2430.0}}}}
  DWFL = RealInput() {"Dyad": {"placement": {"icon": {"x1": -45, "x2": 45, "y1": 605, "y2": 695}, "diagram": {"x1": 2310.0, "x2": 2410.0, "y1": 2210.0, "y2": 2310.0}}}}
  DWFR = RealInput() {"Dyad": {"placement": {"icon": {"x1": -45, "x2": 45, "y1": 755, "y2": 845}, "diagram": {"x1": 2370.0, "x2": 2470.0, "y1": 2330.0, "y2": 2430.0}}}}
  DRUD = RealInput() {"Dyad": {"placement": {"icon": {"x1": -45, "x2": 45, "y1": 905, "y2": 995}, "diagram": {"x1": 2430.0, "x2": 2530.0, "y1": 2210.0, "y2": 2310.0}}}}
  parameter ft_per_m::Real = 3.28084
  parameter BSPAN::Real = 13.89
  parameter mass::Real = 8664.1
  parameter g::Real = 9.81
  parameter rho_sl::Real = 0.002378
  parameter knots_per_fps::Real = 0.592484
  parameter p1_0::Real = 0.0
  parameter p2_0::Real = 0.0
  parameter p3_0::Real = -3048.0
  parameter v1_0::Real = 170.678
  parameter v2_0::Real = 0.0
  parameter v3_0::Real = 52.18176
  parameter q0_0::Real = 0.9950556
  parameter q1_0::Real = 0.0
  parameter q2_0::Real = -0.09932
  parameter q3_0::Real = 0.0
  parameter w1_0::Real = 0.0
  parameter w2_0::Real = 0.0
  parameter w3_0::Real = 0.0
  # Feedback outputs (spec section 8)
  POS_3 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 980, "x2": 1020, "y1": 930, "y2": 970}, "diagram": {"x1": 4600.0, "x2": 4700.0, "y1": 1450.0, "y2": 1550.0}}}}
  ALPHA_DEG = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 980, "x2": 1020, "y1": 30, "y2": 70}, "diagram": {"x1": 4600.0, "x2": 4700.0, "y1": 2050.0, "y2": 2150.0}}}}
  BETADEG = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 980, "x2": 1020, "y1": 90, "y2": 130}, "diagram": {"x1": 4600.0, "x2": 4700.0, "y1": 2200.0, "y2": 2300.0}}}}
  SINPHI = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 980, "x2": 1020, "y1": 450, "y2": 490}, "diagram": {"x1": 4600.0, "x2": 4700.0, "y1": 1750.0, "y2": 1850.0}}}}
  COSPHI = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 980, "x2": 1020, "y1": 510, "y2": 550}, "diagram": {"x1": 4600.0, "x2": 4700.0, "y1": 1900.0, "y2": 2000.0}}}}
  COSTHE = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 980, "x2": 1020, "y1": 570, "y2": 610}, "diagram": {"x1": 4600.0, "x2": 4700.0, "y1": 1600.0, "y2": 1700.0}}}}
  BETADOT = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 980, "x2": 1020, "y1": 150, "y2": 190}, "diagram": {"x1": 4600.0, "x2": 4700.0, "y1": 2350.0, "y2": 2450.0}}}}
  EAS = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 980, "x2": 1020, "y1": 690, "y2": 730}, "diagram": {"x1": 4600.0, "x2": 4700.0, "y1": 2500.0, "y2": 2600.0}}}}
  QBAR = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 980, "x2": 1020, "y1": 630, "y2": 670}, "diagram": {"x1": 4600.0, "x2": 4700.0, "y1": 2950.0, "y2": 3050.0}}}}
  ALT_FT = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 980, "x2": 1020, "y1": 870, "y2": 910}, "diagram": {"x1": 4600.0, "x2": 4700.0, "y1": 3100.0, "y2": 3200.0}}}}
  MACH_out = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 980, "x2": 1020, "y1": 210, "y2": 250}, "diagram": {"x1": 4600.0, "x2": 4700.0, "y1": 2800.0, "y2": 2900.0}}}}
  V_FPS = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 980, "x2": 1020, "y1": 810, "y2": 850}, "diagram": {"x1": 4600.0, "x2": 4700.0, "y1": 2650.0, "y2": 2750.0}}}}
  PDEG = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 980, "x2": 1020, "y1": 270, "y2": 310}, "diagram": {"x1": 3120.0, "x2": 3220.0, "y1": 3000.0, "y2": 3100.0}}}}
  QDEG = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 980, "x2": 1020, "y1": 330, "y2": 370}, "diagram": {"x1": 3010.0, "x2": 3110.0, "y1": 3000.0, "y2": 3100.0}}}}
  RDEG = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 980, "x2": 1020, "y1": 390, "y2": 430}, "diagram": {"x1": 2900.0, "x2": 3000.0, "y1": 3000.0, "y2": 3100.0}}}}
  NZ = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 980, "x2": 1020, "y1": 750, "y2": 790}, "diagram": {"x1": 2780.0, "x2": 2880.0, "y1": 3000.0, "y2": 3100.0}}}}
  # Airframe dynamics
  body = RigidBody6DOF(mass=mass, g=g, p1_0=p1_0, p2_0=p2_0, p3_0=p3_0, v1_0=v1_0, v2_0=v2_0, v3_0=v3_0, q0_0=q0_0, q1_0=q1_0, q2_0=q2_0, q3_0=q3_0, w1_0=w1_0, w2_0=w2_0, w3_0=w3_0) {"Dyad": {"placement": {"diagram": {"x1": 300, "y1": 1400, "x2": 700, "y2": 2400}}}}
  airdata = AirData(ft_per_m=ft_per_m, BSPAN=BSPAN, rho_sl=rho_sl, knots_per_fps=knots_per_fps) {"Dyad": {"placement": {"diagram": {"x1": 1400, "y1": 1650, "x2": 1800, "y2": 2100}}}}
  flight = FlightState() {"Dyad": {"placement": {"diagram": {"x1": 900, "y1": 1650, "x2": 1200, "y2": 2150}}}}
  aero = HL20Demo.shared.HL20Aero() {"Dyad": {"placement": {"diagram": {"x1": 2100, "y1": 1400, "x2": 2500, "y2": 2200}}}}
  forces = AeroForceBuilder() {"Dyad": {"placement": {"diagram": {"x1": 2800, "y1": 1400, "x2": 3200, "y2": 2200}}}}
  vout = VehicleOutputs(mass=mass, g=g) {"Dyad": {"placement": {"diagram": {"x1": 2510, "y1": 2500, "x2": 2910, "y2": 2900}}}}
relations
  connect(body.vel_1, flight.vel_1) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(body.vel_2, flight.vel_2) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(body.vel_3, flight.vel_3) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
                    connect(body.qw, flight.qw, forces.qw) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [], "E": 2}, {"S": -1, "M": [{"x": 890, "y": 2440}, {"x": 2820, "y": 2440}], "E": 3}], "path": {}, "junctions": [{"x": 890, "y": 1900}]}}
                    connect(body.qx, flight.qx, forces.qx) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [], "E": 2}, {"S": -1, "M": [{"x": 860, "y": 2453}, {"x": 2940, "y": 2453}], "E": 3}], "path": {}, "junctions": [{"x": 860, "y": 1975}]}}
                    connect(body.qy, flight.qy, forces.qy) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [], "E": 2}, {"S": -1, "M": [{"x": 830, "y": 2466}, {"x": 3060, "y": 2466}], "E": 3}], "path": {}, "junctions": [{"x": 830, "y": 2050}]}}
                    connect(body.qz, flight.qz, forces.qz) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [], "E": 2}, {"S": -1, "M": [{"x": 800, "y": 2480}, {"x": 3180, "y": 2480}], "E": 3}], "path": {}, "junctions": [{"x": 800, "y": 2125}]}}
                        connect(body.omega_1, airdata.p_rad, aero.pb, vout.p_rad) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 740, "y": 2200}], "E": -1}, {"S": -1, "M": [], "E": -2}, {"S": -2, "M": [], "E": 2}, {"S": -2, "M": [{"x": 1810, "y": 2155}, {"x": 1810, "y": 2080}], "E": -3}, {"S": -3, "M": [{"x": 1950, "y": 1954.32}], "E": 3}, {"S": -1, "M": [{"x": 740, "y": 2950}, {"x": 2530, "y": 2950}], "E": 4}], "path": {}, "junctions": [{"x": 740, "y": 2155}, {"x": 1420, "y": 2155}, {"x": 1950, "y": 2080}]}}
                        connect(body.omega_2, aero.qb, vout.q_rad) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 755, "y": 2275}, {"x": 755, "y": 2160}, {"x": 1980, "y": 2160}, {"x": 1980, "y": 2057.12}], "E": 2}, {"S": -1, "M": [{"x": 730, "y": 2965}, {"x": 2650, "y": 2965}], "E": 3}], "path": {}, "junctions": [{"x": 730, "y": 2275}]}}
                        connect(body.omega_3, airdata.r_rad, aero.rb, vout.r_rad) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 760, "y": 2350}, {"x": 760, "y": 2153}], "E": -2}, {"S": -2, "M": [], "E": 2}, {"S": -2, "M": [], "E": -3}, {"S": -3, "M": [{"x": 1955, "y": 2160}], "E": 3}, {"S": -1, "M": [{"x": 715, "y": 2980}, {"x": 2770, "y": 2980}], "E": 4}], "path": {}, "junctions": [{"x": 715, "y": 2350}, {"x": 1780, "y": 2153}, {"x": 1955, "y": 2153}]}}
                connect(body.pos_3, airdata.pos_m, POS_3) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 760, "y": 710}, {"x": 1190, "y": 710}, {"x": 1190, "y": 1650}], "E": 2}, {"S": -1, "M": [{"x": 780, "y": 1600}, {"x": 780, "y": 700}, {"x": 4599, "y": 700}, {"x": 4599, "y": 1500}, {"x": 4645, "y": 1500}], "E": 3}], "path": {}, "junctions": [{"x": 760, "y": 1600}]}}
  connect(flight.v_scalar, airdata.v_mps) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1205, "y": 1778.85}, {"x": 1205, "y": 1672.5}], "E": 2}], "path": {}}}
  connect(flight.sin_alpha, airdata.sin_alpha) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1395, "y": 2090.4}, {"x": 1395, "y": 1875.0}], "E": 2}], "path": {}}}
  connect(flight.cos_alpha, airdata.cos_alpha) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1390, "y": 2125}, {"x": 1390, "y": 2077.5}], "E": 2}], "path": {}}}
          connect(flight.alpha_deg, aero.alpha_deg, ALPHA_DEG) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1205, "y": 1813.45}], "E": -1}, {"S": -1, "M": [], "E": -2}, {"S": -2, "M": [{"x": 2090, "y": 1440}], "E": 2}, {"S": -2, "M": [{"x": 2090, "y": 1110}, {"x": 4575, "y": 1110}, {"x": 4575, "y": 2100}, {"x": 4645, "y": 2100}], "E": 3}], "path": {}, "junctions": [{"x": 1205, "y": 1185}, {"x": 2090, "y": 1185}]}}
