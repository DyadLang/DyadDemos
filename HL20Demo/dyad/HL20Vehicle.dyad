metadata {"Dyad": {"icons": {"default": "dyad://HL20Demo/vehdyn.svg"}}}
end
"""
HL-20 vehicle plant: wires RigidBody6DOF, AirData, FlightState,
HL20Aero and AeroForceBuilder into the closed airframe model and exposes the
feedback signals the control laws consume. Unit conversions live in
AirData and VehicleOutputs.
"""
component HL20Vehicle
  # Control-surface deflection commands (deg)
  DBFUL = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 325, "y2": 375}, "diagram": {"x1": 2900, "x2": 2960, "y1": 1850, "y2": 1910}}}}
  DBFUR = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 425, "y2": 475}, "diagram": {"x1": 2960, "x2": 3020, "y1": 1950, "y2": 2010}}}}
  DBFLL = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 525, "y2": 575}, "diagram": {"x1": 3020, "x2": 3080, "y1": 1850, "y2": 1910}}}}
  DBFLR = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 625, "y2": 675}, "diagram": {"x1": 3080, "x2": 3140, "y1": 1950, "y2": 2010}}}}
  DWFL = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 125, "y2": 175}, "diagram": {"x1": 3140, "x2": 3200, "y1": 1850, "y2": 1910}}}}
  DWFR = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 225, "y2": 275}, "diagram": {"x1": 3200, "x2": 3260, "y1": 1950, "y2": 2010}}}}
  DRUD = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 725, "y2": 775}, "diagram": {"x1": 3260, "x2": 3320, "y1": 1850, "y2": 1910}}}}
  parameter ft_per_m::Real = 3.28084
  parameter BSPAN::Real = 13.89
  parameter mass::Real = 8664.1
  parameter g::Real = 9.81
  parameter rho_sl::Real = 0.002378
  parameter knots_per_fps::Real = 0.592484
  parameter p1_0::Real = 0.0
  parameter p2_0::Real = 0.0
  parameter p3_0::Real = -3048.0
  parameter v1_0::Real = 170.678
  parameter v2_0::Real = 0.0
  parameter v3_0::Real = 52.18176
  parameter q0_0::Real = 0.9950556
  parameter q1_0::Real = 0.0
  parameter q2_0::Real = -0.09932
  parameter q3_0::Real = 0.0
  parameter w1_0::Real = 0.0
  parameter w2_0::Real = 0.0
  parameter w3_0::Real = 0.0
  # Feedback outputs (spec section 8)
  POS_3 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "x2": 1030, "y1": 750, "y2": 800}, "diagram": {"x1": 2740, "x2": 2800, "y1": 2470, "y2": 2530}}}}
  ALPHA_DEG = RealOutput() {
    "Dyad": {
      "placement": {"icon": {"x1": 970, "x2": 1030, "y1": 50, "y2": 100}, "diagram": {"x1": 4500, "x2": 4560, "y1": 120, "y2": 180}}
    }
  }
  BETADEG = RealOutput() {
    "Dyad": {
