  connect(airdata.mach, aero.mach, MACH_out) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 1870, "y": 1645.68}], "E": 2}, {"S": -1, "M": [{"x": 1870, "y": 1280}, {"x": 4550, "y": 1280}, {"x": 4550, "y": 2850}, {"x": 4645, "y": 2850}], "E": 3}], "junctions": [{"x": 1870, "y": 1672.5}], "path": {}}}
