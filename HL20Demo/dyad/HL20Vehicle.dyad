  connect(body.qy, flight.qy, forces.qy) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1000, "y": 1880}, {"x": 1000, "y": 2260}], "E": -1}, {"S": -1, "M": [{"x": 1275, "y": 2260}, {"x": 1275, "y": 1874.5}], "E": 2}, {"S": -1, "M": [], "E": -2}, {"S": -2, "M": [{"x": 2070, "y": 2490}, {"x": 700, "y": 2490}], "E": 3}], "path": {}, "junctions": [{"x": 1275, "y": 2260}, {"x": 2070, "y": 2260}]} }
  connect(body.qz, flight.qz, forces.qz) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 970, "y": 1920}, {"x": 970, "y": 2275}], "E": -1}, {"S": -1, "M": [{"x": 1285, "y": 2275}, {"x": 1285, "y": 1947.5}], "E": 2}, {"S": -1, "M": [], "E": -2}, {"S": -2, "M": [{"x": 2065, "y": 2486}, {"x": 630.1, "y": 2486}], "E": 3}], "path": {}, "junctions": [{"x": 1285, "y": 2275}, {"x": 2065, "y": 2275}]} }
  connect(body.pos_3, airdata.pos_m, pos_3) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 840, "y": 1600}, {"x": 840, "y": 980}], "E": -1}, {"S": -1, "M": [{"x": 1800, "y": 980}], "E": 2}, {"S": -1, "M": [{"x": 1180, "y": 980}, {"x": 1180, "y": 880}], "E": 3}], "path": {}, "junctions": [{"x": 840, "y": 980}]} }
  connect(body.omega_3, airdata.r_rad, rb, r_rad) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 915, "y": 2080}, {"x": 915, "y": 2300}], "E": -1}, {"S": -1, "M": [{"x": 2056, "y": 2300}, {"x": 2056, "y": 1690}], "E": 2}, {"S": -2, "M": [{"x": 2220, "y": 2170}], "E": 3}, {"S": -3, "M": [{"x": 2160, "y": 2185}, {"x": 2160, "y": 2360}], "E": 4}], "path": {}, "junctions": [{"x": 915, "y": 2300}, {"x": 2056, "y": 2170}, {"x": 2056, "y": 2185}]} }
  connect(body.omega_2, qb, q_rad) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 885, "y": 2040}, {"x": 885, "y": 2390}, {"x": 1000, "y": 2390}], "E": -2}, {"S": -3, "M": [{"x": 950, "y": 2330}], "E": 2}, {"S": -2, "M": [{"x": 995, "y": 2390}, {"x": 995, "y": 2330}], "E": 3}], "path": {}, "junctions": [{"x": 885, "y": 2390}, {"x": 1000, "y": 2390}, {"x": 950, "y": 2390}]} }
  connect(body.omega_1, airdata.p_rad, pb, p_rad) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 930, "y": 2000}, {"x": 930, "y": 2290}], "E": -1}, {"S": -1, "M": [{"x": 2028, "y": 2290}, {"x": 2028, "y": 1690}], "E": 2}, {"S": -2, "M": [{"x": 1760, "y": 2200}, {"x": 1760, "y": 2110}], "E": 3}, {"S": -3, "M": [{"x": 1880, "y": 2130}], "E": 4}], "path": {}, "junctions": [{"x": 930, "y": 2290}, {"x": 2028, "y": 2200}, {"x": 2028, "y": 2130}]} }
  connect(flight.v_scalar, airdata.v_mps) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1640, "y": 1527.75}, {"x": 1640, "y": 1166.375}], "E": 2}], "path": {}} }
  connect(flight.sin_alpha, airdata.sin_alpha) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1650, "y": 1564.25}, {"x": 1650, "y": 1437.775}], "E": 2}], "path": {}} }
  connect(flight.cos_alpha, airdata.cos_alpha) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1680, "y": 1783.25}, {"x": 1680, "y": 1520.375}], "E": 2}], "path": {}} }
  connect(flight.alpha_deg, alpha_deg) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1505, "y": 1600.75}, {"x": 1505, "y": 1625}], "E": 2}], "path": {}} }
  connect(flight.beta_deg, beta_deg) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1515, "y": 1637.25}, {"x": 1515, "y": 1745}], "E": 2}], "path": {}} }
  connect(flight.sin_phi, sin_phi) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1525, "y": 1819.75}, {"x": 1525, "y": 1818}], "E": 2}], "path": {}} }
  connect(flight.cos_phi, cos_phi) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1595, "y": 1856.25}, {"x": 1595, "y": 1970}, {"x": 1640, "y": 1970}], "E": 2}], "path": {}} }
  connect(flight.cos_theta, cos_theta) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1560, "y": 1892.75}, {"x": 1560, "y": 1920}], "E": 2}], "path": {}} }
  connect(airdata.mach, mach) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 2130, "y": 1136.875}, {"x": 2130, "y": 1070}], "E": 2}], "path": {}} }
  connect(airdata.v_fps, v_fps) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(airdata.hob, hob) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(airdata.bdot, bdot) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1860, "y": 970}], "E": 2}], "path": {}} }
  connect(airdata.eas_kts, eas_kts) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1900, "y": 1040}, {"x": 1870, "y": 1040}, {"x": 1870, "y": 820}], "E": 2}], "path": {}} }
  connect(airdata.alt_ft, alt_ft) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 2000, "y": 1020}], "E": 2}], "path": {}} }
  connect(airdata.qbar, forces.qbar_psf, qbar_psf) { "Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 2290, "y": 940}, {"x": 2290, "y": 2480}, {"x": 560, "y": 2480}, {"x": 560, "y": 2500}], "E": 2}, {"S": -3, "M": [{"x": 2090, "y": 860}], "E": 3}], "path": {}, "junctions": [{"x": 1960, "y": 940}, {"x": 2030, "y": 940}, {"x": 2090, "y": 940}]} }
  connect(CX, forces.CX) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(CY, forces.CY) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(CZ, forces.CZ) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(Cl, forces.Cl) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(Cm, forces.Cm) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(Cn, forces.Cn) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
