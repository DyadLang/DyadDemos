"""
Rotates an inertial NED vector into the body frame using the scalar-first
body-to-inertial quaternion q = [qw, qx, qy, qz] (transpose of the
body-to-inertial rotation matrix). Every product and sum is a wired block.
"""
component QuatToBody
  "Quaternion scalar part"
  qw = RealInput() {"Dyad": {"placement": {"icon": {"x1": -45, "x2": 45, "y1": 5, "y2": 95}, "diagram": {"x1": -50.0, "x2": 50.0, "y1": 290.0, "y2": 390.0}}}}
  "Quaternion x part"
  qx = RealInput() {"Dyad": {"placement": {"icon": {"x1": -45, "x2": 45, "y1": 155, "y2": 245}, "diagram": {"x1": -50.0, "x2": 50.0, "y1": 530.0, "y2": 630.0}}}}
  "Quaternion y part"
  qy = RealInput() {"Dyad": {"placement": {"icon": {"x1": -45, "x2": 45, "y1": 305, "y2": 395}, "diagram": {"x1": -50.0, "x2": 50.0, "y1": 770.0, "y2": 870.0}}}}
  "Quaternion z part"
  qz = RealInput() {"Dyad": {"placement": {"icon": {"x1": -45, "x2": 45, "y1": 455, "y2": 545}, "diagram": {"x1": -50.0, "x2": 50.0, "y1": 1010.0, "y2": 1110.0}}}}
  "Inertial NED vector component 1 (North)"
  v1 = RealInput() {"Dyad": {"placement": {"icon": {"x1": -45, "x2": 45, "y1": 605, "y2": 695}, "diagram": {"x1": 1470, "x2": 1570, "y1": 1250, "y2": 1350}}}}
  "Inertial NED vector component 2 (East)"
  v2 = RealInput() {"Dyad": {"placement": {"icon": {"x1": -45, "x2": 45, "y1": 755, "y2": 845}, "diagram": {"x1": 1670, "x2": 1770, "y1": 1250, "y2": 1350}}}}
  "Inertial NED vector component 3 (Down)"
  v3 = RealInput() {"Dyad": {"placement": {"icon": {"x1": -45, "x2": 45, "y1": 905, "y2": 995}, "diagram": {"x1": 1870, "x2": 1970, "y1": 1250, "y2": 1350}}}}
  "Body vector component 1 (forward)"
  b1 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 200, "x2": 1050, "y2": 300}, "diagram": {"x1": 2650.0, "x2": 2750.0, "y1": 330.0, "y2": 430.0}}}}
  "Body vector component 2 (right)"
  b2 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 400, "x2": 1050, "y2": 500}, "diagram": {"x1": 2650.0, "x2": 2750.0, "y1": 570.0, "y2": 670.0}}}}
  "Body vector component 3 (down)"
  b3 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 600, "x2": 1050, "y2": 700}, "diagram": {"x1": 2650.0, "x2": 2750.0, "y1": 810.0, "y2": 910.0}}}}
  dcm = QuatToDCM() {"Dyad": {"placement": {"diagram": {"x1": 600, "y1": 300, "x2": 1000, "y2": 1100}}}}
  mv = DCMMatVec() {"Dyad": {"placement": {"diagram": {"x1": 1400, "y1": 300, "x2": 2200, "y2": 1100}}}}
relations
  connect(qw, dcm.qw) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(qx, dcm.qx) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(qy, dcm.qy) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(qz, dcm.qz) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(dcm.m11, mv.a11) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(dcm.m12, mv.a12) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(dcm.m21, mv.a21) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(dcm.m13, mv.a13) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(dcm.m31, mv.a31) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(dcm.m22, mv.a22) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(dcm.m23, mv.a23) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(dcm.m32, mv.a32) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(dcm.m33, mv.a33) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(v1, mv.u1) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(mv.y1, b1) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(v2, mv.u2) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(mv.y2, b2) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(v3, mv.u3) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(mv.y3, b3) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
metadata {"Dyad": {"icons": {"default": "dyad://HL20Demo/quatrot.svg"}}}
end

