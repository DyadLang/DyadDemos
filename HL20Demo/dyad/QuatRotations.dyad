  b2 = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 600, "x2": 50, "y2": 700}, "diagram": {"x1": 2000, "x2": 2100, "y1": 1850, "y2": 1950}}}}
  "Body vector component 3 (down)"
