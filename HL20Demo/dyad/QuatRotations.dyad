"""
Rotates an inertial NED vector into the body frame using the scalar-first
body-to-inertial quaternion q = [qw, qx, qy, qz] (transpose of the
body-to-inertial rotation matrix). Every product and sum is a wired block.
"""
component QuatToBody
  "Quaternion scalar part"
  qw = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 0, "x2": 50, "y2": 100},
        "diagram": {"x1": -50, "x2": 50, "y1": 325, "y2": 425}
      }
    }
  }
  "Quaternion x part"
  qx = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 100, "x2": 50, "y2": 200},
        "diagram": {"x1": -50, "x2": 50, "y1": 525, "y2": 625}
      }
    }
  }
  "Quaternion y part"
  qy = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 200, "x2": 50, "y2": 300},
        "diagram": {"x1": -50, "x2": 50, "y1": 725, "y2": 825}
      }
    }
  }
  "Quaternion z part"
  qz = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 300, "x2": 50, "y2": 400},
        "diagram": {"x1": -50, "x2": 50, "y1": 925, "y2": 1025}
      }
    }
  }
  "Inertial NED vector component 1 (North)"
  v1 = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 500, "x2": 50, "y2": 600}, "diagram": {"x1": 930, "x2": 1030, "y1": 1950, "y2": 2050}}}}
  "Inertial NED vector component 2 (East)"
  v2 = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 600, "x2": 50, "y2": 700}, "diagram": {"x1": 1600, "x2": 1700, "y1": 1950, "y2": 2050}}}}
  "Inertial NED vector component 3 (Down)"
  v3 = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 700, "x2": 50, "y2": 800}, "diagram": {"x1": 1770, "x2": 1870, "y1": 1950, "y2": 2050}}}}
  "Body vector component 1 (forward)"
  b1 = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 200, "x2": 1050, "y2": 300},
        "diagram": {"x1": 2650, "x2": 2750, "y1": 275, "y2": 375}
      }
    }
  }
  "Body vector component 2 (right)"
  b2 = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 400, "x2": 1050, "y2": 500},
        "diagram": {"x1": 2650, "x2": 2750, "y1": 675, "y2": 775}
      }
    }
  }
  "Body vector component 3 (down)"
  b3 = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 600, "x2": 1050, "y2": 700},
        "diagram": {"x1": 2650, "x2": 2750, "y1": 1075, "y2": 1175}
      }
    }
  }
  dcm = QuatToDCM() {
    "Dyad": {"placement": {"diagram": {"x1": 256.25, "x2": 556.25, "y1": 750, "y2": 1000}}}
  }
  mv = DCMMatVec() {"Dyad": {"placement": {"diagram": {"x1": 700, "x2": 2100, "y1": -150, "y2": 1650}}}}
relations
  connect(qw, dcm.qw) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 230, "y": 375}, {"x": 230, "y": 762.5}], "E": 2}], "path": {}} }
  connect(qx, dcm.qx) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 220, "y": 575}, {"x": 220, "y": 787.5}], "E": 2}], "path": {}} }
  connect(qy, dcm.qy) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 210, "y": 775}, {"x": 210, "y": 812.5}], "E": 2}], "path": {}} }
  connect(qz, dcm.qz) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 240, "y": 975}, {"x": 240, "y": 837.5}], "E": 2}], "path": {}} }
  connect(dcm.m11, mv.a11) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 600, "y": 762.5}, {"x": 600, "y": -60}], "E": 2}], "path": {}} }
  connect(dcm.m12, mv.a12) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 610, "y": 787.5}, {"x": 610, "y": 120}], "E": 2}], "path": {}} }
  connect(dcm.m21, mv.a21) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 620, "y": 812.5}, {"x": 620, "y": 300}], "E": 2}], "path": {}} }
  connect(dcm.m13, mv.a13) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 630, "y": 837.5}, {"x": 630, "y": 480}], "E": 2}], "path": {}} }
  connect(dcm.m31, mv.a31) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 640, "y": 862.5}, {"x": 640, "y": 660}], "E": 2}], "path": {}} }
  connect(dcm.m22, mv.a22) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 650, "y": 887.5}, {"x": 650, "y": 840}], "E": 2}], "path": {}} }
  connect(dcm.m23, mv.a23) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 680, "y": 912.5}, {"x": 680, "y": 1020}], "E": 2}], "path": {}} }
  connect(dcm.m32, mv.a32) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 670, "y": 937.5}, {"x": 670, "y": 1200}], "E": 2}], "path": {}} }
  connect(dcm.m33, mv.a33) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 660, "y": 962.5}, {"x": 660, "y": 1380}], "E": 2}], "path": {}} }
  connect(v1, mv.u1) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(mv.y1, b1) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 2200, "y": 30}, {"x": 2200, "y": 325}], "E": 2}], "path": {}} }
  connect(v2, mv.u2) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1650, "y": 1650}], "E": 2}], "path": {}} }
  connect(mv.y2, b2) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 2190, "y": 570}, {"x": 2190, "y": 725}], "E": 2}], "path": {}} }
  connect(v3, mv.u3) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(mv.y3, b3) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 2180, "y": 1110}, {"x": 2180, "y": 1125}], "E": 2}], "path": {}} }
metadata {"Dyad": {"icons": {"default": "dyad://HL20Demo/quatrot.svg"}}}
end

"""
Rotates a body-frame vector to inertial NED using the scalar-first
body-to-inertial quaternion q = [qw, qx, qy, qz]. Every product and sum is a
wired block.
"""
component QuatToInertial
  "Quaternion scalar part"
  qw = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 0, "x2": 50, "y2": 100},
        "diagram": {"x1": -50, "x2": 50, "y1": 550, "y2": 650}
      }
    }
  }
  "Quaternion x part"
  qx = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 100, "x2": 50, "y2": 200},
