end

"""
Closed-loop pitch-pulse check case (spec scenario 5, TM-107580 Appendix F
trim case 0 maneuver 1): a 1-unit aft pitch-stick pulse from t=1 to t=2.
"""
test component TestHL20FullSystem
  sys = HL20FullSystem(DETRIM0 = 5.5) {
    "Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 600, "y2": 700}}}
  }
  pulse_add = BlockComponents.Sources.Pulse(amplitude = 1.0, offset = 0.0, start_time = 1.0, duty_cycle = 1.0, period = 1.0) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 200, "y2": 300}}}
  }
  c_dwpilot = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 450, "y2": 550}}}
  }
  c_dppilot = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 700, "y2": 800}}}
  }
  c_dlsbcom = BlockComponents.Sources.Constant(k = 20.925) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 950, "y2": 1050}}}
  }
relations
  connect(pulse_add.y, sys.DCPILOT) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 400, "y": 250}, {"x": 400, "y": 615}], "E": 2}],
      "path": {}
    }
  }
  connect(c_dwpilot.y, sys.DWPILOT) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 350, "y": 500},
            {"x": 350, "y": 650},
            {"x": 400, "y": 650},
            {"x": 400, "y": 635}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(c_dppilot.y, sys.DPPILOT) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 350, "y": 750}, {"x": 350, "y": 655}], "E": 2}],
      "path": {}
    }
  }
  connect(c_dlsbcom.y, sys.DLSBCOM) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 400, "y": 1000}, {"x": 400, "y": 675}], "E": 2}],
      "path": {}
    }
  }
  # atol kept only on sys.QDEG, sys.DECMD, sys.DLE: reproducible solver
  # jitter measured at ~1.3-1.7e-4 on these signals (5e-4 gives ~3x margin).
metadata {
  "Dyad": {
    "tests": {
      "pitchpulse": {
        "stop": 10,
        "atol": {
          "sys.QDEG": 0.0005,
          "sys.DECMD": 0.0005,
          "sys.DLE": 0.0005
        },
        "expect": {"signals": ["sys.ALPHA_DEG", "sys.QDEG", "sys.DECMD", "sys.DLE", "sys.NZ"]}
      }
    }
  }
}
end

