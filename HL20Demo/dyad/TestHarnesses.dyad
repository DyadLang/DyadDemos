  c_dwfr = BlockComponents.Sources.Constant(k = 0.0) {"Dyad": {"placement": {"diagram": {"x1": 1185.0, "x2": 1285.0, "y1": 2000.0, "y2": 2100.0}}}}
  c_drud = BlockComponents.Sources.Constant(k = 0.0) {"Dyad": {"placement": {"diagram": {"x1": 1290.0, "x2": 1390.0, "y1": 1850.0, "y2": 1950.0}}}}
relations
  connect(ramp.y, aero.alpha_deg) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
