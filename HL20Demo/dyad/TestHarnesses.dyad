"""
Closed-loop pitch-pulse check case (spec scenario 5, TM-107580 Appendix F
trim case 0 maneuver 1): a 1-unit aft pitch-stick pulse from t=1 to t=2.
"""
test component TestHL20FullSystem
  sys = HL20FullSystem(DETRIM0 = 5.5) {"Dyad": {"placement": {"diagram": {"x1": 500, "y1": 500, "x2": 900, "y2": 900}}}}
  pulse_add = BlockComponents.Sources.Pulse(amplitude = 1.0, offset = 0.0, start_time = 1.0, duty_cycle = 1.0, period = 1.0) {"Dyad": {"placement": {"diagram": {"x1": 200.0, "x2": 300.0, "y1": 510.0, "y2": 610.0}}}}
  c_dwpilot = BlockComponents.Sources.Constant(k = 0.0) {"Dyad": {"placement": {"diagram": {"x1": 350.0, "x2": 450.0, "y1": 590.0, "y2": 690.0}}}}
  c_dppilot = BlockComponents.Sources.Constant(k = 0.0) {"Dyad": {"placement": {"diagram": {"x1": 200.0, "x2": 300.0, "y1": 670.0, "y2": 770.0}}}}
  c_dlsbcom = BlockComponents.Sources.Constant(k = 20.925) {"Dyad": {"placement": {"diagram": {"x1": 350.0, "x2": 450.0, "y1": 750.0, "y2": 850.0}}}}
relations
  connect(pulse_add.y, sys.DCPILOT) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(c_dwpilot.y, sys.DWPILOT) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(c_dppilot.y, sys.DPPILOT) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(c_dlsbcom.y, sys.DLSBCOM) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  # atol kept only on sys.QDEG, sys.DECMD, sys.DLE: reproducible solver
  # jitter measured at ~1.3-1.7e-4 on these signals (5e-4 gives ~3x margin).
metadata {
  "Dyad": {
    "tests": {
      "pitchpulse": {
        "stop": 10,
        "atol": {
          "sys.QDEG": 0.0005,
          "sys.DECMD": 0.0005,
          "sys.DLE": 0.0005
        },
        "expect": {"signals": ["sys.ALPHA_DEG", "sys.QDEG", "sys.DECMD", "sys.DLE", "sys.NZ"]}
      }
    }
  }
}
end

analysis TestHL20FullSystemSim
  extends TransientAnalysis(stop = 10.0)
  model = TestHL20FullSystem()
relations
end