"RigidBody6DOF alone in gravity-only freefall (spec scenario 1)."
test component TestGravityOnly
  body = RigidBody6DOF(mass = 1000.0, Jxx = 100.0, Jyy = 200.0, Jzz = 300.0, g = 9.81, p3_0 = -1000.0, v1_0 = 100.0) {"Dyad": {"placement": {"diagram": {"x1": 500, "y1": 600, "x2": 900, "y2": 1000}}}}
  z1 = BlockComponents.Sources.Constant(k = 0.0) {"Dyad": {"placement": {"diagram": {"x1": 200.0, "x2": 300.0, "y1": 570.0, "y2": 670.0}}}}
  z2 = BlockComponents.Sources.Constant(k = 0.0) {"Dyad": {"placement": {"diagram": {"x1": 375.0, "x2": 475.0, "y1": 642.0, "y2": 742.0}}}}
  z3 = BlockComponents.Sources.Constant(k = 0.0) {"Dyad": {"placement": {"diagram": {"x1": 200.0, "x2": 300.0, "y1": 714.0, "y2": 814.0}}}}
  z4 = BlockComponents.Sources.Constant(k = 0.0) {"Dyad": {"placement": {"diagram": {"x1": 375.0, "x2": 475.0, "y1": 786.0, "y2": 886.0}}}}
  z5 = BlockComponents.Sources.Constant(k = 0.0) {"Dyad": {"placement": {"diagram": {"x1": 200.0, "x2": 300.0, "y1": 858.0, "y2": 958.0}}}}
  z6 = BlockComponents.Sources.Constant(k = 0.0) {"Dyad": {"placement": {"diagram": {"x1": 375.0, "x2": 475.0, "y1": 930.0, "y2": 1030.0}}}}
relations
  connect(z1.y, body.F1) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(z2.y, body.F2) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(z3.y, body.F3) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(z4.y, body.T1) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(z5.y, body.T2) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(z6.y, body.T3) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
metadata {
  "Dyad": {
    "tests": {
      "freefall": {
        "stop": 5,
        "atol": {
          "body.pos_1": 0.001,
          "body.pos_3": 0.001,
          "body.vel_1": 1e-6,
          "body.vel_3": 1e-6
        },
        "expect": {
          "final": {
            "body.pos_1": 500.0,
            "body.pos_3": -877.375,
            "body.vel_1": 100.0,
            "body.vel_3": 49.05
          }
        }
      }
    }
  }
}
end

analysis TestGravityOnlySim
  extends TransientAnalysis(stop = 5.0)
  model = TestGravityOnly()
relations
end

