"RigidBody6DOF alone in gravity-only freefall (spec scenario 1)."
test component TestGravityOnly
  body = RigidBody6DOF(mass = 1000.0, Jxx = 100.0, Jyy = 200.0, Jzz = 300.0, g = 9.81, p3_0 = -1000.0, v1_0 = 100.0) {
    "Dyad": {"placement": {"diagram": {"x1": 475, "x2": 675, "y1": 525, "y2": 1325}}}
  }
  z1 = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 225, "x2": 325, "y1": 500, "y2": 600}}}
  }
  z2 = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 325, "x2": 425, "y1": 600, "y2": 700}}}
  }
  z3 = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 225, "x2": 325, "y1": 675, "y2": 775}}}
  }
  z4 = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 325, "x2": 425, "y1": 800, "y2": 900}}}
  }
  z5 = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 225, "x2": 325, "y1": 875, "y2": 975}}}
  }
  z6 = BlockComponents.Sources.Constant(k = 0.0) {
    "Dyad": {"placement": {"diagram": {"x1": 325, "x2": 425, "y1": 950, "y2": 1050}}}
  }
relations
  connect(z1.y, body.F1) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 450, "y": 550}, {"x": 450, "y": 565}], "E": 2}],
      "path": {}
    }
  }
  connect(z2.y, body.F2) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 450, "y": 650}, {"x": 450, "y": 645}], "E": 2}],
      "path": {}
    }
  }
  connect(z3.y, body.F3) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 450, "y": 725}, {"x": 450, "y": 725}], "E": 2}],
      "path": {}
    }
  }
  connect(z4.y, body.T1) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 450, "y": 850}, {"x": 450, "y": 885}], "E": 2}],
      "path": {}
    }
  }
  connect(z5.y, body.T2) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 450, "y": 925}, {"x": 450, "y": 965}], "E": 2}],
      "path": {}
    }
  }
  connect(z6.y, body.T3) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 450, "y": 1000}, {"x": 450, "y": 1045}], "E": 2}],
      "path": {}
    }
  }
metadata {
  "Dyad": {
    "tests": {
      "freefall": {
        "stop": 5,
        "atol": {
          "body.pos_1": 0.001,
          "body.pos_3": 0.001,
          "body.vel_1": 1e-6,
          "body.vel_3": 1e-6
        },
        "expect": {
          "final": {
            "body.pos_1": 500.0,
            "body.pos_3": -877.375,
            "body.vel_1": 100.0,
            "body.vel_3": 49.05
          }
        }
      }
    }
  }
}
end

analysis TestGravityOnlySim
  extends TransientAnalysis(stop = 5.0)
