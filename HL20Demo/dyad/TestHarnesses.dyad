"The four SAS controllers standalone on constant inputs (spec scenario 4)."
test component TestControllers
  pitch_ctrl = PitchControl(DETRIM0 = 5.5) {"Dyad": {"placement": {"diagram": {"x1": 700, "y1": 800, "x2": 1400, "y2": 1500}}}}
  roll_ctrl = RollControl() {"Dyad": {"placement": {"diagram": {"x1": 500, "y1": 400, "x2": 600, "y2": 500}}}}
  yaw_ctrl = YawControl() {"Dyad": {"placement": {"diagram": {"x1": 1200, "y1": 400, "x2": 1400, "y2": 600}}}}
  speed_ctrl = SpeedControl() {"Dyad": {"placement": {"diagram": {"x1": 1700, "y1": 400, "x2": 1800, "y2": 500}}}}
  c_dcpilot = BlockComponents.Sources.Constant(k = 0.0) {"Dyad": {"placement": {"diagram": {"x1": 500.0, "x2": 600.0, "y1": 785.0, "y2": 885.0}}}}
  c_qdeg = BlockComponents.Sources.Constant(k = 0.0) {"Dyad": {"placement": {"diagram": {"x1": 250.0, "x2": 350.0, "y1": 1530.0, "y2": 1630.0}}}}
  c_rdeg = BlockComponents.Sources.Constant(k = 0.0) {"Dyad": {"placement": {"diagram": {"x1": 250.0, "x2": 350.0, "y1": 1710.0, "y2": 1810.0}}}}
  c_nz = BlockComponents.Sources.Constant(k = 1.0) {"Dyad": {"placement": {"diagram": {"x1": 250.0, "x2": 350.0, "y1": 2610.0, "y2": 2710.0}}}}
  c_sinphi = BlockComponents.Sources.Constant(k = 0.0) {"Dyad": {"placement": {"diagram": {"x1": 250.0, "x2": 350.0, "y1": 1890.0, "y2": 1990.0}}}}
  c_cosphi = BlockComponents.Sources.Constant(k = 1.0) {"Dyad": {"placement": {"diagram": {"x1": 250.0, "x2": 350.0, "y1": 2070.0, "y2": 2170.0}}}}
  c_costhe = BlockComponents.Sources.Constant(k = 0.98) {"Dyad": {"placement": {"diagram": {"x1": 250.0, "x2": 350.0, "y1": 2250.0, "y2": 2350.0}}}}
  c_dledeg = BlockComponents.Sources.Constant(k = 5.5) {"Dyad": {"placement": {"diagram": {"x1": 500.0, "x2": 600.0, "y1": 1275.0, "y2": 1375.0}}}}
  c_qbar = BlockComponents.Sources.Constant(k = 300.0) {"Dyad": {"placement": {"diagram": {"x1": 250.0, "x2": 350.0, "y1": 2430.0, "y2": 2530.0}}}}
  c_mach = BlockComponents.Sources.Constant(k = 0.54) {"Dyad": {"placement": {"diagram": {"x1": 250.0, "x2": 350.0, "y1": 1350.0, "y2": 1450.0}}}}
  c_vtotali = BlockComponents.Sources.Constant(k = 585.0) {"Dyad": {"placement": {"diagram": {"x1": 250.0, "x2": 350.0, "y1": 2790.0, "y2": 2890.0}}}}
  c_dwpilot = BlockComponents.Sources.Constant(k = 0.0) {"Dyad": {"placement": {"diagram": {"x1": 300.0, "x2": 400.0, "y1": 370.0, "y2": 470.0}}}}
  c_pdeg = BlockComponents.Sources.Constant(k = 0.0) {"Dyad": {"placement": {"diagram": {"x1": 433.29999999999995, "x2": 533.3, "y1": 520.0, "y2": 620.0}}}}
  c_dppilot = BlockComponents.Sources.Constant(k = 0.0) {"Dyad": {"placement": {"diagram": {"x1": 1000.0, "x2": 1100.0, "y1": 380.0, "y2": 480.0}}}}
  c_dlsbcom = BlockComponents.Sources.Constant(k = 20.9) {"Dyad": {"placement": {"diagram": {"x1": 1500.0, "x2": 1600.0, "y1": 400.0, "y2": 500.0}}}}
relations
  connect(c_dcpilot.y, pitch_ctrl.DCPILOT) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(c_qdeg.y, pitch_ctrl.QDEG) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 450, "y": 1580}, {"x": 450, "y": 1590}, {"x": 813.75, "y": 1590}], "E": 2}], "path": {}}}
      connect(c_rdeg.y, pitch_ctrl.RDEG, yaw_ctrl.RDEG) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 470, "y": 1760}], "E": -1}, {"S": -1, "M": [{"x": 892, "y": 1620}, {"x": 892, "y": 1500}], "E": 2}, {"S": -1, "M": [{"x": 460, "y": 1620}, {"x": 460, "y": 1680}, {"x": 200, "y": 1680}, {"x": 200, "y": 2900}, {"x": 1450, "y": 2900}, {"x": 1450, "y": 630}, {"x": 1320, "y": 630}], "E": 3}], "path": {}, "junctions": [{"x": 470, "y": 1620}]}}
  connect(c_nz.y, pitch_ctrl.NZ) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 570, "y": 2660}, {"x": 570, "y": 1770}, {"x": 1286.25, "y": 1770}], "E": 2}], "path": {}}}
  connect(c_sinphi.y, pitch_ctrl.SINPHI) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 490, "y": 1940}, {"x": 490, "y": 1650}, {"x": 971.25, "y": 1650}], "E": 2}], "path": {}}}
  connect(c_cosphi.y, pitch_ctrl.COSPHI) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 510, "y": 2120}, {"x": 510, "y": 1680}, {"x": 1050.0, "y": 1680}], "E": 2}], "path": {}}}
  connect(c_costhe.y, pitch_ctrl.COSTHE) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 530, "y": 2300}, {"x": 530, "y": 1710}, {"x": 1128.75, "y": 1710}], "E": 2}], "path": {}}}
  connect(c_dledeg.y, pitch_ctrl.DLEDEG) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(c_qbar.y, pitch_ctrl.QBAR) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 550, "y": 2480}, {"x": 550, "y": 1740}, {"x": 1207.5, "y": 1740}], "E": 2}], "path": {}}}
        connect(c_mach.y, pitch_ctrl.MACH, yaw_ctrl.MACH) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 430, "y": 1400}, {"x": 430, "y": 1560}], "E": -1}, {"S": -1, "M": [{"x": 735, "y": 1560}, {"x": 735, "y": 1500}], "E": 2}, {"S": -1, "M": [{"x": 480, "y": 640}, {"x": 1240, "y": 640}], "E": 3}], "path": {}, "junctions": [{"x": 480, "y": 1560}]}}
      connect(c_vtotali.y, pitch_ctrl.VTOTALI) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 590, "y": 2840}, {"x": 590, "y": 1800}, {"x": 1365.0, "y": 1800}], "E": 2}], "path": {}}}
  connect(c_dwpilot.y, roll_ctrl.DWPILOT) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
    connect(c_pdeg.y, roll_ctrl.PDEG) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(c_dppilot.y, yaw_ctrl.DPPILOT) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
    connect(roll_ctrl.DACMD, yaw_ctrl.DACMD) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 650, "y": 450}, {"x": 650, "y": 510}], "E": 2}], "path": {}}}
    connect(c_dlsbcom.y, speed_ctrl.DLSBCOM) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
metadata {
  "Dyad": {
    "tests": {
      "hold": {
        "stop": 15,
        "atol": {"speed_ctrl.DSBCMD": 0.01, "yaw_ctrl.DRCMD": 0.01},
        "expect": {
          "final": {"speed_ctrl.DSBCMD": 16.3804, "yaw_ctrl.DRCMD": 0.0},
          "signals": ["pitch_ctrl.DECMD", "pitch_ctrl.int_detrim.y", "yaw_ctrl.wash.y"]
        }
      }
    }
  }
}
end

