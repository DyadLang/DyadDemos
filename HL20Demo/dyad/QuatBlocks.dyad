"""
Direction-cosine matrix (inertial-to-body NED) of the scalar-first
quaternion q = [qw, qx, qy, qz]: m11..m33. For a +90 degree yaw this gives
m12 = +1 and m21 = -1. The output pins are ordered
m11, m12, m21, m13, m31, m22, m23, m32, m33 so each entry sits beside its
transpose; wiring them straight into DCMMatVec applies the matrix and
swapping each adjacent pair applies the transpose.
"""
component QuatToDCM
  "Quaternion scalar part"
  qw = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 0, "x2": 50, "y2": 100}, "diagram": {"x1": -50, "x2": 50, "y1": 200, "y2": 300}}}}
  "Quaternion x part"
  qx = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 100, "x2": 50, "y2": 200}, "diagram": {"x1": -50, "x2": 50, "y1": 350, "y2": 450}}}}
  "Quaternion y part"
  qy = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 200, "x2": 50, "y2": 300}, "diagram": {"x1": -50, "x2": 50, "y1": 500, "y2": 600}}}}
  "Quaternion z part"
  qz = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 300, "x2": 50, "y2": 400}, "diagram": {"x1": -50, "x2": 50, "y1": 650, "y2": 750}}}}
  "Direction-cosine entry m11"
  m11 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 0, "x2": 1050, "y2": 100}, "diagram": {"x1": 1200, "x2": 1300, "y1": 2450, "y2": 2550}}}}
  "Direction-cosine entry m12"
  m12 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 100, "x2": 1050, "y2": 200}, "diagram": {"x1": 1200, "x2": 1300, "y1": 1600, "y2": 1700}}}}
  "Direction-cosine entry m21"
  m21 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 200, "x2": 1050, "y2": 300}, "diagram": {"x1": 1200, "x2": 1300, "y1": 1750, "y2": 1850}}}}
  "Direction-cosine entry m13"
  m13 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 300, "x2": 1050, "y2": 400}, "diagram": {"x1": 1200, "x2": 1300, "y1": 1300, "y2": 1400}}}}
  "Direction-cosine entry m31"
  m31 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 400, "x2": 1050, "y2": 500}, "diagram": {"x1": 1200, "x2": 1300, "y1": 1450, "y2": 1550}}}}
  "Direction-cosine entry m22"
  m22 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 500, "x2": 1050, "y2": 600}, "diagram": {"x1": 1200, "x2": 1300, "y1": 2250, "y2": 2350}}}}
  "Direction-cosine entry m23"
  m23 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 600, "x2": 1050, "y2": 700}, "diagram": {"x1": 1200, "x2": 1300, "y1": 950, "y2": 1050}}}}
  "Direction-cosine entry m32"
  m32 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 700, "x2": 1050, "y2": 800}, "diagram": {"x1": 1200, "x2": 1300, "y1": 1100, "y2": 1200}}}}
  "Direction-cosine entry m33"
  m33 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 800, "x2": 1050, "y2": 900}, "diagram": {"x1": 1200, "x2": 1300, "y1": 2000, "y2": 2100}}}}
  qwqx = BlockComponents.Math.Product() {"Dyad": {"placement": {"diagram": {"x1": 600, "x2": 700, "y1": 900, "y2": 1000}}}}
  qx2 = BlockComponents.Math.Product() {"Dyad": {"placement": {"diagram": {"x1": 600, "x2": 700, "y1": 1800, "y2": 1900}}}}
  qwqy = BlockComponents.Math.Product() {"Dyad": {"placement": {"diagram": {"x1": 600, "x2": 700, "y1": 1200, "y2": 1300}}}}
  qxqy = BlockComponents.Math.Product() {"Dyad": {"placement": {"diagram": {"x1": 600, "x2": 700, "y1": 1650, "y2": 1750}}}}
  qwqz = BlockComponents.Math.Product() {"Dyad": {"placement": {"diagram": {"x1": 600, "x2": 700, "y1": 1500, "y2": 1600}}}}
  qy2 = BlockComponents.Math.Product() {"Dyad": {"placement": {"diagram": {"x1": 600, "x2": 700, "y1": 1950, "y2": 2050}}}}
  qxqz = BlockComponents.Math.Product() {"Dyad": {"placement": {"diagram": {"x1": 600, "x2": 700, "y1": 1350, "y2": 1450}}}}
