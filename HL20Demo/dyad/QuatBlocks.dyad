  "Matrix entry a33"
  a33 = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 800, "x2": 50, "y2": 900}, "diagram": {"x1": -50, "x2": 50, "y1": 2170, "y2": 2270}}}}
  "Vector component u1"
  u1 = RealInput() {"Dyad": {"placement": {"icon": {"x1": 150, "y1": 950, "x2": 250, "y2": 1050}, "diagram": {"x1": -50, "x2": 50, "y1": 280, "y2": 380}}}}
  "Product component y1"
  y1 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 50, "x2": 1050, "y2": 150}, "diagram": {"x1": 1650, "x2": 1750, "y1": 950, "y2": 1050}}}}
  "Vector component u2"
  u2 = RealInput() {"Dyad": {"placement": {"icon": {"x1": 450, "y1": 950, "x2": 550, "y2": 1050}, "diagram": {"x1": -50, "x2": 50, "y1": 1030, "y2": 1130}}}}
  "Product component y2"
  y2 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 350, "x2": 1050, "y2": 450}, "diagram": {"x1": 1650, "x2": 1750, "y1": 1200, "y2": 1300}}}}
  "Vector component u3"
