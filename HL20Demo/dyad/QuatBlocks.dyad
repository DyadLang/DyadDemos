"""
Direction-cosine matrix (body-to-inertial NED) of the scalar-first
quaternion q = [qw, qx, qy, qz]: m11..m33. The output pins are ordered
m11, m12, m21, m13, m31, m22, m23, m32, m33 so each entry sits beside its
transpose; wiring them straight into DCMMatVec applies the matrix and
swapping each adjacent pair applies the transpose.
"""
component QuatToDCM
  "Quaternion scalar part"
  qw = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 0, "x2": 50, "y2": 100},
        "diagram": {"x1": -50, "x2": 50, "y1": 700, "y2": 800}
