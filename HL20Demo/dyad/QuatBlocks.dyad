  p11 = BlockComponents.Math.Product() {"Dyad": {"placement": {"diagram": {"x1": 600, "x2": 700, "y1": 200, "y2": 300}}}}
  p12 = BlockComponents.Math.Product() {"Dyad": {"placement": {"diagram": {"x1": 600, "x2": 700, "y1": 950, "y2": 1050}}}}
