  r12 = BlockComponents.Math.Add(k1 = 2.0, k2 = 2.0) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 1600, "y2": 1700}}}}
  r13 = BlockComponents.Math.Add(k1 = 2.0, k2 = -2.0) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 1300, "y2": 1400}}}}
  r21 = BlockComponents.Math.Add(k1 = 2.0, k2 = -2.0) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 1750, "y2": 1850}}}}
  r22 = BlockComponents.Math.Add3(k1 = 1.0, k2 = -2.0, k3 = -2.0) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 2250, "y2": 2350}}}}
  r23 = BlockComponents.Math.Add(k1 = 2.0, k2 = 2.0) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 950, "y2": 1050}}}}
  r31 = BlockComponents.Math.Add(k1 = 2.0, k2 = 2.0) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 1450, "y2": 1550}}}}
  r32 = BlockComponents.Math.Add(k1 = 2.0, k2 = -2.0) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 1100, "y2": 1200}}}}
  r33 = BlockComponents.Math.Add3(k1 = 1.0, k2 = -2.0, k3 = -2.0) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 2000, "y2": 2100}}}}
  one1 = BlockComponents.Sources.Constant(k = 1.0) {"Dyad": {"placement": {"diagram": {"x1": 830, "x2": 930, "y1": 2590, "y2": 2690}}}}
  one2 = BlockComponents.Sources.Constant(k = 1.0) {"Dyad": {"placement": {"diagram": {"x1": 830, "x2": 930, "y1": 2120, "y2": 2220}}}}
  one3 = BlockComponents.Sources.Constant(k = 1.0) {"Dyad": {"placement": {"diagram": {"x1": 830, "x2": 930, "y1": 1900, "y2": 2000}}}}
relations
    connect(qx, qwqx.u2, qxqz.u1, qxqy.u1, qx2.u1, qx2.u2) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 350, "y": 400.0}], "E": -1}, {"S": -1, "M": [], "E": -2}, {"S": -2, "M": [], "E": -3}, {"S": -3, "M": [], "E": -4}, {"S": -4, "M": [], "E": -5}, {"S": -1, "M": [], "E": 2}, {"S": -2, "M": [], "E": 3}, {"S": -3, "M": [], "E": 4}, {"S": -4, "M": [], "E": 5}, {"S": -5, "M": [], "E": 6}], "path": {}, "junctions": [{"x": 350, "y": 980.0}, {"x": 350, "y": 1370.0}, {"x": 350, "y": 1670.0}, {"x": 350, "y": 1820.0}, {"x": 350, "y": 1880.0}]}}
