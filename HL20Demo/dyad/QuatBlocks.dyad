"""
Matrix-times-vector product y = A * u for a 3x3 matrix wired entry by
entry. The matrix pins enter on the left ordered a11, a12, a21, a13, a31,
a22, a23, a32, a33 (each entry beside its transpose) to match QuatToDCM,
the vector u enters on the bottom edge and y exits on the right.
"""
component DCMMatVec
  "Matrix entry a11"
  a11 = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 0, "x2": 50, "y2": 100}, "diagram": {"x1": -50, "x2": 50, "y1": 170, "y2": 270}}}}
  "Matrix entry a12"
  a12 = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 100, "x2": 50, "y2": 200}, "diagram": {"x1": -50, "x2": 50, "y1": 920, "y2": 1020}}}}
  "Matrix entry a21"
