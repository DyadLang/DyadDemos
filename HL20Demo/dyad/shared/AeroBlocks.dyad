"Cubic polynomial block: y = c0 + c1*u + c2*u^2 + c3*u^3. Used for the alpha
polynomials in the HL-20 dynamic-derivative (damping) terms."
component CubicPoly
  extends BlockComponents.Interfaces.SISO
  "Constant coefficient"
  parameter c0::Real = 0.0
  "Linear coefficient"
  parameter c1::Real = 0.0
  "Quadratic coefficient"
  parameter c2::Real = 0.0
  "Cubic coefficient"
  parameter c3::Real = 0.0
relations
  y = c0 + c1 * u + c2 * u ^ 2 + c3 * u ^ 3
metadata {
  "Dyad": {
    "labels": [
      {"label": "$(instance)", "x": 500, "y": 1100, "rot": 0}
    ],
    "icons": {"default": "dyad://HL20Demo/poly.svg"}
  }
}
end
