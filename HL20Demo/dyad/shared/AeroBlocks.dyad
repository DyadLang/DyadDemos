"HL-20 aero 1D polynomial table block. Wraps the registered symbolic function
`HL20Demo.hl20_poly1d(group, alpha_deg, x)` so a DAVE-ML 1D table lookup can be
placed as a block in a graphical diagram."
component HL20Table1D
  "Polynomial group index (varID group start)"
  parameter group::Integer
  "Angle of attack (deg)"
  u1 = RealInput() {^u1}
  "Second independent variable (mach, hob or gear deflection)"
  u2 = RealInput() {^u2}
  "Table value"
  y = RealOutput() {^y}
relations
  y = HL20Demo.hl20_poly1d(group, u1, u2)
metadata {
  "Dyad": {
    "labels": [
      {"label": "$(instance)", "x": 500, "y": 1100, "rot": 0}
    ],
    "icons": {"default": "dyad://HL20Demo/table.svg"}
  },
  "_links": {
    "u1": {
      "Dyad": {
        "placement": {"icon": {"iconName": "default", "x1": -50, "y1": 150, "x2": 50, "y2": 250}}
      }
    },
    "u2": {
      "Dyad": {
        "placement": {"icon": {"iconName": "default", "x1": -50, "y1": 750, "x2": 50, "y2": 850}}
      }
    },
    "y": {
      "Dyad": {
        "placement": {"icon": {"iconName": "default", "x1": 950, "y1": 450, "x2": 1050, "y2": 550}}
      }
    }
  }
}
end

