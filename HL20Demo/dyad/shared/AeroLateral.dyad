"""
HL-20 rolling-moment coefficient buildup (TM-4302), including the p and r
damping polynomials scaled by the span damping factor.
"""
component HL20CR
  "Angle of attack (deg)"
  alpha_deg = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 20, "y2": 80}, "diagram": {"x1": -30, "x2": 30, "y1": 120, "y2": 180}}}}
  "Sideslip angle (deg)"
  beta_deg = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 120, "y2": 180}, "diagram": {"x1": -30, "x2": 30, "y1": 330, "y2": 390}}}}
  "Mach number"
  mach = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 220, "y2": 280}, "diagram": {"x1": -30, "x2": 30, "y1": 520, "y2": 580}}}}
  "Height over body span (ground effect)"
  hob = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 320, "y2": 380}, "diagram": {"x1": -30, "x2": 30, "y1": 700, "y2": 760}}}}
  "Left body flap deflection (deg)"
  DBFLL = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 420, "y2": 480}, "diagram": {"x1": -30, "x2": 30, "y1": 1170, "y2": 1230}}}}
  "Right body flap deflection (deg)"
  DBFLR = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 520, "y2": 580}, "diagram": {"x1": -30, "x2": 30, "y1": 1420, "y2": 1480}}}}
  "Upper left body flap deflection (deg)"
  DBFUL = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 620, "y2": 680}, "diagram": {"x1": -30, "x2": 30, "y1": 1670, "y2": 1730}}}}
  "Upper right body flap deflection (deg)"
  DBFUR = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 720, "y2": 780}, "diagram": {"x1": -30, "x2": 30, "y1": 1920, "y2": 1980}}}}
  "Left wing flap deflection (deg)"
  DWFL = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 820, "y2": 880}, "diagram": {"x1": -30, "x2": 30, "y1": 2170, "y2": 2230}}}}
  "Right wing flap deflection (deg)"
  DWFR = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 920, "y2": 980}, "diagram": {"x1": -30, "x2": 30, "y1": 2420, "y2": 2480}}}}
  "Rudder deflection magnitude (deg)"
  abs_drud = RealInput() {"Dyad": {"placement": {"icon": {"x1": 70, "y1": 970, "x2": 130, "y2": 1030}, "diagram": {"x1": -30, "x2": 30, "y1": 2670, "y2": 2730}}}}
  "Body roll rate (rad/s)"
  pb = RealInput() {"Dyad": {"placement": {"icon": {"x1": 270, "y1": 970, "x2": 330, "y2": 1030}, "diagram": {"x1": 1170, "x2": 1230, "y1": -30, "y2": 30}}}}
  "Body yaw rate (rad/s)"
  rb = RealInput() {"Dyad": {"placement": {"icon": {"x1": 470, "y1": 970, "x2": 530, "y2": 1030}, "diagram": {"x1": 1300, "x2": 1360, "y1": -30, "y2": 30}}}}
  "Span damping factor b/(2 V)"
  damp_b2v = RealInput() {"Dyad": {"placement": {"icon": {"x1": 670, "y1": 970, "x2": 730, "y2": 1030}, "diagram": {"x1": 1595, "x2": 1655, "y1": -30, "y2": 30}}}}
  "Total rolling-moment coefficient"
  y = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 470, "x2": 1030, "y2": 530}, "diagram": {"x1": 2570, "x2": 2630, "y1": 240, "y2": 300}}}}
  "Landing gear deflection (deg)"
  parameter DLG::Real = 0.0
  "Roll damping (p) polynomial coefficients"
  parameter CLP0::Real = -0.55242
  parameter CLP1::Real = 0.014478
  parameter CLP2::Real = -0.0011545
  parameter CLP3::Real = 0.000017706
  "Roll damping (r) polynomial coefficients"
  parameter CLR0::Real = 0.44685
  parameter CLR1::Real = 0.067411
  parameter CLR2::Real = -0.0051866
  parameter CLR3::Real = 0.00012659
  t0a = HL20Table1D(group = HL20Demo.idx1d("CR0A")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 900, "y2": 1000}}}}
  tge = HL20Table1D(group = HL20Demo.idx1d("CRGE")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 650, "y2": 750}}}}
  dlg_const = BlockComponents.Sources.Constant(k = DLG) {"Dyad": {"placement": {"diagram": {"x1": 760, "x2": 860, "y1": 545, "y2": 645}}}}
  tlg = HL20Table1D(group = HL20Demo.idx1d("CRLG")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 400, "y2": 500}}}}
  base_sum = BlockComponents.Math.Add3() {"Dyad": {"placement": {"diagram": {"x1": 1350, "x2": 1450, "y1": 650, "y2": 750}}}}
  base = BlockComponents.Math.Product() {"Dyad": {"placement": {"diagram": {"x1": 1550, "x2": 1650, "y1": 650, "y2": 750}}}}
  tbfll = HL20Table2DR(group = HL20Demo.grp2dr("CRBFLL")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 1150, "y2": 1250}}}}
  tbflr = HL20Table2DR(group = HL20Demo.grp2dr("CRBFLR")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 1400, "y2": 1500}}}}
  bfl = BlockComponents.Math.Add(k2 = -1.0) {"Dyad": {"placement": {"diagram": {"x1": 1350, "x2": 1450, "y1": 1275, "y2": 1375}}}}
  tbful = HL20Table2DR(group = HL20Demo.grp2dr("CRBFUL")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 1650, "y2": 1750}}}}
  tbfur = HL20Table2DR(group = HL20Demo.grp2dr("CRBFUR")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 1900, "y2": 2000}}}}
  bfu = BlockComponents.Math.Add(k2 = -1.0) {"Dyad": {"placement": {"diagram": {"x1": 1350, "x2": 1450, "y1": 1775, "y2": 1875}}}}
  twfl = HL20Table2DR(group = HL20Demo.grp2dr("CRWFL")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 2150, "y2": 2250}}}}
  twfr = HL20Table2DR(group = HL20Demo.grp2dr("CRWFR")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 2400, "y2": 2500}}}}
  wf = BlockComponents.Math.Add(k2 = -1.0) {"Dyad": {"placement": {"diagram": {"x1": 1350, "x2": 1450, "y1": 2275, "y2": 2375}}}}
  trud = HL20Table2DE(group = HL20Demo.grp2de("CRRUD")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 2650, "y2": 2750}}}}
  clp_poly = CubicPoly(c0 = CLP0, c1 = CLP1, c2 = CLP2, c3 = CLP3) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 100, "y2": 200}}}}
  clr_poly = CubicPoly(c0 = CLR0, c1 = CLR1, c2 = CLR2, c3 = CLR3) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 225, "y2": 325}}}}
  clp_pb = BlockComponents.Math.Product() {"Dyad": {"placement": {"diagram": {"x1": 1350, "x2": 1450, "y1": 100, "y2": 200}}}}
  clr_rb = BlockComponents.Math.Product() {"Dyad": {"placement": {"diagram": {"x1": 1350, "x2": 1450, "y1": 225, "y2": 325}}}}
  clp_damp = BlockComponents.Math.Product() {"Dyad": {"placement": {"diagram": {"x1": 1650, "x2": 1750, "y1": 100, "y2": 200}}}}
  clr_damp = BlockComponents.Math.Product() {"Dyad": {"placement": {"diagram": {"x1": 1650, "x2": 1750, "y1": 225, "y2": 325}}}}
  sum1 = BlockComponents.Math.Add3() {"Dyad": {"placement": {"diagram": {"x1": 1850, "x2": 1950, "y1": 1275, "y2": 1375}}}}
  sum2 = BlockComponents.Math.Add3() {"Dyad": {"placement": {"diagram": {"x1": 2100, "x2": 2200, "y1": 2050, "y2": 2150}}}}
  sum3 = BlockComponents.Math.Add3() {"Dyad": {"placement": {"diagram": {"x1": 2300, "x2": 2400, "y1": 220, "y2": 320}}}}
