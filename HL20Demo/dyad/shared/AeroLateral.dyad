"""
HL-20 yawing-moment coefficient buildup (TM-4302), including the p and r
damping polynomials scaled by the span damping factor.
"""
component HL20CN
  "Angle of attack (deg)"
  alpha_deg = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 0, "x2": 50, "y2": 100},
        "diagram": {"x1": -50, "x2": 50, "y1": 1900, "y2": 2000}
      }
    }
  }
  "Sideslip angle (deg)"
  beta_deg = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 100, "x2": 50, "y2": 200},
        "diagram": {"x1": -50, "x2": 50, "y1": 1850, "y2": 1950}
      }
    }
  }
  "Mach number"
  mach = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 200, "x2": 50, "y2": 300},
        "diagram": {"x1": -50, "x2": 50, "y1": 1950, "y2": 2050}
      }
    }
  }
  "Height over body span (ground effect)"
  hob = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 300, "x2": 50, "y2": 400},
        "diagram": {"x1": -50, "x2": 50, "y1": 1650, "y2": 1750}
      }
    }
  }
  "Left body flap deflection (deg)"
  DBFLL = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 400, "x2": 50, "y2": 500},
        "diagram": {"x1": -50, "x2": 50, "y1": 2150, "y2": 2250}
      }
    }
  }
  "Right body flap deflection (deg)"
  DBFLR = RealInput() {
    "Dyad": {
