"""
HL-20 side-force coefficient buildup (TM-4302). Base lateral coefficients are
per-degree sideslip derivatives, so the base sum is multiplied by beta_deg.
Right-side surface lateral effects are antisymmetric and subtracted.
"""
component HL20CY
  "Angle of attack (deg)"
  alpha_deg = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 0, "x2": 50, "y2": 100},
        "diagram": {"x1": 500, "x2": 600, "y1": -50, "y2": 50}
      }
    }
  }
  "Sideslip angle (deg)"
  beta_deg = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 100, "x2": 50, "y2": 200},
        "diagram": {"x1": -50, "x2": 50, "y1": 975, "y2": 1025}
      }
    }
  }
  "Mach number"
  mach = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 200, "x2": 50, "y2": 300},
        "diagram": {"x1": 300, "x2": 400, "y1": -50, "y2": 50}
      }
    }
  }
  "Height over body span (ground effect)"
  hob = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 300, "x2": 50, "y2": 400},
        "diagram": {"x1": -50, "x2": 50, "y1": 550, "y2": 650}
      }
    }
  }
  "Left body flap deflection (deg)"
  DBFLL = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 400, "x2": 50, "y2": 500},
        "diagram": {"x1": -50, "x2": 50, "y1": 800, "y2": 900}
      }
    }
  }
  "Right body flap deflection (deg)"
  DBFLR = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 500, "x2": 50, "y2": 600},
        "diagram": {"x1": -50, "x2": 50, "y1": 1075, "y2": 1125}
      }
    }
  }
  "Upper left body flap deflection (deg)"
  DBFUL = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 600, "x2": 50, "y2": 700},
        "diagram": {"x1": -50, "x2": 50, "y1": 1550, "y2": 1650}
      }
    }
  }
  "Upper right body flap deflection (deg)"
  DBFUR = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 700, "x2": 50, "y2": 800},
        "diagram": {"x1": -50, "x2": 50, "y1": 1800, "y2": 1900}
      }
    }
  }
  "Left wing flap deflection (deg)"
  DWFL = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 800, "x2": 50, "y2": 900},
        "diagram": {"x1": -50, "x2": 50, "y1": 2050, "y2": 2150}
      }
    }
  }
  "Right wing flap deflection (deg)"
  DWFR = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 900, "x2": 50, "y2": 1000},
        "diagram": {"x1": -50, "x2": 50, "y1": 2300, "y2": 2400}
      }
    }
  }
  "Rudder deflection magnitude (deg)"
  abs_drud = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 150, "y1": 950, "x2": 250, "y2": 1050},
        "diagram": {"x1": -50, "x2": 50, "y1": 2550, "y2": 2650}
      }
    }
  }
  "Total side-force coefficient"
  y = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550},
        "diagram": {"x1": 2050, "x2": 2150, "y1": 1800, "y2": 1900}
      }
    }
  }
  "Landing gear deflection (deg)"
  parameter DLG::Real = 0.0
  t0a = HL20Table1D(group = HL20Demo.idx1d("CY0A")) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 1300, "y2": 1400}}}
  }
  tge = HL20Table1D(group = HL20Demo.idx1d("CYGE")) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 550, "y2": 650}}}
  }
  dlg_const = BlockComponents.Sources.Constant(k = DLG) {
    "Dyad": {"placement": {"diagram": {"x1": 300, "x2": 400, "y1": 550, "y2": 650}}}
  }
  tlg = HL20Table1D(group = HL20Demo.idx1d("CYLG")) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 300, "y2": 400}}}
  }
  base_sum = BlockComponents.Math.Add3() {
    "Dyad": {"placement": {"diagram": {"x1": 800, "x2": 900, "y1": 950, "y2": 1050}}}
  }
  base = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 1050, "x2": 1150, "y1": 950, "y2": 1050}}}
  }
  tbfll = HL20Table2DR(group = HL20Demo.grp2dr("CYBFLL")) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 800, "y2": 900}}}
  }
  tbflr = HL20Table2DR(group = HL20Demo.grp2dr("CYBFLR")) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 1050, "y2": 1150}}}
  }
  bfl = BlockComponents.Math.Add(k2 = -1.0) {
    "Dyad": {"placement": {"diagram": {"x1": 800, "x2": 900, "y1": 1350, "y2": 1450}}}
  }
  tbful = HL20Table2DR(group = HL20Demo.grp2dr("CYBFUL")) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 1550, "y2": 1650}}}
  }
  tbfur = HL20Table2DR(group = HL20Demo.grp2dr("CYBFUR")) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 1800, "y2": 1900}}}
  }
  bfu = BlockComponents.Math.Add(k2 = -1.0) {
    "Dyad": {"placement": {"diagram": {"x1": 850, "x2": 950, "y1": 1600, "y2": 1700}}}
  }
  twfl = HL20Table2DR(group = HL20Demo.grp2dr("CYWFL")) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 2050, "y2": 2150}}}
  }
  twfr = HL20Table2DR(group = HL20Demo.grp2dr("CYWFR")) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 2300, "y2": 2400}}}
  }
  wf = BlockComponents.Math.Add(k2 = -1.0) {
    "Dyad": {"placement": {"diagram": {"x1": 850, "x2": 950, "y1": 1850, "y2": 1950}}}
  }
  trud = HL20Table2DE(group = HL20Demo.grp2de("CYRUD")) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 2550, "y2": 2650}}}
  }
  sum1 = BlockComponents.Math.Add3() {
    "Dyad": {"placement": {"diagram": {"x1": 1300, "x2": 1400, "y1": 1400, "y2": 1500}}}
  }
  sum2 = BlockComponents.Math.Add3() {
    "Dyad": {"placement": {"diagram": {"x1": 1550, "x2": 1650, "y1": 1800, "y2": 1900}}}
  }
relations
