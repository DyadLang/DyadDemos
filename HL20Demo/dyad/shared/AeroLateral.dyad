      "placement": {
        "icon": {"x1": -50, "y1": 400, "x2": 50, "y2": 500},
        "diagram": {"x1": -50, "x2": 50, "y1": 2150, "y2": 2250}
      }
    }
  }
  "Right body flap deflection (deg)"
  DBFLR = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 500, "x2": 50, "y2": 600},
        "diagram": {"x1": -50, "x2": 50, "y1": 2400, "y2": 2500}
      }
    }
  }
  "Upper left body flap deflection (deg)"
  DBFUL = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 600, "x2": 50, "y2": 700},
        "diagram": {"x1": -50, "x2": 50, "y1": 2650, "y2": 2750}
      }
    }
  }
  "Upper right body flap deflection (deg)"
  DBFUR = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 700, "x2": 50, "y2": 800},
        "diagram": {"x1": -50, "x2": 50, "y1": 2900, "y2": 3000}
      }
    }
  }
  "Left wing flap deflection (deg)"
  DWFL = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 800, "x2": 50, "y2": 900},
        "diagram": {"x1": -50, "x2": 50, "y1": 3150, "y2": 3250}
      }
    }
  }
  "Right wing flap deflection (deg)"
  DWFR = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 900, "x2": 50, "y2": 1000},
        "diagram": {"x1": -50, "x2": 50, "y1": 3400, "y2": 3500}
      }
    }
  }
  "Rudder deflection magnitude (deg)"
  abs_drud = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 50, "y1": 950, "x2": 150, "y2": 1050},
        "diagram": {"x1": -50, "x2": 50, "y1": 3650, "y2": 3750}
      }
    }
  }
  "Body roll rate (rad/s)"
  pb = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 250, "y1": 950, "x2": 350, "y2": 1050},
        "diagram": {"x1": -50, "x2": 50, "y1": 250, "y2": 350}
      }
    }
  }
  "Body yaw rate (rad/s)"
  rb = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 450, "y1": 950, "x2": 550, "y2": 1050},
