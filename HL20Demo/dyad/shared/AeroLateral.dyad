"""
HL-20 yawing-moment coefficient buildup (TM-4302), including the p and r
damping polynomials scaled by the span damping factor.
"""
component HL20CN
  "Angle of attack (deg)"
  alpha_deg = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 0, "x2": 50, "y2": 100},
        "diagram": {"x1": 150, "x2": 250, "y1": -50, "y2": 50}
      }
    }
  }
  "Sideslip angle (deg)"
  beta_deg = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 100, "x2": 50, "y2": 200},
        "diagram": {"x1": -50, "x2": 50, "y1": 950, "y2": 1050}
      }
    }
  }
  "Mach number"
  mach = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 200, "x2": 50, "y2": 300},
        "diagram": {"x1": 100, "x2": 200, "y1": -50, "y2": 50}
      }
    }
  }
  "Height over body span (ground effect)"
  hob = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 300, "x2": 50, "y2": 400},
        "diagram": {"x1": -50, "x2": 50, "y1": 650, "y2": 750}
      }
    }
  }
  "Left body flap deflection (deg)"
  DBFLL = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 400, "x2": 50, "y2": 500},
        "diagram": {"x1": -50, "x2": 50, "y1": 900, "y2": 1000}
      }
    }
  }
  "Right body flap deflection (deg)"
  DBFLR = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 500, "x2": 50, "y2": 600},
        "diagram": {"x1": -50, "x2": 50, "y1": 1150, "y2": 1250}
      }
    }
  }
  "Upper left body flap deflection (deg)"
  DBFUL = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 600, "x2": 50, "y2": 700},
        "diagram": {"x1": -50, "x2": 50, "y1": 1650, "y2": 1750}
      }
    }
  }
  "Upper right body flap deflection (deg)"
  DBFUR = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 700, "x2": 50, "y2": 800},
        "diagram": {"x1": -50, "x2": 50, "y1": 1900, "y2": 2000}
      }
    }
  }
  "Left wing flap deflection (deg)"
  DWFL = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 800, "x2": 50, "y2": 900},
        "diagram": {"x1": -50, "x2": 50, "y1": 2150, "y2": 2250}
      }
    }
  }
  "Right wing flap deflection (deg)"
  DWFR = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 900, "x2": 50, "y2": 1000},
        "diagram": {"x1": -50, "x2": 50, "y1": 2400, "y2": 2500}
      }
    }
  }
  "Rudder deflection magnitude (deg)"
  abs_drud = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 50, "y1": 950, "x2": 150, "y2": 1050},
        "diagram": {"x1": -50, "x2": 50, "y1": 2650, "y2": 2750}
      }
    }
  }
  "Body roll rate (rad/s)"
  pb = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 250, "y1": 950, "x2": 350, "y2": 1050},
        "diagram": {"x1": 800, "x2": 900, "y1": -50, "y2": 50}
      }
    }
  }
  "Body yaw rate (rad/s)"
  rb = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 450, "y1": 950, "x2": 550, "y2": 1050},
