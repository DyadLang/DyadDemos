"""
HL-20 yawing-moment coefficient buildup (TM-4302), including the p and r
damping polynomials scaled by the span damping factor.
"""
component HL20CN
  "Angle of attack (deg)"
  alpha_deg = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 0, "x2": 50, "y2": 100},
        "diagram": {"x1": 550, "x2": 650, "y1": -50, "y2": 50}
      }
    }
