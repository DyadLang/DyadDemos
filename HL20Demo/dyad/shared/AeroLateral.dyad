"""
HL-20 rolling-moment coefficient buildup (TM-4302), including the p and r
damping polynomials scaled by the span damping factor.
"""
component HL20CR
  "Angle of attack (deg)"
  alpha_deg = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 0, "x2": 50, "y2": 100},
        "diagram": {"x1": 550, "x2": 650, "y1": -50, "y2": 50}
      }
    }
  }
  "Sideslip angle (deg)"
  beta_deg = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 100, "x2": 50, "y2": 200},
        "diagram": {"x1": -50, "x2": 50, "y1": 1950, "y2": 2050}
      }
    }
  }
  "Mach number"
  mach = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 200, "x2": 50, "y2": 300},
        "diagram": {"x1": 300, "x2": 400, "y1": -50, "y2": 50}
      }
    }
  }
  "Height over body span (ground effect)"
  hob = RealInput() {
