      }
    }
  }
  DBFLL = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 200, "y1": 950, "x2": 300, "y2": 1050},
        "diagram": {"x1": -50, "x2": 50, "y1": 600, "y2": 700}
