  }
  # Air-data conditioning: |DRUD|, b/(2V), c/(2V)
  air = AeroAirData(CBAR_ft = CBAR_ft, BSPAN_ft = BSPAN_ft) {
    "Dyad": {"placement": {"diagram": {"x1": 1700, "x2": 2800, "y1": 3275, "y2": 4375}}}
  }
  # Longitudinal coefficients: CL, CD, Cm, CX, CZ
  lon = AeroLongitudinal(DLG = DLG, Cm_bias = Cm_bias, CMQ0 = CMQ0, CMQ1 = CMQ1, CMQ2 = CMQ2, CMQ3 = CMQ3) {
    "Dyad": {"placement": {"diagram": {"x1": 1700, "x2": 2800, "y1": 100, "y2": 1250}}}
  }
  # Lateral-directional coefficients: CY, Cl, Cn
  lat = AeroLateralCoeffs(DLG = DLG, CNP0 = CNP0, CNP1 = CNP1, CNP2 = CNP2, CNP3 = CNP3, CNR0 = CNR0, CNR1 = CNR1, CNR2 = CNR2, CNR3 = CNR3, CLP0 = CLP0, CLP1 = CLP1, CLP2 = CLP2, CLP3 = CLP3, CLR0 = CLR0, CLR1 = CLR1, CLR2 = CLR2, CLR3 = CLR3) {
    "Dyad": {"placement": {"diagram": {"x1": 1700, "x2": 2800, "y1": 1675, "y2": 2775}}}
  }
