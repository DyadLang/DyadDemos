"""
HL-20 aerodynamic model. TM-4302 coefficient buildup via registered symbolic
functions, expressed graphically: every operation is a wired BlockComponents
block and each force/moment coefficient is built up in a dedicated subsystem.

The diagram is organised into three sub-assemblies (see `AeroGroups.dyad`):
`air` conditions the shared air-data inputs (|DRUD|, b/2V, c/2V), `lon` builds
the longitudinal coefficients (CL, CD, Cm and the CX/CZ axis rotation), and
`lat` builds the lateral-directional coefficients (CY, Cl, Cn).
"""
component HL20Aero
  # Inputs
  alpha_deg = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "x2": 40, "y1": 10, "y2": 90}, "diagram": {"x1": -40.0, "y1": 20.0, "x2": 40.0, "y2": 80.0}}}}
  beta_deg = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "x2": 40, "y1": 138.6, "y2": 218.6}, "diagram": {"x1": -40.0, "y1": 170.0, "x2": 40.0, "y2": 230.0}}}}
  mach = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "x2": 40, "y1": 267.1, "y2": 347.1}, "diagram": {"x1": -40.0, "y1": 320.0, "x2": 40.0, "y2": 380.0}}}}
  vrw_fps = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "x2": 40, "y1": 395.7, "y2": 475.7}, "diagram": {"x1": -40.0, "y1": 1670.0, "x2": 40.0, "y2": 1730.0}}}}
  hob = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "x2": 40, "y1": 524.3, "y2": 604.3}, "diagram": {"x1": -40.0, "y1": 470.0, "x2": 40.0, "y2": 530.0}}}}
  pb = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "x2": 40, "y1": 652.9, "y2": 732.9}, "diagram": {"x1": -40.0, "y1": 1820.0, "x2": 40.0, "y2": 1880.0}}}}
  qb = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "x2": 40, "y1": 781.4, "y2": 861.4}, "diagram": {"x1": 3360.0, "y1": 1170.0, "x2": 3440.0, "y2": 1230.0}}}}
  rb = RealInput() {"Dyad": {"placement": {"icon": {"x1": -40, "x2": 40, "y1": 910, "y2": 990}, "diagram": {"x1": -40.0, "y1": 1970.0, "x2": 40.0, "y2": 2030.0}}}}
  DBFUL = RealInput() {"Dyad": {"placement": {"icon": {"x1": 5, "x2": 95, "y1": 955, "y2": 1045}, "diagram": {"x1": -40.0, "y1": 920.0, "x2": 40.0, "y2": 980.0}}}}
  DBFUR = RealInput() {"Dyad": {"placement": {"icon": {"x1": 155, "x2": 245, "y1": 955, "y2": 1045}, "diagram": {"x1": -40.0, "y1": 1070.0, "x2": 40.0, "y2": 1130.0}}}}
  DBFLL = RealInput() {"Dyad": {"placement": {"icon": {"x1": 305, "x2": 395, "y1": 955, "y2": 1045}, "diagram": {"x1": -40.0, "y1": 620.0, "x2": 40.0, "y2": 680.0}}}}
  DBFLR = RealInput() {"Dyad": {"placement": {"icon": {"x1": 455, "x2": 545, "y1": 955, "y2": 1045}, "diagram": {"x1": -40.0, "y1": 770.0, "x2": 40.0, "y2": 830.0}}}}
  DWFL = RealInput() {"Dyad": {"placement": {"icon": {"x1": 605, "x2": 695, "y1": 955, "y2": 1045}, "diagram": {"x1": -40.0, "y1": 1220.0, "x2": 40.0, "y2": 1280.0}}}}
  DWFR = RealInput() {"Dyad": {"placement": {"icon": {"x1": 755, "x2": 845, "y1": 955, "y2": 1045}, "diagram": {"x1": -40.0, "y1": 1370.0, "x2": 40.0, "y2": 1430.0}}}}
  DRUD = RealInput() {"Dyad": {"placement": {"icon": {"x1": 905, "x2": 995, "y1": 955, "y2": 1045}, "diagram": {"x1": -40.0, "y1": 1520.0, "x2": 40.0, "y2": 1580.0}}}}
  parameter DLG::Real = 0.0
  parameter CBAR_ft::Real = 28.24
  parameter BSPAN_ft::Real = 13.89
  parameter Cm_bias::Real = 0.006449
  # Dynamic derivative polynomial coefficients (from DML)
  parameter CMQ0::Real = -0.22364
  parameter CMQ1::Real = 0.020457
  parameter CMQ2::Real = -0.0016741
  parameter CMQ3::Real = 0.000031618
  parameter CNP0::Real = 0.40031
  parameter CNP1::Real = -0.015518
  parameter CNP2::Real = -0.00012143
  parameter CNP3::Real = 0.000018240
  parameter CNR0::Real = -0.79533
  parameter CNR1::Real = -0.012647
  parameter CNR2::Real = 0.00032696
  parameter CNR3::Real = -0.0000065929
  parameter CLP0::Real = -0.55242
  parameter CLP1::Real = 0.014478
  parameter CLP2::Real = -0.0011545
  parameter CLP3::Real = 0.000017706
  parameter CLR0::Real = 0.44685
  parameter CLR1::Real = 0.067411
  parameter CLR2::Real = -0.0051866
  parameter CLR3::Real = 0.00012659
  # Outputs
  CX = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "x2": 1050, "y1": 0, "y2": 100}, "diagram": {"x1": 3360.0, "y1": 270.0, "x2": 3440.0, "y2": 330.0}}}}
  CY = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "x2": 1050, "y1": 180, "y2": 280}, "diagram": {"x1": 3360.0, "y1": 1920.0, "x2": 3440.0, "y2": 1980.0}}}}
  CZ = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "x2": 1050, "y1": 360, "y2": 460}, "diagram": {"x1": 3360.0, "y1": 420.0, "x2": 3440.0, "y2": 480.0}}}}
  Cl = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "x2": 1050, "y1": 540, "y2": 640}, "diagram": {"x1": 3360.0, "y1": 2070.0, "x2": 3440.0, "y2": 2130.0}}}}
  Cm = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "x2": 1050, "y1": 720, "y2": 820}, "diagram": {"x1": 3360.0, "y1": 620.0, "x2": 3440.0, "y2": 680.0}}}}
  Cn = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "x2": 1050, "y1": 900, "y2": 1000}, "diagram": {"x1": 3360.0, "y1": 2220.0, "x2": 3440.0, "y2": 2280.0}}}}
  # Air-data conditioning: |DRUD|, b/(2V), c/(2V)
  air = AeroAirData(CBAR_ft = CBAR_ft, BSPAN_ft = BSPAN_ft) {
    "Dyad": {"placement": {"diagram": {"x1": 1700, "x2": 2800, "y1": 3275, "y2": 4375}}}
  }
  # Longitudinal coefficients: CL, CD, Cm, CX, CZ
  lon = AeroLongitudinal(DLG = DLG, Cm_bias = Cm_bias, CMQ0 = CMQ0, CMQ1 = CMQ1, CMQ2 = CMQ2, CMQ3 = CMQ3) {
    "Dyad": {"placement": {"diagram": {"x1": 1700, "x2": 2800, "y1": 100, "y2": 1250}}}
  }
  # Lateral-directional coefficients: CY, Cl, Cn
  lat = AeroLateralCoeffs(DLG = DLG, CNP0 = CNP0, CNP1 = CNP1, CNP2 = CNP2, CNP3 = CNP3, CNR0 = CNR0, CNR1 = CNR1, CNR2 = CNR2, CNR3 = CNR3, CLP0 = CLP0, CLP1 = CLP1, CLP2 = CLP2, CLP3 = CLP3, CLR0 = CLR0, CLR1 = CLR1, CLR2 = CLR2, CLR3 = CLR3) {
    "Dyad": {"placement": {"diagram": {"x1": 1700, "x2": 2800, "y1": 1675, "y2": 2775}}}
  }
relations
          connect(alpha_deg, lon.alpha_deg, lat.alpha_deg) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": 2, "M": [{"x": 200, "y": 157.5}], "E": -1}, {"S": 3, "M": [{"x": 1400, "y": 1730.0}, {"x": 1400, "y": 50.0}], "E": -1}], "path": {}, "junctions": [{"x": 200, "y": 50.0}]}}
  connect(beta_deg, lat.beta_deg) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1351, "y": 200}, {"x": 1351, "y": 1840}], "E": 2}], "path": {}} }
          connect(mach, lon.mach, lat.mach) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": 2, "M": [{"x": 250, "y": 272.5}], "E": -1}, {"S": 3, "M": [{"x": 1350, "y": 1950.0}, {"x": 1350, "y": 350.0}], "E": -1}], "path": {}, "junctions": [{"x": 250, "y": 350.0}]}}
          connect(hob, lon.hob, lat.hob) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": 2, "M": [{"x": 300, "y": 387.5}], "E": -1}, {"S": 3, "M": [{"x": 1300, "y": 2060.0}, {"x": 1300, "y": 500.0}], "E": -1}], "path": {}, "junctions": [{"x": 300, "y": 500.0}]}}
          connect(DBFLL, lon.DBFLL, lat.DBFLL) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": 2, "M": [{"x": 350, "y": 502.5}], "E": -1}, {"S": 3, "M": [{"x": 1250, "y": 2170.0}, {"x": 1250, "y": 650.0}], "E": -1}], "path": {}, "junctions": [{"x": 350, "y": 650.0}]}}
          connect(DBFLR, lon.DBFLR, lat.DBFLR) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": 2, "M": [{"x": 400, "y": 617.5}], "E": -1}, {"S": 3, "M": [{"x": 1200, "y": 2280.0}, {"x": 1200, "y": 800.0}], "E": -1}], "path": {}, "junctions": [{"x": 400, "y": 800.0}]}}
          connect(DBFUL, lon.DBFUL, lat.DBFUL) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": 2, "M": [{"x": 450, "y": 732.5}], "E": -1}, {"S": 3, "M": [{"x": 1150, "y": 2390.0}, {"x": 1150, "y": 950.0}], "E": -1}], "path": {}, "junctions": [{"x": 450, "y": 950.0}]}}
          connect(DBFUR, lon.DBFUR, lat.DBFUR) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": 2, "M": [{"x": 500, "y": 847.5}], "E": -1}, {"S": 3, "M": [{"x": 1100, "y": 2500.0}, {"x": 1100, "y": 1100.0}], "E": -1}], "path": {}, "junctions": [{"x": 500, "y": 1100.0}]}}
          connect(DWFL, lon.DWFL, lat.DWFL) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": 2, "M": [{"x": 550, "y": 962.5}], "E": -1}, {"S": 3, "M": [{"x": 1050, "y": 2610.0}, {"x": 1050, "y": 1250.0}], "E": -1}], "path": {}, "junctions": [{"x": 550, "y": 1250.0}]}}
          connect(DWFR, lon.DWFR, lat.DWFR) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": 2, "M": [{"x": 600, "y": 1077.5}], "E": -1}, {"S": 3, "M": [{"x": 1000, "y": 2720.0}, {"x": 1000, "y": 1400.0}], "E": -1}], "path": {}, "junctions": [{"x": 600, "y": 1400.0}]}}
          connect(air.abs_drud, lon.abs_drud, lat.abs_drud) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 2800, "y": 3300}], "E": -1}, {"S": 2, "M": [{"x": 1700, "y": 1500}, {"x": 2950, "y": 1500}, {"x": 2950, "y": 3300}], "E": -1}, {"S": 3, "M": [{"x": 1810, "y": 3060}, {"x": 2850, "y": 3060}], "E": -1}], "path": {}, "junctions": [{"x": 2850, "y": 3300}]}}
  connect(air.damp_b2v, lat.damp_b2v) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 2890, "y": 3495}, {"x": 2890, "y": 2980}, {"x": 2470, "y": 2980}], "E": 2}], "path": {}} }
  connect(air.damp_c2v, lon.damp_c2v) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 3050, "y": 3660}, {"x": 3050, "y": 1290}, {"x": 2140, "y": 1290}], "E": 2}], "path": {}}}
  connect(DRUD, air.DRUD) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 999, "y": 1550}, {"x": 999, "y": 3495}], "E": 2}], "path": {}} }
  connect(vrw_fps, air.vrw_fps) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 997, "y": 1700}, {"x": 997, "y": 3330}], "E": 2}], "path": {}} }
  connect(pb, lat.pb) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 996, "y": 1850}, {"x": 996, "y": 3030}, {"x": 2030, "y": 3030}], "E": 2}], "path": {}} }
  connect(rb, lat.rb) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 993, "y": 2000}, {"x": 993, "y": 3055}, {"x": 2043, "y": 3055}, {"x": 2043, "y": 2775}], "E": 2}], "path": {}} }
  connect(qb, lon.qb) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 3470, "y": 1200}, {"x": 3470, "y": 1340}, {"x": 1920, "y": 1340}], "E": 2}], "path": {}}}
  connect(lon.CX, CX) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 2850, "y": 157.5}, {"x": 2850, "y": 444.99999999999994}, {"x": 2850, "y": 300}], "E": 2}], "path": {}}}
  connect(lon.CZ, CZ) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 2850, "y": 675.0}, {"x": 2850, "y": 560}, {"x": 2850, "y": 450}], "E": 2}], "path": {}}}
  connect(lon.Cm, Cm) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 2850, "y": 1192.5}, {"x": 2850, "y": 790}, {"x": 2850, "y": 650}], "E": 2}], "path": {}}}
  connect(lat.CY, CY) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 2850, "y": 1730.0}, {"x": 2850, "y": 2115}, {"x": 2850, "y": 1950}], "E": 2}], "path": {}}}
  connect(lat.Cl, Cl) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 2850, "y": 2225},
            {"x": 2850, "y": 2200},
            {"x": 3350, "y": 2200},
            {"x": 3350, "y": 2100}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(lat.Cn, Cn) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 2850, "y": 2720.0}, {"x": 2850, "y": 2335}, {"x": 2850, "y": 2250}], "E": 2}], "path": {}}}
metadata {"Dyad": {"icons": {"default": "dyad://HL20Demo/icon.svg"}}}
end