"""
HL-20 aerodynamic model. TM-4302 coefficient buildup via registered symbolic
functions, expressed graphically: every operation is a wired BlockComponents
block and each force/moment coefficient is built up in a dedicated subsystem.

The diagram is organised into three sub-assemblies (see `AeroGroups.dyad`):
`air` conditions the shared air-data inputs (|DRUD|, b/2V, c/2V), `lon` builds
the longitudinal coefficients (CL, CD, Cm and the CX/CZ axis rotation), and
`lat` builds the lateral-directional coefficients (CY, Cl, Cn).
"""
component HL20Aero
  # Inputs
  alpha_deg = RealInput() {
    "Dyad": {
      "placement": {"icon": {"x1": -30, "y1": 20, "x2": 30, "y2": 80}, "diagram": {"x1": 220, "x2": 280, "y1": 2010, "y2": 2070}}
    }
  }
  beta_deg = RealInput() {
    "Dyad": {
      "placement": {"icon": {"x1": -30, "y1": 120, "x2": 30, "y2": 180}, "diagram": {"x1": 1220, "x2": 1280, "y1": 1610, "y2": 1670}}
    }
  }
  mach = RealInput() {
    "Dyad": {
      "placement": {"icon": {"x1": -30, "y1": 220, "x2": 30, "y2": 280}, "diagram": {"x1": 320, "x2": 380, "y1": 1970, "y2": 2030}}
    }
  }
  vrw_fps = RealInput() {
    "Dyad": {
      "placement": {"icon": {"x1": -30, "y1": 320, "x2": 30, "y2": 380}, "diagram": {"x1": 595, "x2": 655, "y1": 4230, "y2": 4290}}
    }
  }
  hob = RealInput() {
    "Dyad": {
      "placement": {"icon": {"x1": -30, "y1": 420, "x2": 30, "y2": 480}, "diagram": {"x1": 420, "x2": 480, "y1": 1930, "y2": 1990}}
    }
  }
  pb = RealInput() {
    "Dyad": {
      "placement": {"icon": {"x1": -30, "y1": 520, "x2": 30, "y2": 580}, "diagram": {"x1": 1320, "x2": 1380, "y1": 1570, "y2": 1630}}
    }
  }
  qb = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 620, "x2": 30, "y2": 680}, "diagram": {"x1": 1120, "x2": 1180, "y1": 1650, "y2": 1710}}}}
  rb = RealInput() {
    "Dyad": {
      "placement": {"icon": {"x1": -30, "y1": 720, "x2": 30, "y2": 780}, "diagram": {"x1": 1420, "x2": 1480, "y1": 1530, "y2": 1590}}
    }
  }
  DBFUL = RealInput() {
    "Dyad": {
      "placement": {"icon": {"x1": 20, "y1": 970, "x2": 80, "y2": 1030}, "diagram": {"x1": 720, "x2": 780, "y1": 1810, "y2": 1870}}
    }
  }
  DBFUR = RealInput() {
    "Dyad": {
      "placement": {"icon": {"x1": 120, "y1": 970, "x2": 180, "y2": 1030}, "diagram": {"x1": 820, "x2": 880, "y1": 1770, "y2": 1830}}
    }
  }
  DBFLL = RealInput() {
    "Dyad": {
      "placement": {"icon": {"x1": 220, "y1": 970, "x2": 280, "y2": 1030}, "diagram": {"x1": 520, "x2": 580, "y1": 1890, "y2": 1950}}
    }
  }
  DBFLR = RealInput() {
    "Dyad": {
      "placement": {"icon": {"x1": 320, "y1": 970, "x2": 380, "y2": 1030}, "diagram": {"x1": 620, "x2": 680, "y1": 1850, "y2": 1910}}
    }
  }
  DWFL = RealInput() {
    "Dyad": {
      "placement": {"icon": {"x1": 420, "y1": 970, "x2": 480, "y2": 1030}, "diagram": {"x1": 920, "x2": 980, "y1": 1730, "y2": 1790}}
    }
  }
  DWFR = RealInput() {
    "Dyad": {
      "placement": {"icon": {"x1": 520, "y1": 970, "x2": 580, "y2": 1030}, "diagram": {"x1": 1020, "x2": 1080, "y1": 1690, "y2": 1750}}
    }
  }
  DRUD = RealInput() {
    "Dyad": {
      "placement": {"icon": {"x1": 620, "y1": 970, "x2": 680, "y2": 1030}, "diagram": {"x1": 945, "x2": 1005, "y1": 4230, "y2": 4290}}
    }
  }
  parameter DLG::Real = 0.0
  parameter CBAR_ft::Real = 28.24
  parameter BSPAN_ft::Real = 13.89
  parameter Cm_bias::Real = 0.006449
  # Dynamic derivative polynomial coefficients (from DML)
  parameter CMQ0::Real = -0.22364
  parameter CMQ1::Real = 0.020457
  parameter CMQ2::Real = -0.0016741
  parameter CMQ3::Real = 0.000031618
  parameter CNP0::Real = 0.40031
  parameter CNP1::Real = -0.015518
  parameter CNP2::Real = -0.00012143
  parameter CNP3::Real = 0.000018240
  parameter CNR0::Real = -0.79533
  parameter CNR1::Real = -0.012647
  parameter CNR2::Real = 0.00032696
  parameter CNR3::Real = -0.0000065929
  parameter CLP0::Real = -0.55242
  parameter CLP1::Real = 0.014478
  parameter CLP2::Real = -0.0011545
  parameter CLP3::Real = 0.000017706
  parameter CLR0::Real = 0.44685
  parameter CLR1::Real = 0.067411
  parameter CLR2::Real = -0.0051866
  parameter CLR3::Real = 0.00012659
  # Outputs
  CX = RealOutput() {
    "Dyad": {
      "placement": {"icon": {"x1": 970, "y1": 120, "x2": 1030, "y2": 180}, "diagram": {"x1": 3320, "x2": 3380, "y1": 415, "y2": 475}}
    }
  }
  CY = RealOutput() {
    "Dyad": {
      "placement": {"icon": {"x1": 970, "y1": 220, "x2": 1030, "y2": 280}, "diagram": {"x1": 3320, "x2": 3380, "y1": 2710, "y2": 2770}}
    }
  }
  CZ = RealOutput() {
    "Dyad": {
      "placement": {"icon": {"x1": 970, "y1": 320, "x2": 1030, "y2": 380}, "diagram": {"x1": 3320, "x2": 3380, "y1": 530, "y2": 590}}
    }
  }
  Cl = RealOutput() {
    "Dyad": {
      "placement": {"icon": {"x1": 970, "y1": 420, "x2": 1030, "y2": 480}, "diagram": {"x1": 3320, "x2": 3380, "y1": 2820, "y2": 2880}}
    }
  }
  Cm = RealOutput() {
    "Dyad": {
      "placement": {"icon": {"x1": 970, "y1": 520, "x2": 1030, "y2": 580}, "diagram": {"x1": 3320, "x2": 3380, "y1": 760, "y2": 820}}
    }
  }
  Cn = RealOutput() {
    "Dyad": {
      "placement": {"icon": {"x1": 970, "y1": 620, "x2": 1030, "y2": 680}, "diagram": {"x1": 3320, "x2": 3380, "y1": 2930, "y2": 2990}}
    }
  }
  # Air-data conditioning: |DRUD|, b/(2V), c/(2V)
  air = AeroAirData(CBAR_ft = CBAR_ft, BSPAN_ft = BSPAN_ft) {
    "Dyad": {"placement": {"diagram": {"x1": 450, "x2": 1150, "y1": 3450, "y2": 4150}}}
  }
  # Longitudinal coefficients: CL, CD, Cm, CX, CZ
  lon = AeroLongitudinal(DLG = DLG, Cm_bias = Cm_bias, CMQ0 = CMQ0, CMQ1 = CMQ1, CMQ2 = CMQ2, CMQ3 = CMQ3) {
    "Dyad": {"placement": {"diagram": {"x1": 1700, "x2": 2800, "y1": 100, "y2": 1250}}}
  }
  # Lateral-directional coefficients: CY, Cl, Cn
  lat = AeroLateralCoeffs(DLG = DLG, CNP0 = CNP0, CNP1 = CNP1, CNP2 = CNP2, CNP3 = CNP3, CNR0 = CNR0, CNR1 = CNR1, CNR2 = CNR2, CNR3 = CNR3, CLP0 = CLP0, CLP1 = CLP1, CLP2 = CLP2, CLP3 = CLP3, CLR0 = CLR0, CLR1 = CLR1, CLR2 = CLR2, CLR3 = CLR3) {
    "Dyad": {"placement": {"diagram": {"x1": 1700, "x2": 2800, "y1": 2300, "y2": 3400}}}
  }
relations
  connect(alpha_deg, lon.alpha_deg, lat.alpha_deg) { "Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 200, "y": 365.3846}], "E": 2}, {"S": -1, "M": [{"x": 1920, "y": 2040}], "E": 3}], "path": {}, "junctions": [{"x": 200, "y": 2040}]} }
  connect(mach, lon.mach, lat.mach) { "Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 300, "y": 453.8462}], "E": 2}, {"S": -1, "M": [{"x": 1993.3333, "y": 2000}], "E": 3}], "path": {}, "junctions": [{"x": 300, "y": 2000}]} }
  connect(hob, lon.hob, lat.hob) { "Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 400, "y": 542.3077}], "E": 2}, {"S": -1, "M": [{"x": 2066.6667, "y": 1960}], "E": 3}], "path": {}, "junctions": [{"x": 400, "y": 1960}]} }
  connect(DBFLL, lon.DBFLL, lat.DBFLL) { "Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 500, "y": 630.7692}], "E": 2}, {"S": -1, "M": [{"x": 2140, "y": 1920}], "E": 3}], "path": {}, "junctions": [{"x": 500, "y": 1920}]} }
  connect(DBFLR, lon.DBFLR, lat.DBFLR) { "Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 600, "y": 719.2308}], "E": 2}, {"S": -1, "M": [{"x": 2213.3333, "y": 1880}], "E": 3}], "path": {}, "junctions": [{"x": 600, "y": 1880}]} }
  connect(DBFUL, lon.DBFUL, lat.DBFUL) { "Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 700, "y": 807.6923}], "E": 2}, {"S": -1, "M": [{"x": 2286.6667, "y": 1840}], "E": 3}], "path": {}, "junctions": [{"x": 700, "y": 1840}]} }
  connect(DBFUR, lon.DBFUR, lat.DBFUR) { "Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 800, "y": 896.1538}], "E": 2}, {"S": -1, "M": [{"x": 2360, "y": 1800}], "E": 3}], "path": {}, "junctions": [{"x": 800, "y": 1800}]} }
  connect(DWFL, lon.DWFL, lat.DWFL) { "Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 900, "y": 984.6154}], "E": 2}, {"S": -1, "M": [{"x": 2433.3333, "y": 1760}], "E": 3}], "path": {}, "junctions": [{"x": 900, "y": 1760}]} }
  connect(DWFR, lon.DWFR, lat.DWFR) { "Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 1000, "y": 1073.0769}], "E": 2}, {"S": -1, "M": [{"x": 2506.6667, "y": 1720}], "E": 3}], "path": {}, "junctions": [{"x": 1000, "y": 1720}]} }
  connect(qb, lon.qb) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1100, "y": 1680}, {"x": 1100, "y": 1161.5385}], "E": 2}], "path": {}} }
  connect(beta_deg, lat.beta_deg) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 2580, "y": 1640}], "E": 2}], "path": {}} }
  connect(pb, lat.pb) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 2653.3333, "y": 1600}], "E": 2}], "path": {}} }
  connect(rb, lat.rb) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 2726.6667, "y": 1560}], "E": 2}], "path": {}} }
  connect(vrw_fps, air.vrw_fps) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(DRUD, air.DRUD) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(air.damp_c2v, lon.damp_c2v) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 195, "y": 3485}, {"x": 195, "y": 276.9231}], "E": 2}], "path": {}} }
  connect(air.abs_drud, lon.abs_drud, lat.abs_drud) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 205, "y": 3590}, {"x": 205, "y": 4310}], "E": -1}, {"S": -1, "M": [{"x": 191, "y": 188.4615}], "E": 2}, {"S": -1, "M": [{"x": 1650, "y": 4310}, {"x": 1650, "y": 2280}, {"x": 1773.3333, "y": 2280}], "E": 3}], "path": {}, "junctions": [{"x": 191, "y": 4310}]} }
  connect(air.damp_b2v, lat.damp_b2v) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 215, "y": 3695}, {"x": 215, "y": 4300}, {"x": 1600, "y": 4300}, {"x": 1600, "y": 2110}, {"x": 1846.6667, "y": 2110}], "E": 2}], "path": {}} }
  connect(lon.CX, CX) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(lon.CZ, CZ) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
