        "diagram": {"x1": -50, "x2": 50, "y1": 1650, "y2": 1750}
      }
    }
  }
  hob = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 400, "x2": 50, "y2": 500},
        "diagram": {"x1": -50, "x2": 50, "y1": 450, "y2": 550}
      }
    }
  }
  pb = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 500, "x2": 50, "y2": 600},
        "diagram": {"x1": -50, "x2": 50, "y1": 1800, "y2": 1900}
      }
    }
  }
  qb = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 600, "x2": 50, "y2": 700}, "diagram": {"x1": 3350, "x2": 3450, "y1": 1150, "y2": 1250}}}}
  rb = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 700, "x2": 50, "y2": 800},
        "diagram": {"x1": -50, "x2": 50, "y1": 1950, "y2": 2050}
