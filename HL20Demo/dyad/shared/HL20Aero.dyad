      "placement": {
        "icon": {"x1": 950, "y1": 300, "x2": 1050, "y2": 400},
        "diagram": {"x1": 3350, "x2": 3450, "y1": 400, "y2": 500}
      }
    }
  }
  Cl = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 400, "x2": 1050, "y2": 500},
        "diagram": {"x1": 3350, "x2": 3450, "y1": 2050, "y2": 2150}
