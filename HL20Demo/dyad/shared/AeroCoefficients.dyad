  "Landing gear deflection (deg)"
  parameter DLG::Real = 0.0
  t0a = HL20Table1D(group = HL20Demo.idx1d("CD0A")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 900, "y2": 1000}}}}
  tge = HL20Table1D(group = HL20Demo.idx1d("CDGE")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 650, "y2": 750}}}}
  dlg_const = BlockComponents.Sources.Constant(k = DLG) {"Dyad": {"placement": {"diagram": {"x1": 760, "x2": 860, "y1": 545, "y2": 645}}}}
  tlg = HL20Table1D(group = HL20Demo.idx1d("CDLG")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 400, "y2": 500}}}}
  tbfll = HL20Table2DR(group = HL20Demo.grp2dr("CDBFLL")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 1150, "y2": 1250}}}}
  tbflr = HL20Table2DR(group = HL20Demo.grp2dr("CDBFLR")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 1400, "y2": 1500}}}}
  tbful = HL20Table2DR(group = HL20Demo.grp2dr("CDBFUL")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 1650, "y2": 1750}}}}
  tbfur = HL20Table2DR(group = HL20Demo.grp2dr("CDBFUR")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 1900, "y2": 2000}}}}
  twfl = HL20Table2DR(group = HL20Demo.grp2dr("CDWFL")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 2150, "y2": 2250}}}}
  twfr = HL20Table2DR(group = HL20Demo.grp2dr("CDWFR")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 2400, "y2": 2500}}}}
  trud = HL20Table2DE(group = HL20Demo.grp2de("CDRUD")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 2650, "y2": 2750}}}}
  base = BlockComponents.Math.Add3() {"Dyad": {"placement": {"diagram": {"x1": 1350, "x2": 1450, "y1": 650, "y2": 750}}}}
  bfl = BlockComponents.Math.Add() {"Dyad": {"placement": {"diagram": {"x1": 1350, "x2": 1450, "y1": 1275, "y2": 1375}}}}
