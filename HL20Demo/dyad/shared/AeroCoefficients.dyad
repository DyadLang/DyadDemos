"""
HL-20 pitching-moment coefficient buildup (TM-4302), including the pitch-rate
damping polynomial and the trim bias.
"""
component HL20CM
  "Angle of attack (deg)"
  alpha_deg = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 0, "x2": 50, "y2": 100},
        "diagram": {"x1": 550, "x2": 650, "y1": -50, "y2": 50}
      }
    }
  }
  "Mach number"
  mach = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 100, "x2": 50, "y2": 200},
        "diagram": {"x1": 300, "x2": 400, "y1": -50, "y2": 50}
      }
    }
  }
  "Height over body span (ground effect)"
  hob = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 200, "x2": 50, "y2": 300},
        "diagram": {"x1": -50, "x2": 50, "y1": 800, "y2": 900}
      }
    }
  }
  "Left body flap deflection (deg)"
  DBFLL = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 300, "x2": 50, "y2": 400},
        "diagram": {"x1": -50, "x2": 50, "y1": 1300, "y2": 1400}
      }
    }
  }
  "Right body flap deflection (deg)"
  DBFLR = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 400, "x2": 50, "y2": 500},
        "diagram": {"x1": -50, "x2": 50, "y1": 1550, "y2": 1650}
      }
    }
  }
  "Upper left body flap deflection (deg)"
  DBFUL = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 500, "x2": 50, "y2": 600},
        "diagram": {"x1": -50, "x2": 50, "y1": 1800, "y2": 1900}
      }
    }
  }
  "Upper right body flap deflection (deg)"
  DBFUR = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 600, "x2": 50, "y2": 700},
        "diagram": {"x1": -50, "x2": 50, "y1": 2050, "y2": 2150}
      }
    }
  }
  "Left wing flap deflection (deg)"
  DWFL = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 700, "x2": 50, "y2": 800},
        "diagram": {"x1": -50, "x2": 50, "y1": 2300, "y2": 2400}
      }
    }
  }
  "Right wing flap deflection (deg)"
  DWFR = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 800, "x2": 50, "y2": 900},
        "diagram": {"x1": -50, "x2": 50, "y1": 2550, "y2": 2650}
      }
    }
  }
  "Rudder deflection magnitude (deg)"
  abs_drud = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 900, "x2": 50, "y2": 1000},
        "diagram": {"x1": -50, "x2": 50, "y1": 2800, "y2": 2900}
      }
    }
  }
  "Body pitch rate (rad/s)"
  qb = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 150, "y1": 950, "x2": 250, "y2": 1050},
        "diagram": {"x1": 800, "x2": 900, "y1": -50, "y2": 50}
      }
    }
  }
  "Chord damping factor cbar/(2 V)"
  damp_c2v = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 350, "y1": 950, "x2": 450, "y2": 1050},
        "diagram": {"x1": 1050, "x2": 1150, "y1": -50, "y2": 50}
      }
    }
  }
  "Total pitching-moment coefficient"
  y = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550},
        "diagram": {"x1": 2350, "x2": 2450, "y1": 600, "y2": 700}
      }
    }
  }
  "Landing gear deflection (deg)"
  parameter DLG::Real = 0.0
  "Trim correction added to Cm"
  parameter Cm_bias::Real = 0.006449
  "Pitch damping polynomial coefficients"
  parameter CMQ0::Real = -0.22364
  parameter CMQ1::Real = 0.020457
  parameter CMQ2::Real = -0.0016741
  parameter CMQ3::Real = 0.000031618
  t0a = HL20Table1D(group = HL20Demo.idx1d("CM0A")) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 1050, "y2": 1150}}}
  }
  tge = HL20Table1D(group = HL20Demo.idx1d("CMGE")) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 800, "y2": 900}}}
  }
  dlg_const = BlockComponents.Sources.Constant(k = DLG) {
    "Dyad": {"placement": {"diagram": {"x1": 300, "x2": 400, "y1": 900, "y2": 1000}}}
  }
  tlg = HL20Table1D(group = HL20Demo.idx1d("CMLG")) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 550, "y2": 650}}}
  }
  tbfll = HL20Table2DR(group = HL20Demo.grp2dr("CMBFLL")) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 1300, "y2": 1400}}}
  }
  tbflr = HL20Table2DR(group = HL20Demo.grp2dr("CMBFLR")) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 1550, "y2": 1650}}}
  }
  tbful = HL20Table2DR(group = HL20Demo.grp2dr("CMBFUL")) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 1800, "y2": 1900}}}
  }
  tbfur = HL20Table2DR(group = HL20Demo.grp2dr("CMBFUR")) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 2050, "y2": 2150}}}
  }
  twfl = HL20Table2DR(group = HL20Demo.grp2dr("CMWFL")) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 2300, "y2": 2400}}}
  }
  twfr = HL20Table2DR(group = HL20Demo.grp2dr("CMWFR")) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 2550, "y2": 2650}}}
  }
  trud = HL20Table2DE(group = HL20Demo.grp2de("CMRUD")) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 2800, "y2": 2900}}}
  }
  base = BlockComponents.Math.Add3() {
    "Dyad": {"placement": {"diagram": {"x1": 800, "x2": 900, "y1": 1000, "y2": 1100}}}
  }
  bfl = BlockComponents.Math.Add() {
    "Dyad": {"placement": {"diagram": {"x1": 850, "x2": 950, "y1": 1500, "y2": 1600}}}
  }
  bfu = BlockComponents.Math.Add() {
    "Dyad": {"placement": {"diagram": {"x1": 850, "x2": 950, "y1": 1800, "y2": 1900}}}
  }
  wf = BlockComponents.Math.Add() {
    "Dyad": {"placement": {"diagram": {"x1": 850, "x2": 950, "y1": 2050, "y2": 2150}}}
  }
  cmq_poly = CubicPoly(c0 = CMQ0, c1 = CMQ1, c2 = CMQ2, c3 = CMQ3) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 300, "y2": 400}}}
  }
  cmq_qb = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 800, "x2": 900, "y1": 600, "y2": 700}}}
  }
  cmq_damp = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 1050, "x2": 1150, "y1": 600, "y2": 700}}}
  }
  bias = BlockComponents.Sources.Constant(k = Cm_bias) {
    "Dyad": {"placement": {"diagram": {"x1": 1300, "x2": 1400, "y1": 300, "y2": 400}}}
  }
  sum1 = BlockComponents.Math.Add3() {
    "Dyad": {"placement": {"diagram": {"x1": 1050, "x2": 1150, "y1": 1500, "y2": 1600}}}
  }
  sum2 = BlockComponents.Math.Add3() {
    "Dyad": {"placement": {"diagram": {"x1": 1300, "x2": 1400, "y1": 2050, "y2": 2150}}}
  }
  sum3 = BlockComponents.Math.Add3() {
    "Dyad": {"placement": {"diagram": {"x1": 1550, "x2": 1650, "y1": 600, "y2": 700}}}
  }
relations
