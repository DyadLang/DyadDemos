  sum1 = BlockComponents.Math.Add3() {"Dyad": {"placement": {"diagram": {"x1": 1600, "x2": 1700, "y1": 1275, "y2": 1375}}}}
  sum2 = BlockComponents.Math.Add3() {"Dyad": {"placement": {"diagram": {"x1": 1850, "x2": 1950, "y1": 2050, "y2": 2150}}}}
