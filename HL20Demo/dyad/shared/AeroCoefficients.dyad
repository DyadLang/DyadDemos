"""
HL-20 pitching-moment coefficient buildup (TM-4302), including the pitch-rate
damping polynomial and the trim bias.
"""
component HL20CM
  "Angle of attack (deg)"
  alpha_deg = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 20, "y2": 80}, "diagram": {"x1": -50, "x2": 50, "y1": 100, "y2": 200}}}}
  "Mach number"
  mach = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 120, "y2": 180}, "diagram": {"x1": -50, "x2": 50, "y1": 350, "y2": 450}}}}
  "Height over body span (ground effect)"
  hob = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 220, "y2": 280}, "diagram": {"x1": -50, "x2": 50, "y1": 680, "y2": 780}}}}
  "Left body flap deflection (deg)"
  DBFLL = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 320, "y2": 380}, "diagram": {"x1": -50, "x2": 50, "y1": 1150, "y2": 1250}}}}
  "Right body flap deflection (deg)"
  DBFLR = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 420, "y2": 480}, "diagram": {"x1": -50, "x2": 50, "y1": 1400, "y2": 1500}}}}
  "Upper left body flap deflection (deg)"
  DBFUL = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 520, "y2": 580}, "diagram": {"x1": -50, "x2": 50, "y1": 1650, "y2": 1750}}}}
  "Upper right body flap deflection (deg)"
  DBFUR = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 620, "y2": 680}, "diagram": {"x1": -50, "x2": 50, "y1": 1900, "y2": 2000}}}}
  "Left wing flap deflection (deg)"
  DWFL = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 720, "y2": 780}, "diagram": {"x1": -50, "x2": 50, "y1": 2150, "y2": 2250}}}}
  "Right wing flap deflection (deg)"
  DWFR = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 820, "y2": 880}, "diagram": {"x1": -50, "x2": 50, "y1": 2400, "y2": 2500}}}}
  "Rudder deflection magnitude (deg)"
  abs_drud = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "x2": 30, "y1": 920, "y2": 980}, "diagram": {"x1": -50, "x2": 50, "y1": 2650, "y2": 2750}}}}
  "Body pitch rate (rad/s)"
  qb = RealInput() {"Dyad": {"placement": {"icon": {"x1": 150, "y1": 950, "x2": 250, "y2": 1050}, "diagram": {"x1": 1275, "x2": 1375, "y1": -50, "y2": 50}}}}
  "Chord damping factor cbar/(2 V)"
  damp_c2v = RealInput() {"Dyad": {"placement": {"icon": {"x1": 350, "y1": 950, "x2": 450, "y2": 1050}, "diagram": {"x1": 1575, "x2": 1675, "y1": -50, "y2": 50}}}}
  "Total pitching-moment coefficient"
  y = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550}, "diagram": {"x1": 2350, "x2": 2450, "y1": 150, "y2": 250}}}}
  "Landing gear deflection (deg)"
  parameter DLG::Real = 0.0
  "Trim correction added to Cm"
  parameter Cm_bias::Real = 0.006449
  "Pitch damping polynomial coefficients"
  parameter CMQ0::Real = -0.22364
  parameter CMQ1::Real = 0.020457
  parameter CMQ2::Real = -0.0016741
  parameter CMQ3::Real = 0.000031618
  t0a = HL20Table1D(group = HL20Demo.idx1d("CM0A")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 900, "y2": 1000}}}}
  tge = HL20Table1D(group = HL20Demo.idx1d("CMGE")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 650, "y2": 750}}}}
  dlg_const = BlockComponents.Sources.Constant(k = DLG) {"Dyad": {"placement": {"diagram": {"x1": 760, "x2": 860, "y1": 545, "y2": 645}}}}
  tlg = HL20Table1D(group = HL20Demo.idx1d("CMLG")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 400, "y2": 500}}}}
  tbfll = HL20Table2DR(group = HL20Demo.grp2dr("CMBFLL")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 1150, "y2": 1250}}}}
  tbflr = HL20Table2DR(group = HL20Demo.grp2dr("CMBFLR")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 1400, "y2": 1500}}}}
  tbful = HL20Table2DR(group = HL20Demo.grp2dr("CMBFUL")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 1650, "y2": 1750}}}}
  tbfur = HL20Table2DR(group = HL20Demo.grp2dr("CMBFUR")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 1900, "y2": 2000}}}}
  twfl = HL20Table2DR(group = HL20Demo.grp2dr("CMWFL")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 2150, "y2": 2250}}}}
  twfr = HL20Table2DR(group = HL20Demo.grp2dr("CMWFR")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 2400, "y2": 2500}}}}
  trud = HL20Table2DE(group = HL20Demo.grp2de("CMRUD")) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 2650, "y2": 2750}}}}
  base = BlockComponents.Math.Add3() {"Dyad": {"placement": {"diagram": {"x1": 1350, "x2": 1450, "y1": 650, "y2": 750}}}}
  bfl = BlockComponents.Math.Add() {"Dyad": {"placement": {"diagram": {"x1": 1350, "x2": 1450, "y1": 1275, "y2": 1375}}}}
  bfu = BlockComponents.Math.Add() {"Dyad": {"placement": {"diagram": {"x1": 1350, "x2": 1450, "y1": 1775, "y2": 1875}}}}
  wf = BlockComponents.Math.Add() {"Dyad": {"placement": {"diagram": {"x1": 1350, "x2": 1450, "y1": 2275, "y2": 2375}}}}
  cmq_poly = CubicPoly(c0 = CMQ0, c1 = CMQ1, c2 = CMQ2, c3 = CMQ3) {"Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 100, "y2": 200}}}}
  cmq_qb = BlockComponents.Math.Product() {"Dyad": {"placement": {"diagram": {"x1": 1350, "x2": 1450, "y1": 100, "y2": 200}}}}
  cmq_damp = BlockComponents.Math.Product() {"Dyad": {"placement": {"diagram": {"x1": 1650, "x2": 1750, "y1": 100, "y2": 200}}}}
  bias = BlockComponents.Sources.Constant(k = Cm_bias) {"Dyad": {"placement": {"diagram": {"x1": 1900, "x2": 2000, "y1": 300, "y2": 400}}}}
  sum1 = BlockComponents.Math.Add3() {"Dyad": {"placement": {"diagram": {"x1": 1600, "x2": 1700, "y1": 1275, "y2": 1375}}}}
  sum2 = BlockComponents.Math.Add3() {"Dyad": {"placement": {"diagram": {"x1": 1850, "x2": 1950, "y1": 2050, "y2": 2150}}}}
  sum3 = BlockComponents.Math.Add3() {"Dyad": {"placement": {"diagram": {"x1": 2100, "x2": 2200, "y1": 150, "y2": 250}}}}
relations
    connect(alpha_deg, cmq_poly.u, tlg.u1, tge.u1, t0a.u1, tbfll.u1, tbflr.u1, tbful.u1, tbfur.u1, twfl.u1, twfr.u1, trud.u1) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [], "E": -2}, {"S": -2, "M": [], "E": -3}, {"S": -3, "M": [], "E": -4}, {"S": -4, "M": [], "E": -5}, {"S": -5, "M": [], "E": -6}, {"S": -6, "M": [], "E": -7}, {"S": -7, "M": [], "E": -8}, {"S": -8, "M": [], "E": -9}, {"S": -9, "M": [], "E": -10}, {"S": -10, "M": [], "E": -11}, {"S": -1, "M": [], "E": 2}, {"S": -2, "M": [], "E": 3}, {"S": -3, "M": [], "E": 4}, {"S": -4, "M": [], "E": 5}, {"S": -5, "M": [], "E": 6}, {"S": -6, "M": [], "E": 7}, {"S": -7, "M": [], "E": 8}, {"S": -8, "M": [], "E": 9}, {"S": -9, "M": [], "E": 10}, {"S": -10, "M": [], "E": 11}, {"S": -11, "M": [], "E": 12}], "path": {}, "junctions": [{"x": 700, "y": 150.0}, {"x": 700, "y": 420.0}, {"x": 700, "y": 670.0}, {"x": 700, "y": 920.0}, {"x": 700, "y": 1160.0}, {"x": 700, "y": 1410.0}, {"x": 700, "y": 1660.0}, {"x": 700, "y": 1910.0}, {"x": 700, "y": 2160.0}, {"x": 700, "y": 2410.0}, {"x": 700, "y": 2660.0}]}}
    connect(mach, t0a.u2, tbfll.u3, tbflr.u3, tbful.u3, tbfur.u3, twfl.u3, twfr.u3, trud.u3) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 550, "y": 400.0}], "E": -1}, {"S": -1, "M": [], "E": -2}, {"S": -2, "M": [], "E": -3}, {"S": -3, "M": [], "E": -4}, {"S": -4, "M": [], "E": -5}, {"S": -5, "M": [], "E": -6}, {"S": -6, "M": [], "E": -7}, {"S": -7, "M": [], "E": -8}, {"S": -1, "M": [], "E": 2}, {"S": -2, "M": [], "E": 3}, {"S": -3, "M": [], "E": 4}, {"S": -4, "M": [], "E": 5}, {"S": -5, "M": [], "E": 6}, {"S": -6, "M": [], "E": 7}, {"S": -7, "M": [], "E": 8}, {"S": -8, "M": [], "E": 9}], "path": {}, "junctions": [{"x": 550, "y": 980.0}, {"x": 550, "y": 1240.0}, {"x": 550, "y": 1490.0}, {"x": 550, "y": 1740.0}, {"x": 550, "y": 1990.0}, {"x": 550, "y": 2240.0}, {"x": 550, "y": 2490.0}, {"x": 550, "y": 2740.0}]}}
