  }
  connect(DWFR, cl.DWFR, cd.DWFR) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [{"x": 600, "y": 1250}], "E": -1},
        {"S": 2, "M": [{"x": 600, "y": 950}], "E": -1},
        {"S": 3, "M": [{"x": 750, "y": 2350}, {"x": 750, "y": 1350}], "E": -1}
