"""
Longitudinal coefficient buildup: the CL/CD pair plus the Cm subsystem and
the stability-axis to body-axis rotation (sin/cos of alpha) producing CX, CZ.
"""
component AeroLongitudinal
  "Angle of attack (deg)"
  alpha_deg = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 0, "x2": 50, "y2": 100},
        "diagram": {"x1": -50, "x2": 50, "y1": 150, "y2": 250}
      }
    }
  }
  "Mach number"
  mach = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 100, "x2": 50, "y2": 200},
        "diagram": {"x1": -50, "x2": 50, "y1": 350, "y2": 450}
      }
    }
  }
  "Height over body span (ground effect)"
  hob = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 200, "x2": 50, "y2": 300},
        "diagram": {"x1": -50, "x2": 50, "y1": 550, "y2": 650}
      }
    }
  }
  "Left body flap deflection (deg)"
  DBFLL = RealInput() {
    "Dyad": {
      "placement": {
