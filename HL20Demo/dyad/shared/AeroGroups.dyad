# HL-20 aero sub-assemblies. Groupings of the coefficient buildup blocks used
# inside `HL20Aero` so the top-level diagram stays readable: `AeroAirData`
# conditions the shared air-data/damping inputs, `AeroLongitudinal` builds the
# longitudinal coefficients (CL, CD, Cm and the stability-to-body axis rotation
# into CX, CZ), and `AeroLateralCoeffs` builds the lateral-directional
# coefficients (CY, Cl, Cn).
"""
Shared air-data conditioning: |DRUD| and the damping factors b/(2V), c/(2V)
with division safety (V + 0.1 floor).
"""
component AeroAirData
  "Wind-relative velocity (fps)"
  vrw_fps = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 20, "x2": 30, "y2": 80},
        "diagram": {"x1": -30, "x2": 30, "y1": 170, "y2": 230}
      }
    }
  }
  "Rudder deflection (deg)"
  DRUD = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 170, "x2": 30, "y2": 230},
        "diagram": {"x1": -30, "x2": 30, "y1": 20, "y2": 80}
      }
    }
  }
  "Rudder deflection magnitude (deg)"
  abs_drud = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 970, "y1": 20, "x2": 1030, "y2": 80},
        "diagram": {"x1": 1120, "x2": 1180, "y1": 20, "y2": 80}
      }
    }
  }
  "Span damping factor b/(2 V)"
  damp_b2v = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 970, "y1": 170, "x2": 1030, "y2": 230},
        "diagram": {"x1": 1120, "x2": 1180, "y1": 170, "y2": 230}
      }
    }
  }
  "Chord damping factor cbar/(2 V)"
  damp_c2v = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 970, "y1": 320, "x2": 1030, "y2": 380},
        "diagram": {"x1": 1120, "x2": 1180, "y1": 320, "y2": 380}
      }
    }
  }
  "Reference chord (ft)"
  parameter CBAR_ft::Real = 28.24
  "Reference span (ft)"
  parameter BSPAN_ft::Real = 13.89
  abs_d = BlockComponents.Math.Abs() {
    "Dyad": {"placement": {"diagram": {"x1": 350, "x2": 450, "y1": 100, "y2": 200}}}
  }
  v_eps = BlockComponents.Sources.Constant(k = 0.1) {
    "Dyad": {"placement": {"diagram": {"x1": 100, "x2": 200, "y1": 400, "y2": 500}}}
  }
  vrw_denom = BlockComponents.Math.Add() {
    "Dyad": {"placement": {"diagram": {"x1": 350, "x2": 450, "y1": 250, "y2": 350}}}
  }
  bspan_2 = BlockComponents.Sources.Constant(k = BSPAN_ft / 2.0) {
    "Dyad": {"placement": {"diagram": {"x1": 600, "x2": 700, "y1": 100, "y2": 200}}}
  }
  cbar_2 = BlockComponents.Sources.Constant(k = CBAR_ft / 2.0) {
    "Dyad": {"placement": {"diagram": {"x1": 600, "x2": 700, "y1": 350, "y2": 450}}}
  }
  damp_b = BlockComponents.Math.Division() {
    "Dyad": {"placement": {"diagram": {"x1": 850, "x2": 950, "y1": 100, "y2": 200}}}
  }
  damp_c = BlockComponents.Math.Division() {
    "Dyad": {"placement": {"diagram": {"x1": 850, "x2": 950, "y1": 350, "y2": 450}}}
  }
relations
  connect(DRUD, abs_d.u) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 300, "y": 50}, {"x": 300, "y": 150}], "E": 2}],
      "path": {}
    }
  }
  connect(vrw_fps, vrw_denom.u1) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 300, "y": 200}, {"x": 300, "y": 270}], "E": 2}],
      "path": {}
    }
  }
  connect(v_eps.y, vrw_denom.u2) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 300, "y": 450}, {"x": 300, "y": 330}], "E": 2}],
      "path": {}
    }
  }
  connect(bspan_2.y, damp_b.u1) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 800, "y": 150}, {"x": 800, "y": 120}], "E": 2}],
      "path": {}
    }
  }
  connect(cbar_2.y, damp_c.u1) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 800, "y": 400}, {"x": 800, "y": 370}], "E": 2}],
      "path": {}
    }
  }
  connect(vrw_denom.y, damp_b.u2, damp_c.u2) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 1100, "y": 300}], "E": -1}, {"S": 2, "M": [{"x": 800, "y": 180}, {"x": 800, "y": 250}, {"x": 1100, "y": 250}], "E": -1}, {"S": 3, "M": [{"x": 800, "y": 430}, {"x": 800, "y": 500}, {"x": 525, "y": 500}, {"x": 525, "y": 300}, {"x": 1100, "y": 300}], "E": -1}],
      "junctions": [{"x": 1100, "y": 307.1428571428571}],
      "path": {}
    }
  }
  connect(abs_d.y, abs_drud) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 500, "y": 150}, {"x": 500, "y": 50}], "E": 2}],
      "path": {}
    }
  }
  connect(damp_b.y, damp_b2v) {
    "Dyad": {"edges": [{"S": 1, "M": [{"x": 1150, "y": 150}], "E": 2}], "path": {}}
  }
  connect(damp_c.y, damp_c2v) {
    "Dyad": {"edges": [{"S": 1, "M": [{"x": 1150, "y": 400}], "E": 2}], "path": {}}
  }
metadata {"Dyad": {"icons": {"default": "dyad://HL20Demo/aero_air.svg"}}}
end

"""
Lift/drag coefficient pair: the CL and CD buildup blocks behind one icon so
the shared input fanout is only two pins deep.
"""
component AeroCLCD
  "Angle of attack (deg)"
  alpha_deg = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 20, "x2": 30, "y2": 80}, "diagram": {"x1": 220, "x2": 280, "y1": 2010, "y2": 2070}}}}
  "Mach number"
  mach = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 120, "x2": 30, "y2": 180}, "diagram": {"x1": 320, "x2": 380, "y1": 1970, "y2": 2030}}}}
  "Height over body span (ground effect)"
  hob = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 220, "x2": 30, "y2": 280}, "diagram": {"x1": 420, "x2": 480, "y1": 1930, "y2": 1990}}}}
  "Left body flap deflection (deg)"
  DBFLL = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 320, "x2": 30, "y2": 380}, "diagram": {"x1": 520, "x2": 580, "y1": 1890, "y2": 1950}}}}
  "Right body flap deflection (deg)"
  DBFLR = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 420, "x2": 30, "y2": 480}, "diagram": {"x1": 620, "x2": 680, "y1": 1850, "y2": 1910}}}}
  "Upper left body flap deflection (deg)"
  DBFUL = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 520, "x2": 30, "y2": 580}, "diagram": {"x1": 720, "x2": 780, "y1": 1810, "y2": 1870}}}}
  "Upper right body flap deflection (deg)"
  DBFUR = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 620, "x2": 30, "y2": 680}, "diagram": {"x1": 820, "x2": 880, "y1": 1770, "y2": 1830}}}}
  "Left wing flap deflection (deg)"
  DWFL = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 720, "x2": 30, "y2": 780}, "diagram": {"x1": 920, "x2": 980, "y1": 1730, "y2": 1790}}}}
  "Right wing flap deflection (deg)"
  DWFR = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 820, "x2": 30, "y2": 880}, "diagram": {"x1": 1020, "x2": 1080, "y1": 1690, "y2": 1750}}}}
  "Rudder deflection magnitude (deg)"
  abs_drud = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 920, "x2": 30, "y2": 980}, "diagram": {"x1": 1120, "x2": 1180, "y1": 1650, "y2": 1710}}}}
  "Total lift coefficient"
  cl_y = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 420, "x2": 1030, "y2": 480}, "diagram": {"x1": 2900, "x2": 2960, "y1": 845.0, "y2": 905.0}}}}
  "Total drag coefficient"
  cd_y = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 620, "x2": 1030, "y2": 680}, "diagram": {"x1": 2900, "x2": 2960, "y1": 2870.0, "y2": 2930.0}}}}
  "Landing gear deflection (deg)"
  parameter DLG::Real = 0.0
  cl = HL20CL(DLG = DLG) {"Dyad": {"placement": {"diagram": {"x1": 1400, "x2": 2400, "y1": 125, "y2": 1625}}}}
  cd = HL20CD(DLG = DLG) {"Dyad": {"placement": {"diagram": {"x1": 1400, "x2": 2400, "y1": 2150, "y2": 3650}}}}
relations
  connect(alpha_deg, cl.alpha_deg, cd.alpha_deg) { "Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 200, "y": 200}], "E": 2}, {"S": -1, "M": [{"x": 1500, "y": 2040}], "E": 3}], "path": {}, "junctions": [{"x": 200, "y": 2040}]} }
  connect(mach, cl.mach, cd.mach) { "Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 300, "y": 350}], "E": 2}, {"S": -1, "M": [{"x": 1585, "y": 2000}], "E": 3}], "path": {}, "junctions": [{"x": 300, "y": 2000}]} }
  connect(hob, cl.hob, cd.hob) { "Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 400, "y": 500}], "E": 2}, {"S": -1, "M": [{"x": 1670, "y": 1960}], "E": 3}], "path": {}, "junctions": [{"x": 400, "y": 1960}]} }
  connect(DBFLL, cl.DBFLL, cd.DBFLL) { "Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 500, "y": 650}], "E": 2}, {"S": -1, "M": [{"x": 1755, "y": 1920}], "E": 3}], "path": {}, "junctions": [{"x": 500, "y": 1920}]} }
  connect(DBFLR, cl.DBFLR, cd.DBFLR) { "Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 600, "y": 800}], "E": 2}, {"S": -1, "M": [{"x": 1840, "y": 1880}], "E": 3}], "path": {}, "junctions": [{"x": 600, "y": 1880}]} }
  connect(DBFUL, cl.DBFUL, cd.DBFUL) { "Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 700, "y": 950}], "E": 2}, {"S": -1, "M": [{"x": 1925, "y": 1840}], "E": 3}], "path": {}, "junctions": [{"x": 700, "y": 1840}]} }
  connect(DBFUR, cl.DBFUR, cd.DBFUR) { "Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 800, "y": 1100}], "E": 2}, {"S": -1, "M": [{"x": 2010, "y": 1800}], "E": 3}], "path": {}, "junctions": [{"x": 800, "y": 1800}]} }
  connect(DWFL, cl.DWFL, cd.DWFL) { "Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 900, "y": 1250}], "E": 2}, {"S": -1, "M": [{"x": 2095, "y": 1760}], "E": 3}], "path": {}, "junctions": [{"x": 900, "y": 1760}]} }
  connect(DWFR, cl.DWFR, cd.DWFR) { "Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 1000, "y": 1400}], "E": 2}, {"S": -1, "M": [{"x": 2180, "y": 1720}], "E": 3}], "path": {}, "junctions": [{"x": 1000, "y": 1720}]} }
  connect(abs_drud, cl.abs_drud, cd.abs_drud) { "Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 1100, "y": 1550}], "E": 2}, {"S": -1, "M": [{"x": 2265, "y": 1680}], "E": 3}], "path": {}, "junctions": [{"x": 1100, "y": 1680}]} }
  connect(cl.y, cl_y) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(cd.y, cd_y) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
metadata {"Dyad": {"icons": {"default": "dyad://HL20Demo/aero_clcd.svg"}}}
end

"""
Side-force/yaw coefficient pair: the CY and Cn buildup blocks behind one icon
so the shared input fanout is only two pins deep.
"""
component AeroCYCN
  "Angle of attack (deg)"
  alpha_deg = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 20, "x2": 30, "y2": 80},
        "diagram": {"x1": -30, "x2": 30, "y1": 20, "y2": 80}
      }
    }
  }
  "Sideslip angle (deg)"
  beta_deg = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 120, "x2": 30, "y2": 180},
        "diagram": {"x1": -30, "x2": 30, "y1": 170, "y2": 230}
      }
    }
  }
  "Mach number"
  mach = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 220, "x2": 30, "y2": 280},
        "diagram": {"x1": -30, "x2": 30, "y1": 320, "y2": 380}
      }
    }
  }
  "Height over body span (ground effect)"
  hob = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 320, "x2": 30, "y2": 380},
        "diagram": {"x1": -30, "x2": 30, "y1": 470, "y2": 530}
      }
    }
  }
  "Left body flap deflection (deg)"
  DBFLL = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 420, "x2": 30, "y2": 480},
        "diagram": {"x1": -30, "x2": 30, "y1": 620, "y2": 680}
      }
    }
  }
  "Right body flap deflection (deg)"
  DBFLR = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 520, "x2": 30, "y2": 580},
        "diagram": {"x1": -30, "x2": 30, "y1": 770, "y2": 830}
      }
    }
  }
  "Upper left body flap deflection (deg)"
  DBFUL = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 620, "x2": 30, "y2": 680},
        "diagram": {"x1": -30, "x2": 30, "y1": 920, "y2": 980}
      }
    }
  }
  "Upper right body flap deflection (deg)"
  DBFUR = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 720, "x2": 30, "y2": 780},
        "diagram": {"x1": -30, "x2": 30, "y1": 1070, "y2": 1130}
      }
    }
  }
  "Left wing flap deflection (deg)"
  DWFL = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 820, "x2": 30, "y2": 880},
        "diagram": {"x1": -30, "x2": 30, "y1": 1220, "y2": 1280}
      }
    }
  }
  "Right wing flap deflection (deg)"
  DWFR = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 920, "x2": 30, "y2": 980},
        "diagram": {"x1": -30, "x2": 30, "y1": 1370, "y2": 1430}
      }
    }
  }
  "Rudder deflection magnitude (deg)"
  abs_drud = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 70, "y1": 970, "x2": 130, "y2": 1030},
        "diagram": {"x1": 1670, "x2": 1730, "y1": 2970, "y2": 3030}
      }
    }
  }
  "Body roll rate (rad/s)"
  pb = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 270, "y1": 970, "x2": 330, "y2": 1030},
        "diagram": {"x1": 1870, "x2": 1930, "y1": 2970, "y2": 3030}
      }
    }
  }
  "Body yaw rate (rad/s)"
  rb = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 470, "y1": 970, "x2": 530, "y2": 1030},
        "diagram": {"x1": 2070, "x2": 2130, "y1": 2970, "y2": 3030}
      }
    }
  }
  "Span damping factor b/(2 V)"
  damp_b2v = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 670, "y1": 970, "x2": 730, "y2": 1030},
        "diagram": {"x1": 2270, "x2": 2330, "y1": 2970, "y2": 3030}
      }
    }
  }
  "Side-force coefficient"
  cy_y = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 970, "y1": 370, "x2": 1030, "y2": 430},
        "diagram": {"x1": 3020, "x2": 3080, "y1": 570, "y2": 630}
      }
    }
  }
  "Yawing-moment coefficient"
  cn_y = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 970, "y1": 570, "x2": 1030, "y2": 630},
        "diagram": {"x1": 3020, "x2": 3080, "y1": 1970, "y2": 2030}
      }
    }
  }
  "Landing gear deflection (deg)"
  parameter DLG::Real = 0.0
  "Yaw damping (p) polynomial coefficients"
  parameter CNP0::Real = 0.40031
  parameter CNP1::Real = -0.015518
  parameter CNP2::Real = -0.00012143
  parameter CNP3::Real = 0.000018240
  "Yaw damping (r) polynomial coefficients"
  parameter CNR0::Real = -0.79533
  parameter CNR1::Real = -0.012647
  parameter CNR2::Real = 0.00032696
  parameter CNR3::Real = -0.0000065929
  cy = HL20CY(DLG = DLG) {
    "Dyad": {"placement": {"diagram": {"x1": 1600, "x2": 2600, "y1": 100, "y2": 1100}}}
  }
  cn = HL20CN(DLG = DLG, CNP0 = CNP0, CNP1 = CNP1, CNP2 = CNP2, CNP3 = CNP3, CNR0 = CNR0, CNR1 = CNR1, CNR2 = CNR2, CNR3 = CNR3) {
    "Dyad": {"placement": {"diagram": {"x1": 1600, "x2": 2600, "y1": 1500, "y2": 2500}}}
  }
relations
          connect(alpha_deg, cy.alpha_deg, cn.alpha_deg) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": 2, "M": [{"x": 200, "y": 150.0}], "E": -1}, {"S": 3, "M": [{"x": 1400, "y": 1550.0}, {"x": 1400, "y": 50.0}], "E": -1}], "path": {}, "junctions": [{"x": 200, "y": 50.0}]}}
          connect(beta_deg, cy.beta_deg, cn.beta_deg) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": 2, "M": [{"x": 250, "y": 250.0}], "E": -1}, {"S": 3, "M": [{"x": 1350, "y": 1650.0}, {"x": 1350, "y": 200.0}], "E": -1}], "path": {}, "junctions": [{"x": 250, "y": 200.0}]}}
          connect(mach, cy.mach, cn.mach) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": 2, "M": [{"x": 300, "y": 350.0}], "E": -1}, {"S": 3, "M": [{"x": 1300, "y": 1750.0}, {"x": 1300, "y": 350.0}], "E": -1}], "path": {}, "junctions": [{"x": 300, "y": 350.0}]}}
          connect(hob, cy.hob, cn.hob) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": 2, "M": [{"x": 350, "y": 450.0}], "E": -1}, {"S": 3, "M": [{"x": 1250, "y": 1850.0}, {"x": 1250, "y": 500.0}], "E": -1}], "path": {}, "junctions": [{"x": 350, "y": 500.0}]}}
          connect(DBFLL, cy.DBFLL, cn.DBFLL) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": 2, "M": [{"x": 400, "y": 550.0}], "E": -1}, {"S": 3, "M": [{"x": 1200, "y": 1950.0}, {"x": 1200, "y": 700}, {"x": 400, "y": 700}], "E": -1}], "path": {}, "junctions": [{"x": 400, "y": 650.0}]}}
          connect(DBFLR, cy.DBFLR, cn.DBFLR) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": 2, "M": [{"x": 450, "y": 650.0}], "E": -1}, {"S": 3, "M": [{"x": 1150, "y": 2050.0}, {"x": 1150, "y": 800.0}], "E": -1}], "path": {}, "junctions": [{"x": 450, "y": 800.0}]}}
