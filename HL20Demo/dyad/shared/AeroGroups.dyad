  }
  "Body pitch rate (rad/s)"
  qb = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 150, "y1": 950, "x2": 250, "y2": 1050},
        "diagram": {"x1": 1950, "x2": 2050, "y1": 3050, "y2": 3150}
      }
    }
  }
  "Chord damping factor cbar/(2 V)"
  damp_c2v = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 350, "y1": 950, "x2": 450, "y2": 1050},
        "diagram": {"x1": 2150, "x2": 2250, "y1": 3050, "y2": 3150}
      }
    }
  }
  "Body-axis force coefficient, x"
  CX = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 250, "x2": 1050, "y2": 350},
