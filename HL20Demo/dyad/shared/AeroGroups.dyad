  }
  connect(hob, cl.hob, cd.hob) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 300, "y": 350}], "E": -1}, {"S": 2, "M": [{"x": 300, "y": 350}], "E": -1}, {"S": 3, "M": [{"x": 1550, "y": 1750}, {"x": 1550, "y": 1325}, {"x": 2700, "y": 1325}, {"x": 2700, "y": 50}, {"x": 300, "y": 50}], "E": -1}],
      "junctions": [{"x": 300, "y": 450}],
      "path": {}
    }
  }
  connect(DBFLL, cl.DBFLL, cd.DBFLL) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [{"x": 350, "y": 500}], "E": -1},
        {"S": 2, "M": [{"x": 350, "y": 450}], "E": -1},
        {"S": 3, "M": [{"x": 1000, "y": 1850}, {"x": 1000, "y": 600}], "E": -1}
      ],
      "junctions": [{"x": 350, "y": 600}],
      "path": {}
    }
  }
  connect(DBFLR, cl.DBFLR, cd.DBFLR) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [{"x": 400, "y": 650}], "E": -1},
        {"S": 2, "M": [{"x": 400, "y": 550}], "E": -1},
        {
          "S": 3,
          "M": [{"x": 950, "y": 1950}, {"x": 950, "y": 700}, {"x": 400, "y": 700}],
          "E": -1
        }
      ],
      "junctions": [{"x": 400, "y": 750}],
      "path": {}
    }
  }
  connect(DBFUL, cl.DBFUL, cd.DBFUL) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [{"x": 450, "y": 800}], "E": -1},
        {"S": 2, "M": [{"x": 450, "y": 650}], "E": -1},
        {"S": 3, "M": [{"x": 900, "y": 2050}, {"x": 900, "y": 900}], "E": -1}
      ],
      "junctions": [{"x": 450, "y": 900}],
      "path": {}
    }
  }
  connect(DBFUR, cl.DBFUR, cd.DBFUR) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [{"x": 500, "y": 950}], "E": -1},
        {"S": 2, "M": [{"x": 500, "y": 750}], "E": -1},
        {
          "S": 3,
          "M": [{"x": 850, "y": 2150}, {"x": 850, "y": 1000}, {"x": 500, "y": 1000}],
          "E": -1
        }
      ],
      "junctions": [{"x": 500, "y": 1050}],
      "path": {}
    }
  }
  connect(DWFL, cl.DWFL, cd.DWFL) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [{"x": 550, "y": 1100}], "E": -1},
        {"S": 2, "M": [{"x": 550, "y": 850}], "E": -1},
        {"S": 3, "M": [{"x": 800, "y": 2250}, {"x": 800, "y": 1200}], "E": -1}
      ],
      "junctions": [{"x": 550, "y": 1200}],
      "path": {}
