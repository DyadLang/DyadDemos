  cd_sin = BlockComponents.Math.Product() {
    "Dyad": {
      "placement": {"diagram": {"x1": 2900, "x2": 3000, "y1": 770, "y2": 870, "rot": 0}}
    }
  }
  cx_sum = BlockComponents.Math.Add(k2 = -1.0) {
