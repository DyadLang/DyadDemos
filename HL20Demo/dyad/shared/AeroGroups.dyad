  cz_sum = BlockComponents.Math.Add(k1 = -1.0, k2 = -1.0) {
    "Dyad": {
      "placement": {"diagram": {"x1": 3300, "x2": 3400, "y1": 1320, "y2": 1420}}
    }
  }
relations
