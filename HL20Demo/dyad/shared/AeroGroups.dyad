"""
Lateral-directional coefficient buildup: the CY/Cn pair plus the Cl (roll)
subsystem, including sideslip (beta) and the roll/yaw damping terms driven by
pb, rb and the span damping factor b/(2V).
"""
component AeroLateralCoeffs
  "Angle of attack (deg)"
  alpha_deg = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 0, "x2": 50, "y2": 100},
        "diagram": {"x1": -50, "x2": 50, "y1": 0, "y2": 100}
      }
    }
  }
  "Sideslip angle (deg)"
  beta_deg = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 100, "x2": 50, "y2": 200},
        "diagram": {"x1": -50, "x2": 50, "y1": 150, "y2": 250}
      }
    }
  }
  "Mach number"
  mach = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 200, "x2": 50, "y2": 300},
        "diagram": {"x1": -50, "x2": 50, "y1": 300, "y2": 400}
      }
    }
  }
  "Height over body span (ground effect)"
  hob = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 300, "x2": 50, "y2": 400},
        "diagram": {"x1": -50, "x2": 50, "y1": 450, "y2": 550}
      }
    }
  }
  "Left body flap deflection (deg)"
  DBFLL = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 400, "x2": 50, "y2": 500},
        "diagram": {"x1": -50, "x2": 50, "y1": 600, "y2": 700}
      }
    }
  }
  "Right body flap deflection (deg)"
  DBFLR = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 500, "x2": 50, "y2": 600},
        "diagram": {"x1": -50, "x2": 50, "y1": 750, "y2": 850}
      }
    }
  }
  "Upper left body flap deflection (deg)"
  DBFUL = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 600, "x2": 50, "y2": 700},
        "diagram": {"x1": -50, "x2": 50, "y1": 900, "y2": 1000}
      }
    }
  }
  "Upper right body flap deflection (deg)"
  DBFUR = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 700, "x2": 50, "y2": 800},
        "diagram": {"x1": -50, "x2": 50, "y1": 1050, "y2": 1150}
      }
    }
  }
  "Left wing flap deflection (deg)"
  DWFL = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 800, "x2": 50, "y2": 900},
        "diagram": {"x1": -50, "x2": 50, "y1": 1200, "y2": 1300}
      }
    }
  }
  "Right wing flap deflection (deg)"
  DWFR = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 900, "x2": 50, "y2": 1000},
        "diagram": {"x1": -50, "x2": 50, "y1": 1350, "y2": 1450}
      }
    }
  }
  "Rudder deflection magnitude (deg)"
  abs_drud = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 50, "y1": 950, "x2": 150, "y2": 1050},
        "diagram": {"x1": 1600, "x2": 1700, "y1": 3000, "y2": 3100}
      }
    }
  }
  "Body roll rate (rad/s)"
  pb = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 250, "y1": 950, "x2": 350, "y2": 1050},
        "diagram": {"x1": 1800, "x2": 1900, "y1": 3000, "y2": 3100}
      }
    }
  }
  "Body yaw rate (rad/s)"
  rb = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 450, "y1": 950, "x2": 550, "y2": 1050},
        "diagram": {"x1": 2000, "x2": 2100, "y1": 3000, "y2": 3100}
      }
    }
  }
  "Span damping factor b/(2 V)"
  damp_b2v = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 650, "y1": 950, "x2": 750, "y2": 1050},
        "diagram": {"x1": 2200, "x2": 2300, "y1": 3000, "y2": 3100}
      }
    }
  }
  "Side-force coefficient"
  CY = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 350, "x2": 1050, "y2": 450},
        "diagram": {"x1": 3100, "x2": 3200, "y1": 350, "y2": 450}
      }
    }
  }
  "Rolling-moment coefficient"
  Cl = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 550},
        "diagram": {"x1": 3100, "x2": 3200, "y1": 2100, "y2": 2200}
      }
    }
  }
  "Yawing-moment coefficient"
  Cn = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 550, "x2": 1050, "y2": 650},
        "diagram": {"x1": 3100, "x2": 3200, "y1": 600, "y2": 700}
      }
    }
  }
  "Landing gear deflection (deg)"
  parameter DLG::Real = 0.0
  "Yaw damping (p) polynomial coefficients"
  parameter CNP0::Real = 0.40031
  parameter CNP1::Real = -0.015518
  parameter CNP2::Real = -0.00012143
  parameter CNP3::Real = 0.000018240
  "Yaw damping (r) polynomial coefficients"
  parameter CNR0::Real = -0.79533
  parameter CNR1::Real = -0.012647
  parameter CNR2::Real = 0.00032696
  parameter CNR3::Real = -0.0000065929
  "Roll damping (p) polynomial coefficients"
  parameter CLP0::Real = -0.55242
  parameter CLP1::Real = 0.014478
  parameter CLP2::Real = -0.0011545
  parameter CLP3::Real = 0.000017706
  "Roll damping (r) polynomial coefficients"
  parameter CLR0::Real = 0.44685
  parameter CLR1::Real = 0.067411
  parameter CLR2::Real = -0.0051866
  parameter CLR3::Real = 0.00012659
  pair = AeroCYCN(DLG = DLG, CNP0 = CNP0, CNP1 = CNP1, CNP2 = CNP2, CNP3 = CNP3, CNR0 = CNR0, CNR1 = CNR1, CNR2 = CNR2, CNR3 = CNR3) {
    "Dyad": {"placement": {"diagram": {"x1": 1600, "x2": 2700, "y1": 100, "y2": 1200}}}
  }
  cr = HL20CR(DLG = DLG, CLP0 = CLP0, CLP1 = CLP1, CLP2 = CLP2, CLP3 = CLP3, CLR0 = CLR0, CLR1 = CLR1, CLR2 = CLR2, CLR3 = CLR3) {
    "Dyad": {"placement": {"diagram": {"x1": 1600, "x2": 2600, "y1": 1600, "y2": 2600}}}
  }
