"""
Lateral-directional coefficient buildup: the CY/Cn pair plus the Cl (roll)
subsystem, including sideslip (beta) and the roll/yaw damping terms driven by
pb, rb and the span damping factor b/(2V).
"""
component AeroLateralCoeffs
  "Angle of attack (deg)"
  alpha_deg = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 20, "x2": 30, "y2": 80},
        "diagram": {"x1": -30, "x2": 30, "y1": 20, "y2": 80}
      }
    }
  }
  "Sideslip angle (deg)"
  beta_deg = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 120, "x2": 30, "y2": 180},
        "diagram": {"x1": -30, "x2": 30, "y1": 170, "y2": 230}
      }
    }
  }
  "Mach number"
  mach = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 220, "x2": 30, "y2": 280},
        "diagram": {"x1": -30, "x2": 30, "y1": 320, "y2": 380}
      }
    }
  }
  "Height over body span (ground effect)"
  hob = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 320, "x2": 30, "y2": 380},
        "diagram": {"x1": -30, "x2": 30, "y1": 470, "y2": 530}
      }
    }
  }
  "Left body flap deflection (deg)"
  DBFLL = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 420, "x2": 30, "y2": 480},
        "diagram": {"x1": -30, "x2": 30, "y1": 620, "y2": 680}
      }
    }
  }
  "Right body flap deflection (deg)"
  DBFLR = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 520, "x2": 30, "y2": 580},
        "diagram": {"x1": -30, "x2": 30, "y1": 770, "y2": 830}
      }
    }
  }
  "Upper left body flap deflection (deg)"
  DBFUL = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 620, "x2": 30, "y2": 680},
        "diagram": {"x1": -30, "x2": 30, "y1": 920, "y2": 980}
      }
    }
  }
  "Upper right body flap deflection (deg)"
  DBFUR = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 720, "x2": 30, "y2": 780},
        "diagram": {"x1": -30, "x2": 30, "y1": 1070, "y2": 1130}
      }
    }
  }
  "Left wing flap deflection (deg)"
  DWFL = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 820, "x2": 30, "y2": 880},
        "diagram": {"x1": -30, "x2": 30, "y1": 1220, "y2": 1280}
      }
    }
  }
  "Right wing flap deflection (deg)"
  DWFR = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 920, "x2": 30, "y2": 980},
        "diagram": {"x1": -30, "x2": 30, "y1": 1370, "y2": 1430}
      }
    }
  }
  "Rudder deflection magnitude (deg)"
  abs_drud = RealInput() {"Dyad": {"placement": {"icon": {"x1": 70, "y1": 970, "x2": 130, "y2": 1030}, "diagram": {"x1": 2590, "x2": 2650, "y1": 3020, "y2": 3080}}}}
  "Body roll rate (rad/s)"
  pb = RealInput() {"Dyad": {"placement": {"icon": {"x1": 270, "y1": 970, "x2": 330, "y2": 1030}, "diagram": {"x1": 2710, "x2": 2770, "y1": 3020, "y2": 3080}}}}
  "Body yaw rate (rad/s)"
  rb = RealInput() {"Dyad": {"placement": {"icon": {"x1": 470, "y1": 970, "x2": 530, "y2": 1030}, "diagram": {"x1": 2830, "x2": 2890, "y1": 3020, "y2": 3080}}}}
  "Span damping factor b/(2 V)"
  damp_b2v = RealInput() {"Dyad": {"placement": {"icon": {"x1": 670, "y1": 970, "x2": 730, "y2": 1030}, "diagram": {"x1": 2950, "x2": 3010, "y1": 3020, "y2": 3080}}}}
  "Side-force coefficient"
  CY = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 970, "y1": 370, "x2": 1030, "y2": 430},
        "diagram": {"x1": 3120, "x2": 3180, "y1": 370, "y2": 430}
      }
    }
  }
  "Rolling-moment coefficient"
  Cl = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 970, "y1": 470, "x2": 1030, "y2": 530},
        "diagram": {"x1": 3120, "x2": 3180, "y1": 2120, "y2": 2180}
      }
    }
  }
  "Yawing-moment coefficient"
  Cn = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 970, "y1": 570, "x2": 1030, "y2": 630},
        "diagram": {"x1": 3120, "x2": 3180, "y1": 620, "y2": 680}
      }
    }
  }
  "Landing gear deflection (deg)"
  parameter DLG::Real = 0.0
  "Yaw damping (p) polynomial coefficients"
  parameter CNP0::Real = 0.40031
  parameter CNP1::Real = -0.015518
  parameter CNP2::Real = -0.00012143
  parameter CNP3::Real = 0.000018240
  "Yaw damping (r) polynomial coefficients"
  parameter CNR0::Real = -0.79533
  parameter CNR1::Real = -0.012647
  parameter CNR2::Real = 0.00032696
  parameter CNR3::Real = -0.0000065929
  "Roll damping (p) polynomial coefficients"
  parameter CLP0::Real = -0.55242
  parameter CLP1::Real = 0.014478
  parameter CLP2::Real = -0.0011545
  parameter CLP3::Real = 0.000017706
  "Roll damping (r) polynomial coefficients"
  parameter CLR0::Real = 0.44685
  parameter CLR1::Real = 0.067411
  parameter CLR2::Real = -0.0051866
  parameter CLR3::Real = 0.00012659
  pair = AeroCYCN(DLG = DLG, CNP0 = CNP0, CNP1 = CNP1, CNP2 = CNP2, CNP3 = CNP3, CNR0 = CNR0, CNR1 = CNR1, CNR2 = CNR2, CNR3 = CNR3) {
    "Dyad": {"placement": {"diagram": {"x1": 1600, "x2": 2700, "y1": 100, "y2": 1200}}}
  }
  cr = HL20CR(DLG = DLG, CLP0 = CLP0, CLP1 = CLP1, CLP2 = CLP2, CLP3 = CLP3, CLR0 = CLR0, CLR1 = CLR1, CLR2 = CLR2, CLR3 = CLR3) {
    "Dyad": {"placement": {"diagram": {"x1": 1600, "x2": 2600, "y1": 1600, "y2": 2600}}}
  }
