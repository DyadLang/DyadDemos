  }
  atan_phi = BlockComponents.Math.Atan2() {
    "Dyad": {"placement": {"diagram": {"x1": 1050, "x2": 1150, "y1": 1800, "y2": 1900}}}
  }
  the_arg = BlockComponents.Math.Add(k1 = 2.0, k2 = -2.0) {
