        "diagram": {"x1": 3770, "x2": 3830, "y1": 870, "y2": 930}
      }
    }
  }
  rot = QuatToBody() {
    "Dyad": {"placement": {"diagram": {"x1": 900, "x2": 1100, "y1": 950, "y2": 1750}}}
  }
  aero = AeroAngles() {
