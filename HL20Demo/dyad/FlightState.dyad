    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 550, "x2": 1050, "y2": 600},
        "diagram": {"x1": 2150, "x2": 2250, "y1": 1975, "y2": 2025}
      }
    }
  }
  "cos of Euler roll angle"
  cos_phi = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 600, "x2": 1050, "y2": 650},
        "diagram": {"x1": 2150, "x2": 2250, "y1": 2225, "y2": 2275}
      }
    }
  }
  "cos of Euler pitch angle"
  cos_theta = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 650, "x2": 1050, "y2": 700},
        "diagram": {"x1": 2150, "x2": 2250, "y1": 2675, "y2": 2725}
      }
    }
  }
  "sin of angle of attack"
  sin_alpha = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 700, "x2": 1050, "y2": 750},
        "diagram": {"x1": 2150, "x2": 2250, "y1": 1325, "y2": 1375}
      }
    }
  }
  "cos of angle of attack"
  cos_alpha = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 750, "x2": 1050, "y2": 800},
        "diagram": {"x1": 2150, "x2": 2250, "y1": 1575, "y2": 1625}
      }
    }
  }
  rot = QuatToBody() {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 1000, "y2": 1100}}}
  }
  uu = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 800, "x2": 900, "y1": 250, "y2": 350}}}
  }
  vv = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 800, "x2": 900, "y1": 500, "y2": 600}}}
  }
  ww = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 800, "x2": 900, "y1": 750, "y2": 850}}}
  }
  sum_uvw = BlockComponents.Math.Add3() {
    "Dyad": {"placement": {"diagram": {"x1": 1050, "x2": 1150, "y1": 350, "y2": 450}}}
  }
  v_eps = BlockComponents.Sources.Constant(k = 1e-6) {
    "Dyad": {"placement": {"diagram": {"x1": 300, "x2": 400, "y1": 200, "y2": 300}}}
  }
  sum_v = BlockComponents.Math.Add() {
    "Dyad": {"placement": {"diagram": {"x1": 1300, "x2": 1400, "y1": 200, "y2": 300}}}
  }
  v_sqrt = BlockComponents.Math.Sqrt() {
    "Dyad": {"placement": {"diagram": {"x1": 1550, "x2": 1650, "y1": 200, "y2": 300}}}
  }
  sum_uw = BlockComponents.Math.Add() {
    "Dyad": {"placement": {"diagram": {"x1": 1050, "x2": 1150, "y1": 600, "y2": 700}}}
  }
  sqrt_uw = BlockComponents.Math.Sqrt() {
    "Dyad": {"placement": {"diagram": {"x1": 1300, "x2": 1400, "y1": 700, "y2": 800}}}
  }
  atan_alpha = BlockComponents.Math.Atan2() {
    "Dyad": {"placement": {"diagram": {"x1": 800, "x2": 900, "y1": 1200, "y2": 1300}}}
  }
  atan_beta = BlockComponents.Math.Atan2() {
    "Dyad": {"placement": {"diagram": {"x1": 1550, "x2": 1650, "y1": 750, "y2": 850}}}
  }
  alpha_to_deg = BlockComponents.Math.Gain(k = 57.29577951308232) {
    "Dyad": {"placement": {"diagram": {"x1": 1050, "x2": 1150, "y1": 1050, "y2": 1150}}}
  }
  beta_to_deg = BlockComponents.Math.Gain(k = 57.29577951308232) {
    "Dyad": {"placement": {"diagram": {"x1": 1800, "x2": 1900, "y1": 750, "y2": 850}}}
  }
