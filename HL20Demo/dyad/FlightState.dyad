      "placement": {
        "icon": {"x1": 950, "y1": 400, "x2": 1050, "y2": 450},
        "diagram": {"x1": 2150, "x2": 2250, "y1": 2425, "y2": 2475}
      }
    }
  }
  "Euler yaw angle (deg)"
  psi_deg = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 450, "x2": 1050, "y2": 500},
        "diagram": {"x1": 2150, "x2": 2250, "y1": 2725, "y2": 2775}
