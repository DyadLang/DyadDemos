    }
  }
  "Quaternion y part"
  qy = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 620, "x2": 30, "y2": 680},
        "diagram": {"x1": -30, "x2": 30, "y1": 1170, "y2": 1230}
      }
    }
  }
  "Quaternion z part"
  qz = RealInput() {
