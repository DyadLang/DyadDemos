"""
Flight-state computation: rotates the inertial NED velocity into the body
frame with the inverse quaternion rotation, then derives airspeed, the aero
angles alpha and beta (deg) and the Euler angles phi, theta, psi (deg). Also
exposes the sine/cosine signals the control laws consume. Every operation is a
wired BlockComponents block.
"""
component FlightState
  "Inertial NED velocity, axis 1 (m/s)"
  vel_1 = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 20, "x2": 30, "y2": 80},
        "diagram": {"x1": -30, "x2": 30, "y1": 1470, "y2": 1530}
      }
    }
  }
  "Inertial NED velocity, axis 2 (m/s)"
  vel_2 = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 120, "x2": 30, "y2": 180},
