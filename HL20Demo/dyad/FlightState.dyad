        "diagram": {"x1": -30, "x2": 30, "y1": 1320, "y2": 1380}
      }
    }
  }
  "Body velocity, forward (m/s)"
  u_body = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 970, "y1": 5, "x2": 1030, "y2": 45},
        "diagram": {"x1": 3770, "x2": 3830, "y1": 1020, "y2": 1080}
      }
    }
  }
  "Body velocity, right (m/s)"
  v_body = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 970, "y1": 55, "x2": 1030, "y2": 95},
        "diagram": {"x1": 3770, "x2": 3830, "y1": 1170, "y2": 1230}
      }
    }
  }
  "Body velocity, down (m/s)"
