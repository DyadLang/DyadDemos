  the_clamp = BlockComponents.Nonlinear.Limiter(y_min = -1.0, y_max = 1.0) {
    "Dyad": {"placement": {"diagram": {"x1": 1050, "x2": 1150, "y1": 2350, "y2": 2450}}}
