"Converts body-axis aero coefficients to dimensional body forces/moments (with CG offset),
then rotates forces to inertial NED. Torques remain in body frame. (TM-4302 eqs 7-12)."
component AeroForceBuilder
  # Body-axis nondimensional coefficients
  CX = RealInput()
  CY = RealInput()
  CZ = RealInput()
  Cl = RealInput()
  Cm = RealInput()
  Cn = RealInput()
  # Dynamic pressure (psf)
  qbar_psf = RealInput()
  # body->inertial quaternion (scalar-first)
  qw = RealInput()
  qx = RealInput()
  qy = RealInput()
  qz = RealInput()

  # Outputs: forces inertial NED (N), torques body (N*m), and body-Z force (N)
  F1 = RealOutput()
  F2 = RealOutput()
  F3 = RealOutput()
  T1 = RealOutput()
  T2 = RealOutput()
  T3 = RealOutput()
  Fz_body = RealOutput()

  parameter S_ref::Real = 286.45
  parameter CBAR_ft::Real = 28.24
  parameter BSPAN_ft::Real = 13.89
  parameter Xcg::Real = 0.555
  parameter XRP::Real = 0.54

  final parameter ft_per_m::Real = 3.280839895013123
  final parameter qbar_conv::Real = 47.880259

  variable S_m2::Real
  variable CBAR_m::Real
  variable BSPAN_m::Real
  variable qbar_Pa::Real
  variable dxcg::Real
  variable Fx_b::Real
  variable Fy_b::Real
  variable Fz_b::Real
  variable Mx_b::Real
  variable My_b::Real
  variable Mz_b::Real
relations
  # Unit conversions
  S_m2 = S_ref / ft_per_m^2
  CBAR_m = CBAR_ft / ft_per_m
  BSPAN_m = BSPAN_ft / ft_per_m
  qbar_Pa = qbar_psf * qbar_conv
  dxcg = Xcg - XRP

  # Body-frame forces (N)
  Fx_b = qbar_Pa * S_m2 * CX
  Fy_b = qbar_Pa * S_m2 * CY
  Fz_b = qbar_Pa * S_m2 * CZ

  # Body-frame moments (N*m) with CG offset correction along body x-axis
  Mx_b = qbar_Pa * S_m2 * BSPAN_m * Cl
  My_b = qbar_Pa * S_m2 * CBAR_m * Cm + dxcg * CBAR_m * Fz_b
  Mz_b = qbar_Pa * S_m2 * BSPAN_m * Cn - dxcg * CBAR_m * Fy_b

  # Rotate body forces to inertial NED via R (body->inertial) from q=[qw,qx,qy,qz]
  F1 = (1 - 2*(qy^2 + qz^2))*Fx_b + 2*(qx*qy - qw*qz)*Fy_b + 2*(qx*qz + qw*qy)*Fz_b
  F2 = 2*(qx*qy + qw*qz)*Fx_b + (1 - 2*(qx^2 + qz^2))*Fy_b + 2*(qy*qz - qw*qx)*Fz_b
  F3 = 2*(qx*qz - qw*qy)*Fx_b + 2*(qy*qz + qw*qx)*Fy_b + (1 - 2*(qx^2 + qy^2))*Fz_b

  # Torques remain in body frame
  T1 = Mx_b
  T2 = My_b
  T3 = Mz_b

  Fz_body = Fz_b
end
