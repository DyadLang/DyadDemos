"""
Dimensionalises the HL-20 body-axis aero coefficients into forces and
moments (TM-4302 eqs 7-12), applies the CG-offset correction to the moments,
and rotates the force vector into the inertial NED frame. Every operation is
a wired BlockComponents block.
"""
component AeroForceBuilder
  "Body-axis force coefficient, x"
  CX = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 0, "x2": 50, "y2": 100},
        "diagram": {"x1": -50, "x2": 50, "y1": 100, "y2": 200}
      }
    }
  }
  "Body-axis force coefficient, y"
  CY = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 100, "x2": 50, "y2": 200},
        "diagram": {"x1": -50, "x2": 50, "y1": 1000, "y2": 1100}
      }
    }
  }
  "Body-axis force coefficient, z"
  CZ = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 200, "x2": 50, "y2": 300},
        "diagram": {"x1": -50, "x2": 50, "y1": 1150, "y2": 1250}
      }
    }
  }
  "Rolling-moment coefficient"
  Cl = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 300, "x2": 50, "y2": 400},
        "diagram": {"x1": -50, "x2": 50, "y1": 1300, "y2": 1400}
      }
    }
  }
  "Pitching-moment coefficient"
  Cm = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 400, "x2": 50, "y2": 500},
        "diagram": {"x1": -50, "x2": 50, "y1": 1450, "y2": 1550}
      }
    }
  }
  "Yawing-moment coefficient"
  Cn = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 500, "x2": 50, "y2": 600},
        "diagram": {"x1": -50, "x2": 50, "y1": 1600, "y2": 1700}
      }
    }
  }
  "Dynamic pressure (psf)"
  qbar_psf = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 700, "x2": 50, "y2": 800},
        "diagram": {"x1": -50, "x2": 50, "y1": 250, "y2": 350}
      }
    }
  }
  "Quaternion scalar part"
  qw = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 200, "y1": 950, "x2": 300, "y2": 1050},
        "diagram": {"x1": -50, "x2": 50, "y1": 400, "y2": 500}
      }
    }
  }
  "Quaternion x part"
  qx = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 300, "y1": 950, "x2": 400, "y2": 1050},
        "diagram": {"x1": -50, "x2": 50, "y1": 550, "y2": 650}
      }
    }
  }
  "Quaternion y part"
  qy = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 400, "y1": 950, "x2": 500, "y2": 1050},
        "diagram": {"x1": -50, "x2": 50, "y1": 700, "y2": 800}
      }
    }
  }
  "Quaternion z part"
  qz = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 500, "y1": 950, "x2": 600, "y2": 1050},
        "diagram": {"x1": -50, "x2": 50, "y1": 850, "y2": 950}
      }
    }
  }
  "Aero force, inertial NED axis 1 (N)"
  F1 = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 0, "x2": 1050, "y2": 100},
        "diagram": {"x1": 1400, "x2": 1500, "y1": 150, "y2": 250}
      }
    }
  }
  "Aero force, inertial NED axis 2 (N)"
  F2 = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 100, "x2": 1050, "y2": 200},
        "diagram": {"x1": 1400, "x2": 1500, "y1": 300, "y2": 400}
      }
    }
  }
  "Aero force, inertial NED axis 3 (N)"
  F3 = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 200, "x2": 1050, "y2": 300},
        "diagram": {"x1": 1400, "x2": 1500, "y1": 450, "y2": 550}
      }
    }
  }
  "Aero moment, body axis 1 (N.m)"
  T1 = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 400, "x2": 1050, "y2": 500},
        "diagram": {"x1": 1400, "x2": 1500, "y1": 750, "y2": 850}
      }
    }
  }
  "Aero moment, body axis 2 (N.m)"
  T2 = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 500, "x2": 1050, "y2": 600},
        "diagram": {"x1": 1400, "x2": 1500, "y1": 900, "y2": 1000}
      }
    }
  }
  "Aero moment, body axis 3 (N.m)"
  T3 = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 600, "x2": 1050, "y2": 700},
        "diagram": {"x1": 1400, "x2": 1500, "y1": 1050, "y2": 1150}
      }
    }
  }
  "Aero force, body axis 3 (N), for NZ computation"
  Fz_body = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 800, "x2": 1050, "y2": 900},
        "diagram": {"x1": 1400, "x2": 1500, "y1": 600, "y2": 700}
      }
    }
  }
  "Reference area (ft^2)"
  parameter S_ref::Real = 286.45
  "Reference chord (ft)"
  parameter CBAR::Real = 28.24
  "Reference span (ft)"
  parameter BSPAN::Real = 13.89
  "CG location, fraction of body length"
  parameter Xcg::Real = 0.555
  "Moment reference point, fraction of body length"
  parameter XRP::Real = 0.54
  "Feet per metre"
  parameter ft_per_m::Real = 3.28084
  "psf to Pa conversion"
  parameter psf_to_pa::Real = 47.880259
  qbar_pa = BlockComponents.Math.Gain(k = psf_to_pa) {
    "Dyad": {"placement": {"diagram": {"x1": 300, "x2": 400, "y1": 275, "y2": 375}}}
  }
  qS = BlockComponents.Math.Gain(k = S_ref / (ft_per_m ^ 2)) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 275, "y2": 375}}}
  }
  qSb = BlockComponents.Math.Gain(k = BSPAN / ft_per_m) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 625, "y2": 725}}}
  }
  qSc = BlockComponents.Math.Gain(k = CBAR / ft_per_m) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 825, "y2": 925}}}
  }
  fxb = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 750, "x2": 850, "y1": 225, "y2": 325}}}
  }
  fyb = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 750, "x2": 850, "y1": 375, "y2": 475}}}
  }
  fzb = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 750, "x2": 850, "y1": 525, "y2": 625}}}
  }
  mxb = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 800, "x2": 900, "y1": 675, "y2": 775}}}
  }
  myb1 = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 800, "x2": 900, "y1": 825, "y2": 925}}}
  }
  mzb1 = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 800, "x2": 900, "y1": 975, "y2": 1075}}}
  }
  dxcg_c = BlockComponents.Sources.Constant(k = (Xcg - XRP) * CBAR / ft_per_m) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 975, "y2": 1075}}}
  }
  cg_y = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 1000, "x2": 1100, "y1": 675, "y2": 775}}}
  }
  cg_z = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 1000, "x2": 1100, "y1": 825, "y2": 925}}}
  }
  myb = BlockComponents.Math.Add() {
    "Dyad": {"placement": {"diagram": {"x1": 1150, "x2": 1250, "y1": 725, "y2": 825}}}
  }
  mzb = BlockComponents.Math.Add(k2 = -1.0) {
    "Dyad": {"placement": {"diagram": {"x1": 1150, "x2": 1250, "y1": 875, "y2": 975}}}
  }
  rot = QuatToInertial() {
    "Dyad": {"placement": {"diagram": {"x1": 950, "x2": 1050, "y1": 375, "y2": 475}}}
  }
relations
