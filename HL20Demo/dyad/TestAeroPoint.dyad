      "placement": {"diagram": {"x1": 400, "x2": 500, "y1": 2750, "y2": 2850, "rot": 270}}
    }
  }
  c_dwfl = BlockComponents.Sources.Constant(k = dwfl_k) {
    "Dyad": {
      "placement": {"diagram": {"x1": 400, "x2": 500, "y1": 3000, "y2": 3100, "rot": 270}}
    }
  }
  c_dwfr = BlockComponents.Sources.Constant(k = dwfr_k) {
    "Dyad": {
      "placement": {"diagram": {"x1": 400, "x2": 500, "y1": 3250, "y2": 3350, "rot": 270}}
