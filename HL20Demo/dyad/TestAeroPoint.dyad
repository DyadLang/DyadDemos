      "edges": [{"S": 1, "M": [], "E": 2}],
      "path": {}
    }
  }
  connect(c_rb.y, aero.rb) {
    "Dyad": {
      "edges": [{"S": 1, "M": [], "E": 2}],
      "path": {}
    }
  }
  connect(c_dbful.y, aero.DBFUL) {
