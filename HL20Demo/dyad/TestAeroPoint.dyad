"""
Drives the graphical HL20Aero with constant inputs so its outputs can be
checked point-by-point against the reference coefficient equations.
"""
test component TestAeroPoint
  aero = HL20Demo.shared.HL20Aero() {
    "Dyad": {
      "placement": {"diagram": {"x1": 625, "x2": 1375, "y1": 1000, "y2": 2500}}
    }
  }
  c_alpha = BlockComponents.Sources.Constant(k = alpha_k) {
    "Dyad": {
      "placement": {"diagram": {"x1": 400, "x2": 500, "y1": 1025, "y2": 1125}}
    }
  }
  c_beta = BlockComponents.Sources.Constant(k = beta_k) {
    "Dyad": {
      "placement": {"diagram": {"x1": 200, "x2": 300, "y1": 1175, "y2": 1275}}
    }
  }
  c_mach = BlockComponents.Sources.Constant(k = mach_k) {
    "Dyad": {
      "placement": {"diagram": {"x1": 400, "x2": 500, "y1": 1325, "y2": 1425}}
    }
  }
  c_vrw = BlockComponents.Sources.Constant(k = vrw_k) {
    "Dyad": {
      "placement": {"diagram": {"x1": 200, "x2": 300, "y1": 1475, "y2": 1575}}
    }
  }
  c_hob = BlockComponents.Sources.Constant(k = hob_k) {
    "Dyad": {
      "placement": {"diagram": {"x1": 400, "x2": 500, "y1": 1625, "y2": 1725}}
    }
  }
  c_pb = BlockComponents.Sources.Constant(k = pb_k) {
    "Dyad": {
      "placement": {"diagram": {"x1": 200, "x2": 300, "y1": 1775, "y2": 1875}}
    }
  }
  c_qb = BlockComponents.Sources.Constant(k = qb_k) {
    "Dyad": {"placement": {"diagram": {"x1": 400, "x2": 500, "y1": 1925, "y2": 2025}}}
  }
  c_rb = BlockComponents.Sources.Constant(k = rb_k) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 2075, "y2": 2175}}}
  }
  c_dbful = BlockComponents.Sources.Constant(k = dbful_k) {
    "Dyad": {"placement": {"diagram": {"x1": 400, "x2": 500, "y1": 2600, "y2": 2700}}}
  }
  c_dbfur = BlockComponents.Sources.Constant(k = dbfur_k) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "x2": 300, "y1": 2750, "y2": 2850}}}
  }
  c_dbfll = BlockComponents.Sources.Constant(k = dbfll_k) {
    "Dyad": {
      "placement": {"diagram": {"x1": 400, "x2": 500, "y1": 2900, "y2": 3000}}
    }
  }
  c_dbflr = BlockComponents.Sources.Constant(k = dbflr_k) {
    "Dyad": {
      "placement": {"diagram": {"x1": 200, "x2": 300, "y1": 3050, "y2": 3150}}
    }
  }
  c_dwfl = BlockComponents.Sources.Constant(k = dwfl_k) {
    "Dyad": {
      "placement": {"diagram": {"x1": 400, "x2": 500, "y1": 3200, "y2": 3300}}
    }
  }
  c_dwfr = BlockComponents.Sources.Constant(k = dwfr_k) {
    "Dyad": {
      "placement": {"diagram": {"x1": 200, "x2": 300, "y1": 3350, "y2": 3450}}
    }
  }
  c_drud = BlockComponents.Sources.Constant(k = drud_k) {
    "Dyad": {
      "placement": {"diagram": {"x1": 400, "x2": 500, "y1": 3500, "y2": 3600}}
    }
  }
  parameter alpha_k::Real = 10.0
  parameter beta_k::Real = 0.0
  parameter mach_k::Real = 0.2
  parameter vrw_k::Real = 223.3
  parameter hob_k::Real = 100.0
  parameter pb_k::Real = 0.0
  parameter qb_k::Real = 0.0
  parameter rb_k::Real = 0.0
  parameter dbful_k::Real = 0.0
  parameter dbfur_k::Real = 0.0
  parameter dbfll_k::Real = 0.0
  parameter dbflr_k::Real = 0.0
  parameter dwfl_k::Real = 0.0
  parameter dwfr_k::Real = 0.0
  parameter drud_k::Real = 0.0
relations
  connect(c_alpha.y, aero.alpha_deg) {
    "Dyad": {
      "edges": [{"S": 1, "M": [], "E": 2}],
      "path": {}
    }
  }
  connect(c_beta.y, aero.beta_deg) {
    "Dyad": {
      "edges": [{"S": 1, "M": [], "E": 2}],
      "path": {}
