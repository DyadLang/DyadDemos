      "edges": [{"S": 1, "M": [{"x": 662.5, "y": 2650}], "E": 2}],
      "path": {}
    }
  }
  connect(c_dbfur.y, aero.DBFUR) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 737.5, "y": 2800}], "E": 2}],
      "path": {}
    }
  }
  connect(c_dbfll.y, aero.DBFLL) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 812.5, "y": 2950}], "E": 2}],
      "path": {}
    }
  }
  connect(c_dbflr.y, aero.DBFLR) {
    "Dyad": {
