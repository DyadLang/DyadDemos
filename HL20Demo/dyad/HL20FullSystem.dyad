"""
HL20 full-system demo: four SAS controllers driving the HL20Mixer surface
mixer, which drives the HL20Vehicle flight-dynamics model. Vehicle feedback
signals return to the controllers; primary channels also tee to diagram
outputs.
"""
component HL20FullSystem
  DCPILOT = RealInput() {
    "Dyad": {
      "placement": {"icon": {"x1": -30, "y1": 120, "x2": 30, "y2": 180}, "diagram": {"x1": -30, "x2": 30, "y1": 2270, "y2": 2330}}
    }
  }
  DWPILOT = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 320, "x2": 30, "y2": 380},
        "diagram": {"x1": -30, "x2": 30, "y1": 1670, "y2": 1730}
      }
    }
  }
  DPPILOT = RealInput() {
    "Dyad": {
      "placement": {"icon": {"x1": -30, "y1": 520, "x2": 30, "y2": 580}, "diagram": {"x1": -30, "x2": 30, "y1": 2170, "y2": 2230}}
    }
  }
  DLSBCOM = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 720, "x2": 30, "y2": 780},
        "diagram": {"x1": -30, "x2": 30, "y1": 2070, "y2": 2130}
      }
    }
  }
  DECMD = RealOutput() {
    "Dyad": {
      "placement": {"icon": {"x1": 970, "y1": 20, "x2": 1030, "y2": 80}, "diagram": {"x1": 2970, "x2": 3030, "y1": 1220, "y2": 1280}}
    }
  }
  ALPHA_DEG = RealOutput() {
    "Dyad": {
      "placement": {"icon": {"x1": 970, "y1": 420, "x2": 1030, "y2": 480}, "diagram": {"x1": 2970, "x2": 3030, "y1": 1820, "y2": 1880}}
    }
  }
  QDEG = RealOutput() {
    "Dyad": {
      "placement": {"icon": {"x1": 970, "y1": 520, "x2": 1030, "y2": 580}, "diagram": {"x1": 2970, "x2": 3030, "y1": 120, "y2": 180}}
    }
  }
  NZ = RealOutput() {
    "Dyad": {
      "placement": {"icon": {"x1": 970, "y1": 720, "x2": 1030, "y2": 780}, "diagram": {"x1": 2970, "x2": 3030, "y1": 920, "y2": 980}}
    }
  }
  ALT_FT = RealOutput() {
    "Dyad": {
      "placement": {"icon": {"x1": 970, "y1": 820, "x2": 1030, "y2": 880}, "diagram": {"x1": 2970, "x2": 3030, "y1": 1620, "y2": 1680}}
    }
  }
  DACMD = RealOutput() {
    "Dyad": {
      "placement": {"icon": {"x1": 970, "y1": 120, "x2": 1030, "y2": 180}, "diagram": {"x1": 2970, "x2": 3030, "y1": 320, "y2": 380}}
    }
  }
  DRCMD = RealOutput() {
    "Dyad": {
      "placement": {"icon": {"x1": 970, "y1": 220, "x2": 1030, "y2": 280}, "diagram": {"x1": 2970, "x2": 3030, "y1": 520, "y2": 580}}
    }
  }
  DLE = RealOutput() {
    "Dyad": {
      "placement": {"icon": {"x1": 970, "y1": 620, "x2": 1030, "y2": 680}, "diagram": {"x1": 2970, "x2": 3030, "y1": 1420, "y2": 1480}}
    }
  }
  DSBCMD = RealOutput() {
    "Dyad": {
      "placement": {"icon": {"x1": 970, "y1": 320, "x2": 1030, "y2": 380}, "diagram": {"x1": 2970, "x2": 3030, "y1": 720, "y2": 780}}
    }
  }
  pitch = PitchControl(DETRIM0 = DETRIM0) {
    "Dyad": {"placement": {"diagram": {"x1": 700, "y1": 200, "x2": 1150, "y2": 300}}}
  }
  roll = RollControl() {
    "Dyad": {"placement": {"diagram": {"x1": 350, "y1": 500, "x2": 500, "y2": 600}}}
  }
  yaw = YawControl() {
    "Dyad": {"placement": {"diagram": {"x1": 460, "y1": 700, "x2": 610, "y2": 800}}}
  }
  speed = SpeedControl() {
    "Dyad": {"placement": {"diagram": {"x1": 250, "y1": 900, "x2": 350, "y2": 1000}}}
  }
  mixer = HL20Mixer() {
    "Dyad": {"placement": {"diagram": {"x1": 1300, "y1": 500, "x2": 1500, "y2": 700}}}
  }
  vehicle = HL20Vehicle() {
    "Dyad": {"placement": {"diagram": {"x1": 1900, "y1": 450, "x2": 2000, "y2": 750}}}
  }
  parameter DETRIM0::Real = 5.5
relations
  connect(DCPILOT, pitch.DCPILOT) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 696, "y": 2300}, {"x": 696, "y": 205}], "E": 2}], "path": {}} }
  connect(DWPILOT, roll.DWPILOT) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 200, "y": 1700}, {"x": 200, "y": 520}], "E": 2}], "path": {}} }
  connect(DPPILOT, yaw.DPPILOT) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 455, "y": 2200}, {"x": 455, "y": 715}], "E": 2}], "path": {}} }
  connect(DLSBCOM, speed.DLSBCOM) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 230, "y": 2100}, {"x": 230, "y": 950}], "E": 2}], "path": {}} }
  connect(pitch.DECMD, mixer.DECMD, DECMD) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1165, "y": 250}, {"x": 1165, "y": 180}], "E": -1}, {"S": -1, "M": [], "E": -2}, {"S": -2, "M": [{"x": 2930, "y": 180}, {"x": 2930, "y": 1250}], "E": 3}, {"S": -2, "M": [{"x": 1290, "y": 530}], "E": 2}], "path": {}, "junctions": [{"x": 1165, "y": 180}, {"x": 1290, "y": 180}]} }
  connect(roll.DACMD, yaw.DACMD, mixer.DACMD, DACMD) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 520, "y": 550}, {"x": 520, "y": 105}], "E": -1}, {"S": -1, "M": [], "E": -2}, {"S": -2, "M": [], "E": -3}, {"S": -3, "M": [{"x": 2970, "y": 105}, {"x": 2970, "y": 350}], "E": 4}, {"S": 2, "M": [{"x": 340, "y": 755}, {"x": 340, "y": 105}], "E": -2}, {"S": -3, "M": [{"x": 1270, "y": 570}], "E": 3}], "path": {}, "junctions": [{"x": 520, "y": 105}, {"x": 340, "y": 105}, {"x": 1270, "y": 105}]} }
  connect(yaw.DRCMD, mixer.DRCMD, DRCMD) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 630, "y": 750}, {"x": 630, "y": 120}], "E": -1}, {"S": -1, "M": [], "E": -2}, {"S": -2, "M": [{"x": 2960, "y": 120}, {"x": 2960, "y": 550}], "E": 3}, {"S": -2, "M": [{"x": 1250, "y": 610}], "E": 2}], "path": {}, "junctions": [{"x": 630, "y": 120}, {"x": 1250, "y": 120}]} }
  connect(speed.DSBCMD, mixer.DSBCMD, DSBCMD) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 650, "y": 950}, {"x": 650, "y": 135}], "E": -1}, {"S": -1, "M": [], "E": -2}, {"S": -2, "M": [{"x": 2950, "y": 135}, {"x": 2950, "y": 750}], "E": 3}, {"S": -2, "M": [{"x": 1230, "y": 650}], "E": 2}], "path": {}, "junctions": [{"x": 650, "y": 135}, {"x": 1230, "y": 135}]} }
  connect(mixer.DUL, vehicle.DBFUL) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1810, "y": 561.42}, {"x": 1810, "y": 555}], "E": 2}], "path": {}} }
  connect(mixer.DUR, vehicle.DBFUR) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1820, "y": 587.14}, {"x": 1820, "y": 585}], "E": 2}], "path": {}} }
  connect(mixer.DLL, vehicle.DBFLL) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1830, "y": 612.86}, {"x": 1830, "y": 615}], "E": 2}], "path": {}} }
  connect(mixer.DLR, vehicle.DBFLR) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1840, "y": 638.58}, {"x": 1840, "y": 645}], "E": 2}], "path": {}} }
  connect(mixer.DRE, vehicle.DWFR) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1860, "y": 535.72}, {"x": 1860, "y": 525}], "E": 2}], "path": {}} }
  connect(mixer.DR, vehicle.DRUD) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1870, "y": 664.28}, {"x": 1870, "y": 675}], "E": 2}], "path": {}} }
  connect(mixer.DLE, vehicle.DWFL, DLE) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1850, "y": 510}], "E": -1}, {"S": -1, "M": [{"x": 1850, "y": 495}], "E": 2}, {"S": -1, "M": [{"x": 1850, "y": 430}, {"x": 2920, "y": 430}, {"x": 2920, "y": 1450}], "E": 3}], "path": {}, "junctions": [{"x": 1850, "y": 510}]} }
  connect(mixer.DLEDEG, pitch.DLEDEG) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1530, "y": 690}, {"x": 1530, "y": 150}, {"x": 695, "y": 150}, {"x": 695, "y": 275}], "E": 2}], "path": {}} }
  connect(vehicle.V_FPS, pitch.VTOTALI) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 2020, "y": 667.5}, {"x": 2020, "y": 1250}, {"x": 1127.5, "y": 1250}], "E": 2}], "path": {}} }
  connect(vehicle.NZ, pitch.NZ, NZ) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 2030, "y": 652.5}, {"x": 2030, "y": 1280}, {"x": 1190, "y": 1280}], "E": -2}, {"S": -2, "M": [], "E": -1}, {"S": -1, "M": [], "E": 2}, {"S": -2, "M": [{"x": 1190, "y": 165}, {"x": 2940, "y": 165}, {"x": 2940, "y": 950}], "E": 3}], "path": {}, "junctions": [{"x": 1076.875, "y": 1280}, {"x": 1190, "y": 1280}]} }
  connect(vehicle.QBAR, pitch.QBAR) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 2040, "y": 622.5}, {"x": 2040, "y": 1310}, {"x": 1026.25, "y": 1310}], "E": 2}], "path": {}} }
  connect(vehicle.COSTHE, pitch.COSTHE) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 2050, "y": 607.5}, {"x": 2050, "y": 1340}, {"x": 975.625, "y": 1340}], "E": 2}], "path": {}} }
  connect(vehicle.COSPHI, pitch.COSPHI) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 2060, "y": 592.5}, {"x": 2060, "y": 1370}, {"x": 925, "y": 1370}], "E": 2}], "path": {}} }
