  connect(vehicle.QDEG, pitch.QDEG, QDEG) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 2080, "y": 562.5}, {"x": 2080, "y": 1430}, {"x": 773.125, "y": 1430}], "E": -2}, {"S": -2, "M": [], "E": -1}, {"S": -2, "M": [], "E": 2}, {"S": -1, "M": [{"x": 685, "y": 90}, {"x": 2980, "y": 90}, {"x": 2980, "y": 150}], "E": 3}], "path": {}, "junctions": [{"x": 685, "y": 1430}, {"x": 773.125, "y": 1430}]} }
  connect(vehicle.RDEG, pitch.RDEG, yaw.RDEG) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 2090, "y": 547.5}, {"x": 2090, "y": 1460}, {"x": 823.75, "y": 1460}], "E": -2}, {"S": -2, "M": [], "E": -1}, {"S": -2, "M": [], "E": 2}, {"S": -1, "M": [], "E": 3}], "path": {}, "junctions": [{"x": 569.5, "y": 1460}, {"x": 823.75, "y": 1460}]} }
  connect(vehicle.MACH_out, pitch.MACH, yaw.MACH) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 2100, "y": 532.5}, {"x": 2100, "y": 1490}, {"x": 722.5, "y": 1490}], "E": -2}, {"S": -2, "M": [], "E": -1}, {"S": -2, "M": [], "E": 2}, {"S": -1, "M": [], "E": 3}], "path": {}, "junctions": [{"x": 490, "y": 1490}, {"x": 722.5, "y": 1490}]} }
  connect(vehicle.PDEG, roll.PDEG) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 2110, "y": 517.5}, {"x": 2110, "y": 1520}, {"x": 399.95, "y": 1520}], "E": 2}], "path": {}} }
  connect(vehicle.ALPHA_DEG, ALPHA_DEG) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 2900, "y": 472.5}, {"x": 2900, "y": 1850}], "E": 2}], "path": {}} }
