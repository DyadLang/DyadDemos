"""
HL20 full-system demo: four SAS controllers driving the HL20Mixer surface
mixer, which drives the HL20Vehicle flight-dynamics model. Vehicle feedback
signals return to the controllers; primary channels also tee to diagram
outputs.
"""
component HL20FullSystem
  DCPILOT = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 100, "x2": 50, "y2": 200}, "diagram": {"x1": -50.0, "x2": 50.0, "y1": 1450.0, "y2": 1550.0}}}}
  DWPILOT = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 300, "x2": 50, "y2": 400}, "diagram": {"x1": -50.0, "x2": 50.0, "y1": 1650.0, "y2": 1750.0}}}}
  DPPILOT = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 500, "x2": 50, "y2": 600}, "diagram": {"x1": -50.0, "x2": 50.0, "y1": 1850.0, "y2": 1950.0}}}}
  DLSBCOM = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 700, "x2": 50, "y2": 800}, "diagram": {"x1": -50.0, "x2": 50.0, "y1": 2050.0, "y2": 2150.0}}}}
  DECMD = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 965, "x2": 1035, "y1": 15, "y2": 85}, "diagram": {"x1": 2950.0, "x2": 3050.0, "y1": 150.0, "y2": 250.0}}}}
  ALPHA_DEG = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 965, "x2": 1035, "y1": 465, "y2": 535}, "diagram": {"x1": 2950.0, "x2": 3050.0, "y1": 950.0, "y2": 1050.0}}}}
  QDEG = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 965, "x2": 1035, "y1": 577.5, "y2": 647.5}, "diagram": {"x1": 2950.0, "x2": 3050.0, "y1": 1550.0, "y2": 1650.0}}}}
  NZ = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 965, "x2": 1035, "y1": 802.5, "y2": 872.5}, "diagram": {"x1": 2950.0, "x2": 3050.0, "y1": 1750.0, "y2": 1850.0}}}}
  ALT_FT = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 965, "x2": 1035, "y1": 915, "y2": 985}, "diagram": {"x1": 2950.0, "x2": 3050.0, "y1": 1150.0, "y2": 1250.0}}}}
  DACMD = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 965, "x2": 1035, "y1": 127.5, "y2": 197.5}, "diagram": {"x1": 2950, "x2": 3050, "y1": 300, "y2": 400}}}}
  DRCMD = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 965, "x2": 1035, "y1": 240, "y2": 310}, "diagram": {"x1": 2950, "x2": 3050, "y1": 450, "y2": 550}}}}
  DLE = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 965, "x2": 1035, "y1": 690, "y2": 760}, "diagram": {"x1": 2950.0, "x2": 3050.0, "y1": 1350.0, "y2": 1450.0}}}}
  DSBCMD = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 965, "x2": 1035, "y1": 352.5, "y2": 422.5}, "diagram": {"x1": 2950, "x2": 3050, "y1": 600, "y2": 700}}}}
  pitch = PitchControl(DETRIM0 = DETRIM0) {"Dyad": {"placement": {"diagram": {"x1": 400, "y1": 150, "x2": 900, "y2": 300}}}}
  roll = RollControl() {"Dyad": {"placement": {"diagram": {"x1": 200, "y1": 1100, "x2": 350, "y2": 1200}}}}
  yaw = YawControl() {"Dyad": {"placement": {"diagram": {"x1": 500, "y1": 1300, "x2": 650, "y2": 1400}}}}
  speed = SpeedControl() {"Dyad": {"placement": {"diagram": {"x1": 700, "y1": 1500, "x2": 800, "y2": 1600}}}}
  mixer = HL20Mixer() {"Dyad": {"placement": {"diagram": {"x1": 1300, "y1": 300, "x2": 1400, "y2": 700}}}}
  vehicle = HL20Vehicle() {"Dyad": {"placement": {"diagram": {"x1": 1800, "y1": 250, "x2": 1900, "y2": 1150}}}}
  parameter DETRIM0::Real = 5.5
relations
  connect(DCPILOT, pitch.DCPILOT) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 150, "y": 1500}, {"x": 150, "y": 157.5}], "E": 2}], "path": {}}}
  connect(DWPILOT, roll.DWPILOT) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 160, "y": 1700}, {"x": 160, "y": 1120}], "E": 2}], "path": {}}}
  connect(DPPILOT, yaw.DPPILOT) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 140, "y": 1900}, {"x": 140, "y": 1315}], "E": 2}], "path": {}}}
  connect(DLSBCOM, speed.DLSBCOM) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 170, "y": 2100}, {"x": 170, "y": 1550}], "E": 2}], "path": {}}}
    connect(pitch.DECMD, mixer.DECMD, DECMD) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1280, "y": 225}], "E": -1}, {"S": -1, "M": [{"x": 1298, "y": 360}], "E": 2}, {"S": -1, "M": [{"x": 1298, "y": 90}, {"x": 2890, "y": 90}, {"x": 2890, "y": 200}], "E": 3}], "path": {}, "junctions": [{"x": 1298, "y": 225}]}}
    connect(roll.DACMD, yaw.DACMD, mixer.DACMD, DACMD) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [], "E": -2}, {"S": -2, "M": [], "E": 2}, {"S": -1, "M": [], "E": -3}, {"S": -3, "M": [{"x": 1285, "y": 145}, {"x": 1285, "y": 440}], "E": 3}, {"S": -3, "M": [], "E": -4}, {"S": -4, "M": [{"x": 2850, "y": 350}], "E": 4}], "path": {}, "junctions": [{"x": 370, "y": 1150}, {"x": 370, "y": 1355}, {"x": 370, "y": 145}, {"x": 2850, "y": 145}]}}
    connect(yaw.DRCMD, mixer.DRCMD, DRCMD) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 660, "y": 1460}, {"x": 365, "y": 1460}, {"x": 365, "y": 125}], "E": -2}, {"S": -2, "M": [{"x": 1290, "y": 125}, {"x": 1290, "y": 520}], "E": 2}, {"S": -2, "M": [], "E": -3}, {"S": -3, "M": [{"x": 2840, "y": 500}], "E": 3}], "path": {}, "junctions": [{"x": 660, "y": 1350}, {"x": 365, "y": 125}, {"x": 2840, "y": 125}]}}
    connect(speed.DSBCMD, mixer.DSBCMD, DSBCMD) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [{"x": 860, "y": 1470}, {"x": 360, "y": 1470}, {"x": 360, "y": 105}], "E": -2}, {"S": -2, "M": [{"x": 1295, "y": 105}, {"x": 1295, "y": 600}], "E": 2}, {"S": -2, "M": [], "E": -3}, {"S": -3, "M": [{"x": 2830, "y": 650}], "E": 3}], "path": {}, "junctions": [{"x": 860, "y": 1550}, {"x": 360, "y": 105}, {"x": 2830, "y": 105}]}}
  connect(mixer.DUL, vehicle.DBFUL) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1490, "y": 422.84000000000003}, {"x": 1490, "y": 295.0}], "E": 2}], "path": {}}}
  connect(mixer.DUR, vehicle.DBFUR) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1470, "y": 474.28}, {"x": 1470, "y": 430.0}], "E": 2}], "path": {}}}
  connect(mixer.DLL, vehicle.DBFLL) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1450, "y": 525.72}, {"x": 1450, "y": 565.0}], "E": 2}], "path": {}}}
  connect(mixer.DLR, vehicle.DBFLR) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1430, "y": 577.16}, {"x": 1430, "y": 700.0}], "E": 2}], "path": {}}}
  connect(mixer.DR, vehicle.DRUD) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1410, "y": 628.56}, {"x": 1410, "y": 1105.0}], "E": 2}], "path": {}}}
  connect(mixer.DRE, vehicle.DWFR) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1510, "y": 371.44}, {"x": 1510, "y": 970.0}], "E": 2}], "path": {}}}
  connect(mixer.DLE, vehicle.DWFL) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1530, "y": 320.0}, {"x": 1530, "y": 835.0}], "E": 2}], "path": {}}}
    connect(mixer.DLEDEG, pitch.DLEDEG) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1460, "y": 680}, {"x": 1460, "y": 60}, {"x": 110, "y": 60}, {"x": 110, "y": 262.5}], "E": 2}], "path": {}}}
  connect(mixer.DLE, DLE) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1405, "y": 320}, {"x": 1405, "y": 210}, {"x": 2700, "y": 210}, {"x": 2700, "y": 1400}], "E": 2}], "path": {}}}
    connect(vehicle.MACH_out, pitch.MACH, yaw.MACH) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 2135, "y": 457}, {"x": 2135, "y": 1450}], "E": -2}, {"S": -2, "M": [], "E": 3}, {"S": -2, "M": [], "E": -1}, {"S": -1, "M": [], "E": 2}], "path": {}, "junctions": [{"x": 425, "y": 1450}, {"x": 530, "y": 1450}]}}
    connect(vehicle.PDEG, roll.PDEG) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 2115, "y": 511}, {"x": 2115, "y": 1490}, {"x": 249.95, "y": 1490}, {"x": 249.95, "y": 1200}], "E": 2}], "path": {}}}
    connect(vehicle.RDEG, pitch.RDEG, yaw.RDEG) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 2075, "y": 619}, {"x": 2075, "y": 1440}], "E": -2}, {"S": -2, "M": [], "E": 3}, {"S": -2, "M": [], "E": -1}, {"S": -1, "M": [{"x": 480, "y": 310}, {"x": 537.5, "y": 310}], "E": 2}], "path": {}, "junctions": [{"x": 480, "y": 1440}, {"x": 590, "y": 1440}]}}
  connect(vehicle.SINPHI, pitch.SINPHI) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 2055, "y": 673}, {"x": 2055, "y": 1270}, {"x": 593.75, "y": 1270}, {"x": 593.75, "y": 300}], "E": 2}], "path": {}}}
  connect(vehicle.COSPHI, pitch.COSPHI) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 2035, "y": 727}, {"x": 2035, "y": 1260}, {"x": 650, "y": 1260}, {"x": 650, "y": 300}], "E": 2}], "path": {}}}
  connect(vehicle.COSTHE, pitch.COSTHE) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 2015, "y": 781}, {"x": 2015, "y": 1250}, {"x": 706.25, "y": 1250}, {"x": 706.25, "y": 300}], "E": 2}], "path": {}}}
  connect(vehicle.QBAR, pitch.QBAR) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1995, "y": 835}, {"x": 1995, "y": 1240}, {"x": 762.5, "y": 1240}, {"x": 762.5, "y": 300}], "E": 2}], "path": {}}}
  connect(vehicle.V_FPS, pitch.VTOTALI) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1955, "y": 997}, {"x": 1955, "y": 1220}, {"x": 875, "y": 1220}, {"x": 875, "y": 300}], "E": 2}], "path": {}}}
    connect(vehicle.QDEG, pitch.QDEG, QDEG) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 2095, "y": 565}, {"x": 2095, "y": 1290}], "E": -1}, {"S": -1, "M": [{"x": 481.25, "y": 1290}, {"x": 481.25, "y": 300}], "E": 2}, {"S": -1, "M": [{"x": 2095, "y": 1500}, {"x": 2840, "y": 1500}, {"x": 2840, "y": 1600}], "E": 3}], "path": {}, "junctions": [{"x": 2095, "y": 1290}]}}
        connect(vehicle.NZ, pitch.NZ, NZ) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1975, "y": 943}, {"x": 1975, "y": 1230}], "E": -1}, {"S": -1, "M": [{"x": 818.75, "y": 1230}, {"x": 818.75, "y": 300}], "E": 2}, {"S": -1, "M": [{"x": 1975, "y": 1520}, {"x": 2855, "y": 1520}, {"x": 2855, "y": 1800}], "E": 3}], "path": {}, "junctions": [{"x": 1975, "y": 1230}]}}
  connect(vehicle.ALPHA_DEG, ALPHA_DEG) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1996, "y": 295}, {"x": 1996, "y": 205}, {"x": 2705, "y": 205}, {"x": 2705, "y": 1000}], "E": 2}], "path": {}}}
  connect(vehicle.ALT_FT, ALT_FT) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 2885, "y": 1051}, {"x": 2885, "y": 1200}], "E": 2}], "path": {}}}
metadata {"Dyad": {"icons": {"default": "dyad://HL20Demo/fullsystem.svg"}}}
end
