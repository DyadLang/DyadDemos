"""
Translational dynamics of the flat-earth 6-DOF body in the inertial
NED frame: der(v) = F/m with gravity added internally on the down axis
(axis 3), der(p) = v. Every operation is a wired block.
"""
component TransDynamics
  "External force, inertial NED axis 1 (N)"
  F1 = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 170, "x2": 30, "y2": 230},
        "diagram": {"x1": -30, "x2": 30, "y1": 370, "y2": 430}
      }
    }
  }
  "External force, inertial NED axis 2 (N)"
  F2 = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 420, "x2": 30, "y2": 480},
        "diagram": {"x1": -30, "x2": 30, "y1": 720, "y2": 780}
      }
    }
  }
  "External force, inertial NED axis 3 (N)"
  F3 = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 670, "x2": 30, "y2": 730},
        "diagram": {"x1": -30, "x2": 30, "y1": 1020, "y2": 1080}
      }
    }
  }
  "Velocity, inertial NED axis 1 (m/s)"
  v1 = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 970, "y1": 170, "x2": 1030, "y2": 230},
        "diagram": {"x1": 1470, "x2": 1530, "y1": 370, "y2": 430}
      }
    }
  }
  "Velocity, inertial NED axis 2 (m/s)"
  v2 = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 970, "y1": 420, "x2": 1030, "y2": 480},
        "diagram": {"x1": 1470, "x2": 1530, "y1": 770, "y2": 830}
      }
    }
  }
  "Velocity, inertial NED axis 3 (m/s)"
  v3 = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 970, "y1": 570, "x2": 1030, "y2": 630},
        "diagram": {"x1": 1470, "x2": 1530, "y1": 1120, "y2": 1180}
      }
    }
  }
  "Position, inertial NED axis 1 (m)"
  p1 = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 970, "y1": 670, "x2": 1030, "y2": 730},
        "diagram": {"x1": 1470, "x2": 1530, "y1": 220, "y2": 280}
      }
    }
  }
  "Position, inertial NED axis 2 (m)"
  p2 = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 970, "y1": 770, "x2": 1030, "y2": 830},
        "diagram": {"x1": 1470, "x2": 1530, "y1": 620, "y2": 680}
      }
    }
  }
  "Position, inertial NED axis 3 (m)"
  p3 = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 970, "y1": 870, "x2": 1030, "y2": 930},
        "diagram": {"x1": 1470, "x2": 1530, "y1": 970, "y2": 1030}
      }
    }
  }
  "Vehicle mass (kg)"
  parameter mass::Real = 8664.1
  "Gravitational acceleration (m/s^2)"
  parameter g::Real = 9.81
  "Initial position, axis 1 (m)"
  parameter p1_0::Real = 0.0
  "Initial position, axis 2 (m)"
  parameter p2_0::Real = 0.0
  "Initial position, axis 3 (m)"
  parameter p3_0::Real = 0.0
  "Initial velocity, axis 1 (m/s)"
  parameter v1_0::Real = 0.0
  "Initial velocity, axis 2 (m/s)"
  parameter v2_0::Real = 0.0
  "Initial velocity, axis 3 (m/s)"
  parameter v3_0::Real = 0.0
  # Translational dynamics: der(v) = F/m (+g on axis 3), der(p) = v
  a1 = BlockComponents.Math.Gain(k = 1.0 / mass) {
    "Dyad": {"placement": {"diagram": {"x1": 300, "x2": 400, "y1": 350, "y2": 450}}}
  }
  a2 = BlockComponents.Math.Gain(k = 1.0 / mass) {
    "Dyad": {"placement": {"diagram": {"x1": 300, "x2": 400, "y1": 700, "y2": 800}}}
  }
  a3 = BlockComponents.Math.Gain(k = 1.0 / mass) {
    "Dyad": {"placement": {"diagram": {"x1": 300, "x2": 400, "y1": 1000, "y2": 1100}}}
  }
  grav = BlockComponents.Sources.Constant(k = g) {
    "Dyad": {"placement": {"diagram": {"x1": 300, "x2": 400, "y1": 1250, "y2": 1350}}}
  }
  acc3 = BlockComponents.Math.Add() {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 1050, "y2": 1150}}}
  }
  int_v1 = BlockComponents.Continuous.Integrator(x0 = v1_0) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 350, "y2": 450}}}
  }
  int_v2 = BlockComponents.Continuous.Integrator(x0 = v2_0) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 700, "y2": 800}}}
  }
  int_v3 = BlockComponents.Continuous.Integrator(x0 = v3_0) {
    "Dyad": {"placement": {"diagram": {"x1": 800, "x2": 900, "y1": 1050, "y2": 1150}}}
  }
  int_p1 = BlockComponents.Continuous.Integrator(x0 = p1_0) {
    "Dyad": {"placement": {"diagram": {"x1": 800, "x2": 900, "y1": 200, "y2": 300}}}
  }
  int_p2 = BlockComponents.Continuous.Integrator(x0 = p2_0) {
    "Dyad": {"placement": {"diagram": {"x1": 800, "x2": 900, "y1": 600, "y2": 700}}}
  }
  int_p3 = BlockComponents.Continuous.Integrator(x0 = p3_0) {
    "Dyad": {"placement": {"diagram": {"x1": 1050, "x2": 1150, "y1": 950, "y2": 1050}}}
  }
relations
  connect(F1, a1.u) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(F2, a2.u) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(F3, a3.u) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(a3.y, acc3.u1) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 543.75, "y": 1050}, {"x": 543.75, "y": 1070}], "E": 2}],
      "path": {}
    }
  }
  connect(grav.y, acc3.u2) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 543.75, "y": 1300}, {"x": 543.75, "y": 1130}], "E": 2}],
      "path": {}
    }
  }
  connect(a1.y, int_v1.u) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(a2.y, int_v2.u) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(acc3.y, int_v3.u) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(int_v1.y, int_p1.u) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 793.75, "y": 400}, {"x": 793.75, "y": 250}], "E": 2}],
      "path": {}
    }
  }
  connect(int_v2.y, int_p2.u) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 793.75, "y": 750}, {"x": 793.75, "y": 650}], "E": 2}],
      "path": {}
    }
  }
  connect(int_v3.y, int_p3.u) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 1043.75, "y": 1100}, {"x": 1043.75, "y": 1000}], "E": 2}],
      "path": {}
    }
  }
  connect(int_v1.y, v1) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(int_p1.y, p1) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(int_v2.y, v2) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1420, "y": 750}, {"x": 1420, "y": 800}], "E": 2}], "path": {}}}
  connect(int_p2.y, p2) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(int_v3.y, v3) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1420, "y": 1100}, {"x": 1420, "y": 1150}], "E": 2}], "path": {}}}
  connect(int_p3.y, p3) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
metadata {"Dyad": {"icons": {"default": "dyad://HL20Demo/transdyn.svg"}}}
end

"""
Rotational dynamics of the flat-earth 6-DOF body in the body frame:
Euler's equations I_i dw_i = T_i + (I_j - I_k) w_j w_k with diagonal
inertia. Every operation is a wired block.
"""
component RotDynamics
  "External torque, body axis 1 (N.m)"
  T1 = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 170, "x2": 30, "y2": 230}, "diagram": {"x1": -30, "x2": 30, "y1": 20, "y2": 80}}}}
  "External torque, body axis 2 (N.m)"
  T2 = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 420, "x2": 30, "y2": 480}, "diagram": {"x1": -30, "x2": 30, "y1": 140, "y2": 200}}}}
  "External torque, body axis 3 (N.m)"
  T3 = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 670, "x2": 30, "y2": 730}, "diagram": {"x1": -30, "x2": 30, "y1": 260, "y2": 320}}}}
  "Body angular rate, axis 1 (rad/s)"
  w1 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 170, "x2": 1030, "y2": 230}, "diagram": {"x1": 1770, "x2": 1830, "y1": 280, "y2": 340}}}}
  "Body angular rate, axis 2 (rad/s)"
  w2 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 420, "x2": 1030, "y2": 480}, "diagram": {"x1": 1770, "x2": 1830, "y1": 730, "y2": 790}}}}
  "Body angular rate, axis 3 (rad/s)"
  w3 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 670, "x2": 1030, "y2": 730}, "diagram": {"x1": 1770, "x2": 1830, "y1": 1180, "y2": 1240}}}}
  "Roll moment of inertia (kg.m^2)"
  parameter Jxx::Real = 10186.272
  "Pitch moment of inertia (kg.m^2)"
  parameter Jyy::Real = 45557.464
  "Yaw moment of inertia (kg.m^2)"
  parameter Jzz::Real = 48333.264
  "Initial body roll rate (rad/s)"
  parameter w1_0::Real = 0.0
  "Initial body pitch rate (rad/s)"
  parameter w2_0::Real = 0.0
  "Initial body yaw rate (rad/s)"
  parameter w3_0::Real = 0.0
  # Euler's equations: I_i dw_i = T_i + (I_j - I_k) w_j w_k
  w2w3 = BlockComponents.Math.Product() {"Dyad": {"placement": {"diagram": {"x1": 500, "x2": 600, "y1": 260, "y2": 360}}}}
  gyro1 = BlockComponents.Math.Gain(k = Jyy - Jzz) {"Dyad": {"placement": {"diagram": {"x1": 750, "x2": 850, "y1": 260, "y2": 360}}}}
  sum_t1 = BlockComponents.Math.Add() {"Dyad": {"placement": {"diagram": {"x1": 1000, "x2": 1100, "y1": 260, "y2": 360}}}}
  accw1 = BlockComponents.Math.Gain(k = 1.0 / Jxx) {"Dyad": {"placement": {"diagram": {"x1": 1250, "x2": 1350, "y1": 260, "y2": 360}}}}
  int_w1 = BlockComponents.Continuous.Integrator(x0 = w1_0) {"Dyad": {"placement": {"diagram": {"x1": 1500, "x2": 1600, "y1": 260, "y2": 360}}}}
  w3w1 = BlockComponents.Math.Product() {"Dyad": {"placement": {"diagram": {"x1": 500, "x2": 600, "y1": 710, "y2": 810}}}}
  gyro2 = BlockComponents.Math.Gain(k = Jzz - Jxx) {"Dyad": {"placement": {"diagram": {"x1": 750, "x2": 850, "y1": 710, "y2": 810}}}}
  sum_t2 = BlockComponents.Math.Add() {"Dyad": {"placement": {"diagram": {"x1": 1000, "x2": 1100, "y1": 710, "y2": 810}}}}
  accw2 = BlockComponents.Math.Gain(k = 1.0 / Jyy) {"Dyad": {"placement": {"diagram": {"x1": 1250, "x2": 1350, "y1": 710, "y2": 810}}}}
  int_w2 = BlockComponents.Continuous.Integrator(x0 = w2_0) {"Dyad": {"placement": {"diagram": {"x1": 1500, "x2": 1600, "y1": 710, "y2": 810}}}}
  w1w2 = BlockComponents.Math.Product() {"Dyad": {"placement": {"diagram": {"x1": 500, "x2": 600, "y1": 1160, "y2": 1260}}}}
  gyro3 = BlockComponents.Math.Gain(k = Jxx - Jyy) {"Dyad": {"placement": {"diagram": {"x1": 750, "x2": 850, "y1": 1160, "y2": 1260}}}}
  sum_t3 = BlockComponents.Math.Add() {"Dyad": {"placement": {"diagram": {"x1": 1000, "x2": 1100, "y1": 1160, "y2": 1260}}}}
  accw3 = BlockComponents.Math.Gain(k = 1.0 / Jzz) {"Dyad": {"placement": {"diagram": {"x1": 1250, "x2": 1350, "y1": 1160, "y2": 1260}}}}
  int_w3 = BlockComponents.Continuous.Integrator(x0 = w3_0) {"Dyad": {"placement": {"diagram": {"x1": 1500, "x2": 1600, "y1": 1160, "y2": 1260}}}}
relations
          connect(w2w3.y, gyro1.u) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(T1, sum_t1.u1) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 15, "y": 50}, {"x": 15, "y": 140}, {"x": 995, "y": 140}, {"x": 995, "y": 280}], "E": 2}], "path": {}} }
  connect(gyro1.y, sum_t1.u2) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 920, "y": 310}, {"x": 920, "y": 340}, {"x": 995, "y": 340}], "E": 2}], "path": {}} }
  connect(sum_t1.y, accw1.u) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(accw1.y, int_w1.u) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
        connect(w3w1.y, gyro2.u) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(T2, sum_t2.u1) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 900, "y": 170}, {"x": 900, "y": 685}, {"x": 960, "y": 685}, {"x": 960, "y": 730}], "E": 2}], "path": {}} }
  connect(gyro2.y, sum_t2.u2) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 920, "y": 760}, {"x": 920, "y": 790}, {"x": 995, "y": 790}], "E": 2}], "path": {}} }
  connect(sum_t2.y, accw2.u) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(accw2.y, int_w2.u) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
      connect(w1w2.y, gyro3.u) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(T3, sum_t3.u1) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 360, "y": 290}, {"x": 360, "y": 255}, {"x": 700, "y": 255}, {"x": 700, "y": 1140}, {"x": 985, "y": 1140}, {"x": 985, "y": 1180}], "E": 2}], "path": {}} }
  connect(gyro3.y, sum_t3.u2) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 920, "y": 1210}, {"x": 920, "y": 1240}, {"x": 995, "y": 1240}], "E": 2}], "path": {}} }
  connect(sum_t3.y, accw3.u) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(accw3.y, int_w3.u) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
                connect(int_w1.y, w3w1.u2, w1w2.u1, w1) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [], "E": 4}, {"S": -1, "M": [{"x": 1601, "y": 310}, {"x": 1601, "y": 960}, {"x": 450, "y": 960}], "E": -2}, {"S": -2, "M": [{"x": 450, "y": 790}], "E": 2}, {"S": -2, "M": [{"x": 450, "y": 1180}], "E": 3}], "path": {}, "junctions": [{"x": 1615, "y": 310}, {"x": 450, "y": 960}]}}
                connect(int_w2.y, w2w3.u1, w1w2.u2, w2) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [], "E": 4}, {"S": -1, "M": [{"x": 1604, "y": 760}, {"x": 1604, "y": 1289}, {"x": 380, "y": 1289}], "E": -2}, {"S": -2, "M": [{"x": 380, "y": 280}], "E": -3}, {"S": -3, "M": [], "E": 2}, {"S": -2, "M": [{"x": 460, "y": 1289}, {"x": 460, "y": 1240}], "E": 3}], "path": {}, "junctions": [{"x": 1615, "y": 760}, {"x": 380, "y": 1289}, {"x": 380, "y": 280}]}}
                connect(int_w3.y, w2w3.u2, w3w1.u1, w3) {"Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [], "E": 4}, {"S": -1, "M": [{"x": 1606, "y": 1210}, {"x": 1606, "y": 1288}, {"x": 440, "y": 1288}], "E": -2}, {"S": -2, "M": [{"x": 440, "y": 340}], "E": -3}, {"S": -3, "M": [], "E": 2}, {"S": -2, "M": [{"x": 440, "y": 730}], "E": -4}, {"S": -4, "M": [], "E": 3}], "path": {}, "junctions": [{"x": 1609, "y": 1210}, {"x": 440, "y": 1288}, {"x": 440, "y": 340}, {"x": 440, "y": 730}]}}
metadata {"Dyad": {"icons": {"default": "dyad://HL20Demo/rotdyn.svg"}}}
end

"""
One quaternion-derivative row: dq = k1*qa*wa + k2*qb*wb + k3*qc*wc,
a single row of der(q) = 0.5 * q * omega. Every operation is a wired block.
"""
component QuatDerRow
  "Quaternion factor, product 1"
  qa = RealInput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 70, "x2": 1030, "y2": 130}, "diagram": {"x1": -330, "x2": -270, "y1": 95, "y2": 145}}}}
  "Quaternion factor, product 2"
  qb = RealInput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 170, "x2": 1030, "y2": 230}, "diagram": {"x1": -330, "x2": -270, "y1": 395, "y2": 445}}}}
  "Quaternion factor, product 3"
  qc = RealInput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 270, "x2": 1030, "y2": 330}, "diagram": {"x1": -330, "x2": -270, "y1": 695, "y2": 745}}}}
  "Angular rate factor, product 1"
  wa = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 70, "x2": 30, "y2": 130}, "diagram": {"x1": -30, "x2": 30, "y1": 155, "y2": 205}}}}
  "Angular rate factor, product 2"
  wb = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 170, "x2": 30, "y2": 230}, "diagram": {"x1": -30, "x2": 30, "y1": 455, "y2": 505}}}}
  "Angular rate factor, product 3"
  wc = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 270, "x2": 30, "y2": 330}, "diagram": {"x1": -30, "x2": 30, "y1": 755, "y2": 805}}}}
  "Derivative contribution"
  dq = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 530, "x2": 1030, "y2": 590}, "diagram": {"x1": 1170, "x2": 1230, "y1": 370, "y2": 430}}}}
  "Weight, product 1"
  parameter k1::Real = 0.5
  "Weight, product 2"
  parameter k2::Real = 0.5
  "Weight, product 3"
  parameter k3::Real = 0.5
  p1 = BlockComponents.Math.Product() {"Dyad": {"placement": {"diagram": {"x1": 400, "x2": 500, "y1": 100, "y2": 200}}}}
  p2 = BlockComponents.Math.Product() {"Dyad": {"placement": {"diagram": {"x1": 400, "x2": 500, "y1": 400, "y2": 500}}}}
  p3 = BlockComponents.Math.Product() {"Dyad": {"placement": {"diagram": {"x1": 400, "x2": 500, "y1": 700, "y2": 800}}}}
  s = BlockComponents.Math.Add3(k1 = k1, k2 = k2, k3 = k3) {"Dyad": {"placement": {"diagram": {"x1": 800, "x2": 900, "y1": 350, "y2": 450}}}}
relations
  connect(qa, p1.u1) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(wa, p1.u2) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(qb, p2.u1) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(wb, p2.u2) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(qc, p3.u1) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(wc, p3.u2) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(p1.y, s.u1) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 640, "y": 150}, {"x": 640, "y": 370}], "E": 2}], "path": {}} }
  connect(p2.y, s.u2) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 660, "y": 450}, {"x": 660, "y": 400}], "E": 2}], "path": {}} }
  connect(p3.y, s.u3) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 680, "y": 750}, {"x": 680, "y": 430}], "E": 2}], "path": {}} }
  connect(s.y, dq) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
metadata {"Dyad": {"icons": {"default": "dyad://HL20Demo/quatrow.svg"}}}
end

"""
Quaternion kinematics of the flat-earth 6-DOF body:
der(q) = 0.5 * q * omega for the scalar-first body-to-inertial NED
quaternion q = [q0, q1, q2, q3]. Every operation is a wired block.
"""
component QuatKinematics
  "Body angular rate, axis 1 (rad/s)"
  w1 = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 170, "x2": 30, "y2": 230}, "diagram": {"x1": 240, "x2": 300, "y1": 250.0, "y2": 310.0}}}}
  "Body angular rate, axis 2 (rad/s)"
  w2 = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 420, "x2": 30, "y2": 480}, "diagram": {"x1": 440, "x2": 500, "y1": 330.0, "y2": 390.0}}}}
  "Body angular rate, axis 3 (rad/s)"
  w3 = RealInput() {"Dyad": {"placement": {"icon": {"x1": -30, "y1": 670, "x2": 30, "y2": 730}, "diagram": {"x1": 640, "x2": 700, "y1": 410.0, "y2": 470.0}}}}
  "Quaternion scalar part"
  q0 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 120, "x2": 1030, "y2": 180}, "diagram": {"x1": 2680, "x2": 2740, "y1": 1250.0, "y2": 1310.0}}}}
  "Quaternion x part"
  q1 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 320, "x2": 1030, "y2": 380}, "diagram": {"x1": 2980, "x2": 3040, "y1": 1618, "y2": 1678}}}}
  "Quaternion y part"
  q2 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 520, "x2": 1030, "y2": 580}, "diagram": {"x1": 2880, "x2": 2940, "y1": 2618, "y2": 2678}}}}
  "Quaternion z part"
  q3 = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 720, "x2": 1030, "y2": 780}, "diagram": {"x1": 2780, "x2": 2840, "y1": 2410.0, "y2": 2470.0}}}}
  "Initial quaternion scalar part"
  parameter q0_0::Real = 1.0
  "Initial quaternion x part"
  parameter q1_0::Real = 0.0
  "Initial quaternion y part"
  parameter q2_0::Real = 0.0
  "Initial quaternion z part"
  parameter q3_0::Real = 0.0
  # Quaternion kinematics: der(q) = 0.5 * q * omega
  r0 = QuatDerRow(k1 = -0.5, k2 = -0.5, k3 = -0.5) {"Dyad": {"placement": {"diagram": {"x1": 1200, "x2": 2200, "y1": 200, "y2": 1000}}}}
  r1 = QuatDerRow(k1 = 0.5, k2 = 0.5, k3 = -0.5) {"Dyad": {"placement": {"diagram": {"x1": 1200, "x2": 2200, "y1": 1200, "y2": 2000}}}}
  r2 = QuatDerRow(k1 = 0.5, k2 = -0.5, k3 = 0.5) {"Dyad": {"placement": {"diagram": {"x1": 1200, "x2": 2200, "y1": 2200, "y2": 3000}}}}
  r3 = QuatDerRow(k1 = 0.5, k2 = 0.5, k3 = -0.5) {"Dyad": {"placement": {"diagram": {"x1": 1200, "x2": 2200, "y1": 3200, "y2": 4000}}}}
  int_q0 = BlockComponents.Continuous.Integrator(x0 = q0_0) {"Dyad": {"placement": {"diagram": {"x1": 2400, "x2": 2550, "y1": 573, "y2": 723}}}}
  int_q1 = BlockComponents.Continuous.Integrator(x0 = q1_0) {"Dyad": {"placement": {"diagram": {"x1": 2400, "x2": 2550, "y1": 1573, "y2": 1723}}}}
  int_q2 = BlockComponents.Continuous.Integrator(x0 = q2_0) {"Dyad": {"placement": {"diagram": {"x1": 2400, "x2": 2550, "y1": 2573, "y2": 2723}}}}
  int_q3 = BlockComponents.Continuous.Integrator(x0 = q3_0) {"Dyad": {"placement": {"diagram": {"x1": 2400, "x2": 2550, "y1": 3573, "y2": 3723}}}}
relations
  connect(int_q0.y, q0, r1.qa, r2.qa, r3.qa) { "Dyad": {"edges": [{"S": -1, "M": [], "E": -2}, {"S": -1, "M": [], "E": 3}, {"S": -2, "M": [], "E": 4}, {"S": -1, "M": [{"x": 2650, "y": 648}], "E": 1}, {"S": -2, "M": [{"x": 2650, "y": 3280}], "E": 5}, {"S": -1, "M": [], "E": 2}], "path": {}, "junctions": [{"x": 2650, "y": 1280}, {"x": 2650, "y": 2280}]} }
  connect(int_q1.y, q1, r0.qa, r2.qb, r3.qb) { "Dyad": {"edges": [{"S": -1, "M": [], "E": -2}, {"S": -1, "M": [], "E": 1}, {"S": -2, "M": [], "E": 4}, {"S": -1, "M": [{"x": 2950, "y": 280}], "E": 3}, {"S": -2, "M": [{"x": 2950, "y": 3360}], "E": 5}, {"S": -1, "M": [], "E": 2}], "path": {}, "junctions": [{"x": 2950, "y": 1648}, {"x": 2950, "y": 2360}]} }
  connect(int_q2.y, q2, r0.qb, r1.qb, r3.qc) { "Dyad": {"edges": [{"S": -1, "M": [], "E": -2}, {"S": -1, "M": [], "E": 4}, {"S": -2, "M": [], "E": 1}, {"S": -1, "M": [{"x": 2850, "y": 360}], "E": 3}, {"S": -2, "M": [{"x": 2850, "y": 3440}], "E": 5}, {"S": -2, "M": [], "E": 2}], "path": {}, "junctions": [{"x": 2850, "y": 1360}, {"x": 2850, "y": 2648}]} }
  connect(int_q3.y, q3, r0.qc, r1.qc, r2.qc) { "Dyad": {"edges": [{"S": -1, "M": [], "E": -2}, {"S": -1, "M": [], "E": 4}, {"S": -2, "M": [], "E": 5}, {"S": -1, "M": [{"x": 2750, "y": 440}], "E": 3}, {"S": -2, "M": [{"x": 2750, "y": 3648}], "E": 1}, {"S": -2, "M": [], "E": 2}], "path": {}, "junctions": [{"x": 2750, "y": 1440}, {"x": 2750, "y": 2440}]} }
  connect(w1, r0.wa, r1.wa, r2.wc, r3.wc) { "Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [], "E": -2}, {"S": -2, "M": [], "E": -3}, {"S": -1, "M": [], "E": 2}, {"S": -2, "M": [], "E": 3}, {"S": -3, "M": [], "E": 4}, {"S": -3, "M": [{"x": 350, "y": 3440}], "E": 5}], "path": {}, "junctions": [{"x": 350, "y": 280}, {"x": 350, "y": 1280}, {"x": 350, "y": 2440}]} }
  connect(w2, r0.wb, r1.wc, r2.wa, r3.wb) { "Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [], "E": -2}, {"S": -2, "M": [], "E": -3}, {"S": -1, "M": [], "E": 2}, {"S": -2, "M": [], "E": 3}, {"S": -3, "M": [], "E": 4}, {"S": -3, "M": [{"x": 550, "y": 3360}], "E": 5}], "path": {}, "junctions": [{"x": 550, "y": 360}, {"x": 550, "y": 1440}, {"x": 550, "y": 2280}]} }
  connect(w3, r0.wc, r1.wb, r2.wb, r3.wa) { "Dyad": {"edges": [{"S": 1, "M": [], "E": -1}, {"S": -1, "M": [], "E": -2}, {"S": -2, "M": [], "E": -3}, {"S": -1, "M": [], "E": 2}, {"S": -2, "M": [], "E": 3}, {"S": -3, "M": [], "E": 4}, {"S": -3, "M": [{"x": 750, "y": 3280}], "E": 5}], "path": {}, "junctions": [{"x": 750, "y": 440}, {"x": 750, "y": 1360}, {"x": 750, "y": 2360}]} }
  connect(r0.dq, int_q0.u) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(r1.dq, int_q1.u) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(r2.dq, int_q2.u) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(r3.dq, int_q3.u) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
metadata {"Dyad": {"icons": {"default": "dyad://HL20Demo/quatkin.svg"}}}
end
