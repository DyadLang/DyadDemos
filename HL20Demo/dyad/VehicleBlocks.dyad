"""
Output unit conversions for the HL-20 vehicle.

Body rates to degrees and normal acceleration g.
"""
component VehicleOutputs
  # Inputs
  p_rad = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 0, "y1": 950, "x2": 100, "y2": 1050},
        "diagram": {"x1": -50, "x2": 50, "y1": 100, "y2": 200}
      }
    }
  }
  q_rad = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 300, "y1": 950, "x2": 400, "y2": 1050},
        "diagram": {"x1": -50, "x2": 50, "y1": 200, "y2": 300}
      }
    }
  }
  r_rad = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 600, "y1": 950, "x2": 700, "y2": 1050},
        "diagram": {"x1": -50, "x2": 50, "y1": 300, "y2": 400}
      }
    }
  }
  fz_body = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 900, "y1": 950, "x2": 1000, "y2": 1050},
        "diagram": {"x1": -50, "x2": 50, "y1": 500, "y2": 600}
      }
    }
  }
  # Outputs
  pdeg = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 0, "x2": 1050, "y2": 100},
        "diagram": {"x1": 1000, "x2": 1100, "y1": 100, "y2": 200}
      }
    }
  }
  qdeg = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 100, "x2": 1050, "y2": 200},
        "diagram": {"x1": 1000, "x2": 1100, "y1": 200, "y2": 300}
      }
    }
  }
  rdeg = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 200, "x2": 1050, "y2": 300},
        "diagram": {"x1": 1000, "x2": 1100, "y1": 300, "y2": 400}
      }
    }
  }
  nz_g = RealOutput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 950, "y1": 300, "x2": 1050, "y2": 400},
        "diagram": {"x1": 1000, "x2": 1100, "y1": 500, "y2": 600}
      }
    }
  }
  parameter mass::Real = 8664.1
