"""
Air-data calculations for the HL-20 vehicle.

Converts the rigid-body state into the aerodynamic operating point: altitude,
Mach, dynamic pressure, h/b, equivalent airspeed and beta-dot.
"""
component AirData
  # Inputs
  pos_m = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 220, "y1": -30, "x2": 280, "y2": 30},
        "diagram": {"x1": -30, "x2": 30, "y1": 120, "y2": 180}
      }
    }
  }
  v_mps = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 87.5, "x2": 30, "y2": 137.5},
        "diagram": {"x1": -30, "x2": 30, "y1": 420, "y2": 480}
      }
    }
  }
  p_rad = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 420, "y1": 970, "x2": 480, "y2": 1030},
        "diagram": {"x1": -30, "x2": 30, "y1": 970, "y2": 1030}
      }
    }
  }
  sin_alpha = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 642.5, "x2": 30, "y2": 682.5},
        "diagram": {"x1": -30, "x2": 30, "y1": 1120, "y2": 1180}
      }
    }
  }
  r_rad = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 520, "y1": 970, "x2": 580, "y2": 1030},
        "diagram": {"x1": -30, "x2": 30, "y1": 1270, "y2": 1330}
      }
    }
  }
  cos_alpha = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -30, "y1": 692.5, "x2": 30, "y2": 732.5},
        "diagram": {"x1": -30, "x2": 30, "y1": 1420, "y2": 1480}
      }
    }
  }
  # Outputs
  alt_ft = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 720, "y1": -30, "x2": 780, "y2": 30}, "diagram": {"x1": 2120, "x2": 2180, "y1": 70, "y2": 130}}}}
  hob = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 232.5, "x2": 1030, "y2": 292.5}, "diagram": {"x1": 2120, "x2": 2180, "y1": 270, "y2": 330}}}}
  v_fps = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 132.5, "x2": 1030, "y2": 192.5}, "diagram": {"x1": 2120, "x2": 2180, "y1": 870, "y2": 930}}}}
  qbar = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 620, "y1": -30, "x2": 680, "y2": 30}, "diagram": {"x1": 2120, "x2": 2180, "y1": 470, "y2": 530}}}}
  mach = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 32.5, "x2": 1030, "y2": 92.5}, "diagram": {"x1": 2120, "x2": 2180, "y1": 670, "y2": 730}}}}
  eas_kts = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 470, "y1": -30, "x2": 530, "y2": 30}, "diagram": {"x1": 2120, "x2": 2180, "y1": 1070, "y2": 1130}}}}
  bdot = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 370, "y1": -30, "x2": 430, "y2": 30}, "diagram": {"x1": 2120, "x2": 2180, "y1": 1270, "y2": 1330}}}}
  parameter ft_per_m::Real = 3.28084
  parameter BSPAN::Real = 13.89
  parameter rho_sl::Real = 0.002378
  parameter knots_per_fps::Real = 0.592484
  alt_gain = BlockComponents.Math.Gain(k = -ft_per_m) {
    "Dyad": {"placement": {"diagram": {"x1": 350.0, "y1": 100.0, "x2": 450.0, "y2": 200.0}}}
  }
  atmos = Atmosphere1976() {
    "Dyad": {"placement": {"diagram": {"x1": 700.0, "y1": 150.0, "x2": 800.0, "y2": 250.0}}}
  }
  hob_div = BlockComponents.Math.Division() {
    "Dyad": {"placement": {"diagram": {"x1": 1350.0, "y1": 100.0, "x2": 1450.0, "y2": 200.0}}}
  }
  bspan_eps = BlockComponents.Sources.Constant(k = BSPAN + 0.01) {"Dyad": {"placement": {"diagram": {"x1": 1500, "x2": 1600, "y1": 300, "y2": 400}}}}
  vrw_gain = BlockComponents.Math.Gain(k = ft_per_m) {
    "Dyad": {"placement": {"diagram": {"x1": 350.0, "y1": 400.0, "x2": 450.0, "y2": 500.0}}}
  }
  vrw2 = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 650.0, "y1": 400.0, "x2": 750.0, "y2": 500.0}}}
  }
  qbar_pre = BlockComponents.Math.Gain(k = 0.5 * rho_sl) {
    "Dyad": {"placement": {"diagram": {"x1": 900.0, "y1": 400.0, "x2": 1000.0, "y2": 500.0}}}
  }
  qbar_prod = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 1200.0, "y1": 400.0, "x2": 1300.0, "y2": 500.0}}}
  }
  mach_div = BlockComponents.Math.Division() {
    "Dyad": {"placement": {"diagram": {"x1": 1100.0, "y1": 520.0, "x2": 1200.0, "y2": 620.0}}}
  }
  sos_sum = BlockComponents.Math.Add() {
    "Dyad": {"placement": {"diagram": {"x1": 900.0, "y1": 600.0, "x2": 1000.0, "y2": 700.0}}}
  }
  sos_eps = BlockComponents.Sources.Constant(k = 0.01) {
    "Dyad": {"placement": {"diagram": {"x1": 550.0, "y1": 750.0, "x2": 650.0, "y2": 850.0}}}
  }
  sqrt_sig = BlockComponents.Math.Sqrt() {
    "Dyad": {"placement": {"diagram": {"x1": 1350.0, "y1": 750.0, "x2": 1450.0, "y2": 850.0}}}
  }
  eas_prod = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 1600.0, "y1": 700.0, "x2": 1700.0, "y2": 800.0}}}
  }
  eas = BlockComponents.Math.Gain(k = knots_per_fps) {
    "Dyad": {"placement": {"diagram": {"x1": 1850.0, "y1": 700.0, "x2": 1950.0, "y2": 800.0}}}
  }
  p_sin = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 350.0, "y1": 1000.0, "x2": 450.0, "y2": 1100.0}}}
  }
  r_cos = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 350.0, "y1": 1200.0, "x2": 450.0, "y2": 1300.0}}}
  }
  betadot_d = BlockComponents.Math.Add(k2 = -1.0) {
    "Dyad": {"placement": {"diagram": {"x1": 750.0, "y1": 1050.0, "x2": 850.0, "y2": 1150.0}}}
  }
  betadot = BlockComponents.Math.Gain(k = 57.29577951308232) {
    "Dyad": {"placement": {"diagram": {"x1": 1100.0, "y1": 1050.0, "x2": 1200.0, "y2": 1150.0}}}
  }
relations
  connect(pos_m, alt_gain.u) {
    "Dyad": {
          "edges": [
                {
                      "S": 1,
                      "M": [],
                      "E": 2
                }
          ],
          "path": {}
    }
  }
            connect(alt_gain.y, atmos.alt_ft, alt_ft, hob_div.u1) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 500, "y": 150}], "E": -1}, {"S": -1, "M": [{"x": 500, "y": 200}], "E": 2}, {"S": -1, "M": [{"x": 540, "y": 150}, {"x": 540, "y": 80}, {"x": 2030, "y": 80}, {"x": 2030, "y": 100}], "E": 3}, {"S": -1, "M": [{"x": 560, "y": 150}, {"x": 560, "y": 90}, {"x": 1300, "y": 90}, {"x": 1300, "y": 120}], "E": 4}], "path": {}, "junctions": [{"x": 500, "y": 150}]}}
            connect(atmos.sigma, qbar_prod.u2, sqrt_sig.u) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 850, "y": 180}], "E": -1}, {"S": -1, "M": [{"x": 1170, "y": 180}, {"x": 1170, "y": 480}], "E": 2}, {"S": -1, "M": [{"x": 850, "y": 190}, {"x": 1310, "y": 190}, {"x": 1310, "y": 800}], "E": 3}], "path": {}, "junctions": [{"x": 850, "y": 180}]}}
  connect(atmos.sos_mps, sos_sum.u1) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 860, "y": 220}, {"x": 860, "y": 620}], "E": 2}], "path": {}} }
  connect(sos_eps.y, sos_sum.u2) {
    "Dyad": {
          "edges": [
                {
                      "S": 1,
                      "M": [
                            {
                                  "x": 750,
                                  "y": 800
                            },
                            {
                                  "x": 750,
                                  "y": 680
                            }
                      ],
                      "E": 2
                }
          ],
          "path": {}
    }
  }
  connect(sos_sum.y, mach_div.u2) {
    "Dyad": {
          "edges": [
                {
                      "S": 1,
                      "M": [
                            {
                                  "x": 1050,
                                  "y": 650
                            },
                            {
                                  "x": 1050,
                                  "y": 600
                            }
                      ],
                      "E": 2
                }
          ],
          "path": {}
    }
  }
            connect(v_mps, vrw_gain.u, mach_div.u1) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 200, "y": 450}], "E": -1}, {"S": -1, "M": [], "E": 2}, {"S": -1, "M": [{"x": 200, "y": 540}], "E": 3}], "path": {}, "junctions": [{"x": 200, "y": 450}]}}
            connect(vrw_gain.y, vrw2.u1, vrw2.u2, eas_prod.u1, v_fps) {"Dyad": {"edges": [{"S": 1, "M": [{"x": 550, "y": 450}], "E": -1}, {"S": -1, "M": [{"x": 550, "y": 420}], "E": 2}, {"S": -1, "M": [{"x": 550, "y": 480}], "E": 3}, {"S": -1, "M": [{"x": 560, "y": 450}, {"x": 560, "y": 720}], "E": 4}, {"S": -1, "M": [{"x": 535, "y": 450}, {"x": 535, "y": 910}, {"x": 2130, "y": 910}, {"x": 2130, "y": 900}], "E": 5}], "path": {}, "junctions": [{"x": 550, "y": 450}]}}
  connect(vrw2.y, qbar_pre.u) {
    "Dyad": {
          "edges": [
                {
                      "S": 1,
                      "M": [],
                      "E": 2
                }
          ],
          "path": {}
    }
  }
  connect(qbar_pre.y, qbar_prod.u1) {
    "Dyad": {
          "edges": [
                {
                      "S": 1,
                      "M": [
                            {
                                  "x": 1100,
                                  "y": 450
                            },
                            {
                                  "x": 1100,
                                  "y": 420
                            }
                      ],
                      "E": 2
                }
          ],
          "path": {}
    }
  }
  connect(qbar_prod.y, qbar) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 2090, "y": 450}, {"x": 2090, "y": 500}], "E": 2}], "path": {}} }
  connect(mach_div.y, mach) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 2070, "y": 570}, {"x": 2070, "y": 700}], "E": 2}], "path": {}} }
  connect(bspan_eps.y, hob_div.u2) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1650, "y": 350}, {"x": 1650, "y": 240}, {"x": 1340, "y": 240}, {"x": 1340, "y": 180}], "E": 2}], "path": {}} }
  connect(hob_div.y, hob) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 2040, "y": 150}, {"x": 2040, "y": 300}], "E": 2}], "path": {}} }
  connect(sqrt_sig.y, eas_prod.u2) {
    "Dyad": {
          "edges": [
                {
                      "S": 1,
                      "M": [
                            {
                                  "x": 1520,
                                  "y": 800
                            },
                            {
                                  "x": 1520,
                                  "y": 780
                            }
                      ],
                      "E": 2
                }
          ],
          "path": {}
    }
  }
  connect(eas_prod.y, eas.u) {
    "Dyad": {
          "edges": [
                {
                      "S": 1,
                      "M": [],
                      "E": 2
                }
          ],
          "path": {}
    }
  }
  connect(eas.y, eas_kts) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 2060, "y": 750}, {"x": 2060, "y": 1100}], "E": 2}], "path": {}} }
  connect(p_rad, p_sin.u1) {
    "Dyad": {
          "edges": [
                {
                      "S": 1,
                      "M": [
                            {
                                  "x": 280,
                                  "y": 1000
                            },
                            {
                                  "x": 280,
                                  "y": 1020
                            }
                      ],
                      "E": 2
                }
          ],
          "path": {}
    }
  }
  connect(sin_alpha, p_sin.u2) {
    "Dyad": {
          "edges": [
                {
                      "S": 1,
                      "M": [
                            {
                                  "x": 300,
                                  "y": 1150
                            },
                            {
                                  "x": 300,
                                  "y": 1080
                            }
                      ],
                      "E": 2
                }
          ],
          "path": {}
    }
  }
  connect(r_rad, r_cos.u1) {
    "Dyad": {
          "edges": [
                {
                      "S": 1,
                      "M": [
                            {
                                  "x": 320,
                                  "y": 1300
                            },
                            {
                                  "x": 320,
                                  "y": 1220
                            }
                      ],
                      "E": 2
                }
          ],
          "path": {}
    }
  }
  connect(cos_alpha, r_cos.u2) {
    "Dyad": {
          "edges": [
                {
                      "S": 1,
                      "M": [
                            {
                                  "x": 340,
                                  "y": 1450
                            },
                            {
                                  "x": 340,
                                  "y": 1280
                            }
                      ],
                      "E": 2
                }
          ],
          "path": {}
    }
  }
  connect(p_sin.y, betadot_d.u1) {
    "Dyad": {
          "edges": [
                {
                      "S": 1,
                      "M": [
                            {
                                  "x": 600,
                                  "y": 1050
                            },
                            {
                                  "x": 600,
                                  "y": 1070
                            }
                      ],
                      "E": 2
                }
          ],
          "path": {}
    }
  }
  connect(r_cos.y, betadot_d.u2) {
    "Dyad": {
          "edges": [
                {
                      "S": 1,
                      "M": [
                            {
                                  "x": 650,
                                  "y": 1250
                            },
                            {
                                  "x": 650,
                                  "y": 1130
                            }
                      ],
                      "E": 2
                }
          ],
          "path": {}
    }
  }
  connect(betadot_d.y, betadot.u) {
    "Dyad": {
          "edges": [
                {
                      "S": 1,
                      "M": [],
                      "E": 2
                }
          ],
          "path": {}
    }
  }
  connect(betadot.y, bdot) { "Dyad": {"edges": [{"S": 1, "M": [{"x": 1300, "y": 1100}, {"x": 1300, "y": 1300}], "E": 2}], "path": {}} }
metadata {"Dyad": {"icons": {"default": "dyad://HL20Demo/veh_airdata.svg"}}}
end

"""
Output unit conversions for the HL-20 vehicle.

Body rates to degrees and normal acceleration g.
"""
component VehicleOutputs
  # Inputs
  p_rad = RealInput() {"Dyad": {"placement": {"icon": {"x1": 20, "y1": 970, "x2": 80, "y2": 1030}, "diagram": {"x1": -30, "x2": 30, "y1": 170, "y2": 230}}}}
  q_rad = RealInput() {"Dyad": {"placement": {"icon": {"x1": 320, "y1": 970, "x2": 380, "y2": 1030}, "diagram": {"x1": -30, "x2": 30, "y1": 370, "y2": 430}}}}
  r_rad = RealInput() {"Dyad": {"placement": {"icon": {"x1": 620, "y1": 970, "x2": 680, "y2": 1030}, "diagram": {"x1": -30, "x2": 30, "y1": 570, "y2": 630}}}}
  fz_body = RealInput() {"Dyad": {"placement": {"icon": {"x1": 920, "y1": 970, "x2": 980, "y2": 1030}, "diagram": {"x1": -30, "x2": 30, "y1": 770, "y2": 830}}}}
  # Outputs
  pdeg = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 20, "x2": 1030, "y2": 80}, "diagram": {"x1": 1020, "x2": 1080, "y1": 170, "y2": 230}}}}
  qdeg = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 120, "x2": 1030, "y2": 180}, "diagram": {"x1": 1020, "x2": 1080, "y1": 370, "y2": 430}}}}
  rdeg = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 220, "x2": 1030, "y2": 280}, "diagram": {"x1": 1020, "x2": 1080, "y1": 570, "y2": 630}}}}
  nz_g = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 970, "y1": 320, "x2": 1030, "y2": 380}, "diagram": {"x1": 1020, "x2": 1080, "y1": 770, "y2": 830}}}}
  parameter mass::Real = 8664.1
  parameter g::Real = 9.81
  p_deg = BlockComponents.Math.Gain(k = 57.29577951308232) {"Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 150, "y2": 250}}}}
  q_deg = BlockComponents.Math.Gain(k = 57.29577951308232) {"Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 350, "y2": 450}}}}
  r_deg = BlockComponents.Math.Gain(k = 57.29577951308232) {"Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 550, "y2": 650}}}}
  nz = BlockComponents.Math.Gain(k = -1.0 / (mass * g)) {"Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 750, "y2": 850}}}}
relations
  connect(p_rad, p_deg.u) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(q_rad, q_deg.u) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(r_rad, r_deg.u) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(fz_body, nz.u) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(p_deg.y, pdeg) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(q_deg.y, qdeg) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(r_deg.y, rdeg) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
  connect(nz.y, nz_g) { "Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}} }
metadata {"Dyad": {"icons": {"default": "dyad://HL20Demo/veh_outputs.svg"}}}
end
