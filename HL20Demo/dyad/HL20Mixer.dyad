"""
HL-20 control-surface mixer (TM-107580 PLSURF, subsonic). Limits the
commanded elevator/aileron/rudder/speedbrake commands, shapes the speedbrake
into upper and lower body-flap commands, adds the body-flap aileron split and
the elevator assist, then drives each of the seven surfaces through a
first-order actuator, slew-rate limiter and position limiter.
"""
component HL20Mixer
  DECMD = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 100, "x2": 50, "y2": 200}, "diagram": {"x1": -50, "x2": 50, "y1": 1750, "y2": 1850}}}}
  DACMD = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 300, "x2": 50, "y2": 400}, "diagram": {"x1": -50, "x2": 50, "y1": 400, "y2": 500}}}}
  DRCMD = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 500, "x2": 50, "y2": 600}, "diagram": {"x1": -50, "x2": 50, "y1": 150, "y2": 250}}}}
  DSBCMD = RealInput() {"Dyad": {"placement": {"icon": {"x1": -50, "y1": 700, "x2": 50, "y2": 800}, "diagram": {"x1": -50, "x2": 50, "y1": 1320, "y2": 1420}}}}
  DLE = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 0, "x2": 1050, "y2": 100}, "diagram": {"x1": 3950, "x2": 4050, "y1": 2550, "y2": 2650}}}}
  DRE = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 100, "x2": 1050, "y2": 200}, "diagram": {"x1": 3950, "x2": 4050, "y1": 2850, "y2": 2950}}}}
  DUL = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 200, "x2": 1050, "y2": 300}, "diagram": {"x1": 3950, "x2": 4050, "y1": 650, "y2": 750}}}}
  DUR = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 300, "x2": 1050, "y2": 400}, "diagram": {"x1": 3950, "x2": 4050, "y1": 950, "y2": 1050}}}}
  DLL = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 400, "x2": 1050, "y2": 500}, "diagram": {"x1": 3950, "x2": 4050, "y1": 1250, "y2": 1350}}}}
  DLR = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 500, "x2": 1050, "y2": 600}, "diagram": {"x1": 3950, "x2": 4050, "y1": 1550, "y2": 1650}}}}
  DR = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 600, "x2": 1050, "y2": 700}, "diagram": {"x1": 3950, "x2": 4050, "y1": 150, "y2": 250}}}}
  DLEDEG = RealOutput() {"Dyad": {"placement": {"icon": {"x1": 950, "y1": 800, "x2": 1050, "y2": 900}, "diagram": {"x1": 3950, "x2": 4050, "y1": 2700, "y2": 2800}}}}
  parameter DBFMAX::Real = 60.0
  parameter DLE0::Real = 5.5
  parameter DRE0::Real = 5.5
  parameter DUL0::Real = -6.42
  parameter DUR0::Real = -6.42
  parameter DLL0::Real = 16.42
  parameter DLR0::Real = 16.42
  parameter DR0::Real = 0.0
  dec_l = BlockComponents.Nonlinear.Limiter(y_min = -30.0, y_max = 30.0) {"Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 1750, "y2": 1850}}}}
  dac_l = BlockComponents.Nonlinear.Limiter(y_min = -30.0, y_max = 30.0) {"Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 400, "y2": 500}}}}
  drc_l = BlockComponents.Nonlinear.Limiter(y_min = -30.0, y_max = 30.0) {"Dyad": {"placement": {"diagram": {"x1": 550, "x2": 650, "y1": 150, "y2": 250}}}}
  dac_abs = BlockComponents.Math.Abs() {"Dyad": {"placement": {"diagram": {"x1": 1200, "x2": 1300, "y1": 300, "y2": 400}}}}
  dbfmax = BlockComponents.Sources.Constant(k = DBFMAX) {"Dyad": {"placement": {"diagram": {"x1": 1050, "x2": 1150, "y1": 1250, "y2": 1350}}}}
  sbauth = BlockComponents.Math.Add(k2 = -1.0) {"Dyad": {"placement": {"diagram": {"x1": 1550, "x2": 1650, "y1": 1100, "y2": 1200}}}}
  dsb_l = AdjustableUpperLimit(u_min = 0.001) {"Dyad": {"placement": {"diagram": {"x1": 2050, "x2": 2150, "y1": 1350, "y2": 1450}}}}
  sb_low = BlockComponents.Math.Gain(k = -0.333) {"Dyad": {"placement": {"diagram": {"x1": 2300, "x2": 2400, "y1": 400, "y2": 500}}}}
  sb_hi1 = BlockComponents.Math.Gain(k = -1.0) {"Dyad": {"placement": {"diagram": {"x1": 2300, "x2": 2400, "y1": 600, "y2": 700}}}}
  sb_hi2 = BlockComponents.Sources.Constant(k = 10.0) {"Dyad": {"placement": {"diagram": {"x1": 2300, "x2": 2400, "y1": 240, "y2": 340}}}}
  sb_hi = BlockComponents.Math.Add() {"Dyad": {"placement": {"diagram": {"x1": 2700, "x2": 2800, "y1": 400, "y2": 500}}}}
  sb_sel = Switch(threshold = 15.0) {"Dyad": {"placement": {"diagram": {"x1": 2400, "x2": 2500, "y1": 780, "y2": 880}}}}
  dul_lim = BlockComponents.Nonlinear.Limiter(y_min = -100.0, y_max = 0.0) {"Dyad": {"placement": {"diagram": {"x1": 1050, "x2": 1150, "y1": 550, "y2": 650}}}}
  dll_lim = BlockComponents.Nonlinear.Limiter(y_min = 0.0, y_max = 100.0) {"Dyad": {"placement": {"diagram": {"x1": 1050, "x2": 1150, "y1": 1050, "y2": 1150}}}}
  dur_neg = BlockComponents.Math.Gain(k = -1.0) {"Dyad": {"placement": {"diagram": {"x1": 1050, "x2": 1150, "y1": 800, "y2": 900}}}}
  dur_lim = BlockComponents.Nonlinear.Limiter(y_min = -100.0, y_max = 0.0) {"Dyad": {"placement": {"diagram": {"x1": 1550, "x2": 1650, "y1": 600, "y2": 700}}}}
  dlr_lim = BlockComponents.Nonlinear.Limiter(y_min = 0.0, y_max = 100.0) {"Dyad": {"placement": {"diagram": {"x1": 1550, "x2": 1650, "y1": 1270, "y2": 1370}}}}
  duf_p15 = BlockComponents.Sources.Constant(k = 15.0) {"Dyad": {"placement": {"diagram": {"x1": 400, "x2": 500, "y1": 1900, "y2": 2000}}}}
  duf_sum = BlockComponents.Math.Add() {"Dyad": {"placement": {"diagram": {"x1": 1050, "x2": 1150, "y1": 1900, "y2": 2000}}}}
  duf_sel = Switch(threshold = -15.0) {"Dyad": {"placement": {"diagram": {"x1": 1550, "x2": 1650, "y1": 1800, "y2": 1900}}}}
  duf_zero = BlockComponents.Sources.Constant(k = 0.0) {"Dyad": {"placement": {"diagram": {"x1": 400, "x2": 500, "y1": 1500, "y2": 1600}}}}
  dlf_m15 = BlockComponents.Sources.Constant(k = -15.0) {"Dyad": {"placement": {"diagram": {"x1": 400, "x2": 500, "y1": 2200, "y2": 2300}}}}
  dlf_sum = BlockComponents.Math.Add() {"Dyad": {"placement": {"diagram": {"x1": 1050, "x2": 1150, "y1": 2030, "y2": 2130}}}}
  dlf_sel = Switch(threshold = 15.0) {"Dyad": {"placement": {"diagram": {"x1": 1550, "x2": 1650, "y1": 2130, "y2": 2230}}}}
  dlf_zero = BlockComponents.Sources.Constant(k = 0.0) {"Dyad": {"placement": {"diagram": {"x1": 800, "x2": 900, "y1": 2260, "y2": 2360}}}}
  dulc = BlockComponents.Math.Add3() {"Dyad": {"placement": {"diagram": {"x1": 2600, "x2": 2700, "y1": 650, "y2": 750}}}}
  durc = BlockComponents.Math.Add3() {"Dyad": {"placement": {"diagram": {"x1": 2600, "x2": 2700, "y1": 950, "y2": 1050}}}}
  dllc = BlockComponents.Math.Add3() {"Dyad": {"placement": {"diagram": {"x1": 2600, "x2": 2700, "y1": 1250, "y2": 1350}}}}
  dlrc = BlockComponents.Math.Add3() {"Dyad": {"placement": {"diagram": {"x1": 2600, "x2": 2700, "y1": 1550, "y2": 1650}}}}
  le_fo = BlockComponents.Continuous.FirstOrder(T = 0.05, k = 1.0) {"Dyad": {"placement": {"diagram": {"x1": 2950, "x2": 3050, "y1": 2550, "y2": 2650}}}}
  re_fo = BlockComponents.Continuous.FirstOrder(T = 0.05, k = 1.0) {"Dyad": {"placement": {"diagram": {"x1": 2950, "x2": 3050, "y1": 2850, "y2": 2950}}}}
  ul_fo = BlockComponents.Continuous.FirstOrder(T = 0.05, k = 1.0) {"Dyad": {"placement": {"diagram": {"x1": 2950, "x2": 3050, "y1": 650, "y2": 750}}}}
  ur_fo = BlockComponents.Continuous.FirstOrder(T = 0.05, k = 1.0) {"Dyad": {"placement": {"diagram": {"x1": 2950, "x2": 3050, "y1": 950, "y2": 1050}}}}
  ll_fo = BlockComponents.Continuous.FirstOrder(T = 0.05, k = 1.0) {"Dyad": {"placement": {"diagram": {"x1": 2950, "x2": 3050, "y1": 1250, "y2": 1350}}}}
  lr_fo = BlockComponents.Continuous.FirstOrder(T = 0.05, k = 1.0) {"Dyad": {"placement": {"diagram": {"x1": 2950, "x2": 3050, "y1": 1550, "y2": 1650}}}}
  dr_fo = BlockComponents.Continuous.FirstOrder(T = 0.05, k = 1.0) {"Dyad": {"placement": {"diagram": {"x1": 2950, "x2": 3050, "y1": 150, "y2": 250}}}}
  le_sr = BlockComponents.Nonlinear.SlewRateLimiter(rising = 20.0, falling = -20.0, td = 0.01) {"Dyad": {"placement": {"diagram": {"x1": 3300, "x2": 3400, "y1": 2550, "y2": 2650}}}}
  re_sr = BlockComponents.Nonlinear.SlewRateLimiter(rising = 20.0, falling = -20.0, td = 0.01) {"Dyad": {"placement": {"diagram": {"x1": 3300, "x2": 3400, "y1": 2850, "y2": 2950}}}}
  ul_sr = BlockComponents.Nonlinear.SlewRateLimiter(rising = 20.0, falling = -20.0, td = 0.01) {"Dyad": {"placement": {"diagram": {"x1": 3300, "x2": 3400, "y1": 650, "y2": 750}}}}
  ur_sr = BlockComponents.Nonlinear.SlewRateLimiter(rising = 20.0, falling = -20.0, td = 0.01) {"Dyad": {"placement": {"diagram": {"x1": 3300, "x2": 3400, "y1": 950, "y2": 1050}}}}
  ll_sr = BlockComponents.Nonlinear.SlewRateLimiter(rising = 20.0, falling = -20.0, td = 0.01) {"Dyad": {"placement": {"diagram": {"x1": 3300, "x2": 3400, "y1": 1250, "y2": 1350}}}}
  lr_sr = BlockComponents.Nonlinear.SlewRateLimiter(rising = 20.0, falling = -20.0, td = 0.01) {"Dyad": {"placement": {"diagram": {"x1": 3300, "x2": 3400, "y1": 1550, "y2": 1650}}}}
  dr_sr = BlockComponents.Nonlinear.SlewRateLimiter(rising = 20.0, falling = -20.0, td = 0.01) {"Dyad": {"placement": {"diagram": {"x1": 3300, "x2": 3400, "y1": 150, "y2": 250}}}}
  le_lim = BlockComponents.Nonlinear.Limiter(y_min = -30.0, y_max = 30.0) {"Dyad": {"placement": {"diagram": {"x1": 3650, "x2": 3750, "y1": 2550, "y2": 2650}}}}
  re_lim = BlockComponents.Nonlinear.Limiter(y_min = -30.0, y_max = 30.0) {"Dyad": {"placement": {"diagram": {"x1": 3650, "x2": 3750, "y1": 2850, "y2": 2950}}}}
  ul_lim = BlockComponents.Nonlinear.Limiter(y_min = -60.0, y_max = 0.0) {"Dyad": {"placement": {"diagram": {"x1": 3650, "x2": 3750, "y1": 650, "y2": 750}}}}
  ur_lim = BlockComponents.Nonlinear.Limiter(y_min = -60.0, y_max = 0.0) {"Dyad": {"placement": {"diagram": {"x1": 3650, "x2": 3750, "y1": 950, "y2": 1050}}}}
  ll_lim = BlockComponents.Nonlinear.Limiter(y_min = 0.0, y_max = 60.0) {"Dyad": {"placement": {"diagram": {"x1": 3650, "x2": 3750, "y1": 1250, "y2": 1350}}}}
  lr_lim = BlockComponents.Nonlinear.Limiter(y_min = 0.0, y_max = 60.0) {"Dyad": {"placement": {"diagram": {"x1": 3650, "x2": 3750, "y1": 1550, "y2": 1650}}}}
  dr_lim = BlockComponents.Nonlinear.Limiter(y_min = -30.0, y_max = 30.0) {"Dyad": {"placement": {"diagram": {"x1": 3650, "x2": 3750, "y1": 150, "y2": 250}}}}
