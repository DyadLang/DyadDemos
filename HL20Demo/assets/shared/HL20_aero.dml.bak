                  <apply>
                    <plus/>
                    <ci>CRBFLR2</ci>
                    <apply>
                      <times/>
                      <ci>ALP</ci>
                      <ci>CRBFLR3</ci>
                    </apply> <!--            a*c3    -->
                  </apply> <!--        (c2 + a*c3)   -->
                </apply> <!--        a*(c2 + a*c3)   -->
              </apply> <!--    (c1 + a*(c2 + a*c3))  -->
            </apply> <!--    a*(c1 + a*(c2 + a*c3))  -->
