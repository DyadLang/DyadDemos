  <!-- SIGNED RUDDER LAT/DIR TERMS -->
  <!--                                                                  sCYRUD -->
  <!--    signed sideforce due to rudder -->
  <variableDef name="signed_CYrudder" varID="sCYRUD" units="nd">
    <description>
      Signed sideforce coefficient due to rudder deflection.  Until
      this calculation, lat/dir terms due to rudder are based on
      absolute value of rudder deflection.  Now must correct for sign
      of rudder deflection.
    </description>
    <calculation>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
        <apply>
          <piecewise>
            <piece>
              <apply><minus/><ci>CYRUD</ci></apply>
              <apply><lt/><ci>DRUD</ci><cn>0</cn></apply>
            </piece>
            <otherwise>
              <ci>CYRUD</ci>
            </otherwise>
          </piecewise>
        </apply>
      </math>
    </calculation>
  </variableDef>

  <!--    signed roll moment due to rudder -->
  <variableDef name="signed_Clrudder" varID="sCRRUD" units="nd">
    <description>
      Signed roll moment coefficient due to rudder deflection.  Until
      this calculation, lat/dir terms due to rudder are based on
      absolute value of rudder deflection.  Now must correct for sign
      of rudder deflection.
    </description>
    <calculation>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
        <apply>
          <piecewise>
            <piece>
              <apply><minus/><ci>CRRUD</ci></apply>
              <apply><lt/><ci>DRUD</ci><cn>0</cn></apply>
            </piece>
            <otherwise>
              <ci>CRRUD</ci>
            </otherwise>
          </piecewise>
        </apply>
      </math>
    </calculation>
  </variableDef>

  <!--    signed yaw moment due to rudder -->
  <variableDef name="signed_Cnrudder" varID="sCNRUD" units="nd">
    <description>
      Signed yaw moment coefficient due to rudder deflection.  Until
      this calculation, lat/dir terms due to rudder are based on
      absolute value of rudder deflection.  Now must correct for sign
      of rudder deflection.
    </description>
    <calculation>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
        <apply>
          <piecewise>
            <piece>
              <apply><minus/><ci>CNRUD</ci></apply>
              <apply><lt/><ci>DRUD</ci><cn>0</cn></apply>
            </piece>
            <otherwise>
              <ci>CNRUD</ci>
            </otherwise>
          </piecewise>
        </apply>
      </math>
    </calculation>
  </variableDef>


  <!-- AERODYNAMIC DAMPING TERMS -->
  <!--                                                                     Cmq -->
  <!--    pitch rate damping moment buildup -->
  <variableDef name="Cmq" varID="CMQ" units="nd">
    <description>
      Pitch damping due to pitch rate
      Cmq = Cmq_0 + alpha*(Cmq_1 + alpha*(Cmq_2 + alpha*Cmq_3))
