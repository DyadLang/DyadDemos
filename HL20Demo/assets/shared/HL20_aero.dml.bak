  <!--  RIGHT WING FLAP CONTRIBUTIONS -->
  <!--                                                                     CLdwfr -->
  <!--    table outputs   -->
  <variableDef name="CLdwfr_0" varID="CLWFR0" units="nd">
    <description>
      Output of CLWFR0 function; lift contribution of right
      wing flap deflection due to alpha^0 (constant term).
    </description>
  </variableDef>

  <variableDef name="CLdwfr_1" varID="CLWFR1" units="nd">
    <description>
      Output of CLWFR1 function; lift contribution of right
      wing flap deflection due to alpha^1.
    </description>
  </variableDef>

  <variableDef name="CLdwfr_2" varID="CLWFR2" units="nd">
    <description>
