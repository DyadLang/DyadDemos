              </apply> <!--        a*(c2 + a*c3)  -->
            </apply> <!--    (c1 + a*(c2 + a*c3)) -->
          </apply> <!--    a*(c1 + a*(c2 + a*c3)) -->
        </apply> <!-- c0 + a*(c1 + a*(c2 + a*c3)) -->
      </math>
    </calculation>
  </variableDef>


  <!-- ================== -->
  <!--  Output variables  -->
  <!-- ================== -->

  <variableDef name="totalCoefficientOfLift" varID="CL" units="nd" sign="up" symbol="CL">
    <description>
      Coefficient of lift
      CL = CL0 + CLBFUL + CLBFUR + CLBFLL + CLBFLR + 
      CLWFL + CLWFR + CLRUD + CLGE + CLLG
    </description>
    <calculation>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
        <apply>
          <plus/>
          <ci>CL0</ci>
          <ci>CLBFUL</ci>
          <ci>CLBFUR</ci>
          <ci>CLBFLL</ci>
          <ci>CLBFLR</ci>
          <ci>CLWFL</ci>
          <ci>CLWFR</ci>
          <ci>CLRUD</ci>
          <ci>CLGE</ci>
          <ci>CLLG</ci>
        </apply>
      </math>
    </calculation>
    <isOutput/>
    <isStdAIAA/>
  </variableDef>


  <variableDef name="totalCoefficientOfDrag" varID="CD" units="nd" sign="aft" symbol="CD">
    <description>
      Coefficient of drag
      CD = CD0 + CDBFUL + CDBFUR + CDBFLL + CDBFLR + 
      CDWFL + CDWFR + CDRUD + CDGE + CDLG
    </description>
    <calculation>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
        <apply>
          <plus/>
          <ci>CD0</ci>
          <ci>CDBFUL</ci>
          <ci>CDBFUR</ci>
          <ci>CDBFLL</ci>
          <ci>CDBFLR</ci>
          <ci>CDWFL</ci>
          <ci>CDWFR</ci>
          <ci>CDRUD</ci>
          <ci>CDGE</ci>
          <ci>CDLG</ci>
        </apply>
      </math>
    </calculation>
    <isOutput/>
    <isStdAIAA/>
  </variableDef>

  <variableDef name="aeroBodyMomentCoefficient_Pitch" varID="CM" units="nd" sign="anu" symbol="Cm">
    <description>
      Coefficient of pitching moment
      CM = CM0 + CMBFUL + CMBFUR + CMBFLL + CMBFLR + 
      CMWFL + CMWFR + CMRUD + CMGE + CMLG +
      CMQ*QCO2V
    </description>
    <calculation>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
        <apply>
          <plus/>
          <ci>CM0</ci>
          <ci>CMBFUL</ci>
          <ci>CMBFUR</ci>
          <ci>CMBFLL</ci>
          <ci>CMBFLR</ci>
          <ci>CMWFL</ci>
          <ci>CMWFR</ci>
          <ci>CMRUD</ci>
          <ci>CMGE</ci>
          <ci>CMLG</ci>
          <apply>
            <times/>
            <ci>CMQ</ci>
            <ci>QCO2V</ci>
          </apply>
        </apply>
      </math>
    </calculation>
    <isOutput/>
    <isStdAIAA/>
  </variableDef>

  <variableDef name="aeroBodyForceCoefficient_Y" varID="CY" units="nd" sign="rt" symbol="CY">
    <description>
      Coefficient of sideforce
      CY = CYBFUL + CYBFUR + CYBFLL + CYBFLR + 
      CYWFL + CYWFR + sCYRUD + 
      (CYGE + CYLG + CYB)*BETA
    </description>
    <calculation>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
        <apply>
          <plus/>
          <ci>CYBFUL</ci>
          <ci>CYBFUR</ci>
          <ci>CYBFLL</ci>
          <ci>CYBFLR</ci>
          <ci>CYWFL</ci>
          <ci>CYWFR</ci>
          <ci>sCYRUD</ci>
          <apply>
            <times/>
            <apply>
              <plus/>
              <ci>CYGE</ci>
              <ci>CYLG</ci>
              <ci>CYB</ci>
            </apply>
            <ci>BETA</ci>
          </apply>
        </apply>
      </math>
    </calculation>
    <isOutput/>
    <isStdAIAA/>
  </variableDef>

  <variableDef name="aeroBodyMomentCoefficient_Yaw" varID="CN" units="nd" sign="anr" symbol="CN">
    <description>
      Coefficient of yawing moment
      CN = CNBFUL + CNBFUR + CNBFLL + CNBFLR + 
      CNWFL + CNWFR + sCNRUD + 
      (CNGE + CNLG + CNB)*BETA +
      CNP*PBO2V + CNR*RBO2V
    </description>
    <calculation>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
        <apply>
          <plus/>
          <ci>CNBFUL</ci>
          <ci>CNBFUR</ci>
          <ci>CNBFLL</ci>
          <ci>CNBFLR</ci>
          <ci>CNWFL</ci>
          <ci>CNWFR</ci>
          <ci>sCNRUD</ci>
          <apply>
            <times/>
            <apply>
              <plus/>
              <ci>CNGE</ci>
              <ci>CNLG</ci>
              <ci>CNB</ci>
            </apply>
            <ci>BETA</ci>
          </apply>
          <apply>
            <times/>
            <ci>CNP</ci>
            <ci>PBO2V</ci>
          </apply>
          <apply>
            <times/>
            <ci>CNR</ci>
            <ci>RBO2V</ci>
          </apply>
        </apply>
      </math>
    </calculation>
    <isOutput/>
    <isStdAIAA/>
  </variableDef>

  <variableDef name="aeroBodyMomentCoefficient_Roll" varID="CR" units="nd" sign="rwd" symbol="Cl">
    <description>
      Coefficient of rolling moment
      CR = CRBFUL + CRBFUR + CRBFLL + CRBFLR + 
      CRWFL + CRWFR + sCRRUD + 
      (CRGE + CRLG + CRB)*BETA +
      CLP*PBO2V + CLR*RBO2V
    </description>
    <calculation>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
        <apply>
          <plus/>
          <ci>CRBFUL</ci>
          <ci>CRBFUR</ci>
          <ci>CRBFLL</ci>
          <ci>CRBFLR</ci>
          <ci>CRWFL</ci>
          <ci>CRWFR</ci>
          <ci>sCRRUD</ci>
          <apply>
            <times/>
            <apply>
              <plus/>
              <ci>CRGE</ci>
              <ci>CRLG</ci>
              <ci>CRB</ci>
            </apply>
            <ci>BETA</ci>
          </apply>
          <apply>
            <times/>
            <ci>CLP</ci>
            <ci>PBO2V</ci>
          </apply>
          <apply>
            <times/>
            <ci>CLR</ci>
            <ci>RBO2V</ci>
          </apply>
        </apply>
      </math>
    </calculation>
    <isOutput/>
    <isStdAIAA/>
  </variableDef>

  <!--                          =====================                          -->
  <!-- =========================   BREAKPOINT SETS   ========================= -->
  <!--                          =====================                          -->

  <breakpointDef name="alpha limit Mach points" bpID="ALPHA_LIM_MACH_PTS" units="nd">
    <description>
      Mach number values for angle of attack upper limit function, per REF01
    </description>
    <bpVals>
      -10, 0, 1.009, 1.1, 1.6, 3.0, 20
    </bpVals>
  </breakpointDef>

  <breakpointDef name="Mach" bpID="XMACH1_PTS" units="nd">
    <description>Mach number breakpoints for all aero data tables</description>
    <bpVals> 
      0.3, 0.6, 0.8, 0.9, 0.95, 1.1, 1.2, 1.6, 2.0, 2.5, 3.0, 3.5, 4.0
    </bpVals>
  </breakpointDef>

  <breakpointDef name="Upper body flap" bpID="DBFU_PTS" units="deg">
    <description>Upper body flap deflection breakpoints for tables</description>
    <bpVals>-60., -45., -30., -15., 0.</bpVals>
  </breakpointDef>

  <breakpointDef name="Lower body flap" bpID="DBFL_PTS" units="deg">
    <description>Lower body flap deflections breakpoints for tables</description>
    <bpVals>0., 15., 30., 45., 60.</bpVals>
  </breakpointDef>

  <breakpointDef name="Wing flaps" bpID="DWF_PTS" units="deg">
    <description>Wing flap deflection breakpoints for tables</description>
    <bpVals>-30., -15., 0., 15., 30.</bpVals>
  </breakpointDef>

  <breakpointDef name="Rudder" bpID="DRUD_PTS" units="deg">
    <description>Rudder deflection breakpoints (sym) for tables</description>
    <bpVals>0., 15., 30.</bpVals>
  </breakpointDef>

  <breakpointDef name="HoB" bpID="HOB_PTS" units="nd">
    <description>
      Height-above-ground, based on height of hinge line of lower body flap,
      normalized by span
    </description> 
    <bpVals> 0.2, 0.4, 0.6, 0.8, 1., 1.5, 2., 2.5 </bpVals>
  </breakpointDef>

  <breakpointDef name="Landing gear extension" bpID="DLG_PTS" units="deg">
    <description>Landing gear extension, in degrees (0 = retracted)</description>
    <bpVals>0., 15., 30., 60., 90.</bpVals>
  </breakpointDef>


  <!--                          ============                          -->
