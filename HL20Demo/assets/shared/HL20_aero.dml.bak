  <!--    right wing flap drag buildup -->
  <variableDef name="CDdwfr" varID="CDWFR" units="nd">
    <description>
      Drag contribution of right wing flap deflection
      CDdwfr = CDdwfr_0 + alpha*(CDdwfr_1 + alpha*(CDdwfr_2 + alpha*CDdwfr_3))
