  <!--                          ==========================                          -->
  <!-- =========================   VARIABLE DEFINITIONS   ========================= -->
  <!--                          ==========================                          -->


  <!-- ================== -->
  <!--  Input variables   -->
  <!-- ================== -->

  <variableDef name="angleOfAttack" varID="ALP_UNLIM" units="deg" sign="ANU" symbol="&#x3B1;">
    <description>
      Instantaneous true angle-of-attack, in degrees (before alpha limiter)
    </description>
    <isInput/>
    <isStdAIAA/>
  </variableDef>

  <variableDef name="angleOfSideslip" varID="BETA" units="deg" sign="ANL" symbol="&#x3B2;">
    <description>
      Instantaneous true angle-of-sideslip, in degrees
    </description>
    <isInput/>
    <isStdAIAA/>
  </variableDef>

  <variableDef name="mach" varID="XMACH" units="nd" symbol="M">
    <description>
      Mach number (dimensionless)
    </description>
    <isInput/>
    <isStdAIAA/>
  </variableDef>

  <variableDef name="bodyAngularRate_Roll" varID="PB" units="rad_s" symbol="p">
    <description>
      Body axis roll rate, radians/sec (+RWD)
    </description>
    <isInput/>
    <isStdAIAA/>
  </variableDef>

  <variableDef name="bodyAngularRate_Pitch" varID="QB" units="rad_s" symbol="q">
    <description>
      Body axis pitch rate, radians/sec (+RWD)
    </description>
    <isInput/>
    <isStdAIAA/>
  </variableDef>

  <variableDef name="bodyAngularRate_Yaw" varID="RB" units="rad_s" symbol="r">
    <description>
      Body axis yaw rate, radians/sec (+RWD)
    </description>
    <isInput/>
    <isStdAIAA/>
  </variableDef>

  <variableDef name="trueAirspeed" varID="VRW" units="f_s" symbol="Vrw">
    <description>
      Velocity of vehicle w.r.t. airmass, ft/sec (always +)
    </description>
    <isInput/>
    <isStdAIAA/>
  </variableDef>

  <variableDef name="heightOfCgWrtRwy" varID="H_rwy" units="f" symbol="Hrwy">
    <description>
      Height of ref. pt. above ground, ft
    </description>
    <isInput/>
    <isStdAIAA/>
  </variableDef>

  <variableDef name="upperLeftBodyFlapDeflection" varID="DBFUL" units="deg" sign="ted" symbol="&#x3B4;bful">
    <description>
      Upper left body flap deflection, deg, +TED (so
      deflections are always zero or negative).
    </description>
    <isInput/>
  </variableDef>

  <variableDef name="upperRightBodyFlapDeflection" varID="DBFUR" units="deg" sign="ted" symbol="&#x3B4;bfur">
    <description>
      Upper right body flap deflection, deg, +TED (so deflections
      are always zero or negative).
    </description>
    <isInput/>
  </variableDef>

  <variableDef name="lowerLeftBodyFlapDeflection" varID="DBFLL" units="deg" sign="ted" symbol="&#x3B4;bfll">
    <description>
      Lower left body flap deflection, deg, +TED (so deflections are
      always zero or positive).
    </description>
    <isInput/>
  </variableDef>

  <variableDef name="lowerRightBodyFlapDeflection" varID="DBFLR" units="deg" sign="ted" symbol="&#x3B4;bflr">
    <description>
      Lower right body flap deflection, deg, +TED (so deflections are
      always zero or positive).
    </description>
    <isInput/>
  </variableDef>

  <variableDef name="leftWingFlapDeflection" varID="DWFL" units="deg" sign="ted" symbol="&#x3B4;wfl">
    <description>
      Left wing flap deflection, deg, +TED
    </description>
    <isInput/>
  </variableDef>

  <variableDef name="rightWingFlapDeflection" varID="DWFR" units="deg" sign="ted" symbol="&#x3B4;wfr">
    <description>
      Right wing flap deflection, deg, +TED
    </description>
    <isInput/>
  </variableDef>

  <variableDef name="rudderDeflection" varID="DRUD" units="deg" sign="tel" symbol="&#x3B4;r">
    <description>
      Rudder deflection, deg, +TE left
    </description>
    <isInput/>
  </variableDef>

  <variableDef name="landingGearExtension" varID="DLG" units="deg" sign="ext"  symbol="&#x3B4;lg">
    <description>
      Landing gear extension angle, deg (0 = retracted, 90 = down)
    </description>
    <isInput/>
  </variableDef>


  <!-- ================== -->
  <!--      Constants     -->
  <!-- ================== -->

  <variableDef name="referenceWingChord" varID="CBAR" units="f" initialValue="28.24">
    <description>
      Body length of HL-20, used as reference longitudinal length
    </description>
    <isOutput/>
    <isStdAIAA/>
  </variableDef>

  <variableDef name="referenceWingSpan" varID="BSPAN" units="f" symbol="b" initialValue="13.89">
    <description>
      Width of HL-20, used as reference lateral length
    </description>
    <isOutput/>
    <isStdAIAA/>
  </variableDef>

  <variableDef name="referenceWingArea" varID="SWING" units="f2" symbol="S" initialValue="286.45">
    <description>
      Reference area of HL-20 aero model
    </description>
    <isOutput/>
    <isStdAIAA/>
  </variableDef>

  <variableDef name="vrsPositionOfMrc_X" varID="XRP" units="fracMAC" sign="aft" symbol="xrp"
               initialValue="0.54">
    <description>
      Longitudinal location of ref pt, fraction (0-1) of body length (+AFT)
    </description>
    <isOutput/>
    <isStdAIAA/>
  </variableDef>

  <!-- Aerodynamic damping term constants -->

  <variableDef name="Cmq_0" varID="CMQ0" units="nd" initialValue="-0.22364E+00">
    <description>
      Aerodynamic pitch damping due to pitch rate due to alpha^0
      (constant term).
    </description>
  </variableDef>

  <variableDef name="Cmq_1" varID="CMQ1" units="nd" initialValue=" 0.20457E-01">
    <description>
      Aerodynamic pitch damping due to pitch rate due to alpha^1.
    </description>
  </variableDef>

  <variableDef name="Cmq_2" varID="CMQ2" units="nd" initialValue="-0.16741E-02">
    <description>
      Aerodynamic pitch damping due to pitch rate due to alpha^2.
    </description>
  </variableDef>

  <variableDef name="Cmq_3" varID="CMQ3" units="nd" initialValue=" 0.31618E-04">
    <description>
      Aerodynamic pitch damping due to pitch rate due to alpha^3.
    </description>
  </variableDef>


  <variableDef name="Cnp_0" varID="CNP0" units="nd" initialValue=" 0.40031E+00">
    <description>
      Aerodynamic yaw damping due to roll rate due to alpha^0
      (constant term).
    </description>
  </variableDef>

  <variableDef name="Cnp_1" varID="CNP1" units="nd" initialValue="-0.15518E-01">
    <description>
      Aerodynamic yaw damping due to roll rate due to alpha^1.
    </description>
  </variableDef>

  <variableDef name="Cnp_2" varID="CNP2" units="nd" initialValue="-0.12143E-03">
    <description>
      Aerodynamic yaw damping due to roll rate due to alpha^2.
    </description>
  </variableDef>

  <variableDef name="Cnp_3" varID="CNP3" units="nd" initialValue=" 0.18240E-04">
    <description>
      Aerodynamic yaw damping due to roll rate due to alpha^3.
    </description>
  </variableDef>


  <variableDef name="Cnr_0" varID="CNR0" units="nd" initialValue="-0.79533E+00">
    <description>
      Aerodynamic yaw damping due to yaw rate due to alpha^0
      (constant term).
    </description>
  </variableDef>

  <variableDef name="Cnr_1" varID="CNR1" units="nd" initialValue="-0.12647E-01">
    <description>
      Aerodynamic yaw damping due to yaw rate due to alpha^1.
    </description>
  </variableDef>

  <variableDef name="Cnr_2" varID="CNR2" units="nd" initialValue="0.32696E-03">
    <description>
      Aerodynamic yaw damping due to yaw rate due to alpha^2.
    </description>
  </variableDef>

  <variableDef name="Cnr_3" varID="CNR3" units="nd" initialValue="-0.65929E-05">
    <description>
      Aerodynamic yaw damping due to yaw rate due to alpha^3.
    </description>
  </variableDef>


  <variableDef name="Clp_0" varID="CLP0" units="nd" initialValue="-0.55242E+00">
    <description>
      Aerodynamic roll damping due to roll rate due to alpha^0
      (constant term).
    </description>
  </variableDef>

  <variableDef name="Clp_1" varID="CLP1" units="nd" initialValue="0.14478E-01">
    <description>
      Aerodynamic roll damping due to roll rate due to alpha^1.
    </description>
  </variableDef>

  <variableDef name="Clp_2" varID="CLP2" units="nd" initialValue="-0.11545E-02">
    <description>
      Aerodynamic roll damping due to roll rate due to alpha^2.
    </description>
  </variableDef>

  <variableDef name="Clp_3" varID="CLP3" units="nd" initialValue=" 0.17706E-04">
    <description>
      Aerodynamic roll damping due to roll rate due to alpha^3.
    </description>
  </variableDef>


  <variableDef name="Clr_0" varID="CLR0" units="nd" initialValue=" 0.44685E+00">
    <description>
      Aerodynamic roll damping due to yaw rate due to alpha^0
      (constant term).
    </description>
  </variableDef>

  <variableDef name="Clr_1" varID="CLR1" units="nd" initialValue=" 0.67411E-01">
    <description>
      Aerodynamic roll damping due to yaw rate due to alpha^1.
    </description>
  </variableDef>

  <variableDef name="Clr_2" varID="CLR2" units="nd" initialValue="-0.51866E-02">
    <description>
      Aerodynamic roll damping due to yaw rate due to alpha^2.
    </description>
  </variableDef>

  <variableDef name="Clr_3" varID="CLR3" units="nd" initialValue=" 0.12659E-03">
    <description>
      Aerodynamic roll damping due to yaw rate due to alpha^3.
    </description>
  </variableDef>


  <!-- ================== -->
  <!--  Local variables   -->
  <!-- ================== -->

  <!-- UPPER LIMIT ON ALPHA -->
  <variableDef name="Upper limit of alpha" varID="ALP_MAX_LIM" units="deg" sign="anu">
    <description>
      Output of ALPHA_MAX_LIMIT function vs Mach
    </description>
  </variableDef>

  <!-- LIMITED ALPHA -->
  <variableDef name="Limited_angle_of_attack" varID="ALP" units="deg" sign="anu">
    <description>
      Instantaneous angle of attack, limited as a function of Mach
      number, degrees.

      If unlimited alpha (ALP_UNLIM) is less than -2, output -2 (lower
      alpha limit at all Mach).  If unlimited alpha is greater than
      ALP_MAX_LIM, a function of Mach, output ALP_MAX_LIM. Otherwise,
      output current value of ALP_UNLIM.
    </description>
    <calculation>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
        <apply>
          <piecewise>
            <piece>
              <cn>-2</cn>
              <apply><lt/><ci>ALP_UNLIM</ci><cn>-2</cn></apply>
            </piece>
	    <piece>
	      <ci>ALP_MAX_LIM</ci>
	      <apply><gt/><ci>ALP_UNLIM</ci><ci>ALP_MAX_LIM</ci></apply>
	    </piece>
	    <otherwise>
	      <ci>ALP_UNLIM</ci>
	    </otherwise>
	  </piecewise>
        </apply>
      </math>
    </calculation>
  </variableDef>

  <!-- ABSOLUTE RUDDER DEFLECTION -->
  <variableDef name="abs_rud" varID="abs_rud" units="deg">
    <description>
      Absolute value of rudder deflection angle
    </description>
    <calculation>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
        <apply>
          <abs/>
          <ci>DRUD</ci>
        </apply>        <!-- abs_rud = abs(DRUD) -->
      </math>
    </calculation>
  </variableDef>

  <!-- NORMALIZED HEIGHT ABOVE GROUND -->
  <variableDef name="hob" varID="HOB" units="nd" symbol="h/b">
    <description>
      Height of ref. pt. above ground, normalized by span (width) of
      vehicle.
    </description>
    <calculation>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
        <apply>
          <divide/>
          <ci>H_rwy</ci>
          <ci>BSPAN</ci>
        </apply>        <!-- HOB = (H_rwy / BSPAN) -->
      </math>
    </calculation>
  </variableDef>

  <!-- NORMALIZED ANGULAR RATES -->

  <variableDef name="pbo2V" varID="PBO2V" units="nd" symbol="pb/2V">
    <description>
      Non-dimensionalized body roll rate w.r.t. airmass
    </description>
    <calculation>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>PB</ci>
            <ci>BSPAN</ci>
          </apply>             <!-- (PB*BSPAN) -->
          <apply>
            <times/>
            <cn>2.0</cn>
            <ci>VRW</ci>
          </apply>                        <!-- (2*VRW) -->
        </apply>       <!-- PB02V = (PB*BSPAN)/(2*VRW) -->
      </math>
    </calculation>
  </variableDef>

  <variableDef name="qco2V" varID="QCO2V" units="nd" symbol="qc/2V">
    <description>
      Non-dimensionalized body pitch rate w.r.t. airmass
    </description>
    <calculation>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>QB</ci>
            <ci>CBAR</ci>
          </apply>             <!-- (QB*CBAR) -->
          <apply>
            <times/>
            <cn>2.0</cn>
            <ci>VRW</ci>
          </apply>                       <!-- (2*VRW) -->
        </apply>       <!-- QC02V = (QB*CBAR)/(2*VRW) -->
      </math>
    </calculation>
  </variableDef>

  <variableDef name="rbo2V" varID="RBO2V" units="nd" symbol="rb/2V">
    <description>
      Non-dimensionalized body yaw rate w.r.t. airmass
    </description>
    <calculation>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
        <apply>
          <divide/>
          <apply>
            <times/>
            <ci>RB</ci>
            <ci>BSPAN</ci>
          </apply>             <!-- (RB*BSPAN) -->
          <apply>
            <times/>
            <cn>2.0</cn>
            <ci>VRW</ci>
          </apply>                        <!-- (2*VRW) -->
        </apply>       <!-- RB02V = (RB*BSPAN)/(2*VRW) -->
      </math>
    </calculation>
  </variableDef>

  <!-- PRELIMINARY BUILDUP EQUATIONS -->

  <!-- BASIC AERODYNAMICS - CLEAN VEHICLE -->
  <!--                                                                     CLo -->
  <!--    table outputs   -->
  <variableDef name="CLo_0" varID="CL0A0" units="nd">
    <description>
      Output of CL0A0 function; lift contribution of vehicle
      due to alpha^0 (constant term).
    </description>
  </variableDef>

  <variableDef name="CLo_1" varID="CL0A1" units="nd">
    <description>
      Output of CL0A1 function; lift contribution of vehicle
      due to alpha^1.
    </description>
  </variableDef>

  <variableDef name="CLo_2" varID="CL0A2" units="nd">
    <description>
      Output of CL0A2 function; lift contribution of vehicle
      due to alpha^2.
    </description>
  </variableDef>

  <variableDef name="CLo_3" varID="CL0A3" units="nd">
    <description>
      Output of CL0A3 function; lift contribution of vehicle
      due to alpha^3.
    </description>
  </variableDef>

  <!--    basic lift buildup -->
  <variableDef name="CLo" varID="CL0" units="nd">
    <description>
      Lift contribution of basic vehicle
      CLo = CLo_0 + alpha*(CLo_1 + alpha*(CLo_2 + alpha*CLo_3))
    </description>
    <calculation>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
        <apply>
          <plus/>
          <ci>CL0A0</ci>
          <apply>
            <times/>
            <ci>ALP</ci>
            <apply>
              <plus/>
              <ci>CL0A1</ci>
              <apply>
                <times/>
                <ci>ALP</ci>
                <apply>
                  <plus/>
                  <ci>CL0A2</ci>
                  <apply>
                    <times/>
                    <ci>ALP</ci>
                    <ci>CL0A3</ci>
                  </apply> <!--            a*c3   -->
                </apply> <!--        (c2 + a*c3)  -->
              </apply> <!--        a*(c2 + a*c3)  -->
            </apply> <!--    (c1 + a*(c2 + a*c3)) -->
          </apply> <!--    a*(c1 + a*(c2 + a*c3)) -->
        </apply> <!-- c0 + a*(c1 + a*(c2 + a*c3)) -->
      </math>
    </calculation>
  </variableDef>

