      CDdbfur = CDdbfur_0 + alpha*(CDdbfur_1 + alpha*(CDdbfur_2 + alpha*CDdbfur_3))
    </description>
    <calculation>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
        <apply>
          <plus/>
          <ci>CDBFUR0</ci>
          <apply>
            <times/>
            <ci>ALP</ci>
            <apply>
              <plus/>
              <ci>CDBFUR1</ci>
              <apply>
                <times/>
                <ci>ALP</ci>
                <apply>
                  <plus/>
                  <ci>CDBFUR2</ci>
                  <apply>
                    <times/>
                    <ci>ALP</ci>
                    <ci>CDBFUR3</ci>
                  </apply> <!--            a*c3   -->
                </apply> <!--        (c2 + a*c3)  -->
              </apply> <!--        a*(c2 + a*c3)  -->
            </apply> <!--    (c1 + a*(c2 + a*c3)) -->
          </apply> <!--    a*(c1 + a*(c2 + a*c3)) -->
        </apply> <!-- c0 + a*(c1 + a*(c2 + a*c3)) -->
      </math>
    </calculation>
  </variableDef>

