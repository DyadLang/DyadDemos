      wing flap deflection due to alpha^2.
    </description>
  </variableDef>

  <variableDef name="CLdwfr_3" varID="CLWFR3" units="nd">
    <description>
      Output of CLWFR3 function; lift contribution of right
      wing flap deflection due to alpha^3.
    </description>
  </variableDef>

  <!--    right wing flap lift buildup -->
  <variableDef name="CLdwfr" varID="CLWFR" units="nd">
    <description>
      Lift contribution of right wing flap deflection
      CLdwfr = CLdwfr_0 + alpha*(CLdwfr_1 + alpha*(CLdwfr_2 + alpha*CLdwfr_3))
    </description>
    <calculation>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
        <apply>
          <plus/>
          <ci>CLWFR0</ci>
          <apply>
            <times/>
            <ci>ALP</ci>
            <apply>
              <plus/>
              <ci>CLWFR1</ci>
              <apply>
                <times/>
                <ci>ALP</ci>
                <apply>
                  <plus/>
                  <ci>CLWFR2</ci>
                  <apply>
                    <times/>
                    <ci>ALP</ci>
                    <ci>CLWFR3</ci>
                  </apply> <!--            a*c3   -->
                </apply> <!--        (c2 + a*c3)  -->
              </apply> <!--        a*(c2 + a*c3)  -->
            </apply> <!--    (c1 + a*(c2 + a*c3)) -->
          </apply> <!--    a*(c1 + a*(c2 + a*c3)) -->
        </apply> <!-- c0 + a*(c1 + a*(c2 + a*c3)) -->
      </math>
    </calculation>
  </variableDef>

  <!--                                                                     CDdwfr -->
  <!--    table outputs   -->
  <variableDef name="CDdwfr_0" varID="CDWFR0" units="nd">
