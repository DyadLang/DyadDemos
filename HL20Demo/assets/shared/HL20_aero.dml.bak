    </description>
  </variableDef>

  <!--    right wing flap sideforce buildup -->
  <variableDef name="CYdwfr" varID="CYWFR" units="nd">
    <description>
      Sideforce contribution of right wing flap deflection
      CYdwfr = CYdwfr_0 + alpha*(CYdwfr_1 + alpha*(CYdwfr_2 + alpha*CYdwfr_3))
    </description>
    <calculation>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
        <apply>
          <minus/>      <!-- right wing flap contrib. has minus sign -->
          <apply>
            <plus/>
            <ci>CYWFR0</ci>
            <apply>
              <times/>
              <ci>ALP</ci>
              <apply>
                <plus/>
                <ci>CYWFR1</ci>
                <apply>
                  <times/>
                  <ci>ALP</ci>
                  <apply>
                    <plus/>
                    <ci>CYWFR2</ci>
                    <apply>
                      <times/>
                      <ci>ALP</ci>
                      <ci>CYWFR3</ci>
                    </apply> <!--            a*c3    -->
                  </apply> <!--        (c2 + a*c3)   -->
                </apply> <!--        a*(c2 + a*c3)   -->
              </apply> <!--    (c1 + a*(c2 + a*c3))  -->
            </apply> <!--    a*(c1 + a*(c2 + a*c3))  -->
          </apply> <!-- c0 + a*(c1 + a*(c2 + a*c3))  -->
        </apply> <!-- -(c0 + a*(c1 + a*(c2 + a*c3))) -->
      </math>
    </calculation>
  </variableDef>

