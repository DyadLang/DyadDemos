                  <apply>
                    <times/>
                    <ci>ALP</ci>
                    <ci>CMQ3</ci>
                  </apply> <!--            a*c3   -->
                </apply> <!--        (c2 + a*c3)  -->
              </apply> <!--        a*(c2 + a*c3)  -->
            </apply> <!--    (c1 + a*(c2 + a*c3)) -->
          </apply> <!--    a*(c1 + a*(c2 + a*c3)) -->
