  <variableDef name="CYdbflr_0" varID="CYBFLR0" units="nd">
    <description>
      Output of CYBFLR0 function; sideforce contribution of lower
      right body flap deflection due to alpha^0 (constant term).
    </description>
  </variableDef>

  <variableDef name="CYdbflr_1" varID="CYBFLR1" units="nd">
    <description>
      Output of CYBFLR1 function; sideforce contribution of lower
      right body flap deflection due to alpha^1.
    </description>
  </variableDef>

  <variableDef name="CYdbflr_2" varID="CYBFLR2" units="nd">
    <description>
      Output of CYBFLR2 function; sideforce contribution of lower
      right body flap deflection due to alpha^2.
    </description>
  </variableDef>

  <variableDef name="CYdbflr_3" varID="CYBFLR3" units="nd">
    <description>
      Output of CYBFLR3 function; sideforce contribution of lower
      right body flap deflection due to alpha^3.
    </description>
  </variableDef>

  <!--    lower right body flap sideforce buildup -->
  <variableDef name="CYdbflr" varID="CYBFLR" units="nd">
    <description>
      Sideforce contribution of lower right body flap deflection
      CYdbflr = CYdbflr_0 + alpha*(CYdbflr_1 + alpha*(CYdbflr_2 + alpha*CYdbflr_3))
    </description>
    <calculation>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
        <apply>
          <minus/>      <!-- right body flap contrib. has minus sign -->
          <apply>
            <plus/>
            <ci>CYBFLR0</ci>
            <apply>
              <times/>
              <ci>ALP</ci>
              <apply>
                <plus/>
                <ci>CYBFLR1</ci>
                <apply>
                  <times/>
                  <ci>ALP</ci>
                  <apply>
                    <plus/>
                    <ci>CYBFLR2</ci>
                    <apply>
                      <times/>
                      <ci>ALP</ci>
                      <ci>CYBFLR3</ci>
                    </apply> <!--            a*c3    -->
                  </apply> <!--        (c2 + a*c3)   -->
                </apply> <!--        a*(c2 + a*c3)   -->
              </apply> <!--    (c1 + a*(c2 + a*c3))  -->
            </apply> <!--    a*(c1 + a*(c2 + a*c3))  -->
          </apply> <!-- c0 + a*(c1 + a*(c2 + a*c3))  -->
        </apply> <!-- -(c0 + a*(c1 + a*(c2 + a*c3))) -->
      </math>
    </calculation>
  </variableDef>

