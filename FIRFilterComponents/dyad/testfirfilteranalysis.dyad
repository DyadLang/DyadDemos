"short TestFIRFilterAnalysis analysis description"
analysis TestFIRFilterAnalysis
  extends Dyad.TransientAnalysis(stop = 2 * pi)
  model = FIRFilterComponents.TestFIRFilter()
relations
metadata {
  "Dyad": {
    "experiments": {},
    "tests": {},
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 1100,
        "rot": 0,
        "layer": "icon",
        "attrs": {}
      }
    ],
    "icons": {"default": "dyad://Dyad/Default.svg"},
    "path": {},
    "doc": {"behavior": true},
    "deprecated": null,
    "panel": {}
  }
}
end