"short FIRFilter component description"
component FIRFilter
  realinput = Dyad.RealInput() {^realinput}
  realoutput = Dyad.RealOutput() {^realoutput}
  unitdelay = DiscreteComponents.UnitDelay() {^unitdelay}
  unitdelay1 = DiscreteComponents.UnitDelay() {^unitdelay1}
  unitdelay2 = DiscreteComponents.UnitDelay() {^unitdelay2}
  unitdelay3 = DiscreteComponents.UnitDelay() {^unitdelay3}
  gain = BlockComponents.Math.Gain(k = -3 / 16) {^gain}
  gain1 = BlockComponents.Math.Gain(k = 31 / 32) {^gain1}
  gain2 = BlockComponents.Math.Gain(k = -31 / 32) {^gain2}
  gain3 = BlockComponents.Math.Gain(k = 3 / 16) {^gain3}
  add = BlockComponents.Math.Add() {^add}
  add1 = BlockComponents.Math.Add() {^add1}
  add3 = BlockComponents.Math.Add() {^add3}
relations
  connect(realinput, unitdelay.u) {^id14}
  connect(unitdelay.y, unitdelay1.u, gain1.u) {^id15}
  connect(unitdelay1.y, unitdelay2.u) {^id16}
  connect(unitdelay2.y, unitdelay3.u, gain2.u) {^id17}
  connect(unitdelay3.y, gain3.u) {^id18}
  connect(gain1.y, add.u1) {^id19}
  connect(gain.y, add.u2) {^id20}
  connect(add.y, add1.u2) {^id21}
  connect(gain2.y, add1.u1) {^id22}
  connect(gain3.y, add3.u1) {^id23}
  connect(add1.y, add3.u2) {^id24}
  connect(add3.y, realoutput) {^id25}
  connect(realinput, gain.u) {^id26}
