"short TestFIRFilter component description"
component TestFIRFilter
  firfilter = FIRFilterComponents.FIRFilter() {^firfilter}
  sine = BlockComponents.Sources.Sine(amplitude = 1.0, frequency = 1) {^sine}
  integrator = BlockComponents.Continuous.Integrator() {^integrator}
  periodicclock = DiscreteComponents.PeriodicClock(dt = 0.25) {^periodicclock}
  sampler = DiscreteComponents.Sampler() {^sampler}
relations
  connect(sine.y, integrator.u) {^id6}
  connect(integrator.y, sampler.u) {^id7}
  connect(sampler.y, periodicclock.y) {^id8}
  connect(sampler.y, firfilter.realinput) {^id9}
