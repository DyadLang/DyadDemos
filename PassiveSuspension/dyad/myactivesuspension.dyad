component MyActiveSuspension
  wheel = DyadExampleComponents.MassSpringDamper(m = wheel_mass, d = wheel_damping, c = wheel_stiffness, g = -10, theta = pi / 2) {
    "Dyad": {"placement": {"diagram": {"x1": 350, "x2": 450, "y1": 600, "y2": 700}}}
  }
  car_and_suspension = DyadExampleComponents.MassSpringDamper(m = car_mass, d = suspension_damping, c = suspension_stiffness, g = -10, theta = pi / 2) {
    "Dyad": {"placement": {"diagram": {"x1": 150, "x2": 250, "y1": 600, "y2": 700}}}
  }
  seat = DyadExampleComponents.MassSpringDamper(m = human_and_seat_mass, d = seat_damping, c = seat_stiffness, g = -10, theta = pi / 2) {
    "Dyad": {"placement": {"diagram": {"x1": 350, "x2": 450, "y1": 400, "y2": 500}}}
  }
  road_data = DyadExampleComponents.RoadData() {
    "Dyad": {"placement": {"diagram": {"x1": 150, "y1": 750, "x2": 250, "y2": 850}}}
  }
  road = DyadExampleComponents.SimplePosition() {
    "Dyad": {"placement": {"diagram": {"x1": 350, "y1": 750, "x2": 450, "y2": 850}}}
  }
  force = TranslationalComponents.Sources.Force() {
    "Dyad": {"placement": {"diagram": {"x1": 150, "x2": 250, "y1": 400, "y2": 500}}}
  }
  pid = BlockComponents.Continuous.LimPID(k = Kp, Ti = Ti, Td = Td) {
    "Dyad": {"placement": {"diagram": {"x1": 550, "y1": 250, "x2": 650, "y2": 350}}}
  }
  set_point = BlockComponents.Sources.Constant(k = 1.5) {
    "Dyad": {"placement": {"diagram": {"x1": 350, "y1": 100, "x2": 450, "y2": 200}}}
  }
  seat_pos = TranslationalComponents.Sensors.PositionSensor() {
    "Dyad": {"placement": {"diagram": {"x1": 350, "x2": 450, "y1": 273, "y2": 373}}}
  }
  parameter wheel_mass::Dyad.Mass = 25
  parameter wheel_stiffness::Dyad.TranslationalSpringConstant = 1e2
  parameter wheel_damping::Dyad.DampingCoefficient = 1e4
  parameter car_mass::Dyad.Mass = 1000
  parameter suspension_stiffness::Dyad.TranslationalSpringConstant = 1e4
  parameter suspension_damping::Dyad.DampingCoefficient = 10
  parameter human_and_seat_mass::Dyad.Mass = 100
  parameter seat_stiffness::Dyad.TranslationalSpringConstant = 1000
  parameter seat_damping::Dyad.DampingCoefficient = 1
  parameter wheel_initial_position::Dyad.Position = 0.5
  parameter suspension_initial_position::Dyad.Position = 1
  parameter seat_initial_position::Dyad.Position = 1.5
  parameter Kp::Real = 20
  parameter Ti::Real = 5
  parameter Td::Real = 1
relations
  initial wheel.mass.s = wheel_initial_position
  initial car_and_suspension.mass.s = suspension_initial_position
  initial seat.mass.s = seat_initial_position
  initial wheel.mass.v = 0
  initial car_and_suspension.mass.v = 0
  initial seat.mass.v = 0
  initial wheel.mass.a = 0
  initial car_and_suspension.mass.a = 0
  initial seat.mass.a = 0
  u: analysis_point(pid.y, force.f)
  y: analysis_point(seat_pos.s, pid.u_m)
  pid.u_ff = 0
  connect(wheel.flange_sd, road.flange) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 500, "y": 650}, {"x": 500, "y": 800}], "E": 2}],
      "path": {}
    }
  }
  connect(car_and_suspension.flange_sd, wheel.flange_m) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(car_and_suspension.flange_m, seat.flange_sd, force.flange_a) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [{"x": 100, "y": 650}], "E": -1},
        {"S": 2, "M": [{"x": 500, "y": 450}, {"x": 500, "y": 550}], "E": -1},
        {"S": 3, "M": [{"x": 100, "y": 450}], "E": -1}
      ],
      "junctions": [{"x": 100, "y": 550}],
      "path": {}
    }
  }
  connect(seat.flange_m, force.flange_b, seat_pos.flange) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [], "E": -1},
        {"S": 2, "M": [], "E": -1},
        {"S": 3, "M": [{"x": 300, "y": 323}], "E": -1}
      ],
      "junctions": [{"x": 300, "y": 450}],
      "path": {}
    }
  }
  connect(pid.y, force.f) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 700, "y": 300}, {"x": 700, "y": 50}, {"x": 200, "y": 50}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(pid.u_s, set_point.y) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 500, "y": 277}, {"x": 500, "y": 150}], "E": 2}],
      "path": {}
    }
  }
  connect(seat_pos.s, pid.u_m) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(road_data.y, road.s) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
metadata {
  "Dyad": {
    "icons": {"default": "dyad://PassiveSuspension/MyActiveSuspension.svg"},
    "tests": {
      "case1": {
        "stop": 10,
        "atol": {
          "wheel.mass.s": 0.001,
          "seat.mass.s": 0.001,
          "car_and_suspension.mass.s": 0.001,
          "wheel.mass.v": 0.001,
          "car_and_suspension.mass.v": 0.001,
          "seat.mass.v": 0.001,
          "pid.y": 0.001
        },
        "expect": {
          "signals": [
            "wheel.mass.s",
            "seat.mass.s",
            "car_and_suspension.mass.s",
            "wheel.mass.v",
            "car_and_suspension.mass.v",
            "seat.mass.v",
            "pid.y"
          ]
        }
      }
    }
  }
}
end

analysis ActiveSuspensionTransient
  extends TransientAnalysis(stop = 10, dtmax = 0.01)
  model = MyActiveSuspension()
relations
end