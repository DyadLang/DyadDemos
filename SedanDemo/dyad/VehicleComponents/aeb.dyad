"""
Accelerator robot for track tests: passes the throttle command through, and
releases the accelerator once the speed has dropped `dv_release` below the test
speed after the vehicle has passed `x_armed`.

Before `x_armed` the throttle always passes, so the vehicle can accelerate to
the test speed. The release is a ramp over the last `dv_ramp` of the drop, so
the throttle is exactly zero at and below the release speed.
"""
component ThrottleRobot
  "Throttle command from the speed controller, 0..1"
  throttle_in = RealInput() {^throttle_in}
  "Vehicle longitudinal speed [m/s]"
  v = RealInput() {^v}
  "Vehicle chassis x position [m]"
  x = RealInput() {^x}
  "Throttle command, 0..1"
  throttle = RealOutput() {^throttle}
  "Test speed"
  parameter v_test::Velocity = 10
  "Speed drop below the test speed that releases the accelerator"
  parameter dv_release::Velocity = 5 / 3.6
  "Width of the release ramp above the release speed"
  parameter dv_ramp::Velocity = 0.05
  "x position after which the release is armed"
  parameter x_armed::Length = 0
  "1 while the accelerator may be pressed, else 0"
  variable gate::Real
relations
  gate = max(ifelse(x < x_armed, 1.0, 0.0), min(1, max(0, (v - (v_test - dv_release)) / dv_ramp)))
  throttle = throttle_in * gate
metadata {
  "Dyad": {
    "icons": {"default": "dyad://SedanDemo/ThrottleRobot.svg"},
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 200,
        "rot": 0,
        "attrs": {"font-size": "160"}
      }
    ]
  },
  "_links": {
    "throttle_in": {
      "Dyad": {
        "placement": {
          "icon": {"iconName": "default", "x1": -100, "y1": 450, "x2": 0, "y2": 550, "rot": 0},
          "diagram": {"iconName": "default", "x1": -100, "y1": 450, "x2": 0, "y2": 550, "rot": 0}
