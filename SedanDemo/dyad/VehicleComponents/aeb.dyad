"""
Autonomous emergency braking (AEB) on the deceleration required to stop short
of an in-path target.

The required deceleration to stop with `d_stop` left to the target is

    a_req = closing_speed^2 / (2 * max(gap - d_stop, d_min))

The brake request rises linearly from 0 at `a_on` to 1 at `a_full`. A
first-order lag with time constant `tau` models the brake pressure build-up.
The throttle passes through until the applied brake command reaches `b_cut`,
and is cut fully above it. The function has no discrete state and no events.
"""
component AEBController
  "Gap to the target [m]"
  gap = RealInput() {^gap}
  "Closing speed toward the target [m/s]"
  closing_speed = RealInput() {^closing_speed}
  "1 while the target is in path, else 0"
  in_path = RealInput() {^in_path}
  "Driver throttle command, 0..1"
  throttle_in = RealInput() {^throttle_in}
  "Throttle command to the vehicle, 0..1"
  throttle = RealOutput() {^throttle}
  "Brake command to the vehicle, 0..1"
  braking = RealOutput() {^braking}
  "Required deceleration at which braking starts"
  parameter a_on::Acceleration = 5
  "Required deceleration for a full brake request"
  parameter a_full::Acceleration = 8
  "Gap left to the target at standstill"
  parameter d_stop::Length = 1.0
  "Smallest stopping distance used in the required deceleration"
  parameter d_min::Length = 0.05
  "Brake build-up time constant"
  parameter tau::Time = 0.15
  "Applied brake command above which the throttle is cut"
  parameter b_cut::Real = 0.02
  "Deceleration required to stop with d_stop left"
  variable a_req::Real
  "Brake request before the build-up lag"
  variable request::Real
  "Applied brake command"
  variable b::Real(initial = 0)
relations
  a_req = max(closing_speed, 0)^2 / (2 * max(gap - d_stop, d_min))
  request = in_path * min(1, max(0, (a_req - a_on) / (a_full - a_on)))
  der(b) = (request - b) / tau
  braking = b
  throttle = throttle_in * min(1, max(0, 1 - b / b_cut))
metadata {
  "Dyad": {
    "icons": {"default": "dyad://SedanDemo/AEBController.svg"},
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 200,
        "rot": 0,
        "attrs": {"font-size": "160"}
      }
    ]
  },
  "_links": {
