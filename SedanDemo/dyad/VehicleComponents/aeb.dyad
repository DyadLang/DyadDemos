"""
Stationary target vehicle whose rear faces a vehicle approaching along +x.

The outputs give the target's rear plane and lateral span in the world ground
plane (x along the test path, z to the right, y up).
"""
component StationaryTarget
  "x position of the target's rear plane [m]"
  x_rear = RealOutput() {^x_rear}
  "z position of the target's rear-center point [m]"
  z_center = RealOutput() {^z_center}
  "Target width [m]"
  width = RealOutput() {^width}
  "x position of the rear plane"
  parameter x::Length = 100
  "z position of the rear-center point"
  parameter z::Length = 0
  "Target width, excluding mirrors"
  parameter w::Length = 1.712
relations
  x_rear = x
  z_center = z
  width = w
metadata {
  "Dyad": {
    "icons": {"default": "dyad://SedanDemo/StationaryTarget.svg"},
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 200,
        "rot": 0,
        "attrs": {"font-size": "160"}
      }
    ]
  },
  "_links": {
    "x_rear": {
      "Dyad": {
        "placement": {
          "icon": {"iconName": "default", "x1": 1000, "y1": 250, "x2": 1100, "y2": 350, "rot": 0},
          "diagram": {"iconName": "default", "x1": 1000, "y1": 250, "x2": 1100, "y2": 350, "rot": 0}
        }
      }
    },
    "z_center": {
      "Dyad": {
        "placement": {
          "icon": {"iconName": "default", "x1": 1000, "y1": 450, "x2": 1100, "y2": 550, "rot": 0},
          "diagram": {"iconName": "default", "x1": 1000, "y1": 450, "x2": 1100, "y2": 550, "rot": 0}
        }
      }
    },
    "width": {
      "Dyad": {
        "placement": {
          "icon": {"iconName": "default", "x1": 1000, "y1": 650, "x2": 1100, "y2": 750, "rot": 0},
          "diagram": {"iconName": "default", "x1": 1000, "y1": 650, "x2": 1100, "y2": 750, "rot": 0}
        }
      }
    }
  }
}
end

"""
Ideal forward range sensor for a stationary target.

Measures the gap along x to the target's rear plane and the closing speed, with
no noise, delay or field-of-view limit. The bumper is a straight edge of width
`w` that turns with the yaw, which must stay within ±90°. The gap runs from the
farthest-forward point of the part of the bumper inside the target's lateral
span, and the target is in path while that part has nonzero length. With the
target out of path, the gap runs from the bumper end nearest the target's span.
"""
component IdealRangeSensor
  "Vehicle chassis x position [m]"
  x = RealInput() {^x}
  "Vehicle chassis z position [m]"
  z = RealInput() {^z}
  "Vehicle yaw angle about the world y axis [rad]"
  yaw = RealInput() {^yaw}
  "Vehicle longitudinal speed [m/s]"
  v = RealInput() {^v}
  "Target rear-plane x position [m]"
  target_x = RealInput() {^target_x}
  "Target rear-center z position [m]"
  target_z = RealInput() {^target_z}
  "Target width [m]"
  target_width = RealInput() {^target_width}
  "Gap from the front bumper's leading point inside the target's lateral span to the target's rear plane [m]"
  gap = RealOutput() {^gap}
  "Closing speed toward the target [m/s]"
  closing_speed = RealOutput() {^closing_speed}
  "1 while the target overlaps the front bumper laterally, else 0"
  in_path = RealOutput() {^in_path}
  "Front bumper ahead of the chassis frame origin"
  parameter l_front::Length = 2.412
  "Vehicle width"
  parameter w::Length = 1.849
  "Front bumper center x position"
  variable x_front::Real
  "Front bumper center z position"
  variable z_front::Real
  "Lower end, as the position s along the bumper, of the part inside the target's lateral span"
  variable s_lo::Real
  "Upper end, as the position s along the bumper, of the part inside the target's lateral span"
  variable s_hi::Real
relations
  # Heading: a rotation by yaw about +y maps +x to (cos, -sin) and +z to (sin, cos) in (x, z)
  x_front = x + l_front * cos(yaw)
  z_front = z - l_front * sin(yaw)
  assert(cos(yaw) > 0, "IdealRangeSensor needs the yaw within ±90°; the bumper faces away from the target")
  # Bumper points sit at s(sin, cos) from its center for s in [-w/2, w/2]
  s_lo = max(-w / 2, min(w / 2, (target_z - target_width / 2 - z_front) / cos(yaw)))
  s_hi = max(-w / 2, min(w / 2, (target_z + target_width / 2 - z_front) / cos(yaw)))
  gap = target_x - x_front - max(s_lo * sin(yaw), s_hi * sin(yaw))
  closing_speed = v * cos(yaw)
  in_path = ifelse(s_lo < s_hi, 1.0, 0.0)
metadata {
  "Dyad": {
    "icons": {"default": "dyad://SedanDemo/IdealRangeSensor.svg"},
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 200,
