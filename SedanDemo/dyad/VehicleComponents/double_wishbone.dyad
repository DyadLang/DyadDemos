"""
Double-wishbone suspension linkage for one corner of a vehicle.

Two triangular control arms (upper and lower) hinge on the chassis and carry
the upright between them through ball joints; a fixed-length tie rod constrains
the upright's steering rotation. The linkage has a single vertical-travel
degree of freedom (plus the kingpin rotation commanded through the tie rod when
`steered = true`). A coil-over spring-damper acts between the chassis and the
lower control arm.

All geometry is parameterized by hardpoints expressed in a chassis-fixed
suspension frame using ISO vehicle-dynamics axes (x forward, y left, z up),
given for the left side of the vehicle; positions and inertia tensors are
converted internally to the world convention used by this library (x forward,
y up, z right). Set `mirror = true` for a left corner, `mirror = false` (the
default) mirrors the hardpoints in y for a right corner.

With `closed_form = true` (the default) the kinematic loops are closed
analytically by a `DoubleWishboneJoint` assembly: the upper-arm angle and the
upright orientation are explicit functions of the lower-arm angle and the
tie-rod inner end, so no nonlinear loop-closure equations remain. With
`closed_form = false` the loops are closed at position level only: the upper
ball joint is a stateless `SphericalConstraint` and the tie rod a
`SphericalSpherical` distance constraint, while the upright's orientation is
carried by the lower ball joint (`Spherical` with Euler states), solved by
Newton iteration. The lower control arm hinge holds the travel coordinate (high
state priority).

Connectors:
- `chassis_frame`: rigid attachment on the chassis at the suspension-frame origin
- `wheel_frame`: upright-fixed frame at the wheel center; its z-axis is the
  wheel spin axis (pointing right on both sides of the vehicle)
- `steer_frame` (only when `steered = true`): the tie rod's inner end point.
  Attach it to the steering mechanism at the location that coincides with the
  `tierod_chassis` hardpoint when the steering input is zero. When
  `steered = false` the tie rod is anchored to the chassis internally.
"""
component DoubleWishboneSuspension
  "Rigid attachment on the chassis (suspension-frame origin)"
  chassis_frame = Frame3D() {^chassis_frame}
  "Upright-fixed frame at the wheel center, z along the spin axis"
  wheel_frame = Frame3D() {^wheel_frame}
  "Tie-rod inner end; connect to the steering mechanism"
  steer_frame = Frame3D() if steered {^steer_frame}
  # Lower control arm: chassis hinge (travel DOF), arm body, ball point, spring point
  lca_mount = MultibodyComponents.FixedTranslation(r = r_lca_mid, render = false) {^lca_mount}
  lca_rev = MultibodyComponents.Revolute(n = n_lca, statePriority = 100, render = render, phi(initial = lca_phi0), w(initial = 0)) {^lca_rev}
  lca_body = MultibodyComponents.Body(m = lca_m, r_cm = r_lca_com, I_11 = lca_inertia[1], I_22 = lca_inertia[3], I_33 = lca_inertia[2], render = false) {^lca_body}
  lca_arm = MultibodyComponents.FixedTranslation(r = r_lca_ball, render = render) {^lca_arm}
  lca_spring_arm = MultibodyComponents.FixedTranslation(r = r_lca_spring, render = render) {^lca_spring_arm}
  # Upper control arm: chassis hinge, arm body, ball point
  uca_mount = MultibodyComponents.FixedTranslation(r = r_uca_mid, render = false) {^uca_mount}
  uca_rev = MultibodyComponents.Revolute(n = n_uca, render = render) if !closed_form {^uca_rev}
  uca_body = MultibodyComponents.Body(m = uca_m, r_cm = r_uca_com, I_11 = uca_inertia[1], I_22 = uca_inertia[3], I_33 = uca_inertia[2], render = false) {^uca_body}
  uca_arm = MultibodyComponents.FixedTranslation(r = r_uca_ball, render = render) if !closed_form {^uca_arm}
  # Upright: orientation-carrying lower ball joint, body, and attachment points
  # The loop fixes the ball joint's angles and their rates, so neither gets an initial value
  # (Spherical sets the rates to zero by default even with initialize_orientation = false)
  lca_ball = MultibodyComponents.Spherical(render = render, initialize_orientation = false, phid(initial = missing)) if !closed_form {^lca_ball}
  upright_body = MultibodyComponents.Body(m = upright_m, r_cm = r_upright_com, I_11 = upright_inertia[1], I_22 = upright_inertia[3], I_33 = upright_inertia[2], render = false) {^upright_body}
  upright_to_uca = MultibodyComponents.FixedTranslation(r = r_upright_uca, render = render) if !closed_form {^upright_to_uca}
  upright_to_tierod = MultibodyComponents.FixedTranslation(r = r_upright_tierod, render = render) if !closed_form {^upright_to_tierod}
  upright_to_spindle = MultibodyComponents.FixedTranslation(r = r_upright_spindle, render = render) {^upright_to_spindle}
  # Loop closures: stateless upper ball joint and tie rod distance constraint
  uca_ball = MultibodyComponents.SphericalConstraint(render = render) if !closed_form {^uca_ball}
  tierod = MultibodyComponents.SphericalSpherical(r_0 = rod_tierod, render = render) if !closed_form {^tierod}
  # Closed-form alternative: upper arm hinge, both ball joints and the tie rod in one analytic assembly
  loop = SedanDemo.VehicleComponents.DoubleWishboneJoint(n_b = n_uca, rUpper_ib = r_uca_ball, rUpper_ub = r_upright_uca, rTie_ub = r_upright_tierod, rTie_0 = rod_tierod, upper_phi_guess = uca_rev_phi0, render = render) if closed_form {^loop}
  tierod_mount = MultibodyComponents.FixedTranslation(r = r_tierod_chassis, render = false) if !steered {^tierod_mount}
  # Coil-over spring-damper between chassis and lower control arm
  spring_mount = MultibodyComponents.FixedTranslation(r = r_spring_chassis, render = false) {^spring_mount}
  springdamper = MultibodyComponents.SpringDamperParallel(c = c_spring, d = d_damper, s_unstretched = s_unstretched, render = render) {^springdamper}
  "Tie rod driven by an external steering mechanism instead of anchored to the chassis"
  structural parameter steered::Boolean = false
  "Close the wishbone and tie-rod loops analytically (DoubleWishboneJoint) instead of by position constraints"
  structural parameter closed_form::Boolean = true
  "Mirror the linkage for the left (true) or right (false) side of the vehicle"
  structural parameter mirror::Boolean = false
  "Render the linkage in animations"
  parameter render::Boolean = true
  "Initial lower-control-arm hinge angle; set to the settled value so the simulation starts at static equilibrium instead of bouncing on the tires"
  parameter lca_phi0::Angle = 0
  "Guess for the lower ball joint's Euler angles. The loop closure is nonlinear and has several roots; the default suits a start at the nominal geometry (`lca_phi0 = 0`), so set this to the assembled values whenever the linkage starts away from it"
  parameter lca_ball_phi0::Angle[3] = [1e-6, 1e-6, 1e-6]
  "Guess for the upper-control-arm hinge angle, see `lca_ball_phi0`"
  parameter uca_rev_phi0::Angle = 1e-6
  "Upper control arm front hinge point on the chassis [ISO]"
  parameter uca_front::Length[3] = [-0.100, 0.470, 0.105]
  "Upper control arm back hinge point on the chassis [ISO]"
  parameter uca_back::Length[3] = [-0.250, 0.510, 0.110]
  "Upper control arm ball-joint point on the upright [ISO]"
  parameter uca_upright::Length[3] = [-0.040, 0.695, 0.105]
  "Upper control arm center of mass [ISO]"
  parameter uca_com::Length[3] = [-0.1083, 0.5972, 0.1063]
  "Upper control arm mass"
  parameter uca_m::Mass = 1.032
  "Upper control arm moments of inertia about its COM (Ixx, Iyy, Izz) [ISO]"
  parameter uca_inertia::Inertia[3] = [0.00591, 0.00190, 0.00769]
  "Lower control arm front hinge point on the chassis [ISO]"
  parameter lca_front::Length[3] = [0.200, 0.420, -0.270]
  "Lower control arm back hinge point on the chassis [ISO]"
  parameter lca_back::Length[3] = [-0.200, 0.470, -0.265]
  "Lower control arm ball-joint point on the upright [ISO]"
  parameter lca_upright::Length[3] = [0.0, 0.770, -0.320]
  "Lower control arm center of mass [ISO]"
  parameter lca_com::Length[3] = [0.0048, 0.6112, -0.2932]
  "Lower control arm mass"
  parameter lca_m::Mass = 1.611
  "Lower control arm moments of inertia about its COM (Ixx, Iyy, Izz) [ISO]"
  parameter lca_inertia::Inertia[3] = [0.0151, 0.0207, 0.0355]
  "Upright center of mass [ISO]"
  parameter upright_com::Length[3] = [-0.0224, 0.7470, -0.1118]
  "Upright mass"
  parameter upright_m::Mass = 1.397
  "Upright moments of inertia about its COM (Ixx, Iyy, Izz) [ISO]"
  parameter upright_inertia::Inertia[3] = [0.0138, 0.0146, 0.00283]
  "Wheel center (spindle) position [ISO]"
  parameter spindle_point::Length[3] = [0.0, 0.7979, -0.1199]
  "Tie rod inner attachment point (chassis or steering rack at zero input) [ISO]"
  parameter tierod_chassis::Length[3] = [-0.200, 0.420, -0.120]
  "Tie rod outer attachment point on the upright [ISO]"
  parameter tierod_upright::Length[3] = [-0.150, 0.770, -0.120]
  "Spring/damper attachment point on the chassis [ISO]"
  parameter spring_chassis::Length[3] = [-0.040, 0.520, 0.230]
  "Spring/damper attachment point on the lower control arm [ISO]"
  parameter spring_arm::Length[3] = [0.0, 0.620, -0.270]
  "Spring stiffness"
  parameter c_spring::Real = 500000
  "Damper coefficient"
  parameter d_damper::Real = 10000
  "Unstretched spring length"
  parameter s_unstretched::Length = 0.51
  "Sign of the y-mirroring: +1 right side, -1 left side"
  final parameter dir::Real = ifelse(mirror, -1.0, 1.0)
  # Hinge midpoints and axes in ISO coordinates
  final parameter lca_mid_iso::Length[3] = (lca_front + lca_back) / 2
  final parameter uca_mid_iso::Length[3] = (uca_front + uca_back) / 2
  final parameter lca_axis_iso::Real[3] = (lca_front - lca_back) / MultibodyComponents.norm_(lca_front - lca_back)
  final parameter uca_axis_iso::Real[3] = (uca_front - uca_back) / MultibodyComponents.norm_(uca_front - uca_back)
  # World-frame (x forward, y up, z right) conversions: [x, z, dir*y]
  final parameter r_lca_mid::Length[3] = [lca_mid_iso[1], lca_mid_iso[3], dir * lca_mid_iso[2]]
  final parameter n_lca::Real[3] = [lca_axis_iso[1], lca_axis_iso[3], dir * lca_axis_iso[2]]
  final parameter r_lca_ball::Length[3] = [lca_upright[1] - lca_mid_iso[1], lca_upright[3] - lca_mid_iso[3], dir * (lca_upright[2] - lca_mid_iso[2])]
  final parameter r_lca_com::Length[3] = [lca_com[1] - lca_mid_iso[1], lca_com[3] - lca_mid_iso[3], dir * (lca_com[2] - lca_mid_iso[2])]
  final parameter r_lca_spring::Length[3] = [spring_arm[1] - lca_mid_iso[1], spring_arm[3] - lca_mid_iso[3], dir * (spring_arm[2] - lca_mid_iso[2])]
  final parameter r_uca_mid::Length[3] = [uca_mid_iso[1], uca_mid_iso[3], dir * uca_mid_iso[2]]
  final parameter n_uca::Real[3] = [uca_axis_iso[1], uca_axis_iso[3], dir * uca_axis_iso[2]]
  final parameter r_uca_ball::Length[3] = [uca_upright[1] - uca_mid_iso[1], uca_upright[3] - uca_mid_iso[3], dir * (uca_upright[2] - uca_mid_iso[2])]
  final parameter r_uca_com::Length[3] = [uca_com[1] - uca_mid_iso[1], uca_com[3] - uca_mid_iso[3], dir * (uca_com[2] - uca_mid_iso[2])]
  final parameter r_upright_uca::Length[3] = [uca_upright[1] - lca_upright[1], uca_upright[3] - lca_upright[3], dir * (uca_upright[2] - lca_upright[2])]
  final parameter r_upright_tierod::Length[3] = [tierod_upright[1] - lca_upright[1], tierod_upright[3] - lca_upright[3], dir * (tierod_upright[2] - lca_upright[2])]
  final parameter r_upright_com::Length[3] = [upright_com[1] - lca_upright[1], upright_com[3] - lca_upright[3], dir * (upright_com[2] - lca_upright[2])]
  final parameter r_upright_spindle::Length[3] = [spindle_point[1] - lca_upright[1], spindle_point[3] - lca_upright[3], dir * (spindle_point[2] - lca_upright[2])]
  final parameter r_spring_chassis::Length[3] = [spring_chassis[1], spring_chassis[3], dir * spring_chassis[2]]
  final parameter r_tierod_chassis::Length[3] = [tierod_chassis[1], tierod_chassis[3], dir * tierod_chassis[2]]
  final parameter rod_tierod::Length[3] = [tierod_upright[1] - tierod_chassis[1], tierod_upright[3] - tierod_chassis[3], dir * (tierod_upright[2] - tierod_chassis[2])]
relations
  guess lca_rev.phi = lca_phi0
  if !closed_form
    guess lca_ball.phi = lca_ball_phi0
    guess lca_ball.phid = [0, 0, 0]
    guess uca_rev.phi = uca_rev_phi0
    guess uca_rev.w = 0
    guess tierod.f_rod = 0
    guess uca_ball.frame_b.f = [0, 0, 0]
  end
  connect(lca_mount.frame_b, lca_rev.frame_a)
  if closed_form
    # Analytic loop closure: lower ball joint on the lower arm, upper arm hinge on the chassis
    connect(lca_arm.frame_b, loop.frame_a)
    connect(uca_mount.frame_b, loop.frame_b)
    connect(loop.frame_ub, upright_body.frame_a, upright_to_spindle.frame_a)
    connect(loop.frame_ib, uca_body.frame_a)
    if steered
      connect(loop.frame_c, steer_frame)
    else
      connect(chassis_frame, tierod_mount.frame_a)
      connect(tierod_mount.frame_b, loop.frame_c)
    end
  else
    connect(uca_mount.frame_b, uca_rev.frame_a)
    # Upright hangs on the lower ball joint
    connect(lca_arm.frame_b, lca_ball.frame_a)
    connect(lca_ball.frame_b, upright_body.frame_a, upright_to_uca.frame_a, upright_to_tierod.frame_a, upright_to_spindle.frame_a)
    # Upper ball joint closes the wishbone loop (position-only)
    connect(uca_arm.frame_b, uca_ball.frame_a)
    connect(uca_ball.frame_b, upright_to_uca.frame_b) {^id23}
    # Tie rod
    connect(tierod.frame_b, upright_to_tierod.frame_b) {^id24}
    if steered
      connect(tierod.frame_a, steer_frame)
    else
      connect(chassis_frame, tierod_mount.frame_a)
      connect(tierod_mount.frame_b, tierod.frame_a)
    end
    connect(uca_rev.frame_b, uca_arm.frame_a, uca_body.frame_a) {^id28}
  end
  connect(spring_mount.frame_b, springdamper.frame_a) {^id25}
  connect(springdamper.frame_b, lca_spring_arm.frame_b) {^id26}
  # Wheel mount
  connect(upright_to_spindle.frame_b, wheel_frame) {^id27}
  connect(uca_mount.frame_a, chassis_frame) {^id29}
  connect(spring_mount.frame_a, chassis_frame, lca_mount.frame_a) {^id30}
  connect(lca_spring_arm.frame_a, lca_arm.frame_a) {^id31}
  connect(lca_rev.frame_b, lca_arm.frame_a, lca_body.frame_a) {^id32}
metadata {
