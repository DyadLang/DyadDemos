"""
Rack-and-pinion steering mechanism.

A rack body slides laterally in the vehicle on a prismatic joint, positioned
kinematically from the normalized steering input:

    rack displacement = steering * max_angle * pinion_radius

so full input (+1) corresponds to the pinion angle `max_angle`. The tie rods of
the steered axle attach to `left_frame` / `right_frame`, which are rigidly
fixed on the rack at the tie-rod inner hardpoints. With the tie rods attached
behind the kingpin axis (as in the default hardpoints), positive steering
steers the wheels to the left.

The attachment hardpoint is given in ISO vehicle axes (x forward, y left, z up)
for the left side, relative to the steering-mechanism origin at zero input, and
is mirrored internally for the right side. `chassis_frame` should be attached
to the vehicle body at the steering-mechanism origin.
"""
component RackPinionSteering
  "Rigid attachment on the vehicle body (steering-mechanism origin)"
  chassis_frame = Frame3D() {^chassis_frame}
  "Left tie-rod inner attachment on the rack"
  left_frame = Frame3D() {^left_frame}
  "Right tie-rod inner attachment on the rack"
  right_frame = Frame3D() {^right_frame}
  "Normalized steering input, -1..1 (positive steers left)"
  steering = RealInput() {^steering}
  rack_prismatic = MultibodyComponents.Prismatic(n = [0, 0, 1], statePriority = 90, render = false, v(initial = 0)) {^rack_prismatic}
  actuator = TranslationalComponents.Sources.Position() {^actuator}
  "Converts the normalized steering input to the rack displacement"
  steering_gain = BlockComponents.Math.Gain(k = max_angle * pinion_radius) {^steering_gain}
  rack_body = MultibodyComponents.Body(m = rack_mass, r_cm = [0, 0, 0], I_11 = rack_inertia[1], I_22 = rack_inertia[3], I_33 = rack_inertia[2], render = false) {^rack_body}
  to_left = MultibodyComponents.FixedTranslation(r = r_left, render = render) {^to_left}
  to_right = MultibodyComponents.FixedTranslation(r = r_right, render = render) {^to_right}
  "Render the rack in animations"
  parameter render::Boolean = true
  "Pinion radius"
  parameter pinion_radius::Length = 0.3
  "Pinion angle at full steering input [rad]"
  parameter max_angle::Angle = 15.5 * π / 180
  "Rack (steering link) mass"
  parameter rack_mass::Mass = 1.889
  "Rack moments of inertia about its COM (Ixx, Iyy, Izz) [ISO]"
  parameter rack_inertia::Inertia[3] = [0.138, 0.00009, 0.138]
  "Left tie-rod inner attachment at zero input, relative to the steering origin [ISO]"
  parameter attachment::Length[3] = [-0.012, 0.420, -0.010]
  final parameter r_left::Length[3] = [attachment[1], attachment[3], -attachment[2]]
  final parameter r_right::Length[3] = [attachment[1], attachment[3], attachment[2]]
relations
  connect(steering, steering_gain.u) {^id11}
  connect(steering_gain.y, actuator.s_ref) {^id12}
  connect(actuator.flange, rack_prismatic.axis) {^id13}
  connect(actuator.support, rack_prismatic.support) {^id14}
  connect(chassis_frame, rack_prismatic.frame_a) {^id15}
  connect(to_right.frame_b, right_frame) {^id16}
  connect(to_left.frame_b, left_frame) {^id17}
  connect(to_left.frame_a, to_right.frame_a, rack_prismatic.frame_b, rack_body.frame_a) {^id18}
metadata {
