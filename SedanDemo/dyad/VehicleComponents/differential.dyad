"""
Open differential distributing drive torque equally between two axle shafts.

An ideal planetary gear set wired so the drive flange turns at the mean speed
of the two output flanges:

    2 phi_drive = phi_left + phi_right
    tau_left = tau_right = -tau_drive / 2

There is no inertia and no friction, and the differential is not lockable: the
two outputs are free to spin at different speeds under equal torque.
"""
component Differential1D
  "Drive input (ring gear), connect to the final drive"
  flange_drive = Spline() {^flange_drive}
  "Left axle shaft"
  flange_left = Spline() {^flange_left}
  "Right axle shaft"
  flange_right = Spline() {^flange_right}
  planetary = RotationalComponents.Components.IdealPlanetaryGear(ratio = -2) {^planetary}
relations
  connect(flange_drive, planetary.ring) {^id5}
  connect(flange_left, planetary.sun) {^id6}
  connect(flange_right, planetary.carrier) {^id7}
metadata {
  "Dyad": {
    "icons": {"default": "dyad://SedanDemo/Differential1D.svg"},
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 200,
        "rot": 0,
        "attrs": {"font-size": "160"}
      }
    ]
  },
  "_links": {
