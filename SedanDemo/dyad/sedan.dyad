"""
Complete rear-wheel-drive sedan: mechanical vehicle plus map-based engine and
continuously variable transmission, shaft driveline with open differential on
the rear axle, and friction brakes on all four wheels, each with a slip
limiter (ABS) that `abs_enabled` switches.

Inputs are the normalized driver commands `steering` (-1..1, positive left),
`throttle` (0..1), and `braking` (0..1). Convenience outputs report the
chassis planar pose and longitudinal speed for driver models.
"""
component Sedan
  "Normalized steering input, -1..1 (positive steers left)"
  steering = RealInput() {^steering}
  "Throttle command, 0..1"
  throttle = RealInput() {^throttle}
  "Brake command, 0..1"
  braking = RealInput() {^braking}
  "Chassis x position in the world frame [m]"
  x = RealOutput() {^x}
  "Chassis z position in the world frame [m]"
  z = RealOutput() {^z}
  "Chassis yaw angle about the world y axis [rad]"
  yaw = RealOutput() {^yaw}
  "Chassis longitudinal velocity (x of the chassis frame) [m/s]"
  v = RealOutput() {^v}
  vehicle = SedanVehicle(render = render, final mu_road = mu_road) {^vehicle}
  "Chassis position sensor, world frame"
  position_sensor = MultibodyComponents.AbsolutePosition(resolve_in_frame = MultibodyComponents.ResolveInFrame.World()) {^position_sensor}
  "Chassis velocity sensor, resolved in the chassis frame (v_x is the longitudinal speed)"
  velocity_sensor = MultibodyComponents.AbsoluteVelocity() {^velocity_sensor}
  "Chassis orientation sensor (x-y-z rotation sequence; angle_2 is the yaw)"
  angle_sensor = MultibodyComponents.AbsoluteAngles() {^angle_sensor}
  engine = SedanDemo.VehicleComponents.EngineCVTMap() {^engine}
  # The rear wheels are driven through halfshafts, so the joint-carrier
  # reaction is compensated (see HalfShaft) and the housing reaction acts on
  # the chassis; the shafts are Rotor1D rotors carried by the chassis. The
  # net drive reaction on the vehicle is then torque-balanced, and transient
  # shaft spin-up appears as a roll moment on the chassis.
  driveline = SedanDemo.VehicleComponents.Driveline2WD(final final_ratio = final_ratio, n_drive = [1, 0, 0], n_axle = [0, 0, -1]) {^driveline}
  # The engine reaction torque acts on the chassis about the driveshaft
  # axis; its axis convention must match the driveline's n_drive so the
  # static roll reactions of mount and final-drive housing cancel. The
  # driveshaft spin direction (positive about +x) is chosen to match the
  # reference vehicle, which sets which rear wheel the transient spin-up
  # roll unloads first during a traction-limited launch.
  engine_mount = MultibodyComponents.Mounting1D(n = [1, 0, 0]) {^engine_mount}
  halfshaft_l = SedanDemo.VehicleComponents.HalfShaft(n = [0, 0, -1]) {^halfshaft_l}
  halfshaft_r = SedanDemo.VehicleComponents.HalfShaft(n = [0, 0, -1]) {^halfshaft_r}
  # r is the TMeasy wheel radius of SedanCorner.
  brake_fl = SedanDemo.VehicleComponents.ABSBrake(r = 0.3266, abs_enabled = abs_enabled) {^brake_fl}
  brake_fr = SedanDemo.VehicleComponents.ABSBrake(r = 0.3266, abs_enabled = abs_enabled) {^brake_fr}
  brake_rl = SedanDemo.VehicleComponents.ABSBrake(r = 0.3266, abs_enabled = abs_enabled) {^brake_rl}
  brake_rr = SedanDemo.VehicleComponents.ABSBrake(r = 0.3266, abs_enabled = abs_enabled) {^brake_rr}
  "Render the vehicle in animations; when false the mesh visualizers are left out of the model"
  structural parameter render::Boolean = true
  "Final drive speed ratio, axle/driveshaft"
  parameter final_ratio::Real = 0.2
  "Road friction coefficient, the same under all four tires"
  parameter mu_road::Real = 0.9
  "Enable the brakes' slip limiters (ABS); off matches the reference vehicle"
  structural parameter abs_enabled::Boolean = false
relations
  connect(engine.driveshaft, driveline.flange_transmission) {^id21}
  connect(halfshaft_l.frame_a, vehicle.carrier_rl) {^id22}
  connect(driveline.flange_right, halfshaft_r.flange_a) {^id23}
  connect(halfshaft_r.flange_b, vehicle.axis_rr) {^id24}
  connect(halfshaft_r.frame_a, vehicle.carrier_rr) {^id25}
  connect(driveline.frame_a, vehicle.chassis_frame) {^id26}
  connect(engine.support, engine_mount.flange_b) {^id27}
  connect(engine_mount.frame_a, vehicle.chassis_frame) {^id28}
  connect(brake_fl.spline_a, vehicle.axis_fl) {^id29}
  connect(brake_fl.spline_b, vehicle.support_fl) {^id30}
  connect(brake_fr.spline_a, vehicle.axis_fr) {^id31}
  connect(brake_fr.spline_b, vehicle.support_fr) {^id32}
  connect(brake_rl.spline_a, vehicle.axis_rl, halfshaft_l.flange_b) {^id33}
  connect(brake_rr.spline_a, vehicle.axis_rr) {^id34}
  connect(brake_rr.spline_b, vehicle.support_rr) {^id35}
  connect(steering, vehicle.steering) {^id36}
  connect(throttle, engine.throttle) {^id37}
  connect(brake_rr.braking, brake_fr.braking, braking, brake_fl.braking, brake_rl.braking) {^id38}
  connect(vehicle.chassis_frame, velocity_sensor.frame_a, angle_sensor.frame_a, position_sensor.frame_a) {^id39}
  connect(x, position_sensor.r_x) {^id40}
  connect(z, position_sensor.r_z) {^id41}
  connect(yaw, angle_sensor.angle_2) {^id42}
  connect(v, velocity_sensor.v_x) {^id43}
  connect(velocity_sensor.v_x, brake_fl.v, brake_fr.v, brake_rl.v, brake_rr.v)
  connect(driveline.flange_left, halfshaft_l.flange_a) {^id44}
  connect(brake_rl.spline_b, vehicle.support_rl) {^id45}
