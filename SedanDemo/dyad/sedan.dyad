"""
One corner of the sedan: double-wishbone linkage, wheel spin joint, spindle,
and a load-sensitive TMeasy tire with elastic normal contact.

The tire uses the passenger-car TMeasy parameter pattern at the nominal load
`pn` = 3580.65 N (derived from load index 97: half the 730 kg maximum load),
with the vertical stiffness and damping of the 245/40 R18 tire it represents
and road friction 0.9. A magic-formula alternative fitted from the Pac02
property file shipped with this model is retained in `scripts/fit_tire.jl`.

Drive and brake torque attach to the `axis` flange, with `support` fixed in
the upright; positive `axis` speed rolls the wheel forward on both sides of
the vehicle.
"""
component SedanCorner
  "Rigid attachment on the chassis at the suspension-frame origin"
  chassis_frame = Frame3D() {^chassis_frame}
  "Tie-rod inner end (only on steered corners)"
  steer_frame = Frame3D() if steered {^steer_frame}
  "Wheel spin flange for drive/brake torque"
  axis = Spline() {^axis}
  "Spin-joint support flange, fixed in the upright"
  support = Spline() {^support}
  "Upright-fixed frame at the wheel center (the spin-joint carrier)"
  carrier = Frame3D() {^carrier}
  suspension = SedanDemo.VehicleComponents.DoubleWishboneSuspension(mirror = mirror, steered = steered, render = render, lca_phi0 = lca_phi0, lca_ball_phi0 = lca_ball_phi0, uca_rev_phi0 = uca_rev_phi0) {^suspension}
  wheel_rotation = MultibodyComponents.Revolute(n = [0, 0, -1], n_nonzero = [false, false, true], statePriority = 100, render = false, phi(initial = 0), w(initial = 0)) {^wheel_rotation}
  spindle = MultibodyComponents.Body(m = 1.103, I_11 = 0.000478, I_22 = 0.000478, I_33 = 0.000496, render = false) {^spindle}
  wheel = SedanDemo.VehicleComponents.TMeasySlippingWheel(radius = 0.3266, width = 0.245, m = 24.7, I_axis = 1.099, I_long = 0.396, angular_state = false, elastic_contact = true, pn = 3580.65, mu_0 = 0.8, final mu_road = mu_road, c_z = 456715.6, d_z = 2291.8, render = false) {^wheel}
  "Rim mesh, rotating with the wheel"
  rim_vis = MultibodyComponents.ShapefileVisualizer(shapefile = sedan_asset("sedan_rim.obj"), shape_transform = T_wheel, color = [0.8, 0.8, 0.8, 1.0], render = render) if render {^rim_vis}
  "Tire mesh, rotating with the wheel"
  tire_vis = MultibodyComponents.ShapefileVisualizer(shapefile = sedan_asset("sedan_tire.obj"), shape_transform = T_wheel, color = [0.15, 0.15, 0.15, 1.0], render = render) if render {^tire_vis}
  "Tie rod driven by the steering rack instead of anchored to the chassis"
  structural parameter steered::Boolean = false
  "Left (true) or right (false) side of the vehicle"
  structural parameter mirror::Boolean = false
  "Render this corner in animations; when false the mesh visualizers are left out of the model"
  structural parameter render::Boolean = true
  "Initial lower-control-arm hinge angle (settled value for an equilibrium start)"
  parameter lca_phi0::Angle = 0
  "Guess for the lower ball joint's Euler angles in the settled pose"
  parameter lca_ball_phi0::Angle[3] = [1e-6, 1e-6, 1e-6]
  "Guess for the upper-control-arm hinge angle in the settled pose"
  parameter uca_rev_phi0::Angle = 1e-6
  "Road friction coefficient under this tire"
  parameter mu_road::Real = 0.9
  final parameter dir::Real = ifelse(mirror, -1.0, 1.0)
  "Wheel-mesh placement: meshes are authored with the spin axis along their local y"
  final parameter T_wheel::Real[4, 4] = [[-dir, 0, 0, 0], [0, 0, 1, 0], [0, dir, 0, 0], [0, 0, 0, 1]]
relations
  connect(chassis_frame, suspension.chassis_frame) {^id12}
  if steered
    connect(steer_frame, suspension.steer_frame)
  end
  connect(suspension.wheel_frame, wheel_rotation.frame_a, carrier) {^id13}
  connect(wheel_rotation.frame_b, spindle.frame_a, wheel.frame_a) {^id14}
  if render
    connect(wheel_rotation.frame_b, rim_vis.frame_a, tire_vis.frame_a)
  end
  connect(axis, wheel_rotation.axis) {^id15}
  connect(support, wheel_rotation.support) {^id16}
metadata {
  "Dyad": {
    "icons": {"default": "dyad://SedanDemo/SedanCorner.svg"},
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 200,
        "rot": 0,
        "attrs": {"font-size": "160"}
      }
    ]
  },
  "_links": {
    "chassis_frame": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 470, "y1": 20, "x2": 530, "y2": 80, "rot": 0}
        },
        "tags": []
      }
    },
    "steer_frame": {
