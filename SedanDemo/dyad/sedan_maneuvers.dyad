"""
# Sedan step steer

A cruise controller accelerates the sedan to 15 m/s; once the speed has
settled, the steering input is stepped to 0.1, putting the car into a
steady-state left turn.
"""
example component SedanStepSteer
  world = MultibodyComponents.World() {^world}
  sedan = Sedan(render = render) {^sedan}
  "Cruise speed reference"
  v_ref = BlockComponents.Sources.Constant(k = 15) {^v_ref}
  "Steering step once the speed has settled"
  steering_step = BlockComponents.Sources.Step(height = 0.1, start_time = 12) {^steering_step}
  speed_controller = SedanDemo.VehicleComponents.SpeedController(Kp = 0.4) {^speed_controller}
  "Render the vehicle in animations; when false the mesh visualizers are left out of the model"
  structural parameter render::Boolean = true
relations
  connect(v_ref.y, speed_controller.v_ref)
  connect(speed_controller.v, sedan.v)
  connect(speed_controller.throttle, sedan.throttle)
  connect(speed_controller.braking, sedan.braking)
  connect(steering_step.y, sedan.steering)
metadata {
