"""
# Sedan settle

The sedan is released just above its equilibrium ride height with all driver
inputs zero and settles onto its suspension and tires. Because the rear
suspension hardpoints sit 12.5 cm lower on the chassis than the front ones,
the equilibrium chassis attitude is pitched slightly nose-down while the wheel
centers level out.
"""
example component SedanSettle
  world = MultibodyComponents.World() {^world}
  sedan = Sedan(render = render) {^sedan}
  "Zero driver inputs"
  zero = BlockComponents.Sources.Constant(k = 0) {^zero}
  "Render the vehicle in animations; when false the mesh visualizers are left out of the model"
  structural parameter render::Boolean = true
relations
  connect(zero.y, sedan.steering, sedan.throttle, sedan.braking)
metadata {
  "Dyad": {"tests": {"case1": {"stop": 4, "solver": "Rodas5P"}}},
  "_links": {
    "world": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 60, "y1": 60, "x2": 180, "y2": 180, "rot": 0}
        },
        "tags": []
      }
    },
    "sedan": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 420, "y1": 380, "x2": 580, "y2": 540, "rot": 0}
        },
        "tags": []
      }
    },
    "zero": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 160, "y1": 400, "x2": 280, "y2": 520, "rot": 0}
        },
        "tags": []
      }
    }
  }
}
end

"""
# Sedan full-throttle acceleration

After a one-second settling phase the throttle is stepped to full and the
sedan accelerates in a straight line while its CVT varies the ratio continuously.
"""
example component SedanAcceleration
  world = MultibodyComponents.World() {^world}
  sedan = Sedan(render = render) {^sedan}
  "Zero steering and brake inputs"
  zero = BlockComponents.Sources.Constant(k = 0) {^zero}
  "Full throttle after the settling phase"
  throttle_step = BlockComponents.Sources.Step(height = 1, start_time = 1) {^throttle_step}
  "Render the vehicle in animations; when false the mesh visualizers are left out of the model"
  structural parameter render::Boolean = true
relations
  connect(zero.y, sedan.steering, sedan.braking) {^id5}
  connect(throttle_step.y, sedan.throttle) {^id6}
