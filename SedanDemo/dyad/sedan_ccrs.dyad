    "id3": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1520, "y": -78}, {"x": 1520, "y": -480}], "E": -1}, {"S": -1, "M": [{"x": 720, "y": -380}], "E": 3}, {"S": -1, "M": [], "E": -2}, {"S": -2, "M": [], "E": 4}, {"S": -2, "M": [{"x": -70, "y": -480}], "E": 2}], "junctions": [{"x": 720, "y": -480}, {"x": 560, "y": -480}], "renderStyle": "standard"}},
    "id4": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1550, "y": -30}, {"x": 1550, "y": -520}], "E": -1}, {"S": -1, "M": [{"x": 700, "y": -330}], "E": 2}, {"S": -1, "M": [{"x": 520, "y": -520}], "E": 3}], "junctions": [{"x": 700, "y": -520}], "renderStyle": "standard"}},
    "id5": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1580, "y": 39}, {"x": 1580, "y": -560}], "E": -1}, {"S": -1, "M": [{"x": 680, "y": -280}], "E": 2}, {"S": -1, "M": [{"x": 480, "y": -560}], "E": 3}], "junctions": [{"x": 680, "y": -560}], "renderStyle": "standard"}},
    "id6": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 1100, "y": -330}, {"x": 1100, "y": -90}], "E": 2}], "renderStyle": "standard"}},
    "id7": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}},
    "id8": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 850, "y": 370}], "E": 2}], "renderStyle": "standard"}},
    "id9": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}},
    "id10": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}},
    "id11": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}},
    "id12": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}},
    "id13": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}},
    "id14": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}},
    "id15": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}},
    "id16": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "renderStyle": "standard"}}
  }
}
end

"Euro NCAP CCRs test of the sedan at one test speed, impact location and AEB trigger"
analysis SedanCCRsTest
  extends TransientAnalysis(stop = 42, alg = ODEAlg.Rodas5P(), abstol = 1e-6, reltol = 1e-3)
  model = SedanCCRs(v_test_kmh = v_test_kmh, impact_pct = impact_pct, a_on = a_on)
  "Test speed [km/h]"
  parameter v_test_kmh::Real = 50
  "Impact location, percent of the vehicle width from the right edge"
  parameter impact_pct::Real = 50
  "Required deceleration at which the AEB starts braking"
  parameter a_on::Real = 5
end
