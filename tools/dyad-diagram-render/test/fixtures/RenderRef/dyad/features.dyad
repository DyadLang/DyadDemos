component AnalysisPoints
  src = BlockComponents.Sources.Sine(amplitude = 1.0, frequency = 1) {^src}
  g1 = BlockComponents.Math.Gain(k = 1) {^g1}
  g2 = BlockComponents.Math.Gain(k = 2) {^g2}
relations
  connect(src.y, g1.u) {^c1}
  connect(g1.y, g2.u) {^c2}
  u: analysis_point(g1.y, g2.u)
metadata {
  "_links": {
    "src": {"Dyad": {"placement": {"diagram": {"x1": 100, "x2": 200, "y1": 450, "y2": 550, "rot": 0}}}},
    "g1": {"Dyad": {"placement": {"diagram": {"x1": 350, "x2": 450, "y1": 450, "y2": 550, "rot": 0}}}},
    "g2": {"Dyad": {"placement": {"diagram": {"x1": 600, "x2": 700, "y1": 450, "y2": 550, "rot": 0}}}}
  }
}
end

component Markers
  src = BlockComponents.Sources.Sine(amplitude = 1.0, frequency = 1) {^src}
  g1 = BlockComponents.Math.Gain(k = 1) {^g1}
  g2 = BlockComponents.Math.Gain(k = 2) {^g2}
relations
  connect(src.y, g1.u) {^c1}
  connect(g1.y, g2.u) {^c2}
metadata {
  "_links": {
    "src": {"Dyad": {"placement": {"diagram": {"x1": 100, "x2": 200, "y1": 450, "y2": 550, "rot": 0}}}},
    "g1": {"Dyad": {"placement": {"diagram": {"x1": 350, "x2": 450, "y1": 450, "y2": 550, "rot": 0}}}},
    "g2": {"Dyad": {"placement": {"diagram": {"x1": 600, "x2": 700, "y1": 250, "y2": 350, "rot": 0}}}},
    "c2": {"Dyad": {"renderStyle": "markers"}}
  }
}
end

component Arrays
  s1 = BlockComponents.Sources.Sine(amplitude = 1.0, frequency = 1) {^s1}
  s2 = BlockComponents.Sources.Sine(amplitude = 1.0, frequency = 2) {^s2}
  s3 = BlockComponents.Sources.Sine(amplitude = 1.0, frequency = 3) {^s3}
  ss = BlockComponents.Continuous.StateSpace(nx = 1, nu = 3, ny = 2, A = fill(-1.0, 1, 1), B = fill(1.0, 1, 3), C = fill(1.0, 2, 1), D = fill(0.0, 2, 3)) {^ss}
  g1 = BlockComponents.Math.Gain(k = 1) {^g1}
  g2 = BlockComponents.Math.Gain(k = 2) {^g2}
relations
  connect(s1.y, ss.u[1]) {^c1}
  connect(s2.y, ss.u[2]) {^c2}
  connect(s3.y, ss.u[3]) {^c3}
  connect(ss.y[1], g1.u) {^c4}
  connect(ss.y[2], g2.u) {^c5}
metadata {
  "_links": {
    "s1": {"Dyad": {"placement": {"diagram": {"x1": 100, "x2": 200, "y1": 250, "y2": 350, "rot": 0}}}},
    "s2": {"Dyad": {"placement": {"diagram": {"x1": 100, "x2": 200, "y1": 450, "y2": 550, "rot": 0}}}},
    "s3": {"Dyad": {"placement": {"diagram": {"x1": 100, "x2": 200, "y1": 650, "y2": 750, "rot": 0}}}},
    "ss": {"Dyad": {"placement": {"diagram": {"x1": 400, "x2": 600, "y1": 400, "y2": 600, "rot": 0}}}},
    "g1": {"Dyad": {"placement": {"diagram": {"x1": 750, "x2": 850, "y1": 350, "y2": 450, "rot": 0}}}},
    "g2": {"Dyad": {"placement": {"diagram": {"x1": 750, "x2": 850, "y1": 550, "y2": 650, "rot": 0}}}}
  }
}
end
