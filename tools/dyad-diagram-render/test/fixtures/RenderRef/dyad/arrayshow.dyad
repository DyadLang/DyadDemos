component ArrayBlock
  u = [RealInput() for i in 1:3] {^u}
  y = RealOutput() {^y}
relations
  y = u[1] + u[2] + u[3]
metadata {
  "Dyad": {
    "labels": [{"label": "$(instance)", "x": 500, "y": 1100, "rot": 0}],
    "icons": {"default": "dyad://BlockComponents/StateSpace.svg"}
  },
  "_links": {
    "u": {"Dyad": {"placement": {"icon": {"iconName": "default", "x1": -100, "y1": 450, "x2": 0, "y2": 550, "rot": 0, "show": 5}, "diagram": {"iconName": "default", "x1": -100, "y1": 450, "x2": 0, "y2": 550, "rot": 0, "show": 5}}}},
    "y": {"Dyad": {"placement": {"icon": {"iconName": "default", "x1": 1000, "y1": 450, "x2": 1100, "y2": 550, "rot": 0}}}}
  }
}
end

component ArrayShow
  s1 = BlockComponents.Sources.Sine(amplitude = 1.0, frequency = 1) {^s1}
  s2 = BlockComponents.Sources.Sine(amplitude = 1.0, frequency = 2) {^s2}
  s3 = BlockComponents.Sources.Sine(amplitude = 1.0, frequency = 3) {^s3}
  ab = ArrayBlock() {^ab}
relations
  connect(s1.y, ab.u[1]) {^c1}
  connect(s2.y, ab.u[2]) {^c2}
  connect(s3.y, ab.u[3]) {^c3}
metadata {
  "_links": {
    "s1": {"Dyad": {"placement": {"diagram": {"x1": 100, "x2": 200, "y1": 250, "y2": 350, "rot": 0}}}},
    "s2": {"Dyad": {"placement": {"diagram": {"x1": 100, "x2": 200, "y1": 450, "y2": 550, "rot": 0}}}},
    "s3": {"Dyad": {"placement": {"diagram": {"x1": 100, "x2": 200, "y1": 650, "y2": 750, "rot": 0}}}},
    "ab": {"Dyad": {"placement": {"diagram": {"x1": 400, "x2": 600, "y1": 400, "y2": 600, "rot": 0}}}}
  }
}
end
