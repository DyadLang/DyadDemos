# Pinned versions and checksums for dyad-ui-shot. Read by setup.sh (sourced)
# and by lib/paths.mjs (parsed as KEY=VALUE lines). Change a version only
# together with its checksum.

# Dyad Studio, from Open VSX. Checked against the .sha256 Open VSX publishes.
DYAD_STUDIO_VERSION=3.5.1
DYAD_STUDIO_SHA256=d56e9718be07578c2eb68d4094e196bfa6bd3b98fb7bbd836d6f4ba02934bfee

# chrome-headless-shell from Chrome for Testing; the build puppeteer-core
# 25.17.0 is tested against. Chrome for Testing publishes no checksums, so this
# one was recorded on first download.
CHROME_VERSION=157.0.8103.50
CHROME_SHA256=7bf0d41e424efd1d6281c4162993ab9dc5de92fac213c211614905a71c057d0f

# openvscode-server, only for the optional --mode studio. Its releases publish
# no checksums, so this one was recorded on first download.
OPENVSCODE_VERSION=1.109.5
OPENVSCODE_SHA256=b433bf4f0227321a7014d8460d10a8f958adc0f45aa79bd889e84e65e8f88363

# Dyad Studio's extensionDependencies, only for --mode studio. Checked against
# the .sha256 Open VSX publishes. Format: publisher.name@version=sha256
STUDIO_DEPS="julialang.language-julia@1.250.2=964cd0e8308218d69f39e69b749457125e11a1b27bff370854bfc331485f87f5 JuliaComputing.juliahub-vscode-auth@0.1.15=1691180791dc86d3c3653d8b910a79bc23e2a855e8ba9d2c0d5b15f65a4437f7 ms-toolsai.jupyter-renderers@1.3.0=d09f6c517a8090a932bb4e2c31bcb2de34ddb2a71133477f6c47f28f36eb76ae"

# Dyad CLI, only used by --render-png. Checked against the release's
# SHA256SUMS.txt.
DYAD_CLI_VERSION=3.5.0
