# ===== POWER-SPLIT TRANSMISSION =====
component HybridPlanetaryGear
  """
  Planetary gear set for power-split hybrid.
  Exposes sun, carrier, and ring flanges using RotationalComponents standard library.
  
  Gear ratio = 2.6 (ring teeth / sun teeth).
  """
  extends RotationalComponents.IdealPlanetaryGear(ratio = 2.6)
relations
metadata {
  "Dyad": {"icons": {"default": "dyad://HybridTransmission/planetary_gear.svg"}}
}
end

# ===== COMPLETE HYBRID VEHICLE SYSTEM =====
test component PowerSplitHybrid
  "Complete power-split hybrid vehicle model with ECMS control."
  drive_cycle = HighwayDriveCycle() {^drive_cycle}
  controller = ECMSController() {^controller}
  engine = HybridEngine() {^engine}
  mg1 = HybridMG(Kt = 1.0, max_torque = 130.0) {^mg1} # 40 kW generator
  mg2 = HybridMG(Kt = 1.0, max_torque = 330.0) {^mg2} # 70 kW traction motor
  transmission = HybridPlanetaryGear() {^transmission}
  vehicle = HybridVehicle() {^vehicle}
  battery = HybridBattery() {^battery}
relations
  # Control connections
  connect(drive_cycle.speed_ref, controller.speed_ref) {^id9}
  connect(vehicle.speed_output, controller.speed_actual) {^id10}
  connect(battery.soc_output, controller.soc) {^id11}
  connect(engine.omega_output, controller.engine_omega) {^id12}
  connect(mg1.omega_output, controller.mg1_omega) {^id13}
  connect(controller.engine_throttle, engine.throttle) {^id14}
  connect(controller.mg1_torque_cmd, mg1.torque_cmd) {^id15}
  connect(controller.mg2_torque_cmd, mg2.torque_cmd) {^id16}
  # Mechanical connections - planetary gear
  connect(engine.flange, transmission.carrier) {^id17} # Engine to carrier
  connect(mg1.flange, transmission.sun) {^id18} # MG1 to sun (generator)
  connect(mg2.flange, transmission.ring) {^id19} # MG2 to ring (traction)
  connect(vehicle.flange, transmission.ring) {^id20} # Vehicle to ring (same as MG2)
  # Electrical connections
  connect(mg1.power_elec, battery.mg1_power) {^id21}
  connect(mg2.power_elec, battery.mg2_power) {^id22}
  # Initial conditions - all at rest
  initial engine.omega = 0.0
  initial mg1.omega = 0.0
  initial mg2.omega = 0.0
  initial vehicle.omega_wheel = 0.0
  initial engine.flange.phi = 0.0
  initial mg1.flange.phi = 0.0
  initial mg2.flange.phi = 0.0
  initial vehicle.flange.phi = 0.0
  # Guesses for algebraic torques
  guess engine.flange.tau = 0.0
  guess mg1.flange.tau = 0.0
  guess mg2.flange.tau = 0.0
  guess transmission.carrier.tau = 0.0
  guess transmission.sun.tau = 0.0
  guess transmission.ring.tau = 0.0
