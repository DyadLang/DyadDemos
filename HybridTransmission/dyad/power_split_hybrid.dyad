"""
Power-Split Hybrid Electric Vehicle Model

This model implements a power-split architecture with planetary gear coupling.

Architecture:
- Atkinson cycle ICE (74 kW / 99 hp) connected to planetary carrier
- Motor/Generator MG1 (permanent magnet, 25 kW) connected to sun gear (generator/speed control)
- Motor/Generator MG2 (permanent magnet, 70 kW) connected to ring gear and wheels (traction motor)
- NiMH battery (274-330V, 5.5 kWh usable)
- Planetary gear ratio: 2.6 (ring teeth / sun teeth)

Reference: 
- SAE 2005-01-1364: "Hybrid Electric Powertrains for Passenger Vehicles: Configuration, Performance, and Testing" by Miller, J.M.
- EPA Test Cycle Data: 40 CFR Part 86, Appendix I (HWFET)
"""
test component PowerSplitHybrid
  "Complete power-split hybrid vehicle model with ECMS control."
  drive_cycle = HighwayDriveCycle() {
    "Dyad": {"placement": {"diagram": {"x1": 200, "y1": 562.5, "x2": 400, "y2": 762.5}}}
  }
  controller = ECMSController() {
    "Dyad": {"placement": {"diagram": {"x1": 550, "y1": 512.5, "x2": 850, "y2": 812.5}}}
  }
  engine = HybridEngine() {
    "Dyad": {"placement": {"diagram": {"x1": 1000, "y1": 212.5, "x2": 1200, "y2": 412.5}}}
  }
  mg1 = HybridMG(Kt = 1.0, max_torque = 130.0) {
    "Dyad": {"placement": {"diagram": {"x1": 1000, "y1": 562.5, "x2": 1200, "y2": 762.5}}}
  } # 40 kW generator
  mg2 = HybridMG(Kt = 1.0, max_torque = 330.0) {
    "Dyad": {"placement": {"diagram": {"x1": 1000, "y1": 912.5, "x2": 1200, "y2": 1112.5}}}
  } # 70 kW traction motor
  transmission = HybridPlanetaryGear() {
    "Dyad": {"placement": {"diagram": {"x1": 1350, "y1": 562.5, "x2": 1550, "y2": 762.5}}}
  }
  vehicle = HybridVehicle() {
    "Dyad": {"placement": {"diagram": {"x1": 1650, "y1": 562.5, "x2": 1850, "y2": 762.5}}}
  }
  battery = HybridBattery() {
    "Dyad": {"placement": {"diagram": {"x1": 1300, "y1": 912.5, "x2": 1500, "y2": 1112.5}}}
  }
relations
  # Control connections
  connect(drive_cycle.speed_ref, controller.speed_ref) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(vehicle.speed_output, controller.speed_actual) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 1862.5, "y": 662.5},
            {"x": 1862.5, "y": 1200},
            {"x": 525, "y": 1200},
            {"x": 525, "y": 712.5}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(battery.soc_output, controller.soc) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 1512.5, "y": 1012.5},
            {"x": 1512.5, "y": 1187.5},
            {"x": 537.5, "y": 1187.5},
            {"x": 537.5, "y": 762.5}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(engine.omega_output, controller.engine_omega) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 1212.5, "y": 262.5},
            {"x": 1212.5, "y": 200},
            {"x": 525, "y": 200},
            {"x": 525, "y": 612.5}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(mg1.omega_output, controller.mg1_omega) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 1212.5, "y": 612.5},
            {"x": 1212.5, "y": 500},
            {"x": 537.5, "y": 500},
            {"x": 537.5, "y": 562.50001}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(controller.engine_throttle, engine.throttle) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [{"x": 862.5, "y": 612.49999}, {"x": 862.5, "y": 312.5}], "E": 2}
      ],
      "path": {}
    }
  }
  connect(controller.mg1_torque_cmd, mg1.torque_cmd) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(controller.mg2_torque_cmd, mg2.torque_cmd) {
    "Dyad": {
      "edges": [
        {"S": 1, "M": [{"x": 862.5, "y": 712.50001}, {"x": 862.5, "y": 1012.5}], "E": 2}
      ],
      "path": {}
    }
  }
  # Mechanical connections - planetary gear
  connect(engine.flange, transmission.carrier) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 1337.5, "y": 312.5}, {"x": 1337.5, "y": 620.5}], "E": 2}],
      "path": {}
    }
  } # Engine to carrier
  connect(mg1.flange, transmission.sun) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}} # MG1 to sun (generator)
  connect(mg2.flange, transmission.ring) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 1275, "y": 1012.5},
            {"x": 1275, "y": 775},
            {"x": 1562.5, "y": 775},
            {"x": 1562.5, "y": 662.5}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  } # MG2 to ring (traction)
  connect(vehicle.flange, transmission.ring) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}} # Vehicle to ring (same as MG2)
  # Electrical connections
  connect(mg1.power_elec, battery.mg1_power) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 1287.5, "y": 712.5}, {"x": 1287.5, "y": 962.5}], "E": 2}],
      "path": {}
    }
  }
  connect(mg2.power_elec, battery.mg2_power) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  # Initial conditions - all at rest
  # Only set initials for independent DOFs; connected/constrained vars use guesses
  initial vehicle.omega_wheel = 0.0
  initial engine.flange.phi = 0.0
  initial vehicle.flange.phi = 0.0
  # Guesses for dependent mechanical variables (determined by connections + planetary constraint)
  guess engine.omega = 0.0
  guess mg1.omega = 0.0
  guess mg2.omega = 0.0
  guess mg1.flange.phi = 0.0
  guess mg2.flange.phi = 0.0
  # Guesses for algebraic torques
  guess engine.flange.tau = 0.0
  guess mg1.flange.tau = 0.0
  guess mg2.flange.tau = 0.0
  guess transmission.carrier.tau = 0.0
  guess transmission.sun.tau = 0.0
  guess transmission.ring.tau = 0.0
metadata {
  "Dyad": {
    "tests": {
      "case1": {
        "stop": 765,
        "atol": {"battery.SOC": 0.02, "engine.fuel_consumed": 50, "vehicle.speed": 2.0},
        "expect": {
          "initial": {"vehicle.speed": 0.0, "battery.SOC": 0.6, "engine.fuel_consumed": 0.0},
          "final": {"battery.SOC": 0.4, "engine.fuel_consumed": 1292, "vehicle.speed": 20.0},
          "signals": [
            "vehicle.speed",
            "battery.SOC",
            "engine.fuel_consumed",
            "controller.engine_throttle"
          ]
        }
      }
    }
  }
}
end

# ===== ANALYSIS =====
analysis TestPowerSplitHybrid
  extends TransientAnalysis(stop = 765.0, abstol = 1e-6, reltol = 1e-3, saveat = 0.5)
  model = PowerSplitHybrid()
relations
end