"""
Linear actuator with cascaded speed and current control.

24 V DC link → averaged PWM + H-bridge → brushed DC motor → gearbox + lead screw + carriage.
A Hall-effect speed sensor closes the outer (speed, rpm) loop and an armature current sensor
closes the inner (current) loop.
"""
component LinearActuator
  "Forward/reverse trapezoidal motor-speed reference, 3000 rpm cruise"
  profile = SpeedProfile(n_max = 3000.0) {^profile}
  """
  Cascaded PI control. Current loop: Ziegler-Nichols PI (Ku_i = 21.64 V/A, Pu_i = 0.2911 ms ->
  Kp = 0.45 Ku_i, Ti = Pu_i/1.2; PM 29 deg). Speed loop: from the measured Ku_n = 0.2889 A/rpm and
  Pu_n = 1.562 ms, Ti = 4 Pu_n and Kp = 0.027 Ku_n (PM 46 deg, crossover 373 rad/s, 28x below the
  current loop); the Ziegler-Nichols PI rule is unstable for this integrating, Hall-lag-limited loop.
  """
  controller = CascadeController(Kp_n = 0.0079, Ti_n = 6.25e-3, I_max = 8.0, Kp_i = 9.738, Ti_i = 2.426e-4, V_max = m_max * V_dc) {^controller}
  pwm = AveragedPWM(V_dc = V_dc, m_max = m_max, f_pwm = 20000.0) {^pwm}
  vdc_set = BlockComponents.Sources.Constant(k = V_dc) {^vdc_set}
  supply = ElectricalComponents.Analog.Sources.VoltageSource() {^supply}
  gnd_supply = ElectricalComponents.Analog.Basic.Ground() {^gnd_supply}
  gnd_bridge = ElectricalComponents.Analog.Basic.Ground() {^gnd_bridge}
  bridge = AveragedHBridge() {^bridge}
  current_sensor = ElectricalComponents.Analog.Sensors.CurrentSensor() {^current_sensor}
  motor = DyadExampleComponents.DCMotor(R = R_a, L = L_a, k = k_m, J = J_m, f = f_m) {^motor}
  fixed_motor = RotationalComponents.Components.Fixed() {^fixed_motor}
  hall = HallSpeedSensor() {^hall}
  drivetrain = LeadScrewDriveTrain() {^drivetrain}
  load_step = BlockComponents.Sources.Step(height = F_load, start_time = t_load) {^load_step}
  "DC-link voltage"
  parameter V_dc::Voltage = 24.0
  "Maximum PWM modulation index"
  parameter m_max::Real = 0.98
  "Armature resistance"
  parameter R_a::Resistance = 1.0
  "Armature inductance"
  parameter L_a::Inductance = 1e-3
  "Motor torque / back-EMF constant"
  parameter k_m::ElectricalTorqueConstant = 0.05
  "Rotor inertia"
  parameter J_m::Inertia = 1e-5
  "Motor viscous friction"
  parameter f_m::RotationalDampingConstant = 1e-5
  "External load force on the carriage (opposes extension)"
  parameter F_load::Force = 800.0
  "Load force application time"
  parameter t_load::Time = 0.3
relations
  initial motor.L1.i = 0.0
  initial motor.inertia.w = 0.0
  u_v: analysis_point(controller.v_ref, pwm.v_ref)
  y_i: analysis_point(current_sensor.i, controller.i_meas)
  y_n: analysis_point(hall.n, controller.n_meas)
  connect(profile.n_ref, controller.n_ref) {^id15}
  connect(controller.v_ref, pwm.v_ref) {^id16}
  connect(pwm.m, bridge.m) {^id17}
  connect(vdc_set.y, supply.V) {^id18}
  connect(supply.p, bridge.dc_p) {^id19}
  connect(supply.n, gnd_supply.g) {^id20}
  connect(bridge.dc_n, gnd_bridge.g) {^id21}
  connect(bridge.a, current_sensor.p) {^id22}
  connect(current_sensor.n, motor.p) {^id23}
  connect(bridge.b, motor.n) {^id24}
  connect(current_sensor.i, controller.i_meas) {^id25}
  connect(motor.housing, fixed_motor.spline) {^id26}
  connect(motor.shaft, drivetrain.shaft, hall.spline) {^id27}
  connect(hall.n, controller.n_meas) {^id28}
  connect(load_step.y, drivetrain.f_load) {^id29}
