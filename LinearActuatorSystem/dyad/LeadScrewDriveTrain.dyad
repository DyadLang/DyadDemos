"""
Rigid lead-screw drive train of a linear actuator.

Motor shaft → reduction gearbox (`gear_ratio`) → screw shaft inertia → lead screw
(`ratio = 2π / lead`) → carriage mass on a guide with viscous friction. An external load
force `f_load` acts on the carriage; positive `f_load` opposes extension (positive `s`).

Gearbox and screw are ideal (lossless, backlash-free, rigid). All housings are fixed to
ground inside the component.
"""
component LeadScrewDriveTrain
  "Input shaft (motor side)"
  shaft = Spline() {^shaft}
  "Carriage (actuator rod) flange"
  carriage = Flange() {^carriage}
  "External load force on the carriage, positive opposing extension (N)"
  f_load = RealInput() {^f_load}
  gearbox = RotationalComponents.Components.IdealGear(ratio = gear_ratio) {^gearbox}
  screw_inertia = RotationalComponents.Components.Inertia(J = J_screw) {^screw_inertia}
  lead_screw = TranslationalComponents.Components.IdealGearR2T(ratio = 2 * pi / lead) {^lead_screw}
  carriage_mass = TranslationalComponents.Components.Mass(m = m_carriage) {^carriage_mass}
  guide_friction = TranslationalComponents.Components.Damper(d = d_guide) {^guide_friction}
  load_force = TranslationalComponents.Sources.Force() {^load_force}
  fixed_r = RotationalComponents.Components.Fixed() {^fixed_r}
  fixed_t = TranslationalComponents.Components.Fixed() {^fixed_t}
  "Reaction point of the external load force"
  fixed_load = TranslationalComponents.Components.Fixed() {^fixed_load}
  "Gearbox reduction ratio (motor speed / screw speed)"
  parameter gear_ratio::Real = 5.0
  "Screw lead (carriage travel per screw revolution)"
  parameter lead::Length = 0.005
  "Screw shaft inertia"
  parameter J_screw::Inertia = 1e-6
  "Carriage and payload mass"
  parameter m_carriage::Mass = 10.0
  "Viscous friction coefficient of the carriage guide"
  parameter d_guide::TranslationalDampingConstant = 100.0
relations
  connect(shaft, gearbox.spline_a) {^c1}
  connect(gearbox.spline_b, screw_inertia.spline_a) {^c2}
  connect(screw_inertia.spline_b, lead_screw.spline) {^c3}
  connect(gearbox.support, lead_screw.support_r, fixed_r.spline) {^c4}
  connect(lead_screw.flange, carriage_mass.flange_a) {^c5}
  connect(carriage_mass.flange_b, guide_friction.flange_a, load_force.flange_a, carriage) {^c6}
  connect(lead_screw.support_t, guide_friction.flange_b, fixed_t.flange) {^c7}
  connect(load_force.flange_b, fixed_load.flange) {^c9}
  connect(f_load, load_force.f) {^c8}
metadata {
  "Dyad": {
    "icons": {"default": "dyad://LinearActuatorSystem/LeadScrewDriveTrain.svg"},
    "labels": [
      {"label": "$(instance)", "x": 500, "y": 1100, "rot": 0, "layer": "icon"},
      {"label": "i = $(gear_ratio), lead = $(lead) m", "x": 500, "y": 1250, "rot": 0, "layer": "icon", "attrs": {"font-size": "110", "fill": "#555"}},
      {"label": "m = $(m_carriage) kg", "x": 500, "y": 1380, "rot": 0, "layer": "icon", "attrs": {"font-size": "110", "fill": "#555"}},
      {"label": "motor shaft", "x": 20, "y": 330, "rot": 0, "layer": "diagram", "attrs": {"font-size": "22", "fill": "#555"}},
      {"label": "carriage", "x": 985, "y": 330, "rot": 0, "layer": "diagram", "attrs": {"font-size": "22", "fill": "#2a661f"}},
      {"label": "F_load [N]", "x": 900, "y": 40, "rot": 0, "layer": "diagram", "attrs": {"font-size": "22", "fill": "#c00000"}},
      {"label": "ground (housings)", "x": 350, "y": 860, "rot": 0, "layer": "diagram", "attrs": {"font-size": "20", "fill": "#555"}},
      {"label": "ground (guide)", "x": 750, "y": 860, "rot": 0, "layer": "diagram", "attrs": {"font-size": "20", "fill": "#555"}}
    ]
  },
