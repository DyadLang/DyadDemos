# Test harnesses for the three excitation events of the decoupled
# identification strategy (see agent_resources/reference/ for the original
# study):
#
#   Event 1  low-amplitude chirp   -> Stage 1 calibration of the Maxwell branch
#   Event 2  slow large cycling    -> Stage 2 calibration of the Bouc-Wen element
#   Event 3  tip-in with ripple    -> validation on an unseen scenario
#
# Different excitations isolate different physics: at +/-2 Nm the Bouc-Wen
# state stays negligible (chirp sees only the Maxwell transition), while at
# 1 Hz the Maxwell branch is fully relaxed (slow cycle sees only hysteresis).

"Event 1 harness: low-amplitude linear chirp (1 -> 500 Hz, +/-2 Nm) on a 30 Nm mean torque. Used to generate the Stage 1 measurement data from the truth parameters."
test component TestDrivelineChirp
  model = DrivelineSystem()
  chirp = BlockComponents.Sources.Chirp(fmin = 1.0, fmax = 500.0, T = 5.0, amplitude = 2.0, law = BlockComponents.Sources.ChirpLaw.Linear())
  mean_torque = BlockComponents.Sources.Constant(k = 30.0)
  torque_sum = BlockComponents.Math.Add()
relations
  connect(chirp.y, torque_sum.u1)
  connect(mean_torque.y, torque_sum.u2)
  connect(torque_sum.y, model.torque.tau)
end

analysis TestDrivelineChirpTransient
  extends TransientAnalysis(stop = 5.0, saveat = 0.001)
  model = TestDrivelineChirp()
end

"Stage 1 calibration harness: same chirp excitation as TestDrivelineChirp but with the Bouc-Wen element disabled (alpha = 0, A_bw = 0 keeps z identically zero), so only the Maxwell branch (k1, c1) is identified — mirroring the original study's 4-state Maxwell fit. The small Bouc-Wen contribution present in the measurement data is treated as unmodeled dynamics."
test component TestDrivelineChirpMaxwellOnly
  model = DrivelineSystem(alpha = 0.0, A_bw = 0.0)
  chirp = BlockComponents.Sources.Chirp(fmin = 1.0, fmax = 500.0, T = 5.0, amplitude = 2.0, law = BlockComponents.Sources.ChirpLaw.Linear())
  mean_torque = BlockComponents.Sources.Constant(k = 30.0)
  torque_sum = BlockComponents.Math.Add()
relations
  connect(chirp.y, torque_sum.u1)
  connect(mean_torque.y, torque_sum.u2)
  connect(torque_sum.y, model.torque.tau)
end

analysis TestDrivelineChirpMaxwellOnlyTransient
  extends TransientAnalysis(stop = 5.0, saveat = 0.001)
  model = TestDrivelineChirpMaxwellOnly()
end

"Event 2 harness: slow cycling (1 Hz sine, +/-100 Nm) exercising the Bouc-Wen hysteresis at full amplitude. The Maxwell parameters are re-exposed at harness level so the Stage 2 driver can freeze them to the Stage 1 fit via constructor keywords (model.k1 / model.c1 stay out of the Stage 2 search space and are therefore fixed)."
test component TestDrivelineSlowCycle
  model = DrivelineSystem(final k1 = k1, final c1 = c1)
  sine = BlockComponents.Sources.Sine(amplitude = 100.0, frequency = 1.0)
  "Maxwell branch stiffness [N*m/rad] (frozen from Stage 1)"
  parameter k1::RotationalSpringConstant = 200.0
  "Maxwell branch damping [N*m*s/rad] (frozen from Stage 1)"
  parameter c1::RotationalDampingConstant = 2.0
relations
  connect(sine.y, model.torque.tau)
end

analysis TestDrivelineSlowCycleTransient
  extends TransientAnalysis(stop = 5.0, saveat = 0.005)
  model = TestDrivelineSlowCycle()
end

"Event 3 harness: tip-in with motor ripple (30 -> 150 Nm at t = 0.5 s plus 3 Nm at 600 Hz). Both isolator mechanisms are active simultaneously; never used in calibration — validation only."
test component TestDrivelineTipIn
  model = DrivelineSystem()
  tipin = TipInTorque()
relations
  connect(tipin.y, model.torque.tau)
end

analysis TestDrivelineTipInTransient
  extends TransientAnalysis(stop = 2.0, saveat = 0.0005)
  model = TestDrivelineTipIn()
end
