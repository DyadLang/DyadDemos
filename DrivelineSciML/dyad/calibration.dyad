# Two-stage decoupled calibration of the Maxwell-Bouc-Wen isolator.
#
# Each CalibrationAnalysis takes exactly one dataset and one model, so the
# two stages are separate analyses chained by `scripts/run_calibration.jl`:
# the driver runs Stage 1, then constructs the Stage 2 harness with the
# fitted k1/c1 frozen (TestDrivelineSlowCycle exposes them as harness
# parameters that stay outside the Stage 2 search space).
#
# Stage 1 fits the *full* model (Bouc-Wen active) over (k1, c1, alpha). A
# Maxwell-only fit is structurally biased: the Bouc-Wen element has a tangent
# stiffness alpha*A_bw at the origin — a frequency-flat linear spring that a
# Maxwell-only model lumps into k1/c1 (k1 lands ~28% low at any chirp
# amplitude, since the contamination scales with the chirp like the Maxwell
# response itself). The 1->500 Hz chirp crosses the Maxwell relaxation corner
# (~48 Hz), so its frequency content separates the relaxation element from the
# frequency-flat Bouc-Wen tangent once alpha is free — recovering k1, c1 to a
# few percent and yielding an alpha estimate that seeds Stage 2.
#
# Search bounds are intentionally wide (≥2× around truth) so the optimizer
# does real work; defaults of the model components are the nominal initial
# guesses (k1=200, c1=2, alpha=30, A_bw=1, beta_bw=3, gamma_bw=0.3).

"Stage 1: recover the Maxwell branch (k1, c1) and the Bouc-Wen torque scale (alpha) from low-amplitude chirp measurements by matching the isolator speed difference delta_w (insensitive to the common-mode ramp from the 30 Nm mean torque). Fits the full model (Bouc-Wen active) so alpha absorbs the Bouc-Wen tangent stiffness instead of biasing k1/c1; the chirp's 1->500 Hz sweep separates the Maxwell relaxation element from the frequency-flat tangent. Truth: k1=300, c1=1.0, alpha=50. Measurements generated by scripts/generate_calibration_data.jl."
analysis DrivelineStage1CalibrationAnalysis
  extends DyadModelOptimizer.CalibrationAnalysis(
    alg = ODEAlg.Tsit5(),
    stop = 5.0, saveat = 0.001,
    abstol = 1e-8, reltol = 1e-8,
    data = DyadData.DyadTimeseries("dyad://DrivelineSciML/data/chirp_measurements.csv",
      independent_var = "timestamp",
      dependent_vars = ["delta_w(t)"]),
    depvars_names = ["model.delta_w"],
    search_space_names = ["model.k1", "model.c1", "model.alpha"],
    search_space_lb    = [50.0, 0.1, 10.0],
    search_space_ub    = [500.0, 10.0, 120.0],
    calibration_alg = "SingleShooting",
    optimizer = "auto",
    optimizer_maxiters = 400)
  model = TestDrivelineChirp()
end

"Stage 2: recover the Bouc-Wen element (alpha, beta_bw, gamma_bw) from slow-cycling measurements by matching the engine-side speed. The (now de-biased) Maxwell parameters are frozen to the Stage 1 fit by passing model = TestDrivelineSlowCycle(k1 = ..., c1 = ...) to this analysis, and the Stage 1 alpha seeds this stage's alpha initial guess (via model.alpha) — the full-amplitude slow cycle then sharpens alpha/beta_bw (the saturation torque). A_bw is fixed at 1.0 (the standard Bouc-Wen convention): the flow rule is exactly invariant under (A_bw -> s*A_bw, alpha -> alpha/s), so searching over both alpha and A_bw is structurally non-identifiable. Truth: alpha=50, beta_bw=5.0, gamma_bw=0.5."
analysis DrivelineStage2CalibrationAnalysis
  extends DyadModelOptimizer.CalibrationAnalysis(
    alg = ODEAlg.Tsit5(),
    stop = 5.0, saveat = 0.005,
    abstol = 1e-8, reltol = 1e-8,
    data = DyadData.DyadTimeseries("dyad://DrivelineSciML/data/slow_cycle_measurements.csv",
      independent_var = "timestamp",
      dependent_vars = ["omega_eng(t)"]),
    depvars_names = ["model.J_eng.w"],
    search_space_names = ["model.alpha", "model.beta_bw", "model.gamma_bw"],
    search_space_lb    = [10.0, 1.0, 0.05],
    search_space_ub    = [120.0, 15.0, 1.0],
    calibration_alg = "SingleShooting",
    optimizer = "auto",
    optimizer_maxiters = 300)
  model = TestDrivelineSlowCycle()
end
