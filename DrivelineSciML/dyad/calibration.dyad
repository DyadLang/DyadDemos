# One CalibrationAnalysis takes one dataset and one model, so the two stages
# are separate analyses that `scripts/run_calibration.jl` chains.
#
# Search bounds are deliberately wide (>=2x around truth) so the optimizer does
# real work. Component defaults are the nominal starting guesses: k1=200, c1=2,
# alpha=30, A_bw=1, beta_bw=3, gamma_bw=0.3.

"Stage 1: recovers the Maxwell branch (k1, c1) and the Bouc-Wen torque scale (alpha) from the low-amplitude chirp, matching the speed difference across the isolator (delta_w, which ignores the common-mode ramp the 30 Nm mean torque produces). Leaving the Bouc-Wen element active lets alpha absorb its frequency-flat tangent stiffness, and the 1->500 Hz sweep then separates that tangent from the Maxwell relaxation, which stiffens only above ~48 Hz."
analysis DrivelineStage1CalibrationAnalysis
  extends DyadModelOptimizer.CalibrationAnalysis(
    alg = ODEAlg.Tsit5(),
    stop = 5.0, saveat = 0.001,
    abstol = 1e-8, reltol = 1e-8,
    data = DyadData.DyadTimeseries("dyad://DrivelineSciML/data/chirp_measurements.csv",
      independent_var = "timestamp",
      dependent_vars = ["delta_w(t)"]),
    depvars_names = ["model.delta_w"],
    search_space_names = ["model.k1", "model.c1", "model.alpha"],
    search_space_lb    = [50.0, 0.1, 10.0],
    search_space_ub    = [500.0, 10.0, 120.0],
    calibration_alg = "SingleShooting",
    optimizer = "auto",
    optimizer_maxiters = 400)
  model = TestDrivelineChirp()
end

"Stage 2: recovers the Bouc-Wen element (alpha, beta_bw, gamma_bw) from the full-amplitude slow cycle, matching the engine-side speed. Passing model = TestDrivelineSlowCycle(k1 = ..., c1 = ...) freezes the de-biased Stage 1 Maxwell branch outside this search space. A_bw stays at 1.0 by the standard Bouc-Wen convention: the flow rule is exactly invariant under (A_bw -> s*A_bw, alpha -> alpha/s), so searching both alpha and A_bw is non-identifiable."
analysis DrivelineStage2CalibrationAnalysis
  extends DyadModelOptimizer.CalibrationAnalysis(
    alg = ODEAlg.Tsit5(),
    stop = 5.0, saveat = 0.005,
    abstol = 1e-8, reltol = 1e-8,
    data = DyadData.DyadTimeseries("dyad://DrivelineSciML/data/slow_cycle_measurements.csv",
      independent_var = "timestamp",
      dependent_vars = ["omega_eng(t)"]),
    depvars_names = ["model.J_eng.w"],
    search_space_names = ["model.alpha", "model.beta_bw", "model.gamma_bw"],
    search_space_lb    = [10.0, 1.0, 0.05],
    search_space_ub    = [120.0, 15.0, 1.0],
    calibration_alg = "SingleShooting",
    optimizer = "auto",
    optimizer_maxiters = 300)
  model = TestDrivelineSlowCycle()
end
