"Stage 6: instantaneous C tire; D is peak friction coefficient."
component MagicFormulaTire
  parameter Fz::Real = 4000
  parameter B::Real = 10
  parameter C::Real = 1.3
  parameter D::Real = 1
  parameter E::Real = 0.97
  alpha = RealInput()
  Fy = RealOutput()
relations
  Fy = CLibraryIntegration.mf_fy(alpha, Fz, B, C, D, E)
metadata {
  "Dyad": {
    "icons": {
      "default": "dyad://CLibraryIntegration/icon.svg"
    },
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 1100,
        "rot": 0
      }
    ]
  },
  "_links": {
    "alpha": {
      "Dyad": {
        "placement": {
          "icon": {
            "iconName": "default",
            "x1": -30,
            "x2": 30,
            "y1": 470,
            "y2": 530
          }
        }
      }
    },
    "Fy": {
      "Dyad": {
        "placement": {
          "icon": {
            "iconName": "default",
            "x1": 970,
            "x2": 1030,
            "y1": 470,
            "y2": 530
          }
        }
      }
    }
  }
}
end

"Clocked tire with C-owned lagged slip, implemented in src/5_stateful.jl."
external component RelaxationTire@[output clk extends Periodic]
  structural parameter Fz::Real = 4000
  structural parameter B::Real = 10
  structural parameter C::Real = 1.3
  structural parameter D::Real = 1
  structural parameter E::Real = 0.97
  structural parameter sigma::Real = 0.5
  structural parameter vx::Real = 20
  structural parameter dt::Real = 0.005
  structural parameter alpha0::Real = 0
  alpha = RealInput@[clk]()
  Fy = RealOutput@[clk]()
relations
metadata {
  "Dyad": {
    "icons": {
      "default": "dyad://CLibraryIntegration/icon.svg"
    },
