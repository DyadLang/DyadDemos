# Brake thermal model with pad-disk radiation coupling and external heat inputs
#
# This component models the thermal behavior of a brake system consisting of:
# - Brake disk: Primary thermal mass with convection and radiation cooling to ambient
# - Brake pad: Secondary thermal mass with convection cooling only
# - Radiation coupling: Heat exchange between pad and disk via radiation
#
# Heat generation is provided externally via thermal ports for flexible coupling
# to mechanical friction models.
#
# Energy balance equations:
# Disk: C_disk * dT_disk/dt = Q_heat_disk - Q_conv_disk - Q_rad_disk + Q_rad_pad_disk
# Pad:  C_pad * dT_pad/dt = Q_heat_pad - Q_conv_pad - Q_rad_pad_disk
#
component BrakeThermal
  # === External heat input ports ===
  # Heat input to disk (from friction)
  heat_disk = HeatPort() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 200, "y1": 950, "x2": 300, "y2": 1050},
        "diagram": {"x1": -50, "y1": 500, "x2": 50, "y2": 600}
      }
    }
  }
  # Heat input to pad (from friction)
  heat_pad = HeatPort() {
    "Dyad": {
      "placement": {
        "icon": {"x1": 700, "y1": 950, "x2": 800, "y2": 1050},
        "diagram": {"x1": -50, "y1": 1100, "x2": 50, "y2": 1200}
      }
    }
  }
  # === Speed inputs ===
  # Vehicle speed input [m/s]
  vehicle_speed = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 200, "x2": 50, "y2": 300},
        "diagram": {"x1": -50, "y1": 850, "x2": 50, "y2": 950}
      }
    }
  }
  # Wheel angular speed input [rad/s]
  wheel_speed = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"x1": -50, "y1": 700, "x2": 50, "y2": 800},
        "diagram": {"x1": -50, "y1": 250, "x2": 50, "y2": 350}
      }
    }
  }
  # === Thermal masses ===
  disk_mass = ThermalComponents.Components.HeatCapacitor(C = C_disk, T0 = T_disk_init) {
    "Dyad": {"placement": {"diagram": {"x1": 850, "y1": 400, "x2": 950, "y2": 500}}}
  }
  pad_mass = ThermalComponents.Components.HeatCapacitor(C = C_pad, T0 = T_pad_init) {
    "Dyad": {"placement": {"diagram": {"x1": 850, "y1": 1000, "x2": 950, "y2": 1100}}}
  }
  # === Convective cooling ===
  disk_convection = ThermalComponents.Components.Convection() {
    "Dyad": {"placement": {"diagram": {"x1": 1000, "y1": 500, "x2": 1100, "y2": 600}}}
  }
  pad_convection = ThermalComponents.Components.Convection() {
    "Dyad": {"placement": {"diagram": {"x1": 1000, "y1": 1100, "x2": 1100, "y2": 1200}}}
  }
  # === Radiative cooling (disk to ambient only) ===
  disk_radiation = ThermalComponents.Components.BodyRadiation(Gr = epsilon_disk * A_disk) {
    "Dyad": {"placement": {"diagram": {"x1": 1200, "y1": 600, "x2": 1300, "y2": 700}}}
  }
  # === Pad-disk radiation coupling ===
  pad_disk_radiation = ThermalComponents.Components.BodyRadiation(Gr = G_rad_pad_disk) {
    "Dyad": {"placement": {"diagram": {"x1": 1150, "y1": 900, "x2": 1250, "y2": 1000, "rot": 180}}}
  }
  # === Ambient temperature boundary ===
  ambient = ThermalComponents.Sources.FixedTemperature(T = T_ambient) {
    "Dyad": {"placement": {"diagram": {"x1": 1400, "y1": 750, "x2": 1500, "y2": 850, "rot": 180}}}
  }
  # === Convection coefficient calculations ===
  # Disk convection: h_disk = h_disk_base + k_disk_speed * |wheel_speed|
  wheel_speed_gain = BlockComponents.Math.Gain(k = k_disk_speed) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "y1": 250, "x2": 300, "y2": 350}}}
  }
  disk_h_base_const = BlockComponents.Sources.Constant(k = h_disk_base) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "y1": 50, "x2": 300, "y2": 150}}}
  }
  disk_h_calc = BlockComponents.Math.Add(k1 = 1.0, k2 = 1.0) {
    "Dyad": {"placement": {"diagram": {"x1": 450, "y1": 150, "x2": 550, "y2": 250}}}
  }
  # Pad convection: h_pad = h_pad_base + k_pad_speed * |vehicle_speed|
  vehicle_speed_gain = BlockComponents.Math.Gain(k = k_pad_speed) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "y1": 850, "x2": 300, "y2": 950}}}
  }
  pad_h_base_const = BlockComponents.Sources.Constant(k = h_pad_base) {
    "Dyad": {"placement": {"diagram": {"x1": 200, "y1": 650, "x2": 300, "y2": 750}}}
  }
  pad_h_calc = BlockComponents.Math.Add(k1 = 1.0, k2 = 1.0) {
    "Dyad": {"placement": {"diagram": {"x1": 450, "y1": 750, "x2": 550, "y2": 850}}}
  }
  # Convert to thermal conductances (h * A)
  disk_conductance = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 700, "y1": 250, "x2": 800, "y2": 350}}}
  }
  pad_conductance = BlockComponents.Math.Product() {
    "Dyad": {"placement": {"diagram": {"x1": 700, "y1": 850, "x2": 800, "y2": 950}}}
  }
  # Constants for surface areas
  disk_area_const = BlockComponents.Sources.Constant(k = A_disk) {
    "Dyad": {"placement": {"diagram": {"x1": 450, "y1": 350, "x2": 550, "y2": 450}}}
  }
  pad_area_const = BlockComponents.Sources.Constant(k = A_pad) {
    "Dyad": {"placement": {"diagram": {"x1": 450, "y1": 950, "x2": 550, "y2": 1050}}}
  }
  # === Thermal parameters ===
  # Disk thermal capacity [J/K]
  parameter C_disk::HeatCapacity = 4000
  # Pad thermal capacity [J/K]
  parameter C_pad::HeatCapacity = 1000
  # Disk initial temperature [K]
  parameter T_disk_init::Temperature = 293.15
  # Pad initial temperature [K]
  parameter T_pad_init::Temperature = 293.15
  # Ambient temperature [K]
  parameter T_ambient::Temperature = 293.15
  # === Heat transfer parameters ===
  # Base disk convection coefficient [W/(m2.K)]
  parameter h_disk_base::CoefficientOfHeatTransfer = 20.0
  # Base pad convection coefficient [W/(m2.K)]
  parameter h_pad_base::CoefficientOfHeatTransfer = 15.0
  # Disk convection enhancement factor [W.s/(m3.K)]
  parameter k_disk_speed::Real = 3.0
  # Pad convection enhancement factor [W.s/(m3.K)]
  parameter k_pad_speed::Real = 4.0
  # Disk surface area for convection [m2]
  parameter A_disk::Area = 0.15
  # Pad surface area for convection [m2]
  parameter A_pad::Area = 0.032
  # Disk emissivity [-]
  parameter epsilon_disk::Real = 0.75
  # Radiative conductance for pad-disk coupling [m2]
  parameter G_rad_pad_disk::Area = 0.012
relations
  # Connect heat inputs to thermal masses
  connect(heat_disk, disk_mass.port) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 900, "y": 550}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(heat_pad, pad_mass.port) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 900, "y": 1150}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  # Build disk convection coefficient: h_disk = h_disk_base + k_disk_speed * wheel_speed
  connect(wheel_speed, wheel_speed_gain.u) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(disk_h_base_const.y, disk_h_calc.u1) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 400, "y": 100}, {"x": 400, "y": 170}], "E": 2}],
      "path": {}
    }
  }
  connect(wheel_speed_gain.y, disk_h_calc.u2) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 400, "y": 300}, {"x": 400, "y": 230.0}], "E": 2}],
      "path": {}
    }
  }
  # Build pad convection coefficient: h_pad = h_pad_base + k_pad_speed * vehicle_speed
  connect(vehicle_speed, vehicle_speed_gain.u) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(pad_h_base_const.y, pad_h_calc.u1) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 400, "y": 700}, {"x": 400, "y": 770}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(vehicle_speed_gain.y, pad_h_calc.u2) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 400, "y": 900}, {"x": 400, "y": 830.0}], "E": 2}],
      "path": {}
    }
  }
  # Calculate thermal conductances (h * A)
  connect(disk_h_calc.y, disk_conductance.u1) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 650, "y": 200}, {"x": 650, "y": 270}], "E": 2}],
      "path": {}
    }
  }
  connect(disk_area_const.y, disk_conductance.u2) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 650, "y": 400}, {"x": 650, "y": 330}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(pad_h_calc.y, pad_conductance.u1) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 650, "y": 800}, {"x": 650, "y": 870.0}], "E": 2}],
      "path": {}
    }
  }
  connect(pad_area_const.y, pad_conductance.u2) {
    "Dyad": {
      "edges": [{"S": 1, "M": [{"x": 650, "y": 1000}, {"x": 650, "y": 930.0}], "E": 2}],
      "path": {}
    }
  }
  # Connect convective cooling
  connect(disk_mass.port, disk_convection.solid) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 900, "y": 550}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(pad_mass.port, pad_convection.solid) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 900, "y": 1150}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(disk_convection.fluid, ambient.port) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 1350, "y": 550}, {"x": 1350, "y": 800}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(pad_convection.fluid, ambient.port) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 1350, "y": 1150}, {"x": 1350, "y": 800}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  # Connect disk radiation to ambient
  connect(disk_mass.port, disk_radiation.port_a) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 900, "y": 650}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(disk_radiation.port_b, ambient.port) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 1350, "y": 650}, {"x": 1350, "y": 800}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  # Connect pad-disk radiation
  connect(pad_mass.port, pad_disk_radiation.port_a) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 900, "y": 1250}, {"x": 1300, "y": 1250}, {"x": 1300, "y": 950}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(disk_mass.port, pad_disk_radiation.port_b) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 900, "y": 650}, {"x": 1100, "y": 650}, {"x": 1100, "y": 950}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  # Connect convection coefficient signals
  connect(disk_conductance.y, disk_convection.Gc) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 1050, "y": 300}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
  connect(pad_conductance.y, pad_convection.Gc) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [{"x": 1050, "y": 900}],
          "E": 2
        }
      ],
      "path": {}
    }
  }
metadata {
  "Dyad": {"icons": {"default": "dyad://FrictionBrakeDemo//brake_heat_transfer.svg"}}
}
end

# Test component for the refined brake thermal model with speed inputs
test component BrakeThermalTest_Constant
  # Brake thermal model instance
  brake_thermal = BrakeThermal() {^brake_thermal}
  # Fixed heat inputs to simulate friction
  disk_heat_input = ThermalComponents.Sources.FixedHeatFlow(Q_flow = Q_disk) {^disk_heat_input}
  pad_heat_input = ThermalComponents.Sources.FixedHeatFlow(Q_flow = Q_pad) {^pad_heat_input}
  # Speed signal sources
  vehicle_speed_source = BlockComponents.Sources.Constant(k = vehicle_speed) {^vehicle_speed_source}
  wheel_speed_source = BlockComponents.Sources.Constant(k = wheel_speed) {^wheel_speed_source}
  # Heat flow to disk
  parameter Q_disk::HeatFlowRate = 9300
  # Heat flow to disk
  parameter Q_pad::HeatFlowRate = 700
  # Vehicle speed
  parameter vehicle_speed::Velocity = 25
  # Wheel speed
  parameter wheel_speed::AngularVelocity = 83
relations
  # Connect heat inputs
  connect(disk_heat_input.port, brake_thermal.heat_disk) {^id6}
  connect(pad_heat_input.port, brake_thermal.heat_pad) {^id7}
  # Connect speed inputs
  connect(vehicle_speed_source.y, brake_thermal.vehicle_speed) {^id8}
  connect(wheel_speed_source.y, brake_thermal.wheel_speed) {^id9}
metadata {
  "Dyad": {
    "tests": {
      "case1": {
        "stop": 1800,
        "atol": {"brake_thermal.pad_mass.T": 0.1, "brake_thermal.disk_mass.T": 0.1},
        "expect": {
          "initial": {"brake_thermal.pad_mass.T": 293.15, "brake_thermal.disk_mass.T": 293.15},
          "signals": ["brake_thermal.pad_mass.T", "brake_thermal.disk_mass.T"],
          "final": {"brake_thermal.pad_mass.T": 485.76, "brake_thermal.disk_mass.T": 513.57}
        }
      }
    }
  },
  "_links": {
    "brake_thermal": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 360, "y1": 100, "x2": 460, "y2": 200, "rot": 0}
        }
      }
    },
    "disk_heat_input": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 230, "y1": 250, "x2": 330, "y2": 350, "rot": 0}
        }
      }
    },
    "pad_heat_input": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 230, "y1": 380, "x2": 330, "y2": 480, "rot": 0}
        }
      }
    },
    "vehicle_speed_source": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 170, "y1": 30, "x2": 270, "y2": 130, "rot": 0}
        }
      }
    },
    "wheel_speed_source": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 80, "y1": 200, "x2": 180, "y2": 300, "rot": 0}
        }
      }
    },
    "id6": {
      "Dyad": {
        "edges": [{"S": 1, "M": [{"x": 385, "y": 300}], "E": 2}],
        "renderStyle": "standard"
      }
    },
    "id7": {
      "Dyad": {
        "edges": [{"S": 1, "M": [{"x": 435, "y": 430}], "E": 2}],
        "renderStyle": "standard"
      }
    },
    "id8": {
      "Dyad": {
        "edges": [{"S": 1, "M": [{"x": 330, "y": 80}, {"x": 330, "y": 125}], "E": 2}],
        "renderStyle": "standard"
