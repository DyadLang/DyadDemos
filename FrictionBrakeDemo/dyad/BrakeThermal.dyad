# Transient analysis of brake thermal model with heat cutoff at 1500s
analysis BrakeThermalAnalysis_Step
  extends TransientAnalysis(stop = 5000.0, reltol = 1e-6, abstol = 1e-8)
  model = BrakeThermalTest_Step()
end