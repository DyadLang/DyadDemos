"A double track model of a car."
example component TwoTrackModelTest
  world = MultibodyComponents.PlanarMechanics.World(g = 0) {^world}
  body = MultibodyComponents.PlanarMechanics.Body(m = 100, I = 1, render = false) {^body}
  body1 = MultibodyComponents.PlanarMechanics.Body(m = 300, I = 0.1, render = false) {^body1}
  body2 = MultibodyComponents.PlanarMechanics.Body(m = 100, I = 1, render = false) {^body2}
  wheelJoint1 = MultibodyComponents.PlanarMechanics.SlipBasedWheelJoint(radius = 0.25, r = [0, 1], mu_A = 1, mu_S = 0.7, N = 1000, sAdhesion = 0.04, sSlide = 0.12, vAdhesion_min = 0.05, vSlide_min = 0.15) {^wheelJoint1}
  wheelJoint2 = MultibodyComponents.PlanarMechanics.SlipBasedWheelJoint(radius = 0.25, r = [0, 1], mu_A = 1, mu_S = 0.7, N = 1500, sAdhesion = 0.04, sSlide = 0.12, vAdhesion_min = 0.05, vSlide_min = 0.15) {^wheelJoint2}
  wheelJoint3 = MultibodyComponents.PlanarMechanics.SlipBasedWheelJoint(radius = 0.25, r = [0, 1], mu_A = 1, mu_S = 0.7, N = 1500, sAdhesion = 0.04, sSlide = 0.12, vAdhesion_min = 0.05, vSlide_min = 0.15) {^wheelJoint3}
  wheelJoint4 = MultibodyComponents.PlanarMechanics.SlipBasedWheelJoint(radius = 0.25, r = [0, 1], mu_A = 1, mu_S = 0.7, N = 1000, sAdhesion = 0.04, sSlide = 0.12, vAdhesion_min = 0.05, vSlide_min = 0.15) {^wheelJoint4}
  differentialGear = MultibodyComponents.PlanarMechanics.DifferentialGear() {^differentialGear}
  pulse = BlockComponents.Sources.Square(frequency = 0.5, offset = 0, start_time = 1, amplitude = -2) {^pulse}
  torque = RotationalComponents.Sources.TorqueSource() {^torque}
  fixed = RotationalComponents.Components.Fixed() {^fixed}
  constantTorque = BlockComponents.Sources.Constant(k = 25) {^constantTorque}
  engineTorque = RotationalComponents.Sources.TorqueSource() {^engineTorque}
  inertia = RotationalComponents.Components.Inertia(J = 1) {^inertia}
  inertia1 = RotationalComponents.Components.Inertia(J = 1) {^inertia1}
  inertia2 = RotationalComponents.Components.Inertia(J = 1) {^inertia2}
  inertia3 = RotationalComponents.Components.Inertia(J = 1) {^inertia3}
  fixedTranslation1 = MultibodyComponents.PlanarMechanics.FixedTranslation(r = [0, 2]) {^fixedTranslation1}
  fixedTranslation2 = MultibodyComponents.PlanarMechanics.FixedTranslation(r = [0.75, 0]) {^fixedTranslation2}
  fixedTranslation3 = MultibodyComponents.PlanarMechanics.FixedTranslation(r = [-0.75, 0]) {^fixedTranslation3}
  fixedTranslation4 = MultibodyComponents.PlanarMechanics.FixedTranslation(r = [0.75, 0]) {^fixedTranslation4}
  fixedTranslation5 = MultibodyComponents.PlanarMechanics.FixedTranslation(r = [-0.75, 0]) {^fixedTranslation5}
  leftTrail = MultibodyComponents.PlanarMechanics.FixedTranslation(r = [0, -0.05]) {^leftTrail}
  rightTrail = MultibodyComponents.PlanarMechanics.FixedTranslation(r = [0, 0.05]) {^rightTrail}
  revolute = MultibodyComponents.PlanarMechanics.Revolute() {^revolute}
  revolute2 = MultibodyComponents.PlanarMechanics.Revolute() {^revolute2}
  dynamic_load = BlockComponents.Sources.Constant(k = 0) {^dynamic_load}
  fixed1 = RotationalComponents.Components.Fixed() {^fixed1}
relations
  initial body1.r = [1.0, 1.0]
  initial body1.v = [0.0, 0.0]
  initial body1.phi = 0.0
  initial body1.w = 0.0
  initial inertia.phi = 0.0
  initial inertia.w = 0.0
  initial inertia1.phi = 0.0
  initial inertia1.w = 0.0
  initial inertia2.phi = 0.0
  initial inertia2.w = 0.0
  initial inertia3.phi = 0.0
  initial inertia3.w = 0.0
  initial revolute2.phi = -0.43633231299858
  initial revolute2.w = 0.0
  connect(inertia.spline_a, wheelJoint1.flange_a) {^id30}
  connect(inertia3.spline_a, wheelJoint4.flange_a) {^id31}
  connect(body2.frame_a, wheelJoint4.frame_a, rightTrail.frame_a) {^id32}
  connect(body.frame_a, wheelJoint1.frame_a, leftTrail.frame_b) {^id33}
  connect(pulse.y, torque.tau) {^id34}
  connect(rightTrail.frame_b, revolute.frame_a) {^id35}
  connect(revolute2.flange_a, revolute.flange_a, torque.spline) {^id36}
  connect(fixedTranslation5.frame_a, revolute.frame_b) {^id37}
  connect(fixedTranslation5.frame_b, fixedTranslation4.frame_b) {^id38}
  connect(fixedTranslation1.frame_b, fixedTranslation4.frame_b) {^id39}
  connect(wheelJoint3.frame_a, fixedTranslation3.frame_a) {^id40}
  connect(wheelJoint2.frame_a, fixedTranslation2.frame_a) {^id41}
  connect(wheelJoint3.flange_a, inertia2.spline_a) {^id42}
  connect(wheelJoint2.flange_a, inertia1.spline_a) {^id43}
  connect(fixedTranslation2.frame_b, fixedTranslation3.frame_b, fixedTranslation1.frame_a, body1.frame_a) {^id44}
  connect(differentialGear.flange_left, wheelJoint2.flange_a) {^id45}
  connect(differentialGear.flange_right, wheelJoint3.flange_a) {^id46}
  connect(engineTorque.spline, differentialGear.flange_b) {^id47}
  connect(constantTorque.y, engineTorque.tau) {^id48}
  connect(dynamic_load.y, wheelJoint1.dynamicLoad, wheelJoint2.dynamicLoad, wheelJoint4.dynamicLoad, wheelJoint3.dynamicLoad) {^id49}
  connect(fixed1.spline, torque.support) {^id50}
  connect(fixed.spline, engineTorque.support) {^id51}
  connect(revolute2.frame_b, fixedTranslation4.frame_a) {^id52}
  connect(leftTrail.frame_a, revolute2.frame_a) {^id53}
