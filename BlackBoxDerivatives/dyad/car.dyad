"A car on a straight track: a point mass pushed by a force, slowed by drag"
component Car
  "Driving force"
  force = RealInput() [{"Dyad": {"placement": {"icon": {"iconName": "input", "x1": -100, "y1": 450, "x2": 0, "y2": 550, "rot": 0}}}}]
  "Speed"
  v = RealOutput() [{"Dyad": {"placement": {"icon": {"iconName": "output", "x1": 1000, "y1": 450, "x2": 1100, "y2": 550, "rot": 0}}}}]
  "Aerodynamic drag coefficient"
  parameter c_drag::Real = 0.02
  "Position"
  variable x::Real
relations
  initial x = 0
  initial v = 0
  der(x) = v
  der(v) = force - c_drag * v^2
metadata {"Dyad": {"icons": {"default": "dyad://BlackBoxDerivatives/Car.svg"}}}
end
