"A car on a straight track, driven by a black-box tire force"
component TireCar
  "Wheel slip: the control input"
  slip = RealInput() {
    "Dyad": {
      "placement": {
        "icon": {"iconName": "input", "x1": -100, "y1": 450, "x2": 0, "y2": 550},
        "diagram": {"iconName": "input", "x1": 75, "y1": 375, "x2": 125, "y2": 425}
      }
    }
  }
  tire = Tire() {
    "Dyad": {"placement": {"diagram": {"x1": 250, "y1": 350, "x2": 450, "y2": 550}}}
  }
  car = Car() {
    "Dyad": {"placement": {"diagram": {"x1": 600, "y1": 350, "x2": 800, "y2": 550}}}
  }
relations
  connect(slip, tire.slip) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(tire.force, car.force) {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}}
  connect(car.v, tire.v) {
    "Dyad": {
      "edges": [
        {
          "S": 1,
          "M": [
            {"x": 850, "y": 450},
            {"x": 850, "y": 650},
            {"x": 200, "y": 650},
            {"x": 200, "y": 500}
          ],
          "E": 2
        }
      ],
      "path": {}
    }
  }
metadata {"Dyad": {"icons": {"default": "dyad://BlackBoxDerivatives/icon.svg"}}}
end
