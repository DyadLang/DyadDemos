      }
    }
  }
}
end

test component EspressoCupSystemWithSpoon
  coffeeMug = CoffeeMugSubsystem() {^coffeeMug}
  steam = SteamSubsystem() {^steam}
  spoon = SpoonSubsystem() {^spoon}
  hand = HandSubsystem() {^hand}
  environment = ThermalComponents.Sources.FixedTemperature(T = 293.15) {^environment}
relations
  connect(steam.liquidInterface, coffeeMug.topSurface) {^id6}
  # The spoon is a second path out of the liquid, parallel to the steam.
  connect(spoon.liquidInterface, coffeeMug.topSurface) {^id7}
  connect(hand.cupContact, coffeeMug.outerSurface) {^id8}
  connect(coffeeMug.ambient, environment.port) {^id9}
  connect(steam.ambient, environment.port) {^id10}
  connect(spoon.ambient, environment.port) {^id11}
  # The T0 parameters on the HeatCapacitors already initialize every
  # differential state, so only the algebraic nodes need a starting guess.
  guess coffeeMug.outerSurface.T = 330.0
  guess coffeeMug.convCup2Env.ΔT = 37.0
  # Breaks a cyclic dependency: hand temp - cup surface temp ≈ 310.15 - 330.
  guess hand.handContact.ΔT = -20.0
  guess spoon.spoonMass.port.T = 350.0
metadata {
  "_links": {
    "coffeeMug": {
